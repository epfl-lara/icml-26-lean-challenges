import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.Data.Finsupp.MonomialOrder

open MvPolynomial
open scoped MonomialOrder

namespace ShadowBench.Source

/--
The monomial ideal generated by exponent vectors `A`, i.e. the ideal
`⟨x^α | α ∈ A⟩` from the source theorem.
-/
noncomputable def monomialIdealFromExponents {σ R : Type*} [CommSemiring R]
    (A : Set (σ →₀ ℕ)) : Ideal (MvPolynomial σ R) :=
  Ideal.span ((fun α : σ →₀ ℕ => MvPolynomial.monomial α (1 : R)) '' A)

/--
The set of exponents that occur as monomials in elements of an ideal.
-/
def idealExponentSet {σ R : Type*} [CommSemiring R]
    (I : Ideal (MvPolynomial σ R)) : Set (σ →₀ ℕ) :=
  {α | ∃ f : MvPolynomial σ R, f ∈ I ∧ α ∈ f.support}

end ShadowBench.Source

/--
Source theorem `line-17` from `docs/source.tex`.

Source proof: none is included in the source file.

Proof sketch / prover notes: unfold the bridge definitions for the generated
monomial ideal and the ideal exponent set. From `μ ∈ S`, choose a polynomial
`f ∈ I` whose support contains `μ`; after rewriting `I` as the span of the
monic monomials indexed by `A`, `MvPolynomial.mem_ideal_span_monomial_image`
should give a generator exponent `α ∈ A` with `α ≤ μ` componentwise. The
generator monomial shows `α ∈ S`. Componentwise domination gives
`α ≼[m] μ` by additivity/monotonicity of the monomial order, while leastness of
`μ` gives `μ ≼[m] α`; antisymmetry through `m.toSyn` gives `μ = α`, hence
`μ ∈ A`.
-/
theorem minimal_monomial_mem_generators {σ R : Type*} [CommSemiring R] [Nontrivial R]
    (A : Set (σ →₀ ℕ)) (I : Ideal (MvPolynomial σ R))
    (hI : I = ShadowBench.Source.monomialIdealFromExponents (R := R) A)
    (S : Set (σ →₀ ℕ))
    (hS : S = ShadowBench.Source.idealExponentSet I)
    (m : MonomialOrder σ) {μ : σ →₀ ℕ}
    (hμS : μ ∈ S) (hμ_min : ∀ β ∈ S, μ ≼[m] β) :
    μ ∈ A := by
  subst S
  rcases hμS with ⟨f, hfI, hμf⟩
  rw [hI, ShadowBench.Source.monomialIdealFromExponents] at hfI
  rcases (MvPolynomial.mem_ideal_span_monomial_image.mp hfI μ hμf) with ⟨α, hαA, hα_le_μ⟩
  have hαS : α ∈ ShadowBench.Source.idealExponentSet I := by
    refine ⟨MvPolynomial.monomial α (1 : R), ?_, ?_⟩
    · rw [hI, ShadowBench.Source.monomialIdealFromExponents]
      exact Ideal.subset_span ⟨α, hαA, rfl⟩
    · classical
      rw [MvPolynomial.support_monomial]
      simp
  have hα_le_m : α ≼[m] μ := by
    rcases le_iff_exists_add.mp hα_le_μ with ⟨γ, hγ⟩
    rw [hγ, map_add]
    exact m.le_add_right α γ
  have hμ_le_α : μ ≼[m] α := hμ_min α hαS
  have h_eq_toSyn : m.toSyn μ = m.toSyn α := le_antisymm hμ_le_α hα_le_m
  have h_eq : μ = α := m.toSyn.injective h_eq_toSyn
  simpa [h_eq] using hαA
