import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.Data.Finsupp.MonomialOrder

open MvPolynomial
open scoped MonomialOrder

/-- The monomial ideal generated by the monic monomials whose exponents lie in `A`. -/
def monomialIdealFromExponents {σ R : Type*} [CommSemiring R]
    (A : Set (σ →₀ ℕ)) : Ideal (MvPolynomial σ R) :=
  Ideal.span ((fun α : σ →₀ ℕ => MvPolynomial.monomial α (1 : R)) '' A)

/-- The exponents whose monic monomials belong to an ideal. -/
def monomialIdealExponentSet {σ R : Type*} [CommSemiring R]
    (I : Ideal (MvPolynomial σ R)) : Set (σ →₀ ℕ) :=
  {β | MvPolynomial.monomial β (1 : R) ∈ I}

/-- An exponent is least in a set for the comparison induced by a monomial order. -/
def IsSmallestForMonomialOrder {σ : Type*} (m : MonomialOrder σ)
    (S : Set (σ →₀ ℕ)) (β : σ →₀ ℕ) : Prop :=
  β ∈ S ∧ ∀ γ, γ ∈ S → β ≼[m] γ

/--
Source proof: no proof is supplied in `docs/source.tex`; the intended argument is the standard
monomial-ideal divisibility argument. Rewrite `I` as the span of monic monomials indexed by `A` and
use `MvPolynomial.mem_ideal_span_monomial_image` to obtain a generator exponent `α ∈ A` with
`α ≤ β` componentwise. Since `α` itself belongs to the exponent set, the leastness of `β` gives
`β ≼[m] α`, while monomial-order compatibility with addition gives `α ≼[m] β`; antisymmetry then
forces `β = α`, so `β ∈ A`.
-/
theorem expSet {σ R : Type*} [CommSemiring R] [Nontrivial R]
    (A : Set (σ →₀ ℕ)) (I : Ideal (MvPolynomial σ R))
    (m : MonomialOrder σ) {β : σ →₀ ℕ}
    (hI : I = monomialIdealFromExponents (R := R) A)
    (hβ : IsSmallestForMonomialOrder m (monomialIdealExponentSet I) β) :
    β ∈ A := by
  classical
  rcases hβ with ⟨hβ_mem, hβ_min⟩
  have hmem :
      MvPolynomial.monomial β (1 : R) ∈
        Ideal.span ((fun α : σ →₀ ℕ => MvPolynomial.monomial α (1 : R)) '' A) := by
    simpa [monomialIdealExponentSet, monomialIdealFromExponents, hI] using hβ_mem
  have hβ_support : β ∈ (MvPolynomial.monomial β (1 : R) : MvPolynomial σ R).support := by
    rw [MvPolynomial.mem_support_iff]
    simp [MvPolynomial.coeff_monomial]
  rcases (MvPolynomial.mem_ideal_span_monomial_image
      (x := MvPolynomial.monomial β (1 : R)) (s := A)).1 hmem β hβ_support with
    ⟨α, hαA, hαleβ⟩
  have hα_mem : α ∈ monomialIdealExponentSet I := by
    have : MvPolynomial.monomial α (1 : R) ∈
        Ideal.span ((fun α : σ →₀ ℕ => MvPolynomial.monomial α (1 : R)) '' A) :=
      Ideal.subset_span
        (Set.mem_image_of_mem (fun α : σ →₀ ℕ => MvPolynomial.monomial α (1 : R)) hαA)
    simpa [monomialIdealExponentSet, monomialIdealFromExponents, hI] using this
  have hβα : β ≼[m] α := hβ_min α hα_mem
  have hαβ : α ≼[m] β := m.toSyn_monotone hαleβ
  have h_eq : β = α := m.toSyn.injective (le_antisymm hβα hαβ)
  simpa [h_eq] using hαA
