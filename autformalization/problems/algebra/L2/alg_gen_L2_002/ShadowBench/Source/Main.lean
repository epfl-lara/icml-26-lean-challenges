import Mathlib.RingTheory.MvPolynomial.Groebner
import Mathlib.RingTheory.MvPolynomial.Ideal

open MvPolynomial MonomialOrder
open scoped MonomialOrder

/-- The ideal generated by the leading terms of all polynomials in a set. This is the
Lean bridge for the source notation `⟨LT(S)⟩`. -/
def leadingTermIdeal {σ R : Type*} [CommRing R] (m : MonomialOrder σ)
    (S : Set (MvPolynomial σ R)) : Ideal (MvPolynomial σ R) :=
  Ideal.span (m.leadingTerm '' S)

/-- A certificate that `r` is a remainder obtained by dividing `p` by the family `f`.
It records exactly the properties supplied by Mathlib's multivariate division algorithm:
a quotient decomposition, degree bounds on quotient products, and no monomial of the
remainder divisible by a leading monomial of a divisor. -/
def IsDivisionRemainder {σ ι R : Type*} [CommRing R] (m : MonomialOrder σ)
    (f : ι → MvPolynomial σ R) (p : MvPolynomial σ R)
    (q : ι →₀ MvPolynomial σ R) (r : MvPolynomial σ R) : Prop :=
  p = Finsupp.linearCombination (MvPolynomial σ R) f q + r ∧
    (∀ i, m.degree (f i * q i) ≼[m] m.degree p) ∧
    (∀ c ∈ r.support, ∀ i, ¬ (m.degree (f i) ≤ c))

/-- Source theorem `exists_nonzero_remainder_of_lt_span_leadingTerms`, `docs/source.tex`
lines 16--57.

Source proof: choose `p ∈ I` whose leading term is not in the ideal generated by the
leading terms of the given generators. Divide `p` by the family `f`. If the division
remainder were zero, the division decomposition and degree bounds would force the
leading term of `p` to be divisible by one of the leading terms of the `f i`, hence to
belong to the smaller leading-term ideal, contradicting the choice of `p`.

Prover notes: use `MonomialOrder.div` to obtain the quotient/remainder certificate;
use strict containment of `leadingTermIdeal m (Set.range f)` in `leadingTermIdeal m I`
to pick `p`; the contradiction from `r = 0` should reduce to membership in the monomial
ideal generated by the leading terms of the divisors. -/
theorem exists_nonzero_remainder_of_lt_span_leadingTerms
    {σ ι k : Type*} [Field k] [Finite ι] (m : MonomialOrder σ)
    (f : ι → MvPolynomial σ k) (I : Ideal (MvPolynomial σ k))
    (hI : I = Ideal.span (Set.range f)) (hf_ne : ∀ i, f i ≠ 0)
    (hlt : leadingTermIdeal m (Set.range f) <
      leadingTermIdeal m (I : Set (MvPolynomial σ k))) :
    ∃ p ∈ I, ∃ (q : ι →₀ MvPolynomial σ k) (r : MvPolynomial σ k),
      IsDivisionRemainder m f p q r ∧ r ≠ 0 := by
  classical
  have _hI := hI
  let R := MvPolynomial σ k
  have hnot_le : ¬ leadingTermIdeal m (I : Set R) ≤ leadingTermIdeal m (Set.range f) :=
    not_le_of_gt hlt
  simp only [leadingTermIdeal, Ideal.span_le, Set.image_subset_iff] at hnot_le
  rw [Set.subset_def] at hnot_le
  push_neg at hnot_le
  obtain ⟨p, hpI, hpLT_not⟩ := hnot_le
  have hp_ne : p ≠ 0 := by
    intro hp0
    apply hpLT_not
    simp [hp0]
  have hunits : ∀ i, IsUnit (m.leadingCoeff (f i)) := by
    intro i
    exact (m.isUnit_leadingCoeff).2 (hf_ne i)
  obtain ⟨q, r, hdecomp, hdeg, hrem⟩ := m.div (b := f) hunits p
  refine ⟨p, hpI, q, r, ⟨hdecomp, hdeg, hrem⟩, ?_⟩
  intro hr0
  apply hpLT_not
  have hp_sum : p = Finsupp.linearCombination (MvPolynomial σ k) f q := by
    simpa [hr0] using hdecomp
  let d := m.degree p
  have hcoeffp : p.coeff d ≠ 0 := by
    dsimp [d]
    simpa [MonomialOrder.leadingCoeff] using (m.leadingCoeff_ne_zero_iff.mpr hp_ne)
  have hcoeff_lc : ((Finsupp.linearCombination (MvPolynomial σ k) f q).coeff d) ≠ 0 := by
    rwa [show
      p.coeff d = (Finsupp.linearCombination (MvPolynomial σ k) f q).coeff d from
      congrArg (fun s : MvPolynomial σ k => s.coeff d) hp_sum] at hcoeffp
  have hcoeffsum_ne :
      (∑ i ∈ q.support, (f i * q i).coeff d) ≠ 0 := by
    simpa [Finsupp.linearCombination_apply, Finsupp.sum, smul_eq_mul, mul_comm,
      MvPolynomial.coeff_sum] using hcoeff_lc
  obtain ⟨i, hiq, hcoeff_i⟩ := Finset.exists_ne_zero_of_sum_ne_zero hcoeffsum_ne
  have hqi_ne : q i ≠ 0 := by
    intro hq0
    simp [hq0] at hcoeff_i
  have hprod_degree : m.degree (f i * q i) = d := by
    apply m.toSyn.injective
    apply le_antisymm
    · simpa [d] using hdeg i
    · exact m.le_degree (MvPolynomial.mem_support_iff.mpr hcoeff_i)
  have hdegfi_le : m.degree (f i) ≤ d := by
    rw [← hprod_degree]
    rw [m.degree_mul (hf_ne i) hqi_ne]
    intro a
    simp
  change m.leadingTerm p ∈ leadingTermIdeal m (Set.range f)
  rw [leadingTermIdeal, m.span_leadingTerm_eq_span_monomial' (B := Set.range f)]
  rw [show
      ((fun p : MvPolynomial σ k => MvPolynomial.monomial (m.degree p) (1 : k)) ''
          (Set.range f \ {0})) =
        ((fun s : σ →₀ ℕ => MvPolynomial.monomial s (1 : k)) ''
          ((fun p : MvPolynomial σ k => m.degree p) '' (Set.range f \ {0}))) by
    ext z
    constructor
    · rintro ⟨g, hg, rfl⟩
      exact ⟨m.degree g, ⟨g, hg, rfl⟩, rfl⟩
    · rintro ⟨s, ⟨g, hg, rfl⟩, rfl⟩
      exact ⟨g, hg, rfl⟩]
  rw [MvPolynomial.mem_ideal_span_monomial_image]
  intro x hx
  have hx_eq : x = d := by
    have hlc : m.leadingCoeff p ≠ 0 := (m.leadingCoeff_ne_zero_iff.mpr hp_ne)
    have hdx : d = x := by
      simpa [d, MonomialOrder.leadingTerm, hlc] using hx
    exact hdx.symm
  subst x
  refine ⟨m.degree (f i), ?_, hdegfi_le⟩
  refine ⟨f i, ?_, rfl⟩
  exact ⟨⟨i, rfl⟩, by simpa using hf_ne i⟩
