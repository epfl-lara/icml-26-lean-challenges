import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.MvPolynomial.MonomialOrder

/-- The monomial ideal generated by the monic monomials with exponent vectors in `A`.
This formalizes `⟨x^α | α ∈ A⟩`, representing `x^α` as
`MvPolynomial.monomial α 1`. -/
noncomputable def MvPolynomial.monomialIdeal {σ k : Type*} [CommSemiring k]
    (A : Set (σ →₀ ℕ)) : Ideal (MvPolynomial σ k) :=
  Ideal.span ((fun α : σ →₀ ℕ => MvPolynomial.monomial α (1 : k)) '' A)

/-- Source: `lem:mem_monomialIdeal_iff_divisible` in `docs/source.tex`.

Source proof: a generator divisor gives membership by closure of the ideal under
multiplication. Conversely, membership in the span of the monomials means, after
expanding each polynomial coefficient into terms, that the monomial is a finite sum of
multiples of the generators, so one of those generator monomials divides it.

Prover notes: unfold `MvPolynomial.monomialIdeal` and reduce to
`MvPolynomial.mem_ideal_span_monomial_image_iff_dvd`; the support of
`MvPolynomial.monomial β 1` is the singleton `{β}` because `1 ≠ 0` in a field. -/
theorem MonomialOrder.mem_monomialIdeal_iff_divisible {σ k : Type*} [Field k]
    (A : Set (σ →₀ ℕ)) (β : σ →₀ ℕ) :
    MvPolynomial.monomial β (1 : k) ∈ MvPolynomial.monomialIdeal A ↔
      ∃ α ∈ A,
        MvPolynomial.monomial α (1 : k) ∣ MvPolynomial.monomial β (1 : k) := by
  sorry
