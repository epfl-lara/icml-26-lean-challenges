import Mathlib.RingTheory.Polynomial.UniqueFactorization

open scoped BigOperators

/--
Source theorem `prop:radical-principal` from `docs/source.tex`:
if `f = c * f₁ ^ a₁ * ... * fᵣ ^ aᵣ` is a factorization in
`k[x₁, ..., xₙ]` into distinct irreducible polynomials with positive exponents,
then the radical of the principal ideal generated by `f` is the principal ideal
generated by the squarefree product `f₁ * ... * fᵣ`.

Source proof: prove both ideal inclusions. First choose an exponent `N` larger
than all `aᵢ`; the displayed factorization gives a multiple of `f` equal to a
power of the squarefree product, so the squarefree product lies in the radical.
Conversely, if `g ^ M ∈ (f)`, then each irreducible factor divides `g ^ M` and,
because irreducibles are prime in this UFD, divides `g`; pairwise
non-association of the factors makes their product divide `g`.

Prover notes: use `MvPolynomial (Fin n) k` for `k[x₁, ..., xₙ]`, `Fin r` for the
indexed factors, `MvPolynomial.C c` for the coefficient, and `Ideal.span {f}` for
the principal ideal `⟨f⟩`. The assumptions `c ≠ 0` and pairwise non-association
record the UFD factorization conventions implicit in the source proof.
-/
theorem radical_span_singleton_eq_span_prod_irreducibles
    (k : Type*) [Field k] (n r : ℕ)
    (f : MvPolynomial (Fin n) k) (c : k)
    (factors : Fin r → MvPolynomial (Fin n) k) (exponents : Fin r → ℕ)
    (h_c_ne_zero : c ≠ 0)
    (h_exponents_pos : ∀ i, 0 < exponents i)
    (h_irreducible : ∀ i, Irreducible (factors i))
    (h_distinct : Pairwise (fun i j => ¬ Associated (factors i) (factors j)))
    (h_factorization :
      f = MvPolynomial.C c * ∏ i : Fin r, factors i ^ exponents i) :
    Ideal.radical (Ideal.span ({f} : Set (MvPolynomial (Fin n) k))) =
      Ideal.span ({∏ i : Fin r, factors i} : Set (MvPolynomial (Fin n) k)) := by
  sorry
