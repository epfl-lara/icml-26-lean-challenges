import Mathlib.Topology.Spectral.Basic
import Mathlib.Topology.JacobsonSpace
import Mathlib.Data.Set.Card

open Topology
open Set

variable {X : Type*} [TopologicalSpace X]

/--
Source definition (`docs/source.tex`, line 17): the constructible subbasis consists of compact
open subsets and their complements.  Lean represents a complement of a compact open set as a
closed set whose complement is compact.
-/
def constructibleTopologySubbasis (X : Type*) [TopologicalSpace X] : Set (Set X) :=
  {s | IsOpen s ∧ IsCompact s} ∪ {s | IsClosed s ∧ IsCompact sᶜ}

/--
Source definition (`docs/source.tex`, line 17): the constructible topology is the topology
generated by the constructible subbasis.
-/
@[implicit_reducible]
def constructibleTopology (X : Type*) [TopologicalSpace X] : TopologicalSpace X :=
  .generateFrom (constructibleTopologySubbasis X)

/-- A type synonym for `X` equipped with its constructible topology. -/
@[nolint unusedArguments]
def WithConstructibleTopology (X : Type*) [TopologicalSpace X] : Type _ :=
  X

instance : TopologicalSpace (WithConstructibleTopology X) :=
  constructibleTopology X

/--
Source definition/proof helper (`docs/source.tex`, line 17 and proof lines 236--237): finite
intersections of constructible-subbasis members are compact in a compact quasi-separated space.

Proof sketch: every subbasis member is compact: compact-open members directly, and closed members
because they are closed subsets of the compact ambient space.  Then apply quasi-separatedness to a
finite intersection of compact subsets.
-/
theorem isCompact_sInter_of_subset_constructibleTopologySubbasis [CompactSpace X]
    [QuasiSeparatedSpace X] {s : Set (Set X)} (hs : s ⊆ constructibleTopologySubbasis X)
    (hf : s.Finite) : IsCompact (⋂₀ s) := by
  sorry

/--
Source proof (`docs/source.tex`, lines 24--187): apply Alexander's subbasis theorem to the
constructible subbasis.  If a counterexample family with the finite-intersection property exists,
use Zorn's lemma to choose a maximal one `B`.  Let `B'` be the closed members of `B` and set
`Z = ⋂₀ B'`; compactness gives `Z.Nonempty`.

Prover notes: if `Z` is irreducible, quasi-sobriety gives a generic point.  Closed members of `B`
contain it by definition of `Z`; nonclosed subbasis members are compact open, and compactness plus
the finite-intersection property shows they meet `Z`, so the generic point lies in them too.  This
contradicts `⋂₀ B = ∅`.  If `Z` is reducible, prespectrality gives closed `Y₁ Y₂` with compact
complements covering `Z` but not containing it.  Maximality of `B` gives finite witnesses `A₁ A₂`;
the finite intersection `W` of the remaining members is compact by
`isCompact_sInter_of_subset_constructibleTopologySubbasis`.  Show first `Z ∩ W = ∅`, then use
compactness of `W` and the closed family `B'` with the finite-intersection property to obtain
`W ∩ Z ≠ ∅`, contradiction.
-/
theorem compactSpace_withConstructibleTopology [CompactSpace X] [QuasiSober X]
    [PrespectralSpace X] [QuasiSeparatedSpace X] :
    CompactSpace (WithConstructibleTopology X) := by
  sorry
