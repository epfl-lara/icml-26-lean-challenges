        Y q (Y i) D done init init ?_
        (resetPairDominatesAbove_refl_root q (Y i) D init hD hbst hroot)
        ?_ hall_strict
    · intro pre j tail hsplit hdom hj_mem hj_lt
      exact hpres_lt pre j tail hsplit hj_lt hdom hj_mem
    · intro j hj
      exact hmem_prefix j (by simp [hj])
  · intro left p right hsplit hp_eq hright_lt hleft_current
      hleft_right hactual hreset
    let actual0 := splay (splayTreeAfter Y init left) q
    let reset0 := suffixResetTreeAfter Y q init left
    have hdom0 :
        resetPairDominatesAbove q (Y i) D actual0 reset0 := by
      unfold actual0 reset0
      exact hbase left p right hsplit hp_eq hright_lt
        hleft_current hleft_right
    have hmem_right_actual0 :
        ∀ j : Fin n, j ∈ right → Y j ∈ actual0.toKeyList := by
      intro j hj
      have hj_done : j ∈ done := by
        rw [hsplit]
        simp [hj]
