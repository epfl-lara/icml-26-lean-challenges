private theorem searchPathKeys_nodup_of_isBST :
    ∀ (t : BinaryTree) (q : Nat), IsBST t → (searchPathKeys t q).Nodup
| .empty, q, _hbst => by
    simp [searchPathKeys]
| .node l k r, q, hbst => by
    cases hbst with
    | node _ _ _ hleft hright hbst_left hbst_right =>
        simp only [searchPathKeys]
        by_cases hqk : q < k
        · simp [hqk]
          constructor
          · intro hkpath
            have hleft_mem : k ∈ l.toKeyList :=
              searchPathKeys_subset_toKeyList l q k hkpath
            have hk_lt : k < k :=
              (forallTree_iff_forall_mem.mp hleft) k hleft_mem
            omega
          · exact searchPathKeys_nodup_of_isBST l q hbst_left
        · by_cases hkq : k < q
          · simp [hqk, hkq]
            constructor
            · intro hkpath
              have hright_mem : k ∈ r.toKeyList :=
                searchPathKeys_subset_toKeyList r q k hkpath
              have hk_gt : k < k :=
                (forallTree_iff_forall_mem.mp hright) k hright_mem
              omega
            · exact searchPathKeys_nodup_of_isBST r q hbst_right
          · simp [hqk, hkq]

private theorem list_pair_length_le_of_union_inter_card
    {A B C D E : List Nat}
    (hA : A.Nodup) (hB : B.Nodup) (hC : C.Nodup)
    (hD : D.Nodup) (hE : E.Nodup)
    (hsubA : A.toFinset ⊆ C.toFinset ∪ D.toFinset)
    (hsubB : B.toFinset ⊆ C.toFinset ∪ D.toFinset)
    (hinter :
      (A.toFinset ∩ B.toFinset).card ≤
        (C.toFinset ∩ D.toFinset).card + E.toFinset.card + 2) :
    A.length + B.length ≤ C.length + D.length + E.length + 2 := by
  have hAcard : A.toFinset.card = A.length :=
    List.toFinset_card_of_nodup hA
  have hBcard : B.toFinset.card = B.length :=
    List.toFinset_card_of_nodup hB
  have hCcard : C.toFinset.card = C.length :=
    List.toFinset_card_of_nodup hC
  have hDcard : D.toFinset.card = D.length :=
    List.toFinset_card_of_nodup hD
  have hEcard : E.toFinset.card = E.length :=
    List.toFinset_card_of_nodup hE
  have hUsub :
      A.toFinset ∪ B.toFinset ⊆ C.toFinset ∪ D.toFinset := by
    intro key hkey
    rw [Finset.mem_union] at hkey
    rcases hkey with hkeyA | hkeyB
    · exact hsubA hkeyA
    · exact hsubB hkeyB
  have hUle :
      (A.toFinset ∪ B.toFinset).card ≤
        (C.toFinset ∪ D.toFinset).card :=
    Finset.card_le_card hUsub
  have hAB :=
    Finset.card_union_add_card_inter A.toFinset B.toFinset
  have hCD :=
    Finset.card_union_add_card_inter C.toFinset D.toFinset
  have hcard :
      A.toFinset.card + B.toFinset.card ≤
        C.toFinset.card + D.toFinset.card + E.toFinset.card + 2 := by
    omega
  omega

private theorem search_path_len_le_path_add_after_splay_of_mem
    {t : BinaryTree} {x y : Nat}
    (hbst : IsBST t)
    (hxmem : x ∈ t.toKeyList)
    (hymem : y ∈ t.toKeyList) :
    t.search_path_len y ≤
      t.search_path_len x + (splay t x).search_path_len y := by
  let oldY := searchPathKeys t y
  let oldX := searchPathKeys t x
  let newY := searchPathKeys (splay t x) y
  have holdY_nodup : oldY.Nodup := by
    unfold oldY
    exact searchPathKeys_nodup_of_isBST t y hbst
  have holdX_nodup : oldX.Nodup := by
    unfold oldX
    exact searchPathKeys_nodup_of_isBST t x hbst
  have hnewY_nodup : newY.Nodup := by
    unfold newY
    exact searchPathKeys_nodup_of_isBST (splay t x) y
      (splay_isBST t x hbst)
  have holdY_card : oldY.toFinset.card = oldY.length :=
    List.toFinset_card_of_nodup holdY_nodup
  have holdX_card : oldX.toFinset.card = oldX.length :=
    List.toFinset_card_of_nodup holdX_nodup
  have hnewY_card : newY.toFinset.card = newY.length :=
    List.toFinset_card_of_nodup hnewY_nodup
  have hsubset_card :
      oldY.toFinset.card ≤ (oldX.toFinset ∪ newY.toFinset).card := by
    apply Finset.card_le_card
    intro key hkey
    have hkey_old : key ∈ searchPathKeys t y := by
      simpa [oldY] using hkey
    rw [Finset.mem_union]
    rcases searchPathKeys_old_subset_union_splay t x y key
        hbst hxmem hymem hkey_old with hx_path | hy_new
    · left
      simpa [oldX] using hx_path
    · right
      simpa [newY] using hy_new
  have hunion_card :
      (oldX.toFinset ∪ newY.toFinset).card ≤
        oldX.toFinset.card + newY.toFinset.card :=
    Finset.card_union_le _ _
  have hlen : oldY.length ≤ oldX.length + newY.length := by
    omega
  unfold oldY oldX newY at hlen
  rw [searchPathKeys_length_eq_search_path_len,
      searchPathKeys_length_eq_search_path_len,
      searchPathKeys_length_eq_search_path_len] at hlen
  exact hlen

