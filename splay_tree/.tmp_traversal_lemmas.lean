          resetPairDominatesAbove q (Y i) D
            (splayTreeAfter Y init (left ++ p :: pre))
            (suffixResetTreeAfter Y q init (left ++ p :: pre)) := by
        simpa [hactual_pre, hreset_pre] using hdom_pre
