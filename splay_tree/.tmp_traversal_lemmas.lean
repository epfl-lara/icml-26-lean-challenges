private theorem boundaryBudget_sublist_le {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (q : Nat)
    {xs ys : List (Fin n)}
    (hsub : xs.Sublist ys) :
    boundaryBudget X t xs q ≤ boundaryBudget X t ys q := by
  have hlen := List.Sublist.length_le hsub
  have hhull := boundaryHullSize_sublist_le X t q hsub
  unfold boundaryBudget
  exact_mod_cast Nat.add_le_add hlen hhull

private theorem activeBudget_le_boundaryBudget {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (q : Nat) :
    activeBudget X t xs ≤ boundaryBudget X t xs q := by
