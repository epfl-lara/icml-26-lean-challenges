private theorem splayPathSum_first_tail_rise_split_or_all_tail_le
    {n : Nat} {Y : Fin n → Nat} {i : Fin n}
    {xs : List (Fin n)} (t : BinaryTree)
    (hsub : (i :: xs).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1]) :
    (∀ r : Fin xs.length, Y (xs.get r) ≤ Y i) ∨
      ∃ p : Fin xs.length,
        Y i < Y (xs.get p) ∧
        (∀ r : Fin (xs.take p.val).length,
          Y ((xs.take p.val).get r) ≤ Y i) ∧
        (∀ r : Fin (xs.drop p.val).length,
          Y i ≤ Y ((xs.drop p.val).get r)) ∧
        splayPathSum Y t xs =
          splayPathSum Y t (xs.take p.val) +
            splayPathSum Y
              (splayTreeAfter Y t (xs.take p.val)) (xs.drop p.val) := by
  rcases exists_first_tail_rise_or_all_tail_le_head hsub havoid with
    hall | ⟨p, hp_rise, hbefore, hafter⟩
  · exact Or.inl hall
  · refine Or.inr ⟨p, hp_rise, ?_, ?_, ?_⟩
    · exact take_before_first_tail_rise_le_head hbefore
    · exact drop_from_first_tail_rise_head_le hafter
    · exact splayPathSum_take_drop Y t xs p.val

