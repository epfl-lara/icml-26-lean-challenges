private theorem actualResetFirstLowerPairGapPotential_budget_kernel_of_lower_head
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (hhead :
      ∀ (j : Fin n) (future : List (Fin n)),
        IsBST init →
        rootKey init = some q →
        (Y avoids ![2, 3, 1]) →
        (∀ a : Fin n, Y a ≤ q) →
        (done ++ i :: j :: future).Sublist (List.finRange n) →
        (∀ a : Fin n, a ∈ done ++ i :: j :: future →
          Y a ∈ init.toKeyList) →
        Y i ∈ (splayTreeAfter Y init done).toKeyList →
        Y i < q →
        Y j < q →
        actualResetLowerPairGapAt Y q init (done ++ [i]) j + 1 ≤
          3 * (boundaryBudget Y (suffixResetTreeAfter Y q init done)
                (i :: j :: future) q -
              boundaryBudget Y (suffixResetTreeAfter Y q init (done ++ [i]))
                (j :: future) q)) :
    ∀ (future : List (Fin n)),
      IsBST init →
      rootKey init = some q →
      (Y avoids ![2, 3, 1]) →
      (∀ a : Fin n, Y a ≤ q) →
      (done ++ i :: future).Sublist (List.finRange n) →
      (∀ a : Fin n, a ∈ done ++ i :: future → Y a ∈ init.toKeyList) →
      Y i ∈ (splayTreeAfter Y init done).toKeyList →
      Y i < q →
      actualResetFirstLowerPairGapPotential Y q init (done ++ [i]) future + 1 ≤
        3 * (boundaryBudget Y (suffixResetTreeAfter Y q init done)
              (i :: future) q -
            boundaryBudget Y (suffixResetTreeAfter Y q init (done ++ [i]))
              future q)
| [], hbst, hroot, _havoid, _hle, _hsub, _hmem, hi_mem, hi_lt => by
    have hreset_next :
        suffixResetTreeAfter Y q init (done ++ [i]) =
          splay (splay (suffixResetTreeAfter Y q init done) (Y i)) q :=
      suffixResetTreeAfter_append_singleton_lt Y q done init i hi_lt
    have hbst_reset : IsBST (suffixResetTreeAfter Y q init done) :=
      suffixResetTreeAfter_isBST Y q done init hbst
    have hq_mem_reset :
        q ∈ (suffixResetTreeAfter Y q init done).toKeyList := by
      have hroot_reset :=
        suffixResetTreeAfter_rootKey Y q done init hbst hroot
      exact rootKey_mem_toKeyList hroot_reset
    have hi_mem_reset :
        Y i ∈ (suffixResetTreeAfter Y q init done).toKeyList := by
      rw [suffixResetTreeAfter_toKeyList]
      rw [splayTreeAfter_toKeyList] at hi_mem
      exact hi_mem
    have hbudget :=
      boundaryBudget_after_pivot_reset_add_one_le_cons
        Y i [] q hbst_reset hi_mem_reset hq_mem_reset
        (by intro j hj; simp at hj)
    have hbudget' :
        boundaryBudget Y (suffixResetTreeAfter Y q init (done ++ [i]))
            [] q + 1 ≤
          boundaryBudget Y (suffixResetTreeAfter Y q init done) [i] q := by
      rw [hreset_next]
      exact hbudget
    have hdrop :
        1 ≤
          boundaryBudget Y (suffixResetTreeAfter Y q init done) [i] q -
            boundaryBudget Y (suffixResetTreeAfter Y q init (done ++ [i]))
              [] q := by
      linarith
    simp [actualResetFirstLowerPairGapPotential]
    nlinarith
| j :: future, hbst, hroot, havoid, hle, hsub, hmem, hi_mem,
    hi_lt => by
    by_cases hj_lt : Y j < q
    · simpa [actualResetFirstLowerPairGapPotential, hj_lt] using
        hhead j future hbst hroot havoid hle hsub hmem hi_mem
          hi_lt hj_lt
    · have hj_eq : Y j = q := by
        have hj_le := hle j
        omega
      have hsub_tail : (done ++ i :: future).Sublist (List.finRange n) := by
        have hskip :
            (done ++ i :: future).Sublist (done ++ i :: j :: future) :=
          sublist_append_cons_skip_middle_for_kernel done i j future
        exact hskip.trans hsub
      have hmem_tail :
          ∀ a : Fin n, a ∈ done ++ i :: future → Y a ∈ init.toKeyList := by
        intro a ha
        exact hmem a
          ((sublist_append_cons_skip_middle_for_kernel done i j future).subset ha)
      have ih :=
        actualResetFirstLowerPairGapPotential_budget_kernel_of_lower_head
          Y q init done i hhead future hbst hroot havoid hle hsub_tail
          hmem_tail hi_mem hi_lt
      have hold :
          boundaryBudget Y (suffixResetTreeAfter Y q init done)
              (i :: j :: future) q =
            boundaryBudget Y (suffixResetTreeAfter Y q init done)
              (i :: future) q + 1 :=
        boundaryBudget_cons_cons_pivot_eq
          Y (suffixResetTreeAfter Y q init done) i j future q hj_eq
      have hnew :
          boundaryBudget Y (suffixResetTreeAfter Y q init (done ++ [i]))
              (j :: future) q =
            boundaryBudget Y (suffixResetTreeAfter Y q init (done ++ [i]))
              future q + 1 :=
        boundaryBudget_cons_pivot_eq
          Y (suffixResetTreeAfter Y q init (done ++ [i])) j future q hj_eq
      rw [actualResetFirstLowerPairGapPotential_cons_pivot_eq
        Y q init (done ++ [i]) future j hj_eq, hold, hnew]
      nlinarith

