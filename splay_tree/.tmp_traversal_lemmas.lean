      (i :: xs).Sublist (List.finRange n) →
      splayPathSumWithFinal Y q (splay t (Y i)) xs ≤
        ((splay t (Y i)).search_path_len q : ℝ) +
          suffixResetUpperPathSum Y q (splay (splay t (Y i)) q) xs +
          D * xs.length := by
  intro t i xs hbst hroot _hi_mem hi_lt _hmem_tail hsub
  have hmain :=
    splayPathSumWithFinal_le_suffixResetUpperPathSum_of_prefix_pair_bound
      Y q t D hD hbst hroot hle_all
      (fun done j future hsub' hj_lt =>
        hpair t done j future hbst hroot hsub' hj_lt)
      [i] xs hsub
  have hactual :
      splayTreeAfter Y t [i] = splay t (Y i) := by
    simp [splayTreeAfter]
  have hreset :
      suffixResetTreeAfter Y q t [i] = splay (splay t (Y i)) q := by
    simpa using suffixResetTreeAfter_append_singleton_lt Y q [] t i hi_lt
  simpa [hactual, hreset] using hmain

