            (List.finRange (N - (m.val + 1))))
        ≤
      K * boundaryBudget (prefixSeq Y m) t (List.finRange m.val) (Y m) +
        K * boundaryBudget (suffixSeq Y m) ts
          (List.finRange (N - (m.val + 1))) q := by
          nlinarith
    _ =
      K *
        (boundaryBudget (prefixSeq Y m) t (List.finRange m.val) (Y m) +
          boundaryBudget (suffixSeq Y m) ts
            (List.finRange (N - (m.val + 1))) q) := by ring
    _ ≤ K * (2 * boundaryBudget Y t (List.finRange N) q) := hmul
