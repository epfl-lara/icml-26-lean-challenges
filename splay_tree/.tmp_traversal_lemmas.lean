    hmem_prefix hi_mem hi_lt hlarge hall_le
  exact
    current_path_len_all_done_le_current_of_ordered_low_pair_and_q_cancel
      Y q Cp D E init done i future hD hCpD hbst hroot
      hmem_prefix hi_mem hi_lt hall_le hordered_low_pair
      (hall_cancel Y q init done i future hbst hroot havoid hle hsub
        hmem_prefix hi_mem hi_lt hlarge hall_le)

private theorem traversal_conjecture_of_first_tail_rise_current_path_state_cases_large_low_path_cancel
    (Ks A C Cp D E : ℝ)
    (hKs : 0 ≤ Ks) (hA : 2 ≤ A) (hC : 0 ≤ C)
    (hD : 0 ≤ D) (hCpD : Cp ≤ D) (hDE : 1 ≤ D + E)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          Ks * boundaryBudget Y t (List.finRange N) q)
    (hall_tail_le :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat)
          (t : BinaryTree) (i : Fin N) (xs : List (Fin N)),
        xs ≠ [] →
        IsBST t →
        rootKey t = some q →
        Y i ∈ t.toKeyList →
        Y i < q →
        (∀ j : Fin N, j ∈ xs → Y j ∈ t.toKeyList) →
        (∀ j : Fin N, j ∈ xs → Y j < q) →
        (i :: xs).Sublist (List.finRange N) →
        (Y avoids ![2, 3, 1]) →
        (∀ r : Fin xs.length, Y (xs.get r) ≤ Y i) →
        (t.search_path_len (Y i) : ℝ) +
            ((splay t (Y i)).search_path_len q : ℝ) ≤
          C + A *
            (boundaryBudget Y t (i :: xs) q -
              boundaryBudget Y (splay (splay t (Y i)) q) xs q))
    (hfirst_rise :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat)
          (t : BinaryTree) (i : Fin N) (xs : List (Fin N)),
        xs ≠ [] →
        IsBST t →
        rootKey t = some q →
        Y i ∈ t.toKeyList →
        Y i < q →
        (∀ j : Fin N, j ∈ xs → Y j ∈ t.toKeyList) →
        (∀ j : Fin N, j ∈ xs → Y j < q) →
        (i :: xs).Sublist (List.finRange N) →
        (Y avoids ![2, 3, 1]) →
        ∀ p : Fin xs.length,
          Y i < Y (xs.get p) →
          (∀ r : Fin (xs.take p.val).length,
            Y ((xs.take p.val).get r) ≤ Y i) →
          (∀ r : Fin (xs.drop p.val).length,
            Y i ≤ Y ((xs.drop p.val).get r)) →
          (t.search_path_len (Y i) : ℝ) +
              ((splay t (Y i)).search_path_len q : ℝ) ≤
            C + A *
              (boundaryBudget Y t (i :: xs) q -
                boundaryBudget Y (splay (splay t (Y i)) q) xs q))
    (hlow_path :
      ∀ {q lo x y : Nat} {actual reset : BinaryTree},
        resetPairDominatesAbove q lo D actual reset →
        x ∈ actual.toKeyList →
        x < q →
        x ≤ lo →
        y ∈ (splay actual x).toKeyList →
        lo ≤ y →
        y < q →
        ((splay actual x).search_path_len y : ℝ) ≤
          ((splay (splay reset x) q).search_path_len y : ℝ) + Cp)
    (hall_cancel :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat),
        ∀ (init : BinaryTree) (done : List (Fin N)) (i : Fin N)
            (future : List (Fin N)),
          IsBST init →
          rootKey init = some q →
          (Y avoids ![2, 3, 1]) →
          (∀ j : Fin N, Y j ≤ q) →
          (done ++ i :: future).Sublist (List.finRange N) →
          (∀ j : Fin N, j ∈ done ++ i :: future → Y j ∈ init.toKeyList) →
          Y i ∈ (splayTreeAfter Y init done).toKeyList →
          Y i < q →
          1 < done.length →
          (∀ j : Fin N, j ∈ done → Y j ≤ Y i) →
          ((splayTreeAfter Y init done).search_path_len q : ℝ) +
              ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) ≤
            ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) +
              E)
    (hfirst_lt :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat),
        ∀ (init : BinaryTree) (done : List (Fin N)) (i : Fin N)
            (future : List (Fin N)),
          IsBST init →
          rootKey init = some q →
          (Y avoids ![2, 3, 1]) →
          (∀ j : Fin N, Y j ≤ q) →
          (done ++ i :: future).Sublist (List.finRange N) →
          (∀ j : Fin N, j ∈ done ++ i :: future → Y j ∈ init.toKeyList) →
          Y i ∈ (splayTreeAfter Y init done).toKeyList →
          Y i < q →
          1 < done.length →
          ∀ (left : List (Fin N)) (p : Fin N) (right : List (Fin N)),
            done = left ++ p :: right →
            Y i < Y p →
            (∀ a : Fin left.length, Y (left.get a) ≤ Y i) →
            (∀ c : Fin right.length,
              Y i < Y (right.get c) → Y (right.get c) ≤ Y p) →
            Y p < q →
            splayTreeAfter Y init done =
              splayTreeAfter Y
                (splay (splayTreeAfter Y init left) (Y p)) right →
            suffixResetTreeAfter Y q init done =
              suffixResetTreeAfter Y q
                (splay
                  (splay (suffixResetTreeAfter Y q init left) (Y p)) q)
                right →
            ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) ≤
              ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
                (D + E))
    (hfirst_eq :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat),
        ∀ (init : BinaryTree) (done : List (Fin N)) (i : Fin N)
            (future : List (Fin N)),
          IsBST init →
          rootKey init = some q →
          (Y avoids ![2, 3, 1]) →
          (∀ j : Fin N, Y j ≤ q) →
          (done ++ i :: future).Sublist (List.finRange N) →
          (∀ j : Fin N, j ∈ done ++ i :: future → Y j ∈ init.toKeyList) →
          Y i ∈ (splayTreeAfter Y init done).toKeyList →
          Y i < q →
          1 < done.length →
          ∀ (left : List (Fin N)) (p : Fin N) (right : List (Fin N)),
            done = left ++ p :: right →
            Y i < Y p →
            (∀ a : Fin left.length, Y (left.get a) ≤ Y i) →
            (∀ c : Fin right.length,
              Y i < Y (right.get c) → Y (right.get c) ≤ Y p) →
            Y p = q →
            splayTreeAfter Y init done =
              splayTreeAfter Y
                (splay (splayTreeAfter Y init left) q) right →
            suffixResetTreeAfter Y q init done =
              suffixResetTreeAfter Y q
                (suffixResetTreeAfter Y q init left) right →
            ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) ≤
              ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
                (D + E)) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  refine
    traversal_conjecture_of_first_tail_rise_current_path_state_cases_large
      Ks A C (D + E) hKs hA hC hDE hstrict hall_tail_le
      hfirst_rise ?_ hfirst_lt hfirst_eq
  intro N Y q init done i future hbst hroot havoid hle hsub
    hmem_prefix hi_mem hi_lt hlarge hall_le
  exact
    current_path_len_all_done_le_current_of_low_path_and_q_cancel
      Y q Cp D E init done i future hD hCpD hbst hroot
      hmem_prefix hi_mem hi_lt hall_le hlow_path
      (hall_cancel Y q init done i future hbst hroot havoid hle hsub
        hmem_prefix hi_mem hi_lt hlarge hall_le)

private def intervalSeq (base n : Nat) : Fin n → Nat :=
  fun i => base + i.val

private theorem intervalSeq_zero {base n : Nat} :
    intervalSeq base (n + 1) 0 = base := by
  simp [intervalSeq]

private theorem intervalSeq_succ {base n : Nat} (i : Fin n) :
    intervalSeq base (n + 1) (Fin.succ i) =
      intervalSeq (base + 1) n i := by
  simp [intervalSeq]
  omega

private theorem intervalKeyList_nodup (base n : Nat) :
    ((List.finRange n).map (fun i : Fin n => base + i.val)).Nodup := by
  have hinj : Function.Injective (fun i : Fin n => base + i.val) := by
    intro i j hij
    apply Fin.ext
    exact Nat.add_left_cancel hij
  exact List.Nodup.map hinj (List.nodup_finRange n)

private theorem intervalKeyList_perm_toKeyList_of_exact_mem
    (base n : Nat) (t : BinaryTree)
    (hsize : t.num_nodes = n)
    (hmem : ∀ i : Fin n, intervalSeq base n i ∈ t.toKeyList) :
    List.Perm ((List.finRange n).map (fun i : Fin n => intervalSeq base n i))
      t.toKeyList := by
  have hnodup :=
    intervalKeyList_nodup base n
  have hsubset :
      ((List.finRange n).map (fun i : Fin n => intervalSeq base n i)) ⊆
        t.toKeyList := by
    intro x hx
    rcases (List.mem_map.mp hx) with ⟨i, _hi, rfl⟩
    exact hmem i
  have hsubperm :=
    List.subperm_of_subset hnodup hsubset
  have hlen :
      t.toKeyList.length ≤
        ((List.finRange n).map
          (fun i : Fin n => intervalSeq base n i)).length := by
    rw [toKeyList_length, hsize, List.length_map, List.length_finRange]
  exact hsubperm.perm_of_length_le hlen

private theorem mem_intervalKeyList_of_exact_mem
    {base n : Nat} {t : BinaryTree}
    (hsize : t.num_nodes = n)
    (hmem : ∀ i : Fin n, intervalSeq base n i ∈ t.toKeyList)
    {x : Nat} (hx : x ∈ t.toKeyList) :
    x ∈ (List.finRange n).map (fun i : Fin n => intervalSeq base n i) := by
  have hp :=
    intervalKeyList_perm_toKeyList_of_exact_mem base n t hsize hmem
  exact (List.Perm.mem_iff hp).mpr hx

private theorem intervalSeq_min_of_exact_mem
    {base n : Nat} {t : BinaryTree}
    (hsize : t.num_nodes = n)
    (hmem : ∀ i : Fin n, intervalSeq base n i ∈ t.toKeyList) :
    ∀ x : Nat, x ∈ t.toKeyList → base ≤ x := by
  intro x hx
  have hx_interval :=
    mem_intervalKeyList_of_exact_mem hsize hmem hx
  rcases (List.mem_map.mp hx_interval) with ⟨i, _hi, hix⟩
  rw [← hix]
  simp [intervalSeq]

private theorem intervalSeq_mem_tail_as_succ
    {base n : Nat} {t : BinaryTree}
    (hmem : ∀ i : Fin (n + 1), intervalSeq base (n + 1) i ∈ t.toKeyList) :
    ∀ i : Fin n, intervalSeq (base + 1) n i ∈ t.toKeyList := by
  intro i
  rw [← intervalSeq_succ i]
  exact hmem (Fin.succ i)

private theorem search_path_len_root_right_eq
    {t : BinaryTree} {q x : Nat}
    (hbst : IsBST t) (hroot : rootKey t = some q)
    (hx : x ∈ (rightSubtree t).toKeyList) :
    t.search_path_len x = 1 + (rightSubtree t).search_path_len x := by
  cases ht : t with
  | empty =>
      simp [rootKey, ht] at hroot
  | node l k r =>
      simp [rootKey, ht] at hroot
      subst k
      have hbst_node : IsBST (BinaryTree.node l q r) := by
        simpa [ht] using hbst
      have hx_r : x ∈ r.toKeyList := by
        simpa [ht, rightSubtree] using hx
      have hq_lt_x : q < x := isBST_right_mem_gt_root hbst_node hx_r
      have hnot : ¬ x < q := by omega
      simp [rightSubtree, BinaryTree.search_path_len, hnot, hq_lt_x]

private theorem splay_cost_root_right_eq
    {t : BinaryTree} {q x : Nat}
    (hbst : IsBST t) (hroot : rootKey t = some q)
    (hx : x ∈ (rightSubtree t).toKeyList) :
    splay.cost t x = splay.cost (rightSubtree t) x + 1 := by
  have hpath := search_path_len_root_right_eq hbst hroot hx
  have hx_t : x ∈ t.toKeyList := by
    cases ht : t with
    | empty =>
        simp [rightSubtree, ht, BinaryTree.toKeyList] at hx
    | node l k r =>
        have hx_r : x ∈ r.toKeyList := by
          simpa [ht, rightSubtree] using hx
        simp [BinaryTree.toKeyList, hx_r]
  have hcost_t :=
    splay_cost_add_one_eq_search_path_len_of_mem t x hx_t
  have hcost_r :=
    splay_cost_add_one_eq_search_path_len_of_mem (rightSubtree t) x hx
  have hpathR :
      (t.search_path_len x : ℝ) =
        1 + ((rightSubtree t).search_path_len x : ℝ) := by
    exact_mod_cast hpath
  nlinarith

private theorem splay_min_interval_tail_state {base n : Nat}
    (t : BinaryTree)
    (hsize : t.num_nodes = n + 1)
    (hbst : IsBST t)
    (hmem : ∀ i : Fin (n + 1),
      intervalSeq base (n + 1) i ∈ t.toKeyList) :
    (rightSubtree (splay t base)).num_nodes = n ∧
      IsBST (rightSubtree (splay t base)) ∧
      (∀ i : Fin n,
        intervalSeq (base + 1) n i ∈
          (rightSubtree (splay t base)).toKeyList) := by
  have hbase_mem : base ∈ t.toKeyList := by
    simpa [intervalSeq_zero] using hmem (0 : Fin (n + 1))
  have hmin :
      ∀ x : Nat, x ∈ t.toKeyList → base ≤ x :=
    intervalSeq_min_of_exact_mem hsize hmem
  have htail_mem :
      ∀ i : Fin n, intervalSeq (base + 1) n i ∈ t.toKeyList :=
    intervalSeq_mem_tail_as_succ hmem
  have htail_gt :
      ∀ i : Fin n, base < intervalSeq (base + 1) n i := by
    intro i
    simp [intervalSeq]
    have hpos : 0 < 1 + i.val := by omega
    have hlt : base < base + (1 + i.val) :=
      Nat.lt_add_of_pos_right hpos
    omega
  rcases
      splay_min_delete_state (intervalSeq (base + 1) n) t base
        hbst hbase_mem hmin htail_mem htail_gt with
    ⟨hnum, hbst_right, hmem_right⟩
  have hnum_eq : (rightSubtree (splay t base)).num_nodes = n := by
    omega
  exact ⟨hnum_eq, hbst_right, hmem_right⟩

private theorem mem_intervalSeq_tail_of_exact_mem_gt_succ
    {base n z : Nat} {t : BinaryTree}
    (hsize : t.num_nodes = n + 2)
    (hmem : ∀ i : Fin (n + 2),
      intervalSeq base (n + 2) i ∈ t.toKeyList)
    (hz : z ∈ t.toKeyList) (hgt : base + 1 < z) :
    z ∈ (List.finRange n).map
      (fun i : Fin n => intervalSeq (base + 2) n i) := by
  have hz_interval :=
    mem_intervalKeyList_of_exact_mem hsize hmem hz
  rcases List.mem_map.mp hz_interval with ⟨i, _hi, hiz⟩
  have hgt_i : base + 1 < intervalSeq base (n + 2) i := by
    rw [hiz]
    exact hgt
  have htwo_le : 2 ≤ i.val := by
    simp [intervalSeq] at hgt_i
    omega
  refine List.mem_map.mpr ?_
  refine ⟨⟨i.val - 2, by omega⟩, by simp, ?_⟩
  rw [← hiz]
  simp [intervalSeq]
  omega

private theorem splay_root_interval_succ_right_state {base n : Nat}
    (t : BinaryTree)
    (hsize : t.num_nodes = n + 2)
    (hbst : IsBST t)
    (_hroot : rootKey t = some base)
    (hmem : ∀ i : Fin (n + 2),
      intervalSeq base (n + 2) i ∈ t.toKeyList) :
    (rightSubtree (splay t (base + 1))).num_nodes = n ∧
      IsBST (rightSubtree (splay t (base + 1))) ∧
      (∀ i : Fin n,
        intervalSeq (base + 2) n i ∈
          (rightSubtree (splay t (base + 1))).toKeyList) := by
  have hsucc_mem : base + 1 ∈ t.toKeyList := by
    simpa [intervalSeq] using hmem ⟨1, by omega⟩
  have hroot_s :
      rootKey (splay t (base + 1)) = some (base + 1) :=
    splay_rootKey_eq_some_of_mem_isBST t (base + 1) hbst hsucc_mem
  have hbst_s : IsBST (splay t (base + 1)) :=
    splay_isBST t (base + 1) hbst
  have hbst_right : IsBST (rightSubtree (splay t (base + 1))) :=
    rightSubtree_isBST_of_isBST hbst_s
  have hmem_right :
      ∀ i : Fin n,
        intervalSeq (base + 2) n i ∈
          (rightSubtree (splay t (base + 1))).toKeyList := by
    intro i
    have hy_mem_t :
        intervalSeq (base + 2) n i ∈ t.toKeyList := by
      have hidx : (i.val + 2) < n + 2 := by omega
      have hmem_idx := hmem ⟨i.val + 2, hidx⟩
      simpa [intervalSeq, add_assoc, add_comm, add_left_comm] using hmem_idx
    have hy_mem_s :
        intervalSeq (base + 2) n i ∈ (splay t (base + 1)).toKeyList := by
      rw [splay_toKeyList]
      exact hy_mem_t
    have hy_gt : base + 1 < intervalSeq (base + 2) n i := by
      simp [intervalSeq]
      omega
    exact mem_rightSubtree_of_root_gt_isBST hbst_s hroot_s hy_mem_s hy_gt
  have hright_subset :
      (rightSubtree (splay t (base + 1))).toKeyList ⊆
        (List.finRange n).map
          (fun i : Fin n => intervalSeq (base + 2) n i) := by
    intro z hz
    have hz_mem_s : z ∈ (splay t (base + 1)).toKeyList := by
      cases hs : splay t (base + 1) with
      | empty =>
          simp [rightSubtree, hs, BinaryTree.toKeyList] at hz
      | node l k r =>
          simp [rightSubtree, hs, BinaryTree.toKeyList] at hz ⊢
          exact Or.inr (Or.inr hz)
    have hz_mem_t : z ∈ t.toKeyList := by
      rw [← splay_toKeyList t (base + 1)]
      exact hz_mem_s
    have hz_gt : base + 1 < z := by
      cases hs : splay t (base + 1) with
      | empty =>
          simp [rightSubtree, hs, BinaryTree.toKeyList] at hz
      | node l k r =>
          have hroot_node : k = base + 1 := by
            simp [rootKey, hs] at hroot_s
            omega
          subst k
          have hbst_node : IsBST (BinaryTree.node l (base + 1) r) := by
            simpa [hs] using hbst_s
          have hz_r : z ∈ r.toKeyList := by
            simpa [rightSubtree, hs] using hz
          exact isBST_right_mem_gt_root hbst_node hz_r
    exact mem_intervalSeq_tail_of_exact_mem_gt_succ hsize hmem hz_mem_t hz_gt
  have hnodup_right := isBST_toKeyList_nodup hbst_right
  have hsubperm := List.subperm_of_subset hnodup_right hright_subset
  have hlen_le := List.Subperm.length_le hsubperm
  have htail_subset :
      ((List.finRange n).map
          (fun i : Fin n => intervalSeq (base + 2) n i)) ⊆
        (rightSubtree (splay t (base + 1))).toKeyList := by
    intro z hz
    rcases List.mem_map.mp hz with ⟨i, _hi, rfl⟩
    exact hmem_right i
  have htail_nodup := intervalKeyList_nodup (base + 2) n
  have htail_subperm := List.subperm_of_subset htail_nodup htail_subset
  have hlen_ge := List.Subperm.length_le htail_subperm
  have hnum : (rightSubtree (splay t (base + 1))).num_nodes = n := by
    rw [← toKeyList_length]
    rw [List.length_map, List.length_finRange] at hlen_le hlen_ge
    omega
  exact ⟨hnum, hbst_right, hmem_right⟩

private theorem search_path_len_after_splay_high_low_succ_le_boundary
    {t : BinaryTree} {q y : Nat}
    (hbst : IsBST t)
    (hq_mem : q ∈ t.toKeyList)
    (hy_mem : y ∈ t.toKeyList) :
    (splay t q).search_path_len y + 1 ≤
      t.search_path_len y + (splay t y).search_path_len q := by
  let A := searchPathKeys (splay t q) y
  let C := searchPathKeys t y
  let D := searchPathKeys (splay t y) q
  have hA_nodup : A.Nodup := by
    unfold A
    exact searchPathKeys_nodup_of_isBST (splay t q) y
      (splay_isBST t q hbst)
  have hC_nodup : C.Nodup := by
    unfold C
    exact searchPathKeys_nodup_of_isBST t y hbst
  have hD_nodup : D.Nodup := by
    unfold D
    exact searchPathKeys_nodup_of_isBST (splay t y) q
      (splay_isBST t y hbst)
  have hsubA : A.toFinset ⊆ C.toFinset ∪ D.toFinset := by
    intro key hkey
    have hkeyA : key ∈ searchPathKeys (splay t q) y := by
      simpa [A] using hkey
    rw [Finset.mem_union]
    rcases searchPathKeys_after_splay_subset_boundary_splay
        (t := t) (x := q) (q := y) (key := key)
        hbst hq_mem hy_mem hkeyA with hCkey | hDkey
    · left
      simpa [C] using hCkey
    · right
      simpa [D] using hDkey
  have hA_card : A.toFinset.card = A.length :=
    List.toFinset_card_of_nodup hA_nodup
  have hC_card : C.toFinset.card = C.length :=
    List.toFinset_card_of_nodup hC_nodup
  have hD_card : D.toFinset.card = D.length :=
    List.toFinset_card_of_nodup hD_nodup
  have hA_union :
      A.toFinset.card ≤ (C.toFinset ∪ D.toFinset).card :=
    Finset.card_le_card hsubA
  have hy_C : y ∈ C.toFinset := by
    unfold C
    exact List.mem_toFinset.mpr
      (mem_searchPathKeys_self_of_mem_isBST t y hbst hy_mem)
  have hy_mem_after : y ∈ (splay t y).toKeyList := by
    rw [splay_toKeyList]
    exact hy_mem
  have hbst_after : IsBST (splay t y) :=
    splay_isBST t y hbst
  have hy_D : y ∈ D.toFinset := by
    unfold D
    have hroot_after : rootKey (splay t y) = some y :=
      splay_rootKey_eq_some_of_mem_isBST t y hbst hy_mem
    exact List.mem_toFinset.mpr
      (rootKey_mem_searchPathKeys (t := splay t y) (q := q)
        hroot_after)
  have hy_inter : y ∈ C.toFinset ∩ D.toFinset := by
    simp [hy_C, hy_D]
  have hinter_pos : 0 < (C.toFinset ∩ D.toFinset).card :=
    Finset.card_pos.mpr ⟨y, hy_inter⟩
  have hCD :=
    Finset.card_union_add_card_inter C.toFinset D.toFinset
  have hlen :
      A.length + 1 ≤ C.length + D.length := by
    omega
  unfold A C D at hlen
  rw [searchPathKeys_length_eq_search_path_len,
      searchPathKeys_length_eq_search_path_len,
      searchPathKeys_length_eq_search_path_len] at hlen
  exact hlen

private theorem high_low_access_pair_commute_add_two
    {t : BinaryTree} {q y : Nat}
    (hbst : IsBST t)
    (hq_mem : q ∈ t.toKeyList)
    (hy_mem : y ∈ t.toKeyList)
    (hy_lt : y < q) :
    ((splay t q).search_path_len y : ℝ) +
        ((splay (splay t q) y).search_path_len q : ℝ) ≤
      (t.search_path_len y : ℝ) +
        ((splay t y).search_path_len q : ℝ) + 2 := by
  have hpath_nat :
      (splay t q).search_path_len y + 1 ≤
        t.search_path_len y + (splay t y).search_path_len q :=
    search_path_len_after_splay_high_low_succ_le_boundary
      hbst hq_mem hy_mem
  have hbst_tq : IsBST (splay t q) :=
    splay_isBST t q hbst
  have hroot_tq : rootKey (splay t q) = some q :=
    splay_rootKey_eq_some_of_mem_isBST t q hbst hq_mem
  have hy_mem_tq : y ∈ (splay t q).toKeyList := by
    rw [splay_toKeyList]
    exact hy_mem
  have hq_mem_tq : q ∈ (splay t q).toKeyList := by
    rw [splay_toKeyList]
    exact hq_mem
  have hback_nat :
      (splay (splay t q) y).search_path_len q ≤ 3 := by
    have h :=
      search_path_len_after_splay_lower_le_add_two_strong
        hbst_tq hy_mem_tq hq_mem_tq hy_lt
    have hroot_path :
        (splay t q).search_path_len q = 1 :=
      search_path_len_eq_one_of_rootKey_eq_some hroot_tq
    omega
  have hpath :
      ((splay t q).search_path_len y : ℝ) + 1 ≤
        (t.search_path_len y : ℝ) +
          ((splay t y).search_path_len q : ℝ) := by
    exact_mod_cast hpath_nat
  have hback :
      ((splay (splay t q) y).search_path_len q : ℝ) ≤ 3 := by
    exact_mod_cast hback_nat
  nlinarith

private theorem resetPairDominatesAbove_eq_access_pair_with_pivot_path_add_two
    {q lo x : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hx_eq : x = q) :
    ∀ y : Nat,
      y ∈ (splay actual x).toKeyList →
      lo ≤ y →
      y < q →
      ((splay actual x).search_path_len y : ℝ) +
          ((splay (splay actual x) y).search_path_len q : ℝ) ≤
        (actual.search_path_len q : ℝ) +
          (reset.search_path_len y : ℝ) +
          ((splay reset y).search_path_len q : ℝ) + D + 2 := by
  subst x
  intro y hy_mem hlo hy_lt
  have hq_mem_actual : q ∈ actual.toKeyList := by
    rw [← hdom.2.2.2.1]
    exact rootKey_mem_toKeyList hdom.2.2.1
  have hy_mem_actual : y ∈ actual.toKeyList := by
    simpa [splay_toKeyList] using hy_mem
  have hcommute :
      ((splay actual q).search_path_len y : ℝ) +
          ((splay (splay actual q) y).search_path_len q : ℝ) ≤
        (actual.search_path_len y : ℝ) +
          ((splay actual y).search_path_len q : ℝ) + 2 :=
    high_low_access_pair_commute_add_two
      hdom.1 hq_mem_actual hy_mem_actual hy_lt
  have hpair :=
    resetPairDominatesAbove.pair
      (q := q) (lo := lo) (x := y) (D := D)
      hdom hy_mem_actual hlo hy_lt
  nlinarith

private theorem actualResetLowerPairGapAt_pivot_le_qpath_add_one
    {n : Nat} (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done : List (Fin n)) (i j : Fin n)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi : X i = q)
    (hj_lt : X j < q)
    (hj_mem : X j ∈ init.toKeyList) :
    actualResetLowerPairGapAt X q init (done ++ [i]) j ≤
      actualResetLowerPairGapAt X q init done j +
        ((splayTreeAfter X init done).search_path_len q : ℝ) + 1 := by
  let actual := splayTreeAfter X init done
  let reset := suffixResetTreeAfter X q init done
  have hnot : ¬ X i < q := by
    rw [hi]
    omega
  have hactual_next :
      splayTreeAfter X init (done ++ [i]) = splay actual q := by
    unfold actual
    rw [splayTreeAfter_append]
    simp [splayTreeAfter, hi]
  have hreset_next :
      suffixResetTreeAfter X q init (done ++ [i]) = reset := by
    unfold reset
    exact suffixResetTreeAfter_append_singleton_not_lt
      X q done init i hnot
  have hbst_actual : IsBST actual := by
    unfold actual
    exact splayTreeAfter_isBST X done init hbst
  have hq_mem_actual : q ∈ actual.toKeyList := by
    unfold actual
    rw [splayTreeAfter_toKeyList]
    exact rootKey_mem_toKeyList hroot
  have hj_mem_actual : X j ∈ actual.toKeyList := by
    unfold actual
    rw [splayTreeAfter_toKeyList]
    exact hj_mem
  have hcomm :
      ((splay actual q).search_path_len (X j) : ℝ) +
          ((splay (splay actual q) (X j)).search_path_len q : ℝ) ≤
        (actual.search_path_len (X j) : ℝ) +
          ((splay actual (X j)).search_path_len q : ℝ) + 2 :=
    high_low_access_pair_commute_add_two
      hbst_actual hq_mem_actual hj_mem_actual hj_lt
  have hroot_after :
      rootKey (splay actual q) = some q :=
    splay_rootKey_eq_some_of_mem_isBST actual q hbst_actual hq_mem_actual
  have hq_after :
      (splay actual q).search_path_len q = 1 :=
    search_path_len_eq_one_of_rootKey_eq_some hroot_after
  unfold actualResetLowerPairGapAt
  rw [hactual_next, hreset_next]
  dsimp [actual, reset] at hcomm hq_after
  rw [hq_after]
  dsimp [actual, reset]
  apply max_le
  · positivity
  · have hbefore_le :
        ((actual.search_path_len (X j) : ℝ) +
            ((splay actual (X j)).search_path_len q : ℝ) -
            (actual.search_path_len q : ℝ) -
            (reset.search_path_len (X j) : ℝ) -
            ((splay reset (X j)).search_path_len q : ℝ)) ≤
          max 0
            ((actual.search_path_len (X j) : ℝ) +
              ((splay actual (X j)).search_path_len q : ℝ) -
              (actual.search_path_len q : ℝ) -
              (reset.search_path_len (X j) : ℝ) -
              ((splay reset (X j)).search_path_len q : ℝ)) :=
        le_max_right _ _
    let pa : ℝ :=
      ((splay (splayTreeAfter X init done) q).search_path_len (X j) : ℝ)
    let pb : ℝ :=
      ((splay (splay (splayTreeAfter X init done) q) (X j)).search_path_len q : ℝ)
    let a : ℝ := ((splayTreeAfter X init done).search_path_len (X j) : ℝ)
    let b : ℝ :=
      ((splay (splayTreeAfter X init done) (X j)).search_path_len q : ℝ)
    let qb : ℝ := ((splayTreeAfter X init done).search_path_len q : ℝ)
    let r : ℝ :=
      ((suffixResetTreeAfter X q init done).search_path_len (X j) : ℝ)
    let sr : ℝ :=
      ((splay (suffixResetTreeAfter X q init done) (X j)).search_path_len q : ℝ)
    let M : ℝ := max 0 (a + b - qb - r - sr)
    have hcomm2 : pa + pb ≤ a + b + 2 := by
      simpa [pa, pb, a, b] using hcomm
    have hbefore2 : a + b - qb - r - sr ≤ M := by
      simpa [M, a, b, qb, r, sr, actual, reset] using hbefore_le
    have hsmall : pa + pb - 1 - r - sr ≤ M + qb + 1 := by
      nlinarith
    simpa [pa, pb, a, b, qb, r, sr, M] using hsmall

private theorem actualResetFirstLowerPairGapPotential_pivot_growth_le_qpath_add_one
    {n : Nat} (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi : X i = q)
    (hmem_future : ∀ j : Fin n, j ∈ future → X j ∈ init.toKeyList) :
    actualResetFirstLowerPairGapPotential X q init (done ++ [i]) future ≤
      actualResetFirstLowerPairGapPotential X q init done future +
        ((splayTreeAfter X init done).search_path_len q : ℝ) + 1 := by
  induction future with
  | nil =>
      simp [actualResetFirstLowerPairGapPotential]
      positivity
  | cons j future ih =>
      by_cases hj : X j < q
      · have hle :=
          actualResetLowerPairGapAt_pivot_le_qpath_add_one
            X q init done i j hbst hroot hi hj (hmem_future j (by simp))
        simpa [actualResetFirstLowerPairGapPotential, hj] using hle
      · have htail_mem :
            ∀ k : Fin n, k ∈ future → X k ∈ init.toKeyList := by
          intro k hk
          exact hmem_future k (by simp [hk])
        have ih' := ih htail_mem
        simpa [actualResetFirstLowerPairGapPotential, hj] using ih'

private theorem upperResetFirstPairQPotential_nonneg {n : Nat}
    (A G H : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (hA : 0 ≤ A) (hG : 0 ≤ G)
    (hH : 0 ≤ H) :
    0 ≤ upperResetFirstPairQPotential A G H X q init done future := by
  unfold upperResetFirstPairQPotential
  have hb :
      0 ≤ boundaryBudget X (suffixResetTreeAfter X q init done) future q :=
    boundaryBudget_nonneg X (suffixResetTreeAfter X q init done) future q
  have hg :
      0 ≤ actualResetFirstLowerPairGapPotential X q init done future :=
    actualResetFirstLowerPairGapPotential_nonneg X q init done future
  have hq : 0 ≤ ((splayTreeAfter X init done).search_path_len q : ℝ) := by
    positivity
  nlinarith [mul_nonneg hA hb, mul_nonneg hG hg, mul_nonneg hH hq]

private theorem upperResetFirstPairQPotential_initial_le {n : Nat}
    (A G H : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (future : List (Fin n)) (_hA : 0 ≤ A) (hH : 0 ≤ H)
    (hbst : IsBST init) :
    upperResetFirstPairQPotential A G H X q init [] future ≤
      (A + H) * boundaryBudget X init future q := by
  unfold upperResetFirstPairQPotential
  rw [actualResetFirstLowerPairGapPotential_initial_eq_zero]
  simp [suffixResetTreeAfter, splayTreeAfter]
  have hpath :
      ((init.search_path_len q : ℝ)) ≤ boundaryBudget X init future q :=
    search_path_len_real_le_boundaryBudget_of_boundary X future q hbst
  have hb : 0 ≤ boundaryBudget X init future q :=
    boundaryBudget_nonneg X init future q
  nlinarith [mul_le_mul_of_nonneg_left hpath hH]

private theorem upperResetFirstPairQPotential_cons_pivot_eq {n : Nat}
    (A G H : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) (hi : X i = q) :
    upperResetFirstPairQPotential A G H X q init done (i :: future) =
      upperResetFirstPairQPotential A G H X q init done future + A := by
  unfold upperResetFirstPairQPotential
  rw [boundaryBudget_cons_pivot_eq X
      (suffixResetTreeAfter X q init done) i future q hi,
    actualResetFirstLowerPairGapPotential_cons_pivot_eq
      X q init done future i hi]
  ring

private theorem upperResetFirstPairQPotential_pivot_step_of_qpath_growth
    {n : Nat} (A G H : ℝ) (X : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done future : List (Fin n)) (i : Fin n)
    (hA : 0 ≤ A) (hG : 0 ≤ G) (hHgeG : G ≤ H)
    (hbst : IsBST init) (hroot : rootKey init = some q)
    (hi : X i = q)
    (hmem_future : ∀ j : Fin n, j ∈ future → X j ∈ init.toKeyList) :
    upperResetFirstPairQPotential A G H X q init (done ++ [i]) future ≤
      (G + H) + upperResetFirstPairQPotential A G H X q init done (i :: future) := by
  have hnot : ¬ X i < q := by
    rw [hi]
    omega
  have hreset :
      suffixResetTreeAfter X q init (done ++ [i]) =
        suffixResetTreeAfter X q init done :=
    suffixResetTreeAfter_append_singleton_not_lt X q done init i hnot
  have hactual_next :
      splayTreeAfter X init (done ++ [i]) =
        splay (splayTreeAfter X init done) q := by
    rw [splayTreeAfter_append]
    simp [splayTreeAfter, hi]
  have hroot_actual :
      rootKey (splayTreeAfter X init (done ++ [i])) = some q := by
    rw [hactual_next]
    exact
      splay_rootKey_eq_some_of_mem_isBST
        (splayTreeAfter X init done) q
        (splayTreeAfter_isBST X done init hbst)
        (by
          rw [splayTreeAfter_toKeyList]
          exact rootKey_mem_toKeyList hroot)
  have hq_after :
      (splayTreeAfter X init (done ++ [i])).search_path_len q = 1 :=
    search_path_len_eq_one_of_rootKey_eq_some hroot_actual
  have hgap :
      actualResetFirstLowerPairGapPotential X q init (done ++ [i]) future ≤
        actualResetFirstLowerPairGapPotential X q init done future +
          ((splayTreeAfter X init done).search_path_len q : ℝ) + 1 :=
    actualResetFirstLowerPairGapPotential_pivot_growth_le_qpath_add_one
      X q init done future i hbst hroot hi hmem_future
  have hgap_mul :
      G * actualResetFirstLowerPairGapPotential X q init (done ++ [i]) future ≤
        G * (actualResetFirstLowerPairGapPotential X q init done future +
          ((splayTreeAfter X init done).search_path_len q : ℝ) + 1) := by
    exact mul_le_mul_of_nonneg_left hgap hG
  have hq_before_nonneg :
      0 ≤ ((splayTreeAfter X init done).search_path_len q : ℝ) := by
    positivity
  have hGq_le_Hq :
      G * ((splayTreeAfter X init done).search_path_len q : ℝ) ≤
        H * ((splayTreeAfter X init done).search_path_len q : ℝ) :=
    mul_le_mul_of_nonneg_right hHgeG hq_before_nonneg
  have hgap_bound :
      G * actualResetFirstLowerPairGapPotential X q init (done ++ [i]) future ≤
        G * actualResetFirstLowerPairGapPotential X q init done future +
          H * ((splayTreeAfter X init done).search_path_len q : ℝ) + G := by
    calc
      G * actualResetFirstLowerPairGapPotential X q init (done ++ [i]) future
          ≤ G * (actualResetFirstLowerPairGapPotential X q init done future +
              ((splayTreeAfter X init done).search_path_len q : ℝ) + 1) := hgap_mul
      _ = G * actualResetFirstLowerPairGapPotential X q init done future +
            G * ((splayTreeAfter X init done).search_path_len q : ℝ) + G := by
          ring
      _ ≤ G * actualResetFirstLowerPairGapPotential X q init done future +
            H * ((splayTreeAfter X init done).search_path_len q : ℝ) + G := by
          nlinarith [hGq_le_Hq]
  have hcons :=
    upperResetFirstPairQPotential_cons_pivot_eq
      A G H X q init done future i hi
  rw [hcons]
  unfold upperResetFirstPairQPotential
  rw [hreset, hq_after]
  ring_nf
  nlinarith [hgap_bound, hA]

private theorem upperResetFirstPairQPotential_lower_step_of_gap_drop
    {n : Nat} (A G H D : ℝ) (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hi_lt : Y i < q)
    (hdrop :
      actualResetFirstLowerPairGapPotential Y q init done (i :: future) +
          upperResetFirstPairQPotential A G H Y q init (done ++ [i]) future ≤
        D + upperResetFirstPairQPotential A G H Y q init done (i :: future)) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
        ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) +
        upperResetFirstPairQPotential A G H Y q init (done ++ [i]) future ≤
      ((splayTreeAfter Y init done).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
        D + upperResetFirstPairQPotential A G H Y q init done (i :: future) := by
  have hpair :=
    prefix_pair_bound_of_firstLowerPairGap_head
      Y q init done i future hi_lt
  nlinarith

private theorem upperResetFirstPairQPotential_gap_drop_of_local_bound
    {n : Nat} (A G H D : ℝ) (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hA : 0 ≤ A)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi_mem : Y i ∈ (splayTreeAfter Y init done).toKeyList)
    (hi_lt : Y i < q)
    (hmem_future : ∀ j : Fin n, j ∈ future → Y j ∈ init.toKeyList)
    (hlocal :
      actualResetFirstLowerPairGapPotential Y q init done (i :: future) +
          G * actualResetFirstLowerPairGapPotential Y q init (done ++ [i]) future +
          H * ((splayTreeAfter Y init (done ++ [i])).search_path_len q : ℝ) ≤
        D +
          G * actualResetFirstLowerPairGapPotential Y q init done (i :: future) +
          H * ((splayTreeAfter Y init done).search_path_len q : ℝ) + A) :
    actualResetFirstLowerPairGapPotential Y q init done (i :: future) +
        upperResetFirstPairQPotential A G H Y q init (done ++ [i]) future ≤
      D + upperResetFirstPairQPotential A G H Y q init done (i :: future) := by
  have hreset_next :
      suffixResetTreeAfter Y q init (done ++ [i]) =
        splay (splay (suffixResetTreeAfter Y q init done) (Y i)) q :=
    suffixResetTreeAfter_append_singleton_lt Y q done init i hi_lt
  have hbst_reset : IsBST (suffixResetTreeAfter Y q init done) :=
    suffixResetTreeAfter_isBST Y q done init hbst
  have hq_mem_reset : q ∈ (suffixResetTreeAfter Y q init done).toKeyList := by
    have hroot_reset :=
      suffixResetTreeAfter_rootKey Y q done init hbst hroot
    exact rootKey_mem_toKeyList hroot_reset
  have hi_mem_reset :
      Y i ∈ (suffixResetTreeAfter Y q init done).toKeyList := by
    rw [suffixResetTreeAfter_toKeyList]
    rw [splayTreeAfter_toKeyList] at hi_mem
    exact hi_mem
  have hmem_future_reset :
      ∀ j : Fin n, j ∈ future →
        Y j ∈ (suffixResetTreeAfter Y q init done).toKeyList := by
    intro j hj
    rw [suffixResetTreeAfter_toKeyList]
    exact hmem_future j hj
  have hbudget :=
    boundaryBudget_after_pivot_reset_add_one_le_cons
      Y i future q hbst_reset hi_mem_reset hq_mem_reset
      hmem_future_reset
  have hbudgetR :
      A * boundaryBudget Y (suffixResetTreeAfter Y q init (done ++ [i]))
            future q ≤
        A * boundaryBudget Y (suffixResetTreeAfter Y q init done)
            (i :: future) q - A := by
    rw [hreset_next]
    have hbudget' :
        boundaryBudget Y
              (splay (splay (suffixResetTreeAfter Y q init done) (Y i)) q)
              future q ≤
          boundaryBudget Y (suffixResetTreeAfter Y q init done)
              (i :: future) q - 1 := by
      linarith
    have hmul :=
      mul_le_mul_of_nonneg_left hbudget' hA
    linarith
  unfold upperResetFirstPairQPotential
  nlinarith

private theorem traversal_conjecture_of_upperResetFirstPairQPotential_qpath_upper_blocks
    (Ks K A G H D : ℝ) (hKs : 0 ≤ Ks) (hK : 0 ≤ K)
    (hA : 0 ≤ A) (hG : 0 ≤ G) (hH : 0 ≤ H) (hD : 0 ≤ D)
    (hHgeG : G ≤ H) (hEqD : G + H ≤ D)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          Ks * boundaryBudget Y t (List.finRange N) q)
    (hlower :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        pivotResetLowerPathSum Y q t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q)
    (hlower_drop :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree)
          (done : List (Fin N)) (i : Fin N) (future : List (Fin N)),
        IsBST t →
        rootKey t = some q →
        (Y avoids ![2, 3, 1]) →
        (∀ j : Fin N, Y j ≤ q) →
        (done ++ i :: future).Sublist (List.finRange N) →
        (∀ j : Fin N, j ∈ done ++ i :: future → Y j ∈ t.toKeyList) →
        Y i ∈ (splayTreeAfter Y t done).toKeyList →
        Y i < q →
        actualResetFirstLowerPairGapPotential Y q t done (i :: future) +
            upperResetFirstPairQPotential A G H Y q t (done ++ [i]) future ≤
          D + upperResetFirstPairQPotential A G H Y q t done (i :: future)) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  have hP : 0 ≤ A + H := by nlinarith
  refine
    traversal_conjecture_of_potential_upper_blocks
      Ks K D (A + H) hKs hK hD hP hstrict hlower
      (fun {N} Y q t done future =>
        upperResetFirstPairQPotential A G H Y q t done future)
      ?_ ?_ ?_ ?_
  · intro N Y q t done i future _hbst _hroot havoid hle hsub hmem_sub
      hi_mem hi_lt
    exact
      upperResetFirstPairQPotential_lower_step_of_gap_drop
        A G H D Y q t done i future hi_lt
        (hlower_drop Y q t done i future _hbst _hroot havoid hle hsub
          hmem_sub hi_mem hi_lt)
  · intro N Y q t done i future hbst hroot _havoid _hle _hsub hmem_sub
      hi_eq
    have hstep :
        upperResetFirstPairQPotential A G H Y q t (done ++ [i]) future ≤
          (G + H) + upperResetFirstPairQPotential A G H Y q t done (i :: future) :=
      upperResetFirstPairQPotential_pivot_step_of_qpath_growth
        A G H Y q t done future i hA hG hHgeG hbst hroot hi_eq
        (fun j hj => hmem_sub j (by simp [hj]))
    nlinarith
  · intro N Y q t _hbst _hroot _hmem _havoid _hle
    exact
      upperResetFirstPairQPotential_nonneg
        A G H Y q t (List.finRange N) [] hA hG hH
  · intro N Y q t hbst _hroot _hmem _havoid _hle
    exact
      upperResetFirstPairQPotential_initial_le
        A G H Y q t (List.finRange N) hA hH hbst

private theorem upperResetFirstPairQPotential_gap_drop_of_budget_kernel
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hbst : IsBST init)
