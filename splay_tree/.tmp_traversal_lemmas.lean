    splayPathSum X t xs ≤ (xs.length : ℝ) * boundaryBudget X t xs q := by
  have hactive :=
    splayPathSum_le_length_mul_activeBudget X xs t hbst hmem
  have hbudget := activeBudget_le_boundaryBudget X t xs q
  have hmul :
      (xs.length : ℝ) * activeBudget X t xs ≤
        (xs.length : ℝ) * boundaryBudget X t xs q := by
    exact mul_le_mul_of_nonneg_left hbudget
      (show 0 ≤ (xs.length : ℝ) by positivity)
  exact le_trans hactive hmul

private theorem filteredFinRange_get_lt_of_lt {n : Nat}
    (p : Fin n → Bool)
    {a b : Fin ((List.finRange n).filter p).length} (hab : a < b) :
    ((List.finRange n).filter p).get a <
      ((List.finRange n).filter p).get b := by
  let xs := (List.finRange n).filter p
  have hsub : xs.Sublist (List.finRange n) := by
    unfold xs
    exact List.filter_sublist
  rcases (List.sublist_iff_exists_fin_orderEmbedding_get_eq.mp hsub) with
    ⟨e, he⟩
  have hea := he a
  have heb := he b
  have he_lt : e a < e b := e.strictMono hab
  rw [hea, heb]
  exact (List.sortedLT_finRange n).getElem_lt_getElem_of_lt he_lt

private theorem boundaryBudget_le_length_add_num_nodes {n : Nat}
