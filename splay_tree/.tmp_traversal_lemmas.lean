private theorem resetPairDominatesAbove_threshold_of_last_pivot_split_of_strict_preservation
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
