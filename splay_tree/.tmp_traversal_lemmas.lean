private noncomputable def splayBoundaryBudgetSum {n : Nat}
    (X : Fin n → Nat) (q : Nat) : BinaryTree → List (Fin n) → ℝ
| t, [] => boundaryBudget X t [] q
| t, i :: xs =>
    boundaryBudget X t (i :: xs) q +
      splayBoundaryBudgetSum X q (splay t (X i)) xs

private theorem splayBoundaryBudgetSum_map_comp {n m : Nat}
    (X : Fin n → Nat) (g : Fin m → Fin n) (q : Nat) :
