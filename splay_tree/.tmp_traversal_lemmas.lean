private theorem le_foldr_max_of_mem {α : Type}
    (f : α → ℝ) :
    ∀ {xs : List α} {a : α},
      a ∈ xs →
        f a ≤ xs.foldr (fun x acc => max (f x) acc) 0
| [], a, hmem => by
    simp at hmem
| x :: xs, a, hmem => by
    simp at hmem
    rcases hmem with hxa | htail
    · subst a
      simp
    · have ih := le_foldr_max_of_mem f htail
      simp only [List.foldr_cons]
      exact le_trans ih (le_max_right _ _)

private theorem foldr_max_le_add_of_forall {α : Type}
    (f g : α → ℝ) (C : ℝ) (hC : 0 ≤ C) :
    ∀ (xs : List α),
      (∀ x : α, x ∈ xs → f x ≤ g x + C) →
        xs.foldr (fun x acc => max (f x) acc) 0 ≤
          xs.foldr (fun x acc => max (g x) acc) 0 + C
| [], _hfg => by
    simp
    exact hC
| x :: xs, hfg => by
    have hx : f x ≤ g x + C := hfg x (by simp)
    have htail :
        xs.foldr (fun x acc => max (f x) acc) 0 ≤
          xs.foldr (fun x acc => max (g x) acc) 0 + C :=
      foldr_max_le_add_of_forall f g C hC xs
        (fun y hy => hfg y (by simp [hy]))
    simp only [List.foldr_cons]
    apply max_le
    · have hg_le :
          g x ≤ max (g x) (List.foldr (fun x acc => max (g x) acc) 0 xs) :=
        le_max_left _ _
      linarith
    · have hg_tail :
          List.foldr (fun x acc => max (g x) acc) 0 xs ≤
            max (g x) (List.foldr (fun x acc => max (g x) acc) 0 xs) :=
        le_max_right _ _
      linarith

