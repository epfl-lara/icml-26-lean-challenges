private theorem splayTreeAfter_prefix_pivot_eq_original_take_cons {n : Nat}
    (X : Fin n → Nat) (init : BinaryTree) (m : Fin n) :
    splay
        (splayTreeAfter (prefixSeq X m) init (List.finRange m.val))
        (X m) =
      splayTreeAfter X init (((List.finRange n).take m.val) ++ [m]) := by
  rw [splayTreeAfter_append]
  rw [splayTreeAfter_take_eq_prefixSeq X init m]
  simp [splayTreeAfter]

private theorem activeBudget_suffixSeq_after_prefix_pivot_le_original
    {n : Nat} (X : Fin n → Nat) (init : BinaryTree) (m : Fin n)
    (hbst : IsBST init)
    (hmem : ∀ i : Fin n, X i ∈ init.toKeyList) :
    activeBudget (suffixSeq X m)
        (splay
          (splayTreeAfter (prefixSeq X m) init (List.finRange m.val))
          (X m))
        (List.finRange (n - (m.val + 1))) ≤
      activeBudget X init (List.finRange n) := by
  let consumed := ((List.finRange n).take m.val) ++ [m]
  let future := (List.finRange n).drop (m.val + 1)
  let ts :=
    splay
      (splayTreeAfter (prefixSeq X m) init (List.finRange m.val))
      (X m)
  have hsplit : consumed ++ future = List.finRange n := by
    unfold consumed future
    simpa [List.append_assoc] using (finRange_split_at m).symm
  have hts :
      ts = splayTreeAfter X init consumed := by
    unfold ts consumed
    exact splayTreeAfter_prefix_pivot_eq_original_take_cons X init m
  have hmem_split :
      ∀ i : Fin n, i ∈ consumed ++ future → X i ∈ init.toKeyList := by
    intro i hi
    rw [hsplit] at hi
    exact hmem i
  have hafter :=
    activeBudget_after_splayTreeAfter_le_append
      X consumed future init hbst hmem_split
  have hsuffix_eq :
      activeBudget X ts future =
        activeBudget (suffixSeq X m) ts
          (List.finRange (n - (m.val + 1))) := by
    unfold future
    exact activeBudget_drop_eq_suffixSeq X ts m
  rw [← hts] at hafter
  rw [hsplit] at hafter
  rw [hsuffix_eq] at hafter
  simpa [ts] using hafter

private theorem pivot_search_len_after_prefix_le_activeBudget_original
    {n : Nat} (X : Fin n → Nat) (init : BinaryTree) (m : Fin n)
    (hbst : IsBST init)
    (hmem : ∀ i : Fin n, X i ∈ init.toKeyList) :
    ((splayTreeAfter (prefixSeq X m) init
        (List.finRange m.val)).search_path_len (X m) : ℝ) ≤
      activeBudget X init (List.finRange n) := by
  let pre := (List.finRange n).take m.val
  let tp := splayTreeAfter (prefixSeq X m) init (List.finRange m.val)
  have htp : tp = splayTreeAfter X init pre := by
    unfold tp pre
    exact (splayTreeAfter_take_eq_prefixSeq X init m).symm
  have hbst_tp : IsBST tp := by
    unfold tp
    exact splayTreeAfter_isBST (prefixSeq X m)
      (List.finRange m.val) init hbst
  have hpath :
      (tp.search_path_len (X m) : ℝ) ≤ activeBudget X tp [m] := by
    exact search_path_len_real_le_activeBudget_of_mem
      X [m] hbst_tp (i := m) (by simp)
  have hmem_pre_pivot :
      ∀ i : Fin n, i ∈ pre ++ [m] → X i ∈ init.toKeyList := by
    intro i _hi
    exact hmem i
  have hafter :
      activeBudget X (splayTreeAfter X init pre) [m] ≤
        activeBudget X init (pre ++ [m]) :=
    activeBudget_after_splayTreeAfter_le_append
      X pre [m] init hbst hmem_pre_pivot
  rw [← htp] at hafter
  have hpre_pivot_sub :
      (pre ++ [m]).Sublist (List.finRange n) := by
    let future := (List.finRange n).drop (m.val + 1)
    have hsub : (pre ++ [m]).Sublist ((pre ++ [m]) ++ future) :=
      List.sublist_append_left (pre ++ [m]) future
    have hsplit : (pre ++ [m]) ++ future = List.finRange n := by
      unfold pre future
      simpa [List.append_assoc] using (finRange_split_at m).symm
    simpa [hsplit] using hsub
  have hbudget_full :
      activeBudget X init (pre ++ [m]) ≤
        activeBudget X init (List.finRange n) :=
    activeBudget_sublist_le X init hpre_pivot_sub
  simpa [tp] using le_trans hpath (le_trans hafter hbudget_full)

private theorem boundaryBudget_strictLowerSuffixSeq_after_prefix_pivot_le_original
    {n : Nat} {X : Fin n → Nat} {init : BinaryTree} {m : Fin n}
    (hbst : IsBST init)
    (hmem : ∀ i : Fin n, X i ∈ init.toKeyList) :
    let consumed := ((List.finRange n).take m.val) ++ [m]
    let lowerOrig := (strictLowerSuffixIndices X m).map (suffixIndex m)
    let ts :=
      splay
        (splayTreeAfter (prefixSeq X m) init (List.finRange m.val))
        (X m)
    boundaryBudget (strictLowerSuffixSeq X m) ts
        (List.finRange (strictLowerSuffixIndices X m).length) (X m) ≤
      boundaryBudget X init (consumed ++ lowerOrig) (X m) := by
  let consumed := ((List.finRange n).take m.val) ++ [m]
  let lowerOrig := (strictLowerSuffixIndices X m).map (suffixIndex m)
  let ts :=
    splay
      (splayTreeAfter (prefixSeq X m) init (List.finRange m.val))
      (X m)
  have hts_eq :
      ts = splayTreeAfter X init consumed := by
    unfold ts consumed
    exact splayTreeAfter_prefix_pivot_eq_original_take_cons X init m
  have hmem_consumed_lower :
      ∀ i : Fin n, i ∈ consumed ++ lowerOrig → X i ∈ init.toKeyList := by
    intro i _hi
    exact hmem i
  have hbudget_orig :
      boundaryBudget X (splayTreeAfter X init consumed) lowerOrig (X m) ≤
        boundaryBudget X init (consumed ++ lowerOrig) (X m) :=
    boundaryBudget_after_splayTreeAfter_le_append
      X consumed lowerOrig init (X m) hbst (hmem m) hmem_consumed_lower
  have hmap :
      boundaryBudget X ts lowerOrig (X m) =
        boundaryBudget (strictLowerSuffixSeq X m) ts
          (List.finRange (strictLowerSuffixIndices X m).length) (X m) := by
    unfold lowerOrig
    rw [boundaryBudget_map_comp X (suffixIndex m) ts
      (strictLowerSuffixIndices X m) (X m)]
    change
      boundaryBudget (suffixSeq X m) ts (strictLowerSuffixIndices X m) (X m) =
        boundaryBudget (strictLowerSuffixSeq X m) ts
          (List.finRange (strictLowerSuffixIndices X m).length) (X m)
    exact boundaryBudget_strictLowerSuffixIndices_eq X m ts (X m)
  change
    boundaryBudget (strictLowerSuffixSeq X m) ts
        (List.finRange (strictLowerSuffixIndices X m).length) (X m) ≤
      boundaryBudget X init (consumed ++ lowerOrig) (X m)
  rw [← hmap]
  rw [hts_eq]
  exact hbudget_orig

private theorem strictLowerSuffix_original_indices_sublist_finRange {n : Nat}
    (X : Fin n → Nat) (m : Fin n) :
