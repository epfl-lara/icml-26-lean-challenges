      (splayTreeAfter Y init done)
      (suffixResetTreeAfter Y q init done) := by
  refine
    resetPairDominatesAbove_threshold_of_full_preservation
      Y q D init done i future hD hbst hroot hle hsub
      hmem_prefix ?_ ?_
  · intro actual reset x hdom hx_mem hx_lt
    exact
      resetPairDominatesAbove_preserve_strict_of_path_len_bound_mono
        (q := q) (lo := Y i) (x := x) (C := D) (D := D)
        (le_rfl) hdom hx_mem hx_lt
        (hpres_lt_path actual reset x hdom hx_mem hx_lt)
  · intro actual reset x hdom hx_eq
    exact
      resetPairDominatesAbove_preserve_eq_of_path_len_bound_mono
        (q := q) (lo := Y i) (x := x) (C := D) (D := D)
