        ((splayTreeAfter Y t left).search_path_len (Y p) : ℝ) +
          splayPathSum Y
            (splay (splayTreeAfter Y t left) (Y p)) right := by
  have h :=
    splayPathSum_split_singleton Y left right t p
  simpa [List.singleton_append, add_assoc] using h

private theorem exists_last_pivot_path_split_with_strict_suffix
    {n : Nat} {Y : Fin n → Nat} {q : Nat}
    (done : List (Fin n)) (t : BinaryTree)
    (hle : ∀ j : Fin n, Y j ≤ q)
    (hpivot : ∃ p : Fin n, p ∈ done ∧ Y p = q) :
    ∃ left : List (Fin n), ∃ p : Fin n, ∃ right : List (Fin n),
      done = left ++ p :: right ∧
