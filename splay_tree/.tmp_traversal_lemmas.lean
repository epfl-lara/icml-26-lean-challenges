          hdom_full hj_mem_full
      simpa [hactual_pre, hreset_pre] using hstep
    have htail :
        resetPairDominatesAbove q (Y i) D
          (splayTreeAfter Y actual0 right)
          (suffixResetTreeAfter Y q reset0 right) :=
      resetPairDominatesAbove_after_strict_lists_of_contextual_preservation
        Y q (Y i) D right actual0 reset0 hpres_right hdom0
        hmem_right_actual0 hright_lt_mem
    simpa [actual0, reset0, hactual, hreset] using htail

private theorem resetPairDominatesAbove_threshold_of_full_preservation
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hD : 0 ≤ D)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hle : ∀ j : Fin n, Y j ≤ q)
    (_hsub : (done ++ i :: future).Sublist (List.finRange n))
    (hmem_prefix :
      ∀ j : Fin n, j ∈ done ++ i :: future → Y j ∈ init.toKeyList)
    (hpres_lt :
      ∀ (actual reset : BinaryTree) (x : Nat),
        resetPairDominatesAbove q (Y i) D actual reset →
        x ∈ actual.toKeyList →
        x < q →
        resetPairDominatesAbove q (Y i) D
          (splay actual x) (splay (splay reset x) q))
    (hpres_eq :
      ∀ (actual reset : BinaryTree) (x : Nat),
        resetPairDominatesAbove q (Y i) D actual reset →
        x = q →
        resetPairDominatesAbove q (Y i) D
          (splay actual x) reset) :
    resetPairDominatesAbove q (Y i) D
      (splayTreeAfter Y init done)
      (suffixResetTreeAfter Y q init done) := by
  exact
    resetPairDominatesAbove_after_prefix_of_preservation
      Y q (Y i) D hD hpres_lt hpres_eq init done hbst hroot
      (by
        intro j hj
        exact hmem_prefix j (by simp [hj]))
      (by
        intro j hj
        exact hle j)

private theorem resetPairDominatesAbove_threshold_of_full_path_preservation
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
