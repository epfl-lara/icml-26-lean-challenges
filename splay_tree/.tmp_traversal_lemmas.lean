  exact avoids231_no_triple havoid hij hjk ⟨hki, hijv⟩

private theorem avoids231_before_first_max_le_after {n : Nat}
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {m i k : Fin n}
    (hmax : ∀ a : Fin n, X a ≤ X m)
    (hfirst : ∀ a : Fin n, a < m → X a ≠ X m)
    (him : i < m) (hmk : m < k) :
    X i ≤ X k := by
  by_contra hnot
  have hki : X k < X i := Nat.lt_of_not_ge hnot
  have himax_le : X i ≤ X m := hmax i
  have himax_ne : X i ≠ X m := hfirst i him
  have himax_lt : X i < X m := lt_of_le_of_ne himax_le himax_ne
  exact avoids231_no_triple havoid him hmk ⟨hki, himax_lt⟩

private theorem before_first_max_lt_first_max {n : Nat}
    {X : Fin n → Nat} {m i : Fin n}
    (hmax : ∀ a : Fin n, X a ≤ X m)
    (hfirst : ∀ a : Fin n, a < m → X a ≠ X m)
    (him : i < m) :
    X i < X m := by
  exact lt_of_le_of_ne (hmax i) (hfirst i him)

private theorem prefixSeq_lt_first_max {n : Nat}
    {X : Fin n → Nat} {m : Fin n}
    (hmax : ∀ a : Fin n, X a ≤ X m)
    (hfirst : ∀ a : Fin n, a < m → X a ≠ X m)
    (i : Fin m.val) :
    prefixSeq X m i < X m := by
  unfold prefixSeq
  exact before_first_max_lt_first_max hmax hfirst i.isLt

private theorem suffixSeq_le_first_max {n : Nat}
    {X : Fin n → Nat} {m : Fin n}
    (hmax : ∀ a : Fin n, X a ≤ X m)
    (j : Fin (n - (m.val + 1))) :
    suffixSeq X m j ≤ X m := by
  unfold suffixSeq
  exact hmax _

private theorem take_value_lt_first_max_of_first_max {n : Nat}
    {X : Fin n → Nat} {m i : Fin n}
    (hmax : ∀ a : Fin n, X a ≤ X m)
    (hfirst : ∀ a : Fin n, a < m → X a ≠ X m)
    (hi : i ∈ (List.finRange n).take m.val) :
    X i < X m := by
  exact before_first_max_lt_first_max hmax hfirst (mem_take_finRange_lt hi)

private theorem drop_value_le_first_max_of_first_max {n : Nat}
    {X : Fin n → Nat} {m j : Fin n}
    (hmax : ∀ a : Fin n, X a ≤ X m)
    (_hj : j ∈ (List.finRange n).drop (m.val + 1)) :
    X j ≤ X m := by
  exact hmax j

private theorem take_value_le_drop_value_of_first_max {n : Nat}
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {m i j : Fin n}
    (hmax : ∀ a : Fin n, X a ≤ X m)
    (hfirst : ∀ a : Fin n, a < m → X a ≠ X m)
    (hi : i ∈ (List.finRange n).take m.val)
    (hj : j ∈ (List.finRange n).drop (m.val + 1)) :
    X i ≤ X j := by
  have him : i < m := mem_take_finRange_lt hi
  have hmj : m < j := mem_drop_finRange_gt hj
  exact avoids231_before_first_max_le_after havoid hmax hfirst him hmj

private theorem prefixSeq_le_suffixSeq_of_first_max {n : Nat}
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {m : Fin n}
    (hmax : ∀ a : Fin n, X a ≤ X m)
    (hfirst : ∀ a : Fin n, a < m → X a ≠ X m)
    (i : Fin m.val) (j : Fin (n - (m.val + 1))) :
    prefixSeq X m i ≤ suffixSeq X m j := by
  unfold prefixSeq suffixSeq
  refine avoids231_before_first_max_le_after havoid hmax hfirst ?_ ?_
  · exact i.isLt
  · change m.val < m.val + 1 + j.val
    omega

private theorem suffixSeq_left_le_right_of_middle_eq_first_max {n : Nat}
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {m : Fin n} {i j k : Fin (n - (m.val + 1))}
    (hij : i < j) (hjk : j < k)
    (hj_eq : suffixSeq X m j = X m)
    (hi_lt : suffixSeq X m i < X m) :
    suffixSeq X m i ≤ suffixSeq X m k := by
  have hijv : suffixSeq X m i < suffixSeq X m j := by
    rw [hj_eq]
    exact hi_lt
  exact avoids231_left_le_right_of_left_lt_mid
    (suffixSeq_avoids231 havoid m) hij hjk hijv

private theorem suffixSeq_no_drop_across_repeated_first_max {n : Nat}
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {m : Fin n} {i j k : Fin (n - (m.val + 1))}
    (hij : i < j) (hjk : j < k)
    (hj_eq : suffixSeq X m j = X m)
    (hi_lt : suffixSeq X m i < X m) :
    ¬ suffixSeq X m k < suffixSeq X m i := by
  intro hk_lt
  have hle :=
    suffixSeq_left_le_right_of_middle_eq_first_max
      havoid hij hjk hj_eq hi_lt
  omega

private theorem strictLowerSuffixSeq_left_le_right_of_pivot_between
    {n : Nat} {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {m : Fin n}
    {a b : Fin (strictLowerSuffixIndices X m).length}
    {p : Fin (n - (m.val + 1))}
    (ha_p : (strictLowerSuffixIndices X m).get a < p)
    (hp_b : p < (strictLowerSuffixIndices X m).get b)
    (hp_eq : suffixSeq X m p = X m) :
    strictLowerSuffixSeq X m a ≤ strictLowerSuffixSeq X m b := by
  have ha_lt : suffixSeq X m ((strictLowerSuffixIndices X m).get a) < X m := by
    exact (mem_strictLowerSuffixIndices_iff X m).mp
      (List.getElem_mem a.isLt)
  have hno :=
    suffixSeq_no_drop_across_repeated_first_max
      havoid ha_p hp_b hp_eq ha_lt
  by_contra hnot
  have hdrop :
      suffixSeq X m ((strictLowerSuffixIndices X m).get b) <
        suffixSeq X m ((strictLowerSuffixIndices X m).get a) := by
    have hlt : strictLowerSuffixSeq X m b < strictLowerSuffixSeq X m a :=
      Nat.lt_of_not_ge hnot
    simpa [strictLowerSuffixSeq] using hlt
  exact hno hdrop

private theorem strictLowerSuffixSeq_left_le_right_of_pivotSuffix_between
    {n : Nat} {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {m : Fin n}
    (hsuf_le :
      ∀ j : Fin (n - (m.val + 1)), suffixSeq X m j ≤ X m)
    {a b : Fin (strictLowerSuffixIndices X m).length}
    {p : Fin (pivotSuffixIndices X m).length}
    (ha_p :
      (strictLowerSuffixIndices X m).get a <
        (pivotSuffixIndices X m).get p)
    (hp_b :
      (pivotSuffixIndices X m).get p <
        (strictLowerSuffixIndices X m).get b) :
    strictLowerSuffixSeq X m a ≤ strictLowerSuffixSeq X m b := by
  apply strictLowerSuffixSeq_left_le_right_of_pivot_between havoid ha_p hp_b
  exact (mem_pivotSuffixIndices_iff_eq X m hsuf_le).mp
    (List.getElem_mem p.isLt)

private theorem exists_first_max {n : Nat} (hn : 0 < n)
    (X : Fin n → Nat) :
    ∃ m : Fin n,
      (∀ a : Fin n, X a ≤ X m) ∧
      (∀ a : Fin n, a < m → X a ≠ X m) := by
  classical
  letI : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  obtain ⟨m₀, hmax₀⟩ := Finite.exists_max X
  let p : Fin n → Prop := fun a => ∀ b : Fin n, X b ≤ X a
  have hp₀ : p m₀ := hmax₀
  obtain ⟨m, _hm_le, hmin⟩ :=
    Finite.exists_le_minimal (p := p) (a := m₀) hp₀
  refine ⟨m, hmin.1, ?_⟩
  intro a ham heq
  have hpa : p a := by
    intro b
    rw [heq]
    exact hmin.1 b
  have hma : m ≤ a := hmin.2 hpa (le_of_lt ham)
  exact (not_lt_of_ge hma) ham

private theorem direct_firstMax_boundary_bound_small_le_four
    {n : Nat} (hn : 0 < n) (hn4 : n ≤ 4)
    (X : Fin n → Nat) (init : BinaryTree)
    (hbst : IsBST init)
    (hmem : ∀ i : Fin n, X i ∈ init.toKeyList) :
    ∃ m : Fin n,
      (∀ a : Fin n, X a ≤ X m) ∧
      (∀ a : Fin n, a < m → X a ≠ X m) ∧
      splayPathSum X init (List.finRange n) ≤
        4 * boundaryBudget X init (List.finRange n) (X m) := by
  obtain ⟨m, hmax, hfirst⟩ := exists_first_max hn X
  refine ⟨m, hmax, hfirst, ?_⟩
  have hpath :=
    splayPathSum_le_length_mul_boundaryBudget
      X (List.finRange n) init (X m) hbst
      (by
        intro i _hi
        exact hmem i)
  rw [List.length_finRange] at hpath
  have hB_nonneg :
      0 ≤ boundaryBudget X init (List.finRange n) (X m) :=
    boundaryBudget_nonneg X init (List.finRange n) (X m)
  have hn4_real : (n : ℝ) ≤ 4 := by
    exact_mod_cast hn4
  have hmul :
      (n : ℝ) * boundaryBudget X init (List.finRange n) (X m) ≤
        4 * boundaryBudget X init (List.finRange n) (X m) := by
    exact mul_le_mul_of_nonneg_right hn4_real hB_nonneg
  exact le_trans hpath hmul

private theorem exists_first_max_split {n : Nat} (hn : 0 < n)
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1]) :
    ∃ m : Fin n,
      (∀ a : Fin n, X a ≤ X m) ∧
      (∀ a : Fin n, a < m → X a ≠ X m) ∧
      (∀ i k : Fin n, i < m → m < k → X i ≤ X k) := by
  obtain ⟨m, hmax, hfirst⟩ := exists_first_max hn X
  refine ⟨m, hmax, hfirst, ?_⟩
  intro i k him hmk
  exact avoids231_before_first_max_le_after havoid hmax hfirst him hmk

private theorem first_max_eq_of_exists_value {n : Nat}
    {Y : Fin n → Nat} {q : Nat} {m : Fin n}
    (hmax : ∀ a : Fin n, Y a ≤ Y m)
    (hle : ∀ a : Fin n, Y a ≤ q)
    (hocc : ∃ a : Fin n, Y a = q) :
    Y m = q := by
  obtain ⟨a, ha⟩ := hocc
  have hq_le : q ≤ Y m := by
    rw [← ha]
    exact hmax a
  have hm_le : Y m ≤ q := hle m
  omega

private theorem exists_first_max_prefix_suffix_split {n : Nat} (hn : 0 < n)
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1]) :
    ∃ m : Fin n,
      (∀ a : Fin n, X a ≤ X m) ∧
      (∀ a : Fin n, a < m → X a ≠ X m) ∧
      (prefixSeq X m avoids ![2, 3, 1]) ∧
      (suffixSeq X m avoids ![2, 3, 1]) ∧
      (∀ i : Fin m.val, ∀ j : Fin (n - (m.val + 1)),
        prefixSeq X m i ≤ suffixSeq X m j) := by
  obtain ⟨m, hmax, hfirst⟩ := exists_first_max hn X
  refine ⟨m, hmax, hfirst, prefixSeq_avoids231 havoid m,
    suffixSeq_avoids231 havoid m, ?_⟩
  intro i j
  exact prefixSeq_le_suffixSeq_of_first_max havoid hmax hfirst i j

private theorem exists_first_max_prefix_suffix_strict_split {n : Nat}
    (hn : 0 < n) {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1]) :
    ∃ m : Fin n,
      (∀ a : Fin n, X a ≤ X m) ∧
      (∀ a : Fin n, a < m → X a ≠ X m) ∧
      (prefixSeq X m avoids ![2, 3, 1]) ∧
      (suffixSeq X m avoids ![2, 3, 1]) ∧
      (∀ i : Fin m.val, prefixSeq X m i < X m) ∧
      (∀ j : Fin (n - (m.val + 1)), suffixSeq X m j ≤ X m) ∧
      (∀ i : Fin m.val, ∀ j : Fin (n - (m.val + 1)),
        prefixSeq X m i ≤ suffixSeq X m j) := by
  obtain ⟨m, hmax, hfirst⟩ := exists_first_max hn X
  refine ⟨m, hmax, hfirst, prefixSeq_avoids231 havoid m,
    suffixSeq_avoids231 havoid m, ?_, ?_, ?_⟩
  · intro i
    exact prefixSeq_lt_first_max hmax hfirst i
  · intro j
    exact suffixSeq_le_first_max hmax j
  · intro i j
    exact prefixSeq_le_suffixSeq_of_first_max havoid hmax hfirst i j

private theorem exists_first_max_path_decomp {n : Nat}
    (hn : 0 < n) (X : Fin n → Nat) (havoid : X avoids ![2, 3, 1])
    (init : BinaryTree) :
    ∃ m : Fin n,
      (∀ a : Fin n, X a ≤ X m) ∧
      (∀ a : Fin n, a < m → X a ≠ X m) ∧
      (prefixSeq X m avoids ![2, 3, 1]) ∧
      (suffixSeq X m avoids ![2, 3, 1]) ∧
      (∀ i : Fin m.val, prefixSeq X m i < X m) ∧
      (∀ j : Fin (n - (m.val + 1)), suffixSeq X m j ≤ X m) ∧
      (∀ i : Fin m.val, ∀ j : Fin (n - (m.val + 1)),
        prefixSeq X m i ≤ suffixSeq X m j) ∧
      splayPathSum X init (List.finRange n) =
        splayPathSum (prefixSeq X m) init (List.finRange m.val) +
          ((splayTreeAfter (prefixSeq X m) init
              (List.finRange m.val)).search_path_len (X m) +
            splayPathSum (suffixSeq X m)
              (splay
                (splayTreeAfter (prefixSeq X m) init
                  (List.finRange m.val))
                (X m))
              (List.finRange (n - (m.val + 1)))) := by
  obtain ⟨m, hmax, hfirst, hpre, hsuf, hpre_lt, hsuf_le,
    hpre_suf⟩ :=
    exists_first_max_prefix_suffix_strict_split hn havoid
  refine ⟨m, hmax, hfirst, hpre, hsuf, hpre_lt, hsuf_le, hpre_suf, ?_⟩
  exact splayPathSum_finRange_prefix_pivot_suffix X init m

private theorem firstMax_path_bound_of_activeBudget_subblocks
    (K : ℝ) (hK : 0 ≤ K)
    (hsubblock :
      ∀ {N : Nat} (Y : Fin N → Nat) (t : BinaryTree),
        (Y avoids ![2, 3, 1]) →
        IsBST t →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        splayPathSum Y t (List.finRange N) ≤
          K * activeBudget Y t (List.finRange N))
    {n : Nat} (hn : 0 < n) (X : Fin n → Nat)
    (init : BinaryTree)
    (havoid : X avoids ![2, 3, 1])
    (hbst : IsBST init)
    (hmem : ∀ i : Fin n, X i ∈ init.toKeyList) :
    splayPathSum X init (List.finRange n) ≤
      (2 * K + 1) * activeBudget X init (List.finRange n) := by
  obtain ⟨m, _hmax, _hfirst, hpreAvoid, hsufAvoid, _hpre_lt,
      _hsuf_le, _hpre_suf, hrec⟩ :=
    exists_first_max_path_decomp hn X havoid init
  let tp := splayTreeAfter (prefixSeq X m) init (List.finRange m.val)
  let ts := splay tp (X m)
  have hprefix :
      splayPathSum (prefixSeq X m) init (List.finRange m.val) ≤
        K * activeBudget (prefixSeq X m) init (List.finRange m.val) :=
    hsubblock (prefixSeq X m) init hpreAvoid hbst (prefixSeq_mem hmem m)
  have htp_bst : IsBST tp := by
    unfold tp
    exact splayTreeAfter_isBST (prefixSeq X m)
      (List.finRange m.val) init hbst
  have hts_bst : IsBST ts := by
    unfold ts
    exact splay_isBST tp (X m) htp_bst
  have hsuffix :
      splayPathSum (suffixSeq X m) ts
          (List.finRange (n - (m.val + 1))) ≤
        K * activeBudget (suffixSeq X m) ts
          (List.finRange (n - (m.val + 1))) :=
    hsubblock (suffixSeq X m) ts hsufAvoid hts_bst
      (by
        intro i
        unfold ts tp
        exact suffixSeq_mem_after_prefix_pivot hmem m i)
  have htake_sub :
      ((List.finRange n).take m.val).Sublist (List.finRange n) :=
    List.take_sublist _ _
  have hprefix_budget :
      activeBudget (prefixSeq X m) init (List.finRange m.val) ≤
        activeBudget X init (List.finRange n) := by
    have htake :
        activeBudget X init ((List.finRange n).take m.val) ≤
          activeBudget X init (List.finRange n) :=
      activeBudget_sublist_le X init htake_sub
    simpa [activeBudget_take_eq_prefixSeq X init m] using htake
  have hsuffix_budget :
      activeBudget (suffixSeq X m) ts
          (List.finRange (n - (m.val + 1))) ≤
        activeBudget X init (List.finRange n) := by
    unfold ts tp
    exact activeBudget_suffixSeq_after_prefix_pivot_le_original
      X init m hbst hmem
  have hpivot :
      (tp.search_path_len (X m) : ℝ) ≤
        activeBudget X init (List.finRange n) := by
    unfold tp
    exact pivot_search_len_after_prefix_le_activeBudget_original
      X init m hbst hmem
  have hprefix_full :
      splayPathSum (prefixSeq X m) init (List.finRange m.val) ≤
        K * activeBudget X init (List.finRange n) :=
    le_trans hprefix (mul_le_mul_of_nonneg_left hprefix_budget hK)
  have hsuffix_full :
      splayPathSum (suffixSeq X m) ts
          (List.finRange (n - (m.val + 1))) ≤
        K * activeBudget X init (List.finRange n) :=
    le_trans hsuffix (mul_le_mul_of_nonneg_left hsuffix_budget hK)
  rw [hrec]
  change
    splayPathSum (prefixSeq X m) init (List.finRange m.val) +
        ((tp.search_path_len (X m) : ℝ) +
          splayPathSum (suffixSeq X m) ts
            (List.finRange (n - (m.val + 1)))) ≤
      (2 * K + 1) * activeBudget X init (List.finRange n)
  nlinarith

private theorem exists_first_max_pathWithFinal_decomp {n : Nat}
    (hn : 0 < n) (X : Fin n → Nat) (havoid : X avoids ![2, 3, 1])
    (init : BinaryTree) (q : Nat) :
    ∃ m : Fin n,
      (∀ a : Fin n, X a ≤ X m) ∧
      (∀ a : Fin n, a < m → X a ≠ X m) ∧
      (prefixSeq X m avoids ![2, 3, 1]) ∧
      (suffixSeq X m avoids ![2, 3, 1]) ∧
      (∀ i : Fin m.val, prefixSeq X m i < X m) ∧
      (∀ j : Fin (n - (m.val + 1)), suffixSeq X m j ≤ X m) ∧
      (∀ i : Fin m.val, ∀ j : Fin (n - (m.val + 1)),
        prefixSeq X m i ≤ suffixSeq X m j) ∧
      splayPathSumWithFinal X q init (List.finRange n) =
        splayPathSum (prefixSeq X m) init (List.finRange m.val) +
          ((splayTreeAfter (prefixSeq X m) init
              (List.finRange m.val)).search_path_len (X m) +
            splayPathSumWithFinal (suffixSeq X m) q
              (splay
                (splayTreeAfter (prefixSeq X m) init
                  (List.finRange m.val))
                (X m))
              (List.finRange (n - (m.val + 1)))) := by
  obtain ⟨m, hmax, hfirst, hpre, hsuf, hpre_lt, hsuf_le,
    hpre_suf⟩ :=
    exists_first_max_prefix_suffix_strict_split hn havoid
  refine ⟨m, hmax, hfirst, hpre, hsuf, hpre_lt, hsuf_le, hpre_suf, ?_⟩
  exact splayPathSumWithFinal_finRange_prefix_pivot_suffix X init m q

private theorem strict_block_firstMax_pathWithFinal_bound_of_boundary_blocks
    (Ks Ku : ℝ) (hKs : 0 ≤ Ks) (hKu : 0 ≤ Ku)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          Ks * boundaryBudget Y t (List.finRange N) q)
    (hupper :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i ≤ q) →
        splayPathSum Y t (List.finRange N) ≤
          Ku * boundaryBudget Y t (List.finRange N) q)
    {N : Nat} (hn : 0 < N) (Y : Fin N → Nat) (q : Nat)
    (t : BinaryTree)
    (hbst : IsBST t)
    (hq_mem : q ∈ t.toKeyList)
    (hmem : ∀ i : Fin N, Y i ∈ t.toKeyList)
    (havoid : Y avoids ![2, 3, 1])
    (hlt : ∀ i : Fin N, Y i < q) :
    splayPathSumWithFinal Y q t (List.finRange N) ≤
      (Ks + Ku + 1) * boundaryBudget Y t (List.finRange N) q := by
  obtain ⟨m, _hmax, _hfirst, hpreAvoid, hsufAvoid, hpre_lt,
      hsuf_le, _hpre_suf, hpath⟩ :=
    exists_first_max_pathWithFinal_decomp hn Y havoid t q
  let tp := splayTreeAfter (prefixSeq Y m) t (List.finRange m.val)
  let ts := splay tp (Y m)
  let Bq := boundaryBudget Y t (List.finRange N) q
  have hm_mem_fin : m ∈ List.finRange N := by
    simp
  have hBm_le_Bq :
      boundaryBudget Y t (List.finRange N) (Y m) ≤ Bq := by
    unfold Bq
    exact boundaryBudget_boundary_mem_le
      Y t (List.finRange N) q hm_mem_fin
  have hprefix_pivot :
      splayPathSum (prefixSeq Y m) t (List.finRange m.val) +
          ((tp.search_path_len (Y m) : Nat) : ℝ) ≤
        Ks * Bq := by
    have hpre :=
      prefix_pivot_pathSum_le_full_boundaryBudget_of_bound
        Ks hKs hstrict hbst hmem hpreAvoid hpre_lt
    change
      splayPathSum (prefixSeq Y m) t (List.finRange m.val) +
          ((tp.search_path_len (Y m) : Nat) : ℝ) ≤
        Ks * boundaryBudget Y t (List.finRange N) (Y m) at hpre
    exact le_trans hpre (mul_le_mul_of_nonneg_left hBm_le_Bq hKs)
  have htp_bst : IsBST tp := by
    unfold tp
    exact splayTreeAfter_isBST (prefixSeq Y m)
      (List.finRange m.val) t hbst
  have hm_mem_tp : Y m ∈ tp.toKeyList := by
    unfold tp
    rw [splayTreeAfter_toKeyList (prefixSeq Y m)
      (List.finRange m.val) t]
    exact hmem m
  have hts_bst : IsBST ts := by
    unfold ts
    exact splay_isBST tp (Y m) htp_bst
  have hroot_ts : rootKey ts = some (Y m) := by
    unfold ts
    exact splay_rootKey_eq_some_of_mem_isBST tp (Y m)
      htp_bst hm_mem_tp
  have hq_mem_ts : q ∈ ts.toKeyList := by
    unfold ts tp
    rw [splay_toKeyList,
      splayTreeAfter_toKeyList (prefixSeq Y m)
        (List.finRange m.val) t]
    exact hq_mem
  have hsuf_mem :
      ∀ i : Fin (N - (m.val + 1)), suffixSeq Y m i ∈ ts.toKeyList := by
    intro i
    unfold ts tp
    exact suffixSeq_mem_after_prefix_pivot hmem m i
  have hsuf_path :
      splayPathSum (suffixSeq Y m) ts
          (List.finRange (N - (m.val + 1))) ≤
        Ku * Bq := by
    have hsuf :=
      hupper (suffixSeq Y m) (Y m) ts hts_bst hroot_ts
        hsuf_mem hsufAvoid hsuf_le
    have hbudget_pivot :=
      boundaryBudget_suffixSeq_after_prefix_pivot_le_finRange
        (m := m) hbst hmem
    change
      boundaryBudget (suffixSeq Y m) ts
          (List.finRange (N - (m.val + 1))) (Y m) ≤
        boundaryBudget Y t (List.finRange N) (Y m) at hbudget_pivot
    have hbudget_q :
        boundaryBudget (suffixSeq Y m) ts
            (List.finRange (N - (m.val + 1))) (Y m) ≤ Bq :=
      le_trans hbudget_pivot hBm_le_Bq
    exact le_trans hsuf (mul_le_mul_of_nonneg_left hbudget_q hKu)
  have hfinal_search :
      ((splayTreeAfter (suffixSeq Y m) ts
        (List.finRange (N - (m.val + 1)))).search_path_len q : ℝ) ≤
        Bq := by
    let tf :=
      splayTreeAfter (suffixSeq Y m) ts
        (List.finRange (N - (m.val + 1)))
    have htf_bst : IsBST tf := by
      unfold tf
      exact splayTreeAfter_isBST (suffixSeq Y m)
        (List.finRange (N - (m.val + 1))) ts hts_bst
    have hsearch :
        (tf.search_path_len q : ℝ) ≤
          boundaryBudget (suffixSeq Y m) tf [] q :=
      search_path_len_real_le_boundaryBudget_of_boundary
        (suffixSeq Y m) [] q htf_bst
    have hafter :
        boundaryBudget (suffixSeq Y m) tf [] q ≤
          boundaryBudget (suffixSeq Y m) ts
            (List.finRange (N - (m.val + 1))) q := by
      unfold tf
      have hmem_all :
          ∀ i : Fin (N - (m.val + 1)),
            i ∈ List.finRange (N - (m.val + 1)) ++ [] →
              suffixSeq Y m i ∈ ts.toKeyList := by
        intro i _hi
        exact hsuf_mem i
      have happ :=
        boundaryBudget_after_splayTreeAfter_le_append
          (suffixSeq Y m) (List.finRange (N - (m.val + 1))) []
          ts q hts_bst hq_mem_ts hmem_all
      simpa using happ
    have hbudget_q :=
      boundaryBudget_suffixSeq_after_prefix_pivot_le_finRange_boundary
        (m := m) q hbst hq_mem hmem
    change
      boundaryBudget (suffixSeq Y m) ts
          (List.finRange (N - (m.val + 1))) q ≤ Bq at hbudget_q
    exact le_trans hsearch (le_trans hafter hbudget_q)
  rw [hpath]
  rw [splayPathSumWithFinal_eq_pathSum_add_final
    (suffixSeq Y m) q (List.finRange (N - (m.val + 1))) ts]
  change
    splayPathSum (prefixSeq Y m) t (List.finRange m.val) +
        (((tp.search_path_len (Y m) : Nat) : ℝ) +
          (splayPathSum (suffixSeq Y m) ts
            (List.finRange (N - (m.val + 1))) +
            ((splayTreeAfter (suffixSeq Y m) ts
              (List.finRange (N - (m.val + 1)))).search_path_len q : ℝ))) ≤
      (Ks + Ku + 1) * Bq
  nlinarith

private theorem strict_block_firstMax_pathWithFinal_bound_of_strict_split
    (K : ℝ)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q)
    {N : Nat} (hn : 0 < N) (Y : Fin N → Nat) (q : Nat)
    (t : BinaryTree)
    (hbst : IsBST t)
    (hq_mem : q ∈ t.toKeyList)
    (hmem : ∀ i : Fin N, Y i ∈ t.toKeyList)
    (havoid : Y avoids ![2, 3, 1])
    (hlt : ∀ i : Fin N, Y i < q) :
    ∃ m : Fin N,
      splayPathSumWithFinal Y q t (List.finRange N) ≤
        K * boundaryBudget (prefixSeq Y m) t (List.finRange m.val) (Y m) +
          K *
            boundaryBudget (suffixSeq Y m)
              (splay
                (splayTreeAfter (prefixSeq Y m) t
                  (List.finRange m.val))
                (Y m))
              (List.finRange (N - (m.val + 1))) q := by
  obtain ⟨m, hmax, _hfirst, hpreAvoid, hsufAvoid, hpre_lt,
      _hsuf_le, _hpre_suf, hpath⟩ :=
    exists_first_max_pathWithFinal_decomp hn Y havoid t q
  let tp := splayTreeAfter (prefixSeq Y m) t (List.finRange m.val)
  let ts := splay tp (Y m)
  have hprefix :
      splayPathSum (prefixSeq Y m) t (List.finRange m.val) +
          ((tp.search_path_len (Y m) : Nat) : ℝ) ≤
        K * boundaryBudget (prefixSeq Y m) t
          (List.finRange m.val) (Y m) := by
    have hpreFinal :=
      hstrict (prefixSeq Y m) (Y m) t hbst (hmem m)
        (prefixSeq_mem hmem m) hpreAvoid hpre_lt
    unfold tp
    simpa [splayPathSumWithFinal_eq_pathSum_add_final] using hpreFinal
  have htp_bst : IsBST tp := by
    unfold tp
    exact splayTreeAfter_isBST (prefixSeq Y m)
      (List.finRange m.val) t hbst
  have hm_mem_tp : Y m ∈ tp.toKeyList := by
    unfold tp
    rw [splayTreeAfter_toKeyList (prefixSeq Y m)
      (List.finRange m.val) t]
    exact hmem m
  have hts_bst : IsBST ts := by
    unfold ts
    exact splay_isBST tp (Y m) htp_bst
  have hq_mem_ts : q ∈ ts.toKeyList := by
    unfold ts tp
    rw [splay_toKeyList,
      splayTreeAfter_toKeyList (prefixSeq Y m)
        (List.finRange m.val) t]
    exact hq_mem
  have hsuf_mem :
      ∀ i : Fin (N - (m.val + 1)),
        suffixSeq Y m i ∈ ts.toKeyList := by
    intro i
    unfold ts tp
    exact suffixSeq_mem_after_prefix_pivot hmem m i
  have hsuf_lt_q :
      ∀ i : Fin (N - (m.val + 1)), suffixSeq Y m i < q := by
    intro i
    exact lt_of_le_of_lt (suffixSeq_le_first_max hmax i) (hlt m)
  have hsuffix :
      splayPathSumWithFinal (suffixSeq Y m) q ts
          (List.finRange (N - (m.val + 1))) ≤
        K * boundaryBudget (suffixSeq Y m) ts
          (List.finRange (N - (m.val + 1))) q :=
    hstrict (suffixSeq Y m) q ts hts_bst hq_mem_ts
      hsuf_mem hsufAvoid hsuf_lt_q
  refine ⟨m, ?_⟩
  rw [hpath]
  change
    splayPathSum (prefixSeq Y m) t (List.finRange m.val) +
        (((tp.search_path_len (Y m) : Nat) : ℝ) +
          splayPathSumWithFinal (suffixSeq Y m) q ts
            (List.finRange (N - (m.val + 1)))) ≤
      K * boundaryBudget (prefixSeq Y m) t (List.finRange m.val) (Y m) +
        K * boundaryBudget (suffixSeq Y m) ts
          (List.finRange (N - (m.val + 1))) q
  nlinarith

private theorem boundaryBudget_strict_firstMax_split_le_two
    {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree)
    (m : Fin N)
    (hbst : IsBST t)
    (hq_mem : q ∈ t.toKeyList)
    (hmem : ∀ i : Fin N, Y i ∈ t.toKeyList) :
    boundaryBudget (prefixSeq Y m) t (List.finRange m.val) (Y m) +
        boundaryBudget (suffixSeq Y m)
          (splay
            (splayTreeAfter (prefixSeq Y m) t
              (List.finRange m.val))
            (Y m))
          (List.finRange (N - (m.val + 1))) q ≤
      2 * boundaryBudget Y t (List.finRange N) q := by
  let B := boundaryBudget Y t (List.finRange N) q
  have hm_mem_fin : m ∈ List.finRange N := by
    simp
  have htake_sub :
      ((List.finRange N).take m.val).Sublist (List.finRange N) :=
    List.take_sublist _ _
  have hbudget_take :
      boundaryBudget Y t ((List.finRange N).take m.val) (Y m) ≤
        boundaryBudget Y t (List.finRange N) (Y m) :=
    boundaryBudget_sublist_le Y t (Y m) htake_sub
  have hbudget_boundary :
      boundaryBudget Y t (List.finRange N) (Y m) ≤ B := by
    unfold B
    exact boundaryBudget_boundary_mem_le Y t (List.finRange N) q hm_mem_fin
  have hprefix_le :
      boundaryBudget (prefixSeq Y m) t (List.finRange m.val) (Y m) ≤ B := by
    have hprefix :
        boundaryBudget (prefixSeq Y m) t (List.finRange m.val) (Y m) =
          boundaryBudget Y t ((List.finRange N).take m.val) (Y m) := by
      exact (boundaryBudget_take_eq_prefixSeq Y t m).symm
    rw [hprefix]
    exact le_trans hbudget_take hbudget_boundary
  have hsuffix_le :
      boundaryBudget (suffixSeq Y m)
          (splay
            (splayTreeAfter (prefixSeq Y m) t
              (List.finRange m.val))
            (Y m))
          (List.finRange (N - (m.val + 1))) q ≤ B := by
    have hsuf :=
      boundaryBudget_suffixSeq_after_prefix_pivot_le_finRange_boundary
        (m := m) q hbst hq_mem hmem
    simpa [B] using hsuf
  nlinarith

private theorem strict_block_firstMax_pathWithFinal_bound_factor_two
    (K : ℝ) (hK : 0 ≤ K)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q)
    {N : Nat} (hn : 0 < N) (Y : Fin N → Nat) (q : Nat)
    (t : BinaryTree)
    (hbst : IsBST t)
    (hq_mem : q ∈ t.toKeyList)
    (hmem : ∀ i : Fin N, Y i ∈ t.toKeyList)
    (havoid : Y avoids ![2, 3, 1])
    (hlt : ∀ i : Fin N, Y i < q) :
    splayPathSumWithFinal Y q t (List.finRange N) ≤
      2 * K * boundaryBudget Y t (List.finRange N) q := by
  obtain ⟨m, hpath⟩ :=
    strict_block_firstMax_pathWithFinal_bound_of_strict_split
      K hstrict hn Y q t hbst hq_mem hmem havoid hlt
  have hsplit :=
    boundaryBudget_strict_firstMax_split_le_two
      Y q t m hbst hq_mem hmem
  have hmul :
      K *
          (boundaryBudget (prefixSeq Y m) t (List.finRange m.val) (Y m) +
            boundaryBudget (suffixSeq Y m)
              (splay
                (splayTreeAfter (prefixSeq Y m) t
                  (List.finRange m.val))
                (Y m))
              (List.finRange (N - (m.val + 1))) q) ≤
        K * (2 * boundaryBudget Y t (List.finRange N) q) := by
    exact mul_le_mul_of_nonneg_left hsplit hK
  calc
    splayPathSumWithFinal Y q t (List.finRange N)
        ≤
      K * boundaryBudget (prefixSeq Y m) t (List.finRange m.val) (Y m) +
        K *
          boundaryBudget (suffixSeq Y m)
            (splay
              (splayTreeAfter (prefixSeq Y m) t
                (List.finRange m.val))
              (Y m))
            (List.finRange (N - (m.val + 1))) q := hpath
    _ =
      K *
        (boundaryBudget (prefixSeq Y m) t (List.finRange m.val) (Y m) +
          boundaryBudget (suffixSeq Y m)
            (splay
              (splayTreeAfter (prefixSeq Y m) t
                (List.finRange m.val))
              (Y m))
            (List.finRange (N - (m.val + 1))) q) := by ring
    _ ≤ K * (2 * boundaryBudget Y t (List.finRange N) q) := hmul
    _ = 2 * K * boundaryBudget Y t (List.finRange N) q := by ring

private theorem strict_block_firstMax_pathWithFinal_bound_factor_two_of_ih
    (K : ℝ) (hK : 0 ≤ K)
    {N : Nat} (hn : 0 < N)
    (hstrictIH :
      ∀ k, k < N → ∀ (Y : Fin k → Nat) (q : Nat)
          (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin k, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin k, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange k) ≤
