private theorem ordered_low_pair_of_path_len_bound
    {q x y : Nat} {C : ℝ} {actual reset : BinaryTree}
    (hbst_actual : IsBST actual)
    (hbst_reset : IsBST reset)
    (hroot_reset : rootKey reset = some q)
    (hkeys : reset.toKeyList = actual.toKeyList)
    (hx_mem : x ∈ actual.toKeyList)
    (hx_lt : x < q)
    (hy_mem : y ∈ (splay actual x).toKeyList)
    (hy_lt : y < q)
    (hpath :
      ((splay actual x).search_path_len y : ℝ) ≤
        ((splay (splay reset x) q).search_path_len y : ℝ) + C) :
    ((splay actual x).search_path_len y : ℝ) +
        ((splay (splay actual x) y).search_path_len q : ℝ) ≤
      ((splay actual x).search_path_len q : ℝ) +
        ((splay (splay reset x) q).search_path_len y : ℝ) +
        ((splay (splay (splay reset x) q) y).search_path_len q : ℝ) +
        C := by
  let actual' := splay actual x
  let reset' := splay (splay reset x) q
  have hbst_actual' : IsBST actual' := by
    unfold actual'
    exact splay_isBST actual x hbst_actual
  have hbst_reset' : IsBST reset' := by
    unfold reset'
    exact splay_isBST (splay reset x) q
      (splay_isBST reset x hbst_reset)
  have hroot_reset' : rootKey reset' = some q := by
    unfold reset'
    exact rootKey_after_pivot_reset_of_root hbst_reset hroot_reset
  have hkeys' : reset'.toKeyList = actual'.toKeyList := by
    unfold reset' actual'
    rw [splay_toKeyList, splay_toKeyList, splay_toKeyList]
    exact hkeys
  have hq_path_nat :
      (splay actual' y).search_path_len q ≤
        actual'.search_path_len q +
          (splay reset' y).search_path_len q :=
    search_path_len_after_lower_access_le_actual_boundary_add_reset_access
      hbst_actual' hbst_reset' hroot_reset' hkeys'
      hy_mem hy_lt
  have hq_path :
      ((splay actual' y).search_path_len q : ℝ) ≤
        (actual'.search_path_len q : ℝ) +
          ((splay reset' y).search_path_len q : ℝ) := by
    exact_mod_cast hq_path_nat
  dsimp [actual', reset'] at hq_path hpath
  nlinarith

private theorem ordered_low_pair_eq_current
    {q lo x y : Nat} {C : ℝ} {actual reset : BinaryTree}
    (hC : 0 ≤ C)
    (hbst_actual : IsBST actual)
    (_hbst_reset : IsBST reset)
    (hroot_reset : rootKey reset = some q)
    (hkeys : reset.toKeyList = actual.toKeyList)
    (hx_mem : x ∈ actual.toKeyList)
    (_hx_lt : x < q)
    (_hx_le : x ≤ lo)
    (_hy_mem : y ∈ (splay actual x).toKeyList)
    (_hlo : lo ≤ y)
    (_hy_lt : y < q)
    (hy_eq : y = x) :
    ((splay actual x).search_path_len y : ℝ) +
        ((splay (splay actual x) y).search_path_len q : ℝ) ≤
      ((splay actual x).search_path_len q : ℝ) +
        ((splay (splay reset x) q).search_path_len y : ℝ) +
        ((splay (splay (splay reset x) q) y).search_path_len q : ℝ) +
        C := by
  subst y
  have hroot_actual_x :
      rootKey (splay actual x) = some x :=
    splay_rootKey_eq_some_of_mem_isBST actual x hbst_actual hx_mem
  have hpath_x :
      (splay actual x).search_path_len x = 1 :=
    search_path_len_eq_one_of_rootKey_eq_some hroot_actual_x
  have hsplay_x :
      splay (splay actual x) x = splay actual x :=
    splay_eq_self_of_rootKey_eq_some hroot_actual_x
  have hx_mem_reset_after :
      x ∈ (splay (splay reset x) q).toKeyList := by
    rw [splay_toKeyList, splay_toKeyList]
    rw [hkeys]
    exact hx_mem
  have hpath_reset_pos :
      0 < (splay (splay reset x) q).search_path_len x :=
    search_path_len_pos_of_mem
      (splay (splay reset x) q) x hx_mem_reset_after
  have hpath_reset_one :
      (1 : ℝ) ≤
        ((splay (splay reset x) q).search_path_len x : ℝ) := by
    exact_mod_cast (Nat.succ_le_iff.mpr hpath_reset_pos)
  have hreset_after_nonneg :
      (0 : ℝ) ≤
        ((splay (splay (splay reset x) q) x).search_path_len q : ℝ) := by
    exact_mod_cast
      (Nat.zero_le
        ((splay (splay (splay reset x) q) x).search_path_len q))
  rw [hpath_x, hsplay_x]
  norm_num
  nlinarith [hpath_reset_one, hreset_after_nonneg, hC]

