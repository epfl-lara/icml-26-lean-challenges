private theorem split_left_lower_le_current_of_pivot_between_avoids231
    {n : Nat} {Y : Fin n → Nat}
    {left right future : List (Fin n)} {p i : Fin n} {q : Nat}
    (hsub : ((left ++ p :: right) ++ i :: future).Sublist
      (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    {a : Fin left.length}
    (ha_lt_q : Y (left.get a) < q)
    (hp_eq_q : Y p = q) :
    Y (left.get a) ≤ Y i := by
  let done : List (Fin n) := left ++ p :: right
  let ia : Fin done.length := ⟨a.val, by
    have ha : a.val < left.length := a.isLt
    simp [done]
    omega⟩
  let ip : Fin done.length := ⟨left.length, by
    simp [done]⟩
  have hia_ip : ia < ip := by
    change a.val < left.length
    exact a.isLt
  have hget_a : done.get ia = left.get a := by
    simp [done, ia]
  have hget_p : done.get ip = p := by
    simp [done, ip]
  have ha_done : Y (done.get ia) < q := by
    rw [hget_a]
