private theorem resetPairDominatesAbove_low_final_of_path_len_bound
    {n : Nat} (Y : Fin n → Nat) (q lo : Nat) (D : ℝ)
    (actual reset : BinaryTree) (xs : List (Fin n))
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hpath :
      ∀ x : Nat,
        x ∈ (splay (splayTreeAfter Y actual xs) q).toKeyList →
        lo ≤ x →
        x < q →
        ((splay (splayTreeAfter Y actual xs) q).search_path_len x : ℝ) ≤
          ((suffixResetTreeAfter Y q reset xs).search_path_len x : ℝ) + D) :
    resetPairDominatesAbove q lo D
      (splay (splayTreeAfter Y actual xs) q)
      (suffixResetTreeAfter Y q reset xs) := by
  have hbst_actual :
      IsBST (splay (splayTreeAfter Y actual xs) q) := by
    exact
      splay_isBST (splayTreeAfter Y actual xs) q
        (splayTreeAfter_isBST Y xs actual hdom.1)
  have hbst_reset :
      IsBST (suffixResetTreeAfter Y q reset xs) := by
    exact suffixResetTreeAfter_isBST Y q xs reset hdom.2.1
  have hroot_reset :
      rootKey (suffixResetTreeAfter Y q reset xs) = some q := by
    exact
      suffixResetTreeAfter_rootKey Y q xs reset
        hdom.2.1 hdom.2.2.1
  have hkeys :
      (suffixResetTreeAfter Y q reset xs).toKeyList =
        (splay (splayTreeAfter Y actual xs) q).toKeyList := by
    rw [suffixResetTreeAfter_toKeyList, splay_toKeyList,
      splayTreeAfter_toKeyList]
    exact hdom.2.2.2.1
  exact
    resetPairDominatesAbove_of_path_len_bound
      hbst_actual hbst_reset hroot_reset hkeys hpath

private theorem resetPairDominatesAbove_low_final_of_pair_preservations
    {n : Nat} (Y : Fin n → Nat) (q lo : Nat) (Cp Cq D : ℝ)
    (hCpD : Cp ≤ D) (hCqD : Cq ≤ D)
    (hpres_lt_pair :
      ∀ (actual reset : BinaryTree) (x : Nat),
        resetPairDominatesAbove q lo D actual reset →
        x ∈ actual.toKeyList →
        x < q →
        ∀ y : Nat,
          y ∈ (splay actual x).toKeyList →
          lo ≤ y →
          y < q →
          ((splay actual x).search_path_len y : ℝ) +
              ((splay (splay actual x) y).search_path_len q : ℝ) ≤
            ((splay actual x).search_path_len q : ℝ) +
              ((splay (splay reset x) q).search_path_len y : ℝ) +
              ((splay (splay (splay reset x) q) y).search_path_len q : ℝ) +
              Cp)
    (hpres_eq_pair :
      ∀ (actual reset : BinaryTree) (x : Nat),
        resetPairDominatesAbove q lo D actual reset →
        x = q →
        ∀ y : Nat,
          y ∈ (splay actual x).toKeyList →
          lo ≤ y →
          y < q →
          ((splay actual x).search_path_len y : ℝ) +
              ((splay (splay actual x) y).search_path_len q : ℝ) ≤
            ((splay actual x).search_path_len q : ℝ) +
              (reset.search_path_len y : ℝ) +
              ((splay reset y).search_path_len q : ℝ) +
              Cq)
    (actual reset : BinaryTree) (xs : List (Fin n))
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (_hroot_actual : rootKey actual = some q)
    (hmem_xs : ∀ j : Fin n, j ∈ xs → Y j ∈ actual.toKeyList)
    (hle_xs : ∀ j : Fin n, j ∈ xs → Y j ≤ lo) :
    resetPairDominatesAbove q lo D
      (splay (splayTreeAfter Y actual xs) q)
      (suffixResetTreeAfter Y q reset xs) := by
  by_cases hlo_lt : lo < q
  · have hpres_low :
        ∀ (actual reset : BinaryTree) (x : Nat),
          resetPairDominatesAbove q lo D actual reset →
          x ∈ actual.toKeyList →
          x < q →
          x ≤ lo →
          resetPairDominatesAbove q lo D
            (splay actual x) (splay (splay reset x) q) := by
      intro actual0 reset0 x hdom0 hx_mem hx_lt _hx_le
      exact
        resetPairDominatesAbove_preserve_strict_of_pair_bound_mono
          (q := q) (lo := lo) (x := x) (C := Cp) (D := D)
          hCpD hdom0 hx_mem hx_lt
          (hpres_lt_pair actual0 reset0 x hdom0 hx_mem hx_lt)
    have hdom_xs :
        resetPairDominatesAbove q lo D
          (splayTreeAfter Y actual xs)
          (suffixResetTreeAfter Y q reset xs) :=
      resetPairDominatesAbove_after_low_lists_of_preservation
        Y q lo D hpres_low xs actual reset hdom hmem_xs hle_xs hlo_lt
    exact
      resetPairDominatesAbove_preserve_eq_of_pair_bound_mono
        (q := q) (lo := lo) (x := q) (C := Cq) (D := D)
        hCqD hdom_xs rfl
        (hpres_eq_pair
          (splayTreeAfter Y actual xs)
          (suffixResetTreeAfter Y q reset xs)
          q hdom_xs rfl)
  · have hq_le_lo : q ≤ lo := Nat.le_of_not_gt hlo_lt
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · exact
        splay_isBST (splayTreeAfter Y actual xs) q
          (splayTreeAfter_isBST Y xs actual hdom.1)
    · exact suffixResetTreeAfter_isBST Y q xs reset hdom.2.1
    · exact
        suffixResetTreeAfter_rootKey Y q xs reset
          hdom.2.1 hdom.2.2.1
    · rw [suffixResetTreeAfter_toKeyList, splay_toKeyList,
        splayTreeAfter_toKeyList]
      exact hdom.2.2.2.1
    · intro x _hx_mem hlo_x hx_lt
      exfalso
      omega

private theorem traversal_conjecture_of_first_tail_rise_low_final_components
    (Ks A C Cp D : ℝ)
    (hKs : 0 ≤ Ks) (hA : 2 ≤ A) (hC : 0 ≤ C)
    (hD : 0 ≤ D) (hCpD : Cp ≤ D)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          Ks * boundaryBudget Y t (List.finRange N) q)
    (hall_tail_le :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat)
          (t : BinaryTree) (i : Fin N) (xs : List (Fin N)),
        xs ≠ [] →
        IsBST t →
        rootKey t = some q →
        Y i ∈ t.toKeyList →
        Y i < q →
        (∀ j : Fin N, j ∈ xs → Y j ∈ t.toKeyList) →
        (∀ j : Fin N, j ∈ xs → Y j < q) →
        (i :: xs).Sublist (List.finRange N) →
        (Y avoids ![2, 3, 1]) →
        (∀ r : Fin xs.length, Y (xs.get r) ≤ Y i) →
        (t.search_path_len (Y i) : ℝ) +
            ((splay t (Y i)).search_path_len q : ℝ) ≤
          C + A *
            (boundaryBudget Y t (i :: xs) q -
              boundaryBudget Y (splay (splay t (Y i)) q) xs q))
    (hfirst_rise :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat)
          (t : BinaryTree) (i : Fin N) (xs : List (Fin N)),
        xs ≠ [] →
        IsBST t →
        rootKey t = some q →
        Y i ∈ t.toKeyList →
        Y i < q →
        (∀ j : Fin N, j ∈ xs → Y j ∈ t.toKeyList) →
        (∀ j : Fin N, j ∈ xs → Y j < q) →
        (i :: xs).Sublist (List.finRange N) →
        (Y avoids ![2, 3, 1]) →
        ∀ p : Fin xs.length,
          Y i < Y (xs.get p) →
          (∀ r : Fin (xs.take p.val).length,
            Y ((xs.take p.val).get r) ≤ Y i) →
          (∀ r : Fin (xs.drop p.val).length,
            Y i ≤ Y ((xs.drop p.val).get r)) →
          (t.search_path_len (Y i) : ℝ) +
              ((splay t (Y i)).search_path_len q : ℝ) ≤
            C + A *
              (boundaryBudget Y t (i :: xs) q -
                boundaryBudget Y (splay (splay t (Y i)) q) xs q))
    (hpres_lt_pair :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat),
        ∀ (init : BinaryTree) (done : List (Fin N)) (i : Fin N)
            (future : List (Fin N)),
          IsBST init →
          rootKey init = some q →
          (Y avoids ![2, 3, 1]) →
          (∀ j : Fin N, Y j ≤ q) →
          (done ++ i :: future).Sublist (List.finRange N) →
          (∀ j : Fin N, j ∈ done ++ i :: future → Y j ∈ init.toKeyList) →
          Y i ∈ (splayTreeAfter Y init done).toKeyList →
          Y i < q →
          ∀ (actual reset : BinaryTree) (x : Nat),
            resetPairDominatesAbove q (Y i) D actual reset →
            x ∈ actual.toKeyList →
            x < q →
            ∀ y : Nat,
              y ∈ (splay actual x).toKeyList →
              Y i ≤ y →
              y < q →
              ((splay actual x).search_path_len y : ℝ) +
                  ((splay (splay actual x) y).search_path_len q : ℝ) ≤
                ((splay actual x).search_path_len q : ℝ) +
                  ((splay (splay reset x) q).search_path_len y : ℝ) +
                  ((splay (splay (splay reset x) q) y).search_path_len q : ℝ) +
                  Cp)
    (hlow_final :
      ∀ {N : Nat} (Y : Fin N → Nat) (q lo : Nat),
        ∀ (actual reset : BinaryTree) (xs : List (Fin N)),
          resetPairDominatesAbove q lo D actual reset →
          rootKey actual = some q →
          (∀ j : Fin N, j ∈ xs → Y j ∈ actual.toKeyList) →
          (∀ j : Fin N, j ∈ xs → Y j ≤ lo) →
          resetPairDominatesAbove q lo D
            (splay (splayTreeAfter Y actual xs) q)
            (suffixResetTreeAfter Y q reset xs)) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  refine
    traversal_conjecture_of_first_tail_rise_ordered_pair_components
      Ks A C Cp D hKs hA hC hD hCpD hstrict hall_tail_le
      hfirst_rise hpres_lt_pair ?_
  intro N Y q init done i future hbst hroot _havoid hle _hsub
    hmem_prefix _hi_mem _hi_lt left p right hsplit _hp_eq
    _hright_lt hleft_current _hleft_right x hx_mem hlo hx_lt
  have hmem_left :
      ∀ j : Fin N, j ∈ left → Y j ∈ init.toKeyList := by
    intro j hj
    have hj_done : j ∈ done := by
      rw [hsplit]
      simp [hj]
    exact hmem_prefix j (by simp [hj_done])
  have hle_left :
      ∀ j : Fin N, j ∈ left → Y j ≤ q := by
    intro j _hj
    exact hle j
  have hlow_left :
      ∀ j : Fin N, j ∈ left → Y j < q → Y j ≤ Y i := by
    intro j hj hj_lt
    rcases List.mem_iff_getElem.mp hj with ⟨k, hk, hget⟩
    let a : Fin left.length := ⟨k, hk⟩
    have ha := hleft_current a
    simpa [a, hget] using ha (by simpa [a, hget] using hj_lt)
  have hdom :
      resetPairDominatesAbove q (Y i) D
        (splay (splayTreeAfter Y init left) q)
        (suffixResetTreeAfter Y q init left) :=
    resetPairDominatesAbove_ordered_pivot_prefix_of_low_final
      Y q (Y i) D hD
      (fun actual reset xs hdom hroot_actual hmem_xs hle_xs =>
        hlow_final Y q (Y i) actual reset xs hdom hroot_actual
          hmem_xs hle_xs)
      init left hbst hroot hmem_left hle_left hlow_left
  exact
    resetPairDominatesAbove.pair
      (q := q) (lo := Y i) (x := x) (D := D)
      hdom hx_mem hlo hx_lt

