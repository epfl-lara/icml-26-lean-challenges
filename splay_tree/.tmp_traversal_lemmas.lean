private theorem local_pair_slack_two_nat_of_inter_card
    {t : BinaryTree} {q x : Nat}
    (hbst : IsBST t)
    (hxmem : x ∈ t.toKeyList)
    (hqmem : q ∈ t.toKeyList)
    (hinter :
      ((searchPathKeys t x).toFinset ∩
          (searchPathKeys (splay t x) q).toFinset).card ≤
        ((searchPathKeys t q).toFinset ∩
            (searchPathKeys (splay t q) x).toFinset).card +
          (searchPathKeys (splay (splay t q) x) q).toFinset.card + 2) :
    t.search_path_len x + (splay t x).search_path_len q ≤
      t.search_path_len q + (splay t q).search_path_len x +
        (splay (splay t q) x).search_path_len q + 2 := by
  let A := searchPathKeys t x
  let B := searchPathKeys (splay t x) q
  let C := searchPathKeys t q
  let D := searchPathKeys (splay t q) x
  let E := searchPathKeys (splay (splay t q) x) q
  have hA : A.Nodup := by
    unfold A
    exact searchPathKeys_nodup_of_isBST t x hbst
  have hB : B.Nodup := by
    unfold B
    exact searchPathKeys_nodup_of_isBST (splay t x) q
      (splay_isBST t x hbst)
  have hC : C.Nodup := by
    unfold C
    exact searchPathKeys_nodup_of_isBST t q hbst
  have hD : D.Nodup := by
    unfold D
    exact searchPathKeys_nodup_of_isBST (splay t q) x
      (splay_isBST t q hbst)
  have hE : E.Nodup := by
    unfold E
    exact searchPathKeys_nodup_of_isBST
      (splay (splay t q) x) q
      (splay_isBST (splay t q) x (splay_isBST t q hbst))
  have hsubA : A.toFinset ⊆ C.toFinset ∪ D.toFinset := by
    intro key hkey
    have hkeyA : key ∈ searchPathKeys t x := by
      simpa [A] using hkey
    rw [Finset.mem_union]
    rcases searchPathKeys_old_subset_union_splay t q x key
        hbst hqmem hxmem hkeyA with hCkey | hDkey
    · left
      simpa [C] using hCkey
    · right
      simpa [D] using hDkey
  have hsubB : B.toFinset ⊆ C.toFinset ∪ D.toFinset := by
    intro key hkey
    have hkeyB : key ∈ searchPathKeys (splay t x) q := by
      simpa [B] using hkey
    rw [Finset.mem_union]
    rcases searchPathKeys_after_splay_subset_boundary_splay
        (t := t) (x := x) (q := q) (key := key)
        hbst hxmem hqmem hkeyB with hCkey | hDkey
    · left
      simpa [C] using hCkey
    · right
      simpa [D] using hDkey
  have hlen :
      A.length + B.length ≤ C.length + D.length + E.length + 2 := by
    exact
      list_pair_length_le_of_union_inter_card
        hA hB hC hD hE hsubA hsubB
        (by simpa [A, B, C, D, E] using hinter)
  unfold A B C D E at hlen
  rw [searchPathKeys_length_eq_search_path_len,
    searchPathKeys_length_eq_search_path_len,
    searchPathKeys_length_eq_search_path_len,
      searchPathKeys_length_eq_search_path_len,
      searchPathKeys_length_eq_search_path_len] at hlen
  exact hlen

private theorem reset_pair_slack_two_of_pathKey_union_inter_budget
    {actual reset : BinaryTree} {q x : Nat}
    (hbst_actual : IsBST actual)
    (hbst_reset : IsBST reset)
    (hbudget :
      ((searchPathKeys actual x).toFinset ∪
          (searchPathKeys (splay actual x) q).toFinset).card +
        ((searchPathKeys actual x).toFinset ∩
          (searchPathKeys (splay actual x) q).toFinset).card ≤
          (searchPathKeys actual q).toFinset.card +
            (searchPathKeys reset x).toFinset.card +
            (searchPathKeys (splay reset x) q).toFinset.card + 2) :
    (actual.search_path_len x : ℝ) +
        ((splay actual x).search_path_len q : ℝ) ≤
      (actual.search_path_len q : ℝ) +
        (reset.search_path_len x : ℝ) +
        ((splay reset x).search_path_len q : ℝ) + 2 := by
  let A := searchPathKeys actual x
  let B := searchPathKeys (splay actual x) q
  let C := searchPathKeys actual q
  let D := searchPathKeys reset x
  let E := searchPathKeys (splay reset x) q
  have hA : A.Nodup := by
    unfold A
    exact searchPathKeys_nodup_of_isBST actual x hbst_actual
  have hB : B.Nodup := by
    unfold B
    exact searchPathKeys_nodup_of_isBST (splay actual x) q
      (splay_isBST actual x hbst_actual)
  have hC : C.Nodup := by
    unfold C
    exact searchPathKeys_nodup_of_isBST actual q hbst_actual
  have hD : D.Nodup := by
    unfold D
    exact searchPathKeys_nodup_of_isBST reset x hbst_reset
  have hE : E.Nodup := by
    unfold E
    exact searchPathKeys_nodup_of_isBST (splay reset x) q
      (splay_isBST reset x hbst_reset)
  have hAcard : A.toFinset.card = A.length :=
    List.toFinset_card_of_nodup hA
  have hBcard : B.toFinset.card = B.length :=
    List.toFinset_card_of_nodup hB
  have hCcard : C.toFinset.card = C.length :=
    List.toFinset_card_of_nodup hC
  have hDcard : D.toFinset.card = D.length :=
    List.toFinset_card_of_nodup hD
  have hEcard : E.toFinset.card = E.length :=
    List.toFinset_card_of_nodup hE
  have hAB :=
    Finset.card_union_add_card_inter A.toFinset B.toFinset
  have hbudget' :
      (A.toFinset ∪ B.toFinset).card +
          (A.toFinset ∩ B.toFinset).card ≤
        C.toFinset.card + D.toFinset.card + E.toFinset.card + 2 := by
    simpa [A, B, C, D, E] using hbudget
  have hlen :
      A.length + B.length ≤ C.length + D.length + E.length + 2 := by
    omega
  unfold A B C D E at hlen
  rw [searchPathKeys_length_eq_search_path_len,
    searchPathKeys_length_eq_search_path_len,
    searchPathKeys_length_eq_search_path_len,
    searchPathKeys_length_eq_search_path_len,
    searchPathKeys_length_eq_search_path_len] at hlen
  have hreal :
      (actual.search_path_len x : ℝ) +
          ((splay actual x).search_path_len q : ℝ) ≤
        (actual.search_path_len q : ℝ) +
          (reset.search_path_len x : ℝ) +
          ((splay reset x).search_path_len q : ℝ) + 2 := by
    exact_mod_cast hlen
  simpa [add_assoc] using hreal

private theorem local_pair_inter_card_bound_of_rootKey
