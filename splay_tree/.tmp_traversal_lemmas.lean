private theorem head_le_tail_after_tail_rise_of_avoids231 {n : Nat}
    {Y : Fin n → Nat} {i : Fin n} {xs : List (Fin n)}
    (hsub : (i :: xs).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    {p q : Fin xs.length} (hpq : p < q)
    (hrise : Y i < Y (xs.get p)) :
    Y i ≤ Y (xs.get q) := by
  let ys : List (Fin n) := i :: xs
  let i0 : Fin ys.length := ⟨0, by simp [ys]⟩
  let p' : Fin ys.length := ⟨p.val + 1, by
    simp [ys]⟩
  let q' : Fin ys.length := ⟨q.val + 1, by
    simp [ys]⟩
  have hi0p : i0 < p' := by
    change 0 < p.val + 1
    omega
  have hpq' : p' < q' := by
    change p.val + 1 < q.val + 1
    omega
  have hrise' : listSeq Y ys i0 < listSeq Y ys p' := by
    simpa [listSeq, ys, i0, p'] using hrise
  have hle :=
    listSeq_left_le_right_of_left_lt_mid
      (Y := Y) (xs := ys) hsub havoid hi0p hpq' hrise'
  simpa [listSeq, ys, i0, q'] using hle

private theorem tail_before_first_rise_le_head {n : Nat}
    {Y : Fin n → Nat} {i : Fin n} {xs : List (Fin n)}
