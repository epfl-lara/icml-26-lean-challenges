      have hj_mem : Y j ∈ t.toKeyList := hmem j (by simp [hj])
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hj_mem
    have hlt_tail :
        ∀ j : Fin n, j ∈ xs → Y j < q := by
      intro j hj
      exact hlt j (by simp [hj])
    have ih :=
      pivotResetPairPathSum_le_two_lowerPathSum_of_lt Y q xs tr
        hbst_tr hroot_tr hmem_tail hlt_tail
    simp [pivotResetPairPathSum, pivotResetLowerPathSum]
    nlinarith

private theorem pivotResetPairPathSum_right_le_two_lowerPathSum {n : Nat}
    (Y : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t →
      rootKey t = some q →
      (∀ i : Fin n, i ∈ xs → Y i ∈ (rightSubtree t).toKeyList) →
      pivotResetPairPathSum Y q t xs ≤
        2 * pivotResetLowerPathSum Y q t xs
| [], t, _hbst, _hroot, _hmem_right => by
    simp [pivotResetPairPathSum, pivotResetLowerPathSum]
| i :: xs, t, hbst, hroot, hmem_right => by
    let tr := splay (splay t (Y i)) q
    have hi_right : Y i ∈ (rightSubtree t).toKeyList :=
      hmem_right i (by simp)
    have hpair :
        (t.search_path_len (Y i) : ℝ) +
            ((splay t (Y i)).search_path_len q : ℝ) ≤
          2 * (t.search_path_len (Y i) : ℝ) := by
      exact_mod_cast
        rooted_pivot_access_reset_pair_path_right_le hbst hroot hi_right
    have hbst_tr : IsBST tr := by
      unfold tr
      exact splay_isBST (splay t (Y i)) q (splay_isBST t (Y i) hbst)
    have hroot_tr : rootKey tr = some q := by
      unfold tr
      exact rootKey_after_pivot_reset_of_root hbst hroot
    have hmem_tail :
        ∀ j : Fin n, j ∈ xs → Y j ∈ (rightSubtree tr).toKeyList := by
      intro j hj
      have hj_right : Y j ∈ (rightSubtree t).toKeyList :=
        hmem_right j (by simp [hj])
      have hj_mem_t : Y j ∈ t.toKeyList :=
        mem_toKeyList_of_mem_rightSubtree hj_right
      have hj_gt : q < Y j :=
        rooted_rightSubtree_mem_gt hbst hroot hj_right
      unfold tr
      exact mem_rightSubtree_after_pivot_reset_of_gt
        hbst hroot hj_mem_t hj_gt
    have ih :=
      pivotResetPairPathSum_right_le_two_lowerPathSum Y q xs tr
        hbst_tr hroot_tr hmem_tail
    simp [pivotResetPairPathSum, pivotResetLowerPathSum]
    nlinarith

private theorem pivotResetLowerPathSum_le_num_nodes_mul_length {n : Nat}
    (Y : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      pivotResetLowerPathSum Y q t xs ≤ (t.num_nodes : ℝ) * xs.length
| [], t => by
    simp [pivotResetLowerPathSum]
| i :: xs, t => by
    let tr := splay (splay t (Y i)) q
    have hstep_nat := search_path_len_le_num_nodes t (Y i)
    have hstep : (t.search_path_len (Y i) : ℝ) ≤ t.num_nodes := by
      exact_mod_cast hstep_nat
    have ih := pivotResetLowerPathSum_le_num_nodes_mul_length Y q xs tr
    have hnodes : tr.num_nodes = t.num_nodes := by
      unfold tr
      rw [splay_num_nodes, splay_num_nodes]
    rw [hnodes] at ih
    simp [pivotResetLowerPathSum]
    nlinarith

private theorem pivotResetPairPathSum_le_two_num_nodes_mul_length {n : Nat}
    (Y : Fin n → Nat) (q : Nat) (xs : List (Fin n)) (t : BinaryTree)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem_left : ∀ i : Fin n, i ∈ xs → Y i ∈ (leftSubtree t).toKeyList) :
    pivotResetPairPathSum Y q t xs ≤
      2 * ((t.num_nodes : ℝ) * xs.length) := by
  have hpair :=
    pivotResetPairPathSum_le_two_lowerPathSum Y q xs t
      hbst hroot hmem_left
  have hlower := pivotResetLowerPathSum_le_num_nodes_mul_length Y q xs t
  nlinarith

private theorem pivotResetPairPathSum_le_two_num_nodes_mul_length_of_lt
    {n : Nat}
    (Y : Fin n → Nat) (q : Nat) (xs : List (Fin n)) (t : BinaryTree)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem : ∀ i : Fin n, i ∈ xs → Y i ∈ t.toKeyList)
    (hlt : ∀ i : Fin n, i ∈ xs → Y i < q) :
    pivotResetPairPathSum Y q t xs ≤
      2 * ((t.num_nodes : ℝ) * xs.length) := by
  have hpair :=
    pivotResetPairPathSum_le_two_lowerPathSum_of_lt Y q xs t
      hbst hroot hmem hlt
  have hlower := pivotResetLowerPathSum_le_num_nodes_mul_length Y q xs t
  nlinarith

private theorem pivotResetPairPathSum_right_le_two_num_nodes_mul_length
    {n : Nat}
    (Y : Fin n → Nat) (q : Nat) (xs : List (Fin n)) (t : BinaryTree)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem_right :
      ∀ i : Fin n, i ∈ xs → Y i ∈ (rightSubtree t).toKeyList) :
    pivotResetPairPathSum Y q t xs ≤
      2 * ((t.num_nodes : ℝ) * xs.length) := by
  have hpair :=
    pivotResetPairPathSum_right_le_two_lowerPathSum Y q xs t
      hbst hroot hmem_right
  have hlower := pivotResetLowerPathSum_le_num_nodes_mul_length Y q xs t
  nlinarith

private theorem pivotResetTreeAfter_isBST {n : Nat}
    (Y : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t → IsBST (pivotResetTreeAfter Y q t xs)
| [], t, hbst => by
    simpa [pivotResetTreeAfter] using hbst
| i :: xs, t, hbst => by
    simp [pivotResetTreeAfter]
    exact pivotResetTreeAfter_isBST Y q xs
      (splay (splay t (Y i)) q)
      (splay_isBST (splay t (Y i)) q (splay_isBST t (Y i) hbst))

private theorem pivotResetTreeAfter_rootKey {n : Nat}
    (Y : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t →
      rootKey t = some q →
      rootKey (pivotResetTreeAfter Y q t xs) = some q
| [], t, _hbst, hroot => by
    simpa [pivotResetTreeAfter] using hroot
| i :: xs, t, hbst, hroot => by
    let tr := splay (splay t (Y i)) q
    have hbst_tr : IsBST tr := by
      unfold tr
      exact splay_isBST (splay t (Y i)) q (splay_isBST t (Y i) hbst)
    have hroot_tr : rootKey tr = some q := by
      unfold tr
      exact rootKey_after_pivot_reset_of_root hbst hroot
    simpa [pivotResetTreeAfter, tr] using
      pivotResetTreeAfter_rootKey Y q xs tr hbst_tr hroot_tr

private theorem pivotResetTreeAfter_toKeyList {n : Nat}
    (Y : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      (pivotResetTreeAfter Y q t xs).toKeyList = t.toKeyList
| [], t => by
    simp [pivotResetTreeAfter]
| i :: xs, t => by
    simp [pivotResetTreeAfter,
      pivotResetTreeAfter_toKeyList Y q xs (splay (splay t (Y i)) q),
      splay_toKeyList]

private theorem pivotResetTreeAfter_mem_leftSubtree_of_lt {n : Nat}
    (Y : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (y : Nat),
      IsBST t →
      rootKey t = some q →
      y ∈ t.toKeyList →
      y < q →
      y ∈ (leftSubtree (pivotResetTreeAfter Y q t xs)).toKeyList
| [], t, y, hbst, hroot, hymem, hylt => by
    simpa [pivotResetTreeAfter] using
      mem_leftSubtree_of_root_lt_isBST hbst hroot hymem hylt
| i :: xs, t, y, hbst, hroot, hymem, hylt => by
    let tr := splay (splay t (Y i)) q
    have hbst_tr : IsBST tr := by
      unfold tr
      exact splay_isBST (splay t (Y i)) q (splay_isBST t (Y i) hbst)
    have hroot_tr : rootKey tr = some q := by
      unfold tr
      exact rootKey_after_pivot_reset_of_root hbst hroot
    have hymem_tr : y ∈ tr.toKeyList := by
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hymem
    simpa [pivotResetTreeAfter, tr] using
      pivotResetTreeAfter_mem_leftSubtree_of_lt
        Y q xs tr y hbst_tr hroot_tr hymem_tr hylt

private theorem pivotResetTreeAfter_mem_rightSubtree_of_gt {n : Nat}
    (Y : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (y : Nat),
      IsBST t →
      rootKey t = some q →
      y ∈ t.toKeyList →
      q < y →
      y ∈ (rightSubtree (pivotResetTreeAfter Y q t xs)).toKeyList
| [], t, y, hbst, hroot, hymem, hygt => by
    simpa [pivotResetTreeAfter] using
      mem_rightSubtree_of_root_gt_isBST hbst hroot hymem hygt
| i :: xs, t, y, hbst, hroot, hymem, hygt => by
    let tr := splay (splay t (Y i)) q
    have hbst_tr : IsBST tr := by
      unfold tr
      exact splay_isBST (splay t (Y i)) q (splay_isBST t (Y i) hbst)
    have hroot_tr : rootKey tr = some q := by
      unfold tr
      exact rootKey_after_pivot_reset_of_root hbst hroot
    have hymem_tr : y ∈ tr.toKeyList := by
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hymem
    simpa [pivotResetTreeAfter, tr] using
      pivotResetTreeAfter_mem_rightSubtree_of_gt
        Y q xs tr y hbst_tr hroot_tr hymem_tr hygt

private theorem splayPathSum_const_of_root {n : Nat}
    (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (q : Nat),
      rootKey t = some q →
      (∀ i : Fin n, i ∈ xs → X i = q) →
      splayPathSum X t xs = xs.length
| [], t, q, _hroot, _hconst => by
    simp [splayPathSum]
| i :: xs, t, q, hroot, hconst => by
    have hxi : X i = q := hconst i (by simp)
    have htail : ∀ j : Fin n, j ∈ xs → X j = q := by
      intro j hj
      exact hconst j (by simp [hj])
    have hpath := search_path_len_eq_one_of_rootKey_eq_some hroot
    have hsplay := splay_eq_self_of_rootKey_eq_some hroot
    simp [splayPathSum, hxi, hpath, hsplay,
      splayPathSum_const_of_root X xs t q hroot htail]
    ring

private theorem splayPathSum_const_le_num_nodes_add_length {n : Nat}
    (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (q : Nat),
      IsBST t → q ∈ t.toKeyList →
      (∀ i : Fin n, i ∈ xs → X i = q) →
      splayPathSum X t xs ≤ (t.num_nodes : ℝ) + xs.length
| [], t, q, _hbst, _hmem, _hconst => by
    simp [splayPathSum]
| i :: xs, t, q, hbst, hmem, hconst => by
    have hxi : X i = q := hconst i (by simp)
    have htail : ∀ j : Fin n, j ∈ xs → X j = q := by
      intro j hj
      exact hconst j (by simp [hj])
    have hroot := splay_rootKey_eq_some_of_mem_isBST t q hbst hmem
    have htail_sum :
        splayPathSum X (splay t q) xs = xs.length :=
      splayPathSum_const_of_root X xs (splay t q) q hroot htail
    have hstep_nat := search_path_len_le_num_nodes t q
    have hstep : (t.search_path_len q : ℝ) ≤ t.num_nodes := by
      exact_mod_cast hstep_nat
    simp [splayPathSum, hxi, htail_sum]
    nlinarith [show 0 ≤ (xs.length : ℝ) by positivity]

private def searchPathKeys : BinaryTree → Nat → List Nat
| .empty, _q => []
| .node l k r, q =>
    k :: if q < k then searchPathKeys l q
      else if k < q then searchPathKeys r q
      else []

private theorem searchPathKeys_length_eq_search_path_len :
    ∀ (t : BinaryTree) (q : Nat),
      (searchPathKeys t q).length = t.search_path_len q
| .empty, q => by
    simp [searchPathKeys, BinaryTree.search_path_len]
| .node l k r, q => by
    simp only [searchPathKeys, BinaryTree.search_path_len]
    by_cases hqk : q < k
    · simp [hqk, searchPathKeys_length_eq_search_path_len l q]
      omega
    · by_cases hkq : k < q
      · simp [hqk, hkq, searchPathKeys_length_eq_search_path_len r q]
        omega
      · simp [hqk, hkq]

private theorem searchPathKeys_subset_toKeyList :
    ∀ (t : BinaryTree) (q key : Nat),
      key ∈ searchPathKeys t q → key ∈ t.toKeyList
| .empty, q, key, hmem => by
    simp [searchPathKeys] at hmem
| .node l k r, q, key, hmem => by
    simp only [searchPathKeys] at hmem
    by_cases hqk : q < k
    · simp [hqk] at hmem
      rcases hmem with hkey | hmem
      · subst key
        simp [BinaryTree.toKeyList]
      · have hsub := searchPathKeys_subset_toKeyList l q key hmem
        simp [BinaryTree.toKeyList, hsub]
    · by_cases hkq : k < q
      · simp [hqk, hkq] at hmem
        rcases hmem with hkey | hmem
        · subst key
          simp [BinaryTree.toKeyList]
        · have hsub := searchPathKeys_subset_toKeyList r q key hmem
          simp [BinaryTree.toKeyList, hsub]
      · simp [hqk, hkq] at hmem
        subst key
        simp [BinaryTree.toKeyList]

private theorem searchPathKeys_key_le_root_of_target_le_root :
    ∀ (t : BinaryTree) {root y key : Nat},
      IsBST t → rootKey t = some root → y ≤ root →
      key ∈ searchPathKeys t y → key ≤ root
| .empty, root, y, key, _hbst, hroot, _hyle, hkey => by
    simp [rootKey] at hroot
| .node l k r, root, y, key, hbst, hroot, hyle, hkey => by
    cases hbst with
    | node _ _ _ hleft _hright hbst_left _hbst_right =>
        simp [rootKey] at hroot
        subst root
        simp only [searchPathKeys] at hkey
        by_cases hyk : y < k
        · simp [hyk] at hkey
          rcases hkey with hkey_eq | hkey_path
          · subst key
            omega
          · have hkey_mem_l :
                key ∈ l.toKeyList :=
              searchPathKeys_subset_toKeyList l y key hkey_path
            have hkey_lt_k :
                key < k :=
              (forallTree_iff_forall_mem.mp hleft) key hkey_mem_l
            omega
        · by_cases hky : k < y
          · omega
          · simp [hyk, hky] at hkey
            subst key
            omega

private theorem root_le_searchPathKeys_key_of_root_le_target :
    ∀ (t : BinaryTree) {root y key : Nat},
      IsBST t → rootKey t = some root → root ≤ y →
      key ∈ searchPathKeys t y → root ≤ key
| .empty, root, y, key, _hbst, hroot, _hley, hkey => by
    simp [rootKey] at hroot
| .node l k r, root, y, key, hbst, hroot, hley, hkey => by
    cases hbst with
    | node _ _ _ _hleft hright _hbst_left hbst_right =>
        simp [rootKey] at hroot
        subst root
        simp only [searchPathKeys] at hkey
        by_cases hyk : y < k
        · omega
        · by_cases hky : k < y
          · simp [hyk, hky] at hkey
            rcases hkey with hkey_eq | hkey_path
            · subst key
              omega
            · have hkey_mem_r :
                  key ∈ r.toKeyList :=
                searchPathKeys_subset_toKeyList r y key hkey_path
              have hk_lt_key :
                  k < key :=
                (forallTree_iff_forall_mem.mp hright) key hkey_mem_r
              omega
          · simp [hyk, hky] at hkey
            subst key
            omega

private theorem searchPathKeys_bstInsert_eq_of_mem (x q : Nat) :
    ∀ (t : BinaryTree),
      IsBST t →
      q ∈ t.toKeyList →
      searchPathKeys (bstInsert x t) q = searchPathKeys t q
| .empty, _hbst, hmem => by
    simp [BinaryTree.toKeyList] at hmem
| .node l k r, hbst, hmem => by
    cases hbst with
    | node _ _ _ hleft hright hbst_left hbst_right =>
        by_cases hxk : x = k
        · simp [bstInsert, hxk]
        · by_cases hxlt : x < k
          · by_cases hqk : q < k
            · have hqmem_l :
                  q ∈ l.toKeyList :=
                isBST_node_mem_left_of_lt_root
                  (IsBST.node k l r hleft hright hbst_left hbst_right)
                  hmem hqk
              have ih :=
                searchPathKeys_bstInsert_eq_of_mem x q l
                  hbst_left hqmem_l
              simp [bstInsert, hxk, hxlt, searchPathKeys, hqk, ih]
            · by_cases hkq : k < q
              · have hqmem_r :
                    q ∈ r.toKeyList :=
                  isBST_node_mem_right_of_gt_root
                    (IsBST.node k l r hleft hright hbst_left hbst_right)
                    hmem hkq
                simp [bstInsert, hxk, hxlt, searchPathKeys, hqk, hkq]
              · simp [bstInsert, hxk, hxlt, searchPathKeys, hqk, hkq]
          · by_cases hqk : q < k
            · have hqmem_l :
                  q ∈ l.toKeyList :=
                isBST_node_mem_left_of_lt_root
                  (IsBST.node k l r hleft hright hbst_left hbst_right)
                  hmem hqk
              simp [bstInsert, hxk, hxlt, searchPathKeys, hqk]
            · by_cases hkq : k < q
              · have hqmem_r :
                    q ∈ r.toKeyList :=
                  isBST_node_mem_right_of_gt_root
                    (IsBST.node k l r hleft hright hbst_left hbst_right)
                    hmem hkq
                have ih :=
                  searchPathKeys_bstInsert_eq_of_mem x q r
                    hbst_right hqmem_r
                simp [bstInsert, hxk, hxlt, searchPathKeys, hqk, hkq, ih]
              · simp [bstInsert, hxk, hxlt, searchPathKeys, hqk, hkq]

private theorem searchPathKeys_foldl_bstInsert_eq_of_mem {n : Nat}
    (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (q : Nat),
      IsBST t →
      q ∈ t.toKeyList →
      searchPathKeys (xs.foldl (fun t i => bstInsert (X i) t) t) q =
        searchPathKeys t q
| [], t, q, _hbst, _hmem => by
    simp
| i :: xs, t, q, hbst, hmem => by
    have hbst_ins : IsBST (bstInsert (X i) t) :=
      bstInsert_isBST (X i) t hbst
    have hmem_ins : q ∈ (bstInsert (X i) t).toKeyList := by
      rw [mem_bstInsert_iff]
      exact Or.inr hmem
    change
      searchPathKeys
          (xs.foldl (fun t i => bstInsert (X i) t)
            (bstInsert (X i) t)) q =
        searchPathKeys t q
    rw [searchPathKeys_foldl_bstInsert_eq_of_mem X xs
      (bstInsert (X i) t) q hbst_ins hmem_ins]
    exact searchPathKeys_bstInsert_eq_of_mem (X i) q t hbst hmem

private theorem searchPathKeys_rotateRight_subset_of_mem_left
    {l r : BinaryTree} {k x y key : Nat}
    (hbst : IsBST (BinaryTree.node l k r))
    (hxmem : x ∈ l.toKeyList)
    (hkey : key ∈ searchPathKeys (rotateRight (BinaryTree.node l k r)) y) :
    key ∈ searchPathKeys (BinaryTree.node l k r) x ∨
      key ∈ searchPathKeys (BinaryTree.node l k r) y := by
  cases l with
  | empty =>
      simp [BinaryTree.toKeyList] at hxmem
  | node ll lk lr =>
      cases hbst with
      | node _ _ _ hleft _hright hbst_left _hbst_right =>
          cases hbst_left with
          | node _ _ _ hll_left hlr_right _hbst_ll _hbst_lr =>
              have hx_lt_k : x < k :=
                (forallTree_iff_forall_mem.mp hleft) x
                  (by simpa [BinaryTree.toKeyList] using hxmem)
              have hlk_lt_k : lk < k :=
                (forallTree_iff_forall_mem.mp hleft) lk
                  (by simp [BinaryTree.toKeyList])
              simp only [BinaryTree.toKeyList, List.mem_append,
                List.mem_singleton] at hxmem
              rcases hxmem with (hx_ll | hx_lk) | hx_lr
              · have hx_lt_lk :=
                  (forallTree_iff_forall_mem.mp hll_left) x hx_ll
                by_cases hy_lt_lk : y < lk
                · have hy_lt_k : y < k := by omega
                  simp [rotateRight, searchPathKeys, hx_lt_k, hx_lt_lk,
                    hy_lt_lk, hy_lt_k] at hkey ⊢
                  tauto
                · by_cases hlk_lt_y : lk < y
                  · by_cases hy_lt_k : y < k
                    · simp [rotateRight, searchPathKeys, hx_lt_k, hx_lt_lk,
                        hy_lt_lk, hlk_lt_y, hy_lt_k] at hkey ⊢
                      tauto
                    · by_cases hk_lt_y : k < y
                      · simp [rotateRight, searchPathKeys, hx_lt_k, hx_lt_lk,
                          hy_lt_lk, hlk_lt_y, hy_lt_k, hk_lt_y] at hkey ⊢
                        tauto
                      · simp [rotateRight, searchPathKeys, hx_lt_k, hx_lt_lk,
                          hy_lt_lk, hlk_lt_y, hy_lt_k, hk_lt_y] at hkey ⊢
                        tauto
                  · simp [rotateRight, searchPathKeys, hx_lt_k, hx_lt_lk,
                      hy_lt_lk, hlk_lt_y] at hkey ⊢
                    tauto
              · subst x
                by_cases hy_lt_lk : y < lk
                · have hy_lt_k : y < k := by omega
                  simp [rotateRight, searchPathKeys, hlk_lt_k,
                    hy_lt_lk, hy_lt_k] at hkey ⊢
                  tauto
                · by_cases hlk_lt_y : lk < y
                  · by_cases hy_lt_k : y < k
                    · simp [rotateRight, searchPathKeys, hlk_lt_k,
                        hy_lt_lk, hlk_lt_y, hy_lt_k] at hkey ⊢
                      tauto
                    · by_cases hk_lt_y : k < y
                      · simp [rotateRight, searchPathKeys, hlk_lt_k,
                          hy_lt_lk, hlk_lt_y, hy_lt_k, hk_lt_y] at hkey ⊢
                        tauto
                      · simp [rotateRight, searchPathKeys, hlk_lt_k,
                          hy_lt_lk, hlk_lt_y, hy_lt_k, hk_lt_y] at hkey ⊢
                        tauto
                  · simp [rotateRight, searchPathKeys, hlk_lt_k,
                      hy_lt_lk, hlk_lt_y] at hkey ⊢
                    tauto
              · have hlk_lt_x :=
                  (forallTree_iff_forall_mem.mp hlr_right) x hx_lr
                have hnot_x_lt_lk : ¬ x < lk := by omega
                by_cases hy_lt_lk : y < lk
                · have hy_lt_k : y < k := by omega
                  simp [rotateRight, searchPathKeys, hx_lt_k, hnot_x_lt_lk,
                    hlk_lt_x, hy_lt_lk, hy_lt_k] at hkey ⊢
                  tauto
                · by_cases hlk_lt_y : lk < y
                  · by_cases hy_lt_k : y < k
                    · simp [rotateRight, searchPathKeys, hx_lt_k,
                        hnot_x_lt_lk, hlk_lt_x, hy_lt_lk, hlk_lt_y,
                        hy_lt_k] at hkey ⊢
                      tauto
                    · by_cases hk_lt_y : k < y
                      · simp [rotateRight, searchPathKeys, hx_lt_k,
                          hnot_x_lt_lk, hlk_lt_x, hy_lt_lk, hlk_lt_y,
                          hy_lt_k, hk_lt_y] at hkey ⊢
                        tauto
                      · simp [rotateRight, searchPathKeys, hx_lt_k,
                          hnot_x_lt_lk, hlk_lt_x, hy_lt_lk, hlk_lt_y,
                          hy_lt_k, hk_lt_y] at hkey ⊢
                        tauto
                  · simp [rotateRight, searchPathKeys, hx_lt_k,
                      hnot_x_lt_lk, hlk_lt_x, hy_lt_lk, hlk_lt_y] at hkey ⊢
                    tauto

private theorem searchPathKeys_rotateLeft_subset_of_mem_right
    {l r : BinaryTree} {k x y key : Nat}
    (hbst : IsBST (BinaryTree.node l k r))
    (hxmem : x ∈ r.toKeyList)
    (hkey : key ∈ searchPathKeys (rotateLeft (BinaryTree.node l k r)) y) :
    key ∈ searchPathKeys (BinaryTree.node l k r) x ∨
      key ∈ searchPathKeys (BinaryTree.node l k r) y := by
  cases r with
  | empty =>
      simp [BinaryTree.toKeyList] at hxmem
  | node rl rk rr =>
      cases hbst with
      | node _ _ _ _hleft hright _hbst_left hbst_right =>
          cases hbst_right with
          | node _ _ _ hrl_left hrr_right _hbst_rl _hbst_rr =>
              have hk_lt_x : k < x :=
                (forallTree_iff_forall_mem.mp hright) x
                  (by simpa [BinaryTree.toKeyList] using hxmem)
              have hk_lt_rk : k < rk :=
                (forallTree_iff_forall_mem.mp hright) rk
                  (by simp [BinaryTree.toKeyList])
              simp only [BinaryTree.toKeyList, List.mem_append,
                List.mem_singleton] at hxmem
              rcases hxmem with (hx_rl | hx_rk) | hx_rr
              · have hx_lt_rk :=
                  (forallTree_iff_forall_mem.mp hrl_left) x hx_rl
                have hnot_x_lt_k : ¬ x < k := by omega
                by_cases hy_lt_rk : y < rk
                · by_cases hy_lt_k : y < k
                  · simp [rotateLeft, searchPathKeys, hnot_x_lt_k, hk_lt_x,
                      hx_lt_rk, hy_lt_rk, hy_lt_k] at hkey ⊢
                    tauto
                  · by_cases hk_lt_y : k < y
                    · simp [rotateLeft, searchPathKeys, hnot_x_lt_k, hk_lt_x,
                        hx_lt_rk, hy_lt_rk, hy_lt_k, hk_lt_y] at hkey ⊢
                      tauto
                    · simp [rotateLeft, searchPathKeys, hnot_x_lt_k, hk_lt_x,
                        hx_lt_rk, hy_lt_rk, hy_lt_k, hk_lt_y] at hkey ⊢
                      tauto
                · by_cases hrk_lt_y : rk < y
                  · have hk_lt_y : k < y := by omega
                    have hnot_y_lt_k : ¬ y < k := by omega
                    simp [rotateLeft, searchPathKeys, hnot_x_lt_k, hk_lt_x,
                      hx_lt_rk, hy_lt_rk, hrk_lt_y, hk_lt_y,
                      hnot_y_lt_k] at hkey ⊢
                    tauto
                  · simp [rotateLeft, searchPathKeys, hnot_x_lt_k, hk_lt_x,
                      hx_lt_rk, hy_lt_rk, hrk_lt_y] at hkey ⊢
                    tauto
              · subst x
                have hnot_rk_lt_k : ¬ rk < k := by omega
                by_cases hy_lt_rk : y < rk
                · by_cases hy_lt_k : y < k
                  · simp [rotateLeft, searchPathKeys, hnot_rk_lt_k,
                      hk_lt_rk, hy_lt_rk, hy_lt_k] at hkey ⊢
                    tauto
                  · by_cases hk_lt_y : k < y
                    · simp [rotateLeft, searchPathKeys, hnot_rk_lt_k,
                        hk_lt_rk, hy_lt_rk, hy_lt_k, hk_lt_y] at hkey ⊢
                      tauto
                    · simp [rotateLeft, searchPathKeys, hnot_rk_lt_k,
                        hk_lt_rk, hy_lt_rk, hy_lt_k, hk_lt_y] at hkey ⊢
                      tauto
                · by_cases hrk_lt_y : rk < y
                  · have hk_lt_y : k < y := by omega
                    have hnot_y_lt_k : ¬ y < k := by omega
                    simp [rotateLeft, searchPathKeys, hnot_rk_lt_k,
                      hk_lt_rk, hy_lt_rk, hrk_lt_y, hk_lt_y,
                      hnot_y_lt_k] at hkey ⊢
                    tauto
                  · simp [rotateLeft, searchPathKeys, hnot_rk_lt_k,
                      hk_lt_rk, hy_lt_rk, hrk_lt_y] at hkey ⊢
                    tauto
              · have hrk_lt_x :=
                  (forallTree_iff_forall_mem.mp hrr_right) x hx_rr
                have hnot_x_lt_k : ¬ x < k := by omega
                have hnot_x_lt_rk : ¬ x < rk := by omega
                by_cases hy_lt_rk : y < rk
                · by_cases hy_lt_k : y < k
                  · simp [rotateLeft, searchPathKeys, hnot_x_lt_k,
                      hnot_x_lt_rk, hrk_lt_x, hy_lt_rk, hy_lt_k] at hkey ⊢
                    tauto
                  · by_cases hk_lt_y : k < y
                    · simp [rotateLeft, searchPathKeys, hnot_x_lt_k,
                        hnot_x_lt_rk, hrk_lt_x, hy_lt_rk, hy_lt_k,
                        hk_lt_y] at hkey ⊢
                      tauto
                    · simp [rotateLeft, searchPathKeys, hnot_x_lt_k,
                        hnot_x_lt_rk, hrk_lt_x, hy_lt_rk, hy_lt_k,
                        hk_lt_y] at hkey ⊢
                      tauto
                · by_cases hrk_lt_y : rk < y
                  · have hk_lt_y : k < y := by omega
                    have hnot_y_lt_k : ¬ y < k := by omega
                    simp [rotateLeft, searchPathKeys, hnot_x_lt_k,
                      hnot_x_lt_rk, hrk_lt_x, hy_lt_rk, hrk_lt_y,
                      hk_lt_y, hnot_y_lt_k] at hkey ⊢
                    tauto
                  · simp [rotateLeft, searchPathKeys, hnot_x_lt_k,
                      hnot_x_lt_rk, hrk_lt_x, hy_lt_rk, hrk_lt_y] at hkey ⊢
                    tauto

private theorem searchPathKeys_rotate_zig_subset_of_mem_left
    {l r : BinaryTree} {k x y key : Nat}
    (hbst : IsBST (BinaryTree.node l k r))
    (hxmem : x ∈ l.toKeyList)
    (hkey : key ∈ searchPathKeys (rotate (BinaryTree.node l k r) .zig) y) :
    key ∈ searchPathKeys (BinaryTree.node l k r) x ∨
      key ∈ searchPathKeys (BinaryTree.node l k r) y := by
  simpa [rotate] using
    (searchPathKeys_rotateRight_subset_of_mem_left
      (l := l) (r := r) (k := k) (x := x) (y := y) (key := key)
      hbst hxmem hkey)

private theorem searchPathKeys_rotate_zag_subset_of_mem_right
    {l r : BinaryTree} {k x y key : Nat}
    (hbst : IsBST (BinaryTree.node l k r))
    (hxmem : x ∈ r.toKeyList)
    (hkey : key ∈ searchPathKeys (rotate (BinaryTree.node l k r) .zag) y) :
    key ∈ searchPathKeys (BinaryTree.node l k r) x ∨
      key ∈ searchPathKeys (BinaryTree.node l k r) y := by
  simpa [rotate] using
    (searchPathKeys_rotateLeft_subset_of_mem_right
      (l := l) (r := r) (k := k) (x := x) (y := y) (key := key)
      hbst hxmem hkey)

private theorem searchPathKeys_splay_inner_subset_zigZig_after
    {ll lr r : BinaryTree} {lk k x y key : Nat}
    (hbst : IsBST (BinaryTree.node (BinaryTree.node ll lk lr) k r))
    (hxmem : x ∈ ll.toKeyList)
    (hymem : y ∈ ll.toKeyList)
    (hkey : key ∈ searchPathKeys (splay ll x) y) :
    key ∈ searchPathKeys
      (rotate
        (BinaryTree.node (BinaryTree.node (splay ll x) lk lr) k r)
        .zigZig) y := by
  cases hbst with
  | node _ _ _ hleft _hright hbst_left _hbst_right =>
      cases hbst_left with
      | node _ _ _ hll_left _hlr_right hbst_ll _hbst_lr =>
          have hx_lt_lk :
              x < lk :=
            (forallTree_iff_forall_mem.mp hll_left) x hxmem
          have hy_lt_lk :
              y < lk :=
            (forallTree_iff_forall_mem.mp hll_left) y hymem
          have hroot_inner :=
            splay_rootKey_eq_some_of_mem_isBST ll x hbst_ll hxmem
          cases hs : splay ll x with
          | empty =>
              simp [rootKey, hs] at hroot_inner
          | node sl sk sr =>
              simp [rootKey, hs] at hroot_inner
              subst sk
              by_cases hy_lt_x : y < x
              · simp [rotate, rotateRight, hs, searchPathKeys, hy_lt_x] at hkey ⊢
                exact hkey
              · by_cases hx_lt_y : x < y
                · have hnot_lk_lt_y : ¬ lk < y := by omega
                  simp [rotate, rotateRight, hs, searchPathKeys, hy_lt_x,
                    hx_lt_y, hy_lt_lk] at hkey ⊢
                  tauto
                · have hy_eq_x : y = x := by omega
                  subst y
                  simp [rotate, rotateRight, hs, searchPathKeys] at hkey ⊢
                  exact hkey

private theorem searchPathKeys_zigZig_old_subset_union_of_inner
    {ll lr r : BinaryTree} {lk k x y key : Nat}
    (hbst : IsBST (BinaryTree.node (BinaryTree.node ll lk lr) k r))
    (hxmem : x ∈ ll.toKeyList)
    (hymem : y ∈
      (BinaryTree.node (BinaryTree.node ll lk lr) k r).toKeyList)
    (hinner : ∀ z key, z ∈ ll.toKeyList →
      key ∈ searchPathKeys ll z →
        key ∈ searchPathKeys ll x ∨
          key ∈ searchPathKeys (splay ll x) z)
    (hkey :
      key ∈ searchPathKeys
        (BinaryTree.node (BinaryTree.node ll lk lr) k r) y) :
    key ∈ searchPathKeys
        (BinaryTree.node (BinaryTree.node ll lk lr) k r) x ∨
      key ∈ searchPathKeys
        (rotate
          (BinaryTree.node (BinaryTree.node (splay ll x) lk lr) k r)
          .zigZig) y := by
  cases hbst with
  | node _ _ _ hleft hright hbst_left hbst_right =>
      cases hbst_left with
      | node _ _ _ hll_left hlr_right hbst_ll hbst_lr =>
          have hx_lt_lk :
              x < lk :=
            (forallTree_iff_forall_mem.mp hll_left) x hxmem
          have hx_left_mem :
              x ∈ (BinaryTree.node ll lk lr).toKeyList := by
            simp [BinaryTree.toKeyList, hxmem]
          have hx_lt_k :
              x < k :=
            (forallTree_iff_forall_mem.mp hleft) x hx_left_mem
          simp only [BinaryTree.toKeyList, List.mem_append,
            List.mem_singleton] at hymem
          rcases hymem with (((hymem_ll | hy_eq_lk) | hymem_lr) | hy_eq_k) | hymem_r
          · have hy_lt_lk :
                y < lk :=
              (forallTree_iff_forall_mem.mp hll_left) y hymem_ll
            have hy_left_mem :
                y ∈ (BinaryTree.node ll lk lr).toKeyList := by
              simp [BinaryTree.toKeyList, hymem_ll]
            have hy_lt_k :
                y < k :=
              (forallTree_iff_forall_mem.mp hleft) y hy_left_mem
            simp [searchPathKeys, hx_lt_k, hx_lt_lk, hy_lt_k,
              hy_lt_lk] at hkey
            rcases hkey with hkey_root | hkey_lk | hkey_inner
            · left
              simp [searchPathKeys, hx_lt_k, hx_lt_lk, hkey_root]
            · left
              simp [searchPathKeys, hx_lt_k, hx_lt_lk, hkey_lk]
            · rcases hinner y key hymem_ll hkey_inner with
                hkey_x_inner | hkey_after_inner
              · left
                simp [searchPathKeys, hx_lt_k, hx_lt_lk, hkey_x_inner]
              · right
                exact
                  searchPathKeys_splay_inner_subset_zigZig_after
                    (ll := ll) (lr := lr) (r := r) (lk := lk) (k := k)
                    (x := x) (y := y) (key := key)
                    (IsBST.node k (BinaryTree.node ll lk lr) r
                      hleft hright
                      (IsBST.node lk ll lr hll_left hlr_right
                        hbst_ll hbst_lr)
                      hbst_right)
                    hxmem hymem_ll hkey_after_inner
          · subst y
            have hlk_lt_k :
                lk < k :=
              (forallTree_iff_forall_mem.mp hleft) lk
                (by simp [BinaryTree.toKeyList])
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST ll x hbst_ll hxmem
            cases hs : splay ll x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                simp [searchPathKeys, hlk_lt_k] at hkey
                rcases hkey with hkey_k | hkey_lk
                · left
                  simp [searchPathKeys, hx_lt_k, hx_lt_lk, hkey_k]
                · right
                  have hnot_lk_lt_x : ¬ lk < x := by omega
                  simp [rotate, rotateRight, hs, searchPathKeys,
                    hnot_lk_lt_x, hx_lt_lk, hkey_lk]
          · have hlk_lt_y :
                lk < y :=
              (forallTree_iff_forall_mem.mp hlr_right) y hymem_lr
            have hy_left_mem :
                y ∈ (BinaryTree.node ll lk lr).toKeyList := by
              simp [BinaryTree.toKeyList, hymem_lr]
            have hy_lt_k :
                y < k :=
              (forallTree_iff_forall_mem.mp hleft) y hy_left_mem
            have hx_lt_y : x < y := by omega
            have hnot_y_lt_x : ¬ y < x := by omega
            have hnot_y_lt_lk : ¬ y < lk := by omega
            have hnot_k_lt_y : ¬ k < y := by omega
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST ll x hbst_ll hxmem
            cases hs : splay ll x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                simp [searchPathKeys, hx_lt_k, hx_lt_lk, hnot_y_lt_lk,
                  hlk_lt_y, hy_lt_k] at hkey
                right
                simp [rotate, rotateRight, hs, searchPathKeys,
                  hnot_y_lt_x, hx_lt_y, hnot_y_lt_lk, hlk_lt_y,
                  hy_lt_k]
                tauto
          · subst y
            have hlk_lt_k :
                lk < k :=
              (forallTree_iff_forall_mem.mp hleft) lk
                (by simp [BinaryTree.toKeyList])
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST ll x hbst_ll hxmem
            cases hs : splay ll x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                simp [searchPathKeys, hx_lt_k] at hkey
                right
                have hnot_k_lt_x : ¬ k < x := by omega
                have hnot_k_lt_lk : ¬ k < lk := by omega
                simp [rotate, rotateRight, hs, searchPathKeys,
                  hnot_k_lt_x, hx_lt_k, hnot_k_lt_lk, hlk_lt_k, hkey]
          · have k_lt_y :
                k < y :=
              (forallTree_iff_forall_mem.mp hright) y hymem_r
            have hlk_lt_k :
                lk < k :=
              (forallTree_iff_forall_mem.mp hleft) lk
                (by simp [BinaryTree.toKeyList])
            have hx_lt_y : x < y := by omega
            have hlk_lt_y : lk < y := by omega
            have hnot_y_lt_x : ¬ y < x := by omega
            have hnot_y_lt_lk : ¬ y < lk := by omega
            have hnot_y_lt_k : ¬ y < k := by omega
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST ll x hbst_ll hxmem
            cases hs : splay ll x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                simp [searchPathKeys, hx_lt_k, hnot_y_lt_k, k_lt_y] at hkey
                right
                simp [rotate, rotateRight, hs, searchPathKeys,
                  hnot_y_lt_x, hx_lt_y, hnot_y_lt_lk, hlk_lt_y,
                  hnot_y_lt_k, k_lt_y]
                tauto

private theorem searchPathKeys_splay_zigZig_branch_old_subset_of_inner
    {ll lr r : BinaryTree} {lk k x y key : Nat}
    (hbst : IsBST (BinaryTree.node (BinaryTree.node ll lk lr) k r))
    (hxmem : x ∈ ll.toKeyList)
    (hymem : y ∈
      (BinaryTree.node (BinaryTree.node ll lk lr) k r).toKeyList)
    (hinner : ∀ z key, z ∈ ll.toKeyList →
      key ∈ searchPathKeys ll z →
        key ∈ searchPathKeys ll x ∨
          key ∈ searchPathKeys (splay ll x) z)
    (hkey :
      key ∈ searchPathKeys
        (BinaryTree.node (BinaryTree.node ll lk lr) k r) y) :
    key ∈ searchPathKeys
        (BinaryTree.node (BinaryTree.node ll lk lr) k r) x ∨
      key ∈ searchPathKeys
        (splay (BinaryTree.node (BinaryTree.node ll lk lr) k r) x) y := by
  cases hbst with
  | node _ _ _ hleft _hright hbst_left _hbst_right =>
      cases hbst_left with
      | node _ _ _ hll_left _hlr_right _hbst_ll _hbst_lr =>
          have hx_left_mem :
              x ∈ (BinaryTree.node ll lk lr).toKeyList := by
            simp [BinaryTree.toKeyList, hxmem]
          have hx_lt_k :=
            (forallTree_iff_forall_mem.mp hleft) x hx_left_mem
          have hx_lt_lk :=
            (forallTree_iff_forall_mem.mp hll_left) x hxmem
          have hx_ne_k : x ≠ k := by omega
          have hsplay :
              splay (BinaryTree.node (BinaryTree.node ll lk lr) k r) x =
                rotate
                  (BinaryTree.node
                    (BinaryTree.node (splay ll x) lk lr) k r)
                  .zigZig := by
            cases ll with
            | empty =>
                simp [BinaryTree.toKeyList] at hxmem
            | node a q b =>
                conv_lhs => unfold splay
                simp [hx_ne_k, hx_lt_k, hx_lt_lk]
          rw [hsplay]
          exact
            searchPathKeys_zigZig_old_subset_union_of_inner
              (ll := ll) (lr := lr) (r := r) (lk := lk) (k := k)
              (x := x) (y := y) (key := key)
              (IsBST.node k (BinaryTree.node ll lk lr) r
                hleft _hright
                (IsBST.node lk ll lr hll_left _hlr_right
                  _hbst_ll _hbst_lr)
                _hbst_right)
              hxmem hymem hinner hkey

private theorem searchPathKeys_splay_inner_subset_zagZag_after
    {l rl rr : BinaryTree} {k rk x y key : Nat}
    (hbst : IsBST (BinaryTree.node l k (BinaryTree.node rl rk rr)))
    (hxmem : x ∈ rr.toKeyList)
    (hymem : y ∈ rr.toKeyList)
    (hkey : key ∈ searchPathKeys (splay rr x) y) :
    key ∈ searchPathKeys
      (rotate
        (BinaryTree.node l k (BinaryTree.node rl rk (splay rr x)))
        .zagZag) y := by
  cases hbst with
  | node _ _ _ _hleft hright _hbst_left hbst_right =>
      cases hbst_right with
      | node _ _ _ _hrl_left hrr_right _hbst_rl hbst_rr =>
          have hrk_lt_x :
              rk < x :=
            (forallTree_iff_forall_mem.mp hrr_right) x hxmem
          have hrk_lt_y :
              rk < y :=
            (forallTree_iff_forall_mem.mp hrr_right) y hymem
          have hroot_inner :=
            splay_rootKey_eq_some_of_mem_isBST rr x hbst_rr hxmem
          cases hs : splay rr x with
          | empty =>
              simp [rootKey, hs] at hroot_inner
          | node sl sk sr =>
              simp [rootKey, hs] at hroot_inner
              subst sk
              by_cases hy_lt_x : y < x
              · have hnot_y_lt_rk : ¬ y < rk := by omega
                simp [rotate, rotateLeft, hs, searchPathKeys, hy_lt_x,
                  hnot_y_lt_rk, hrk_lt_y] at hkey ⊢
                tauto
              · by_cases hx_lt_y : x < y
                · simp [rotate, rotateLeft, hs, searchPathKeys, hy_lt_x,
                    hx_lt_y] at hkey ⊢
                  exact hkey
                · have hy_eq_x : y = x := by omega
                  subst y
                  simp [rotate, rotateLeft, hs, searchPathKeys] at hkey ⊢
                  exact hkey

private theorem searchPathKeys_zagZag_old_subset_union_of_inner
    {l rl rr : BinaryTree} {k rk x y key : Nat}
    (hbst : IsBST (BinaryTree.node l k (BinaryTree.node rl rk rr)))
    (hxmem : x ∈ rr.toKeyList)
    (hymem : y ∈
      (BinaryTree.node l k (BinaryTree.node rl rk rr)).toKeyList)
    (hinner : ∀ z key, z ∈ rr.toKeyList →
      key ∈ searchPathKeys rr z →
        key ∈ searchPathKeys rr x ∨
          key ∈ searchPathKeys (splay rr x) z)
    (hkey :
      key ∈ searchPathKeys
        (BinaryTree.node l k (BinaryTree.node rl rk rr)) y) :
    key ∈ searchPathKeys
        (BinaryTree.node l k (BinaryTree.node rl rk rr)) x ∨
      key ∈ searchPathKeys
        (rotate
          (BinaryTree.node l k (BinaryTree.node rl rk (splay rr x)))
          .zagZag) y := by
  cases hbst with
  | node _ _ _ hleft hright hbst_left hbst_right =>
      cases hbst_right with
      | node _ _ _ hrl_left hrr_right hbst_rl hbst_rr =>
          have hx_right_mem :
              x ∈ (BinaryTree.node rl rk rr).toKeyList := by
            simp [BinaryTree.toKeyList, hxmem]
          have hk_lt_x :
              k < x :=
            (forallTree_iff_forall_mem.mp hright) x hx_right_mem
          have hrk_lt_x :
              rk < x :=
            (forallTree_iff_forall_mem.mp hrr_right) x hxmem
          have hnot_x_lt_k : ¬ x < k := by omega
          have hnot_x_lt_rk : ¬ x < rk := by omega
          simp only [BinaryTree.toKeyList, List.mem_append,
            List.mem_singleton] at hymem
          rcases hymem with (hymem_l | hy_eq_k) | ((hymem_rl | hy_eq_rk) | hymem_rr)
          · have hy_lt_k :
                y < k :=
              (forallTree_iff_forall_mem.mp hleft) y hymem_l
            have hk_lt_rk :
                k < rk :=
              (forallTree_iff_forall_mem.mp hright) rk
                (by simp [BinaryTree.toKeyList])
            have hy_lt_rk : y < rk := by omega
            have hy_lt_x : y < x := by omega
            have hnot_rk_lt_y : ¬ rk < y := by omega
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST rr x hbst_rr hxmem
            cases hs : splay rr x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                simp [searchPathKeys, hy_lt_k] at hkey
                right
                simp [rotate, rotateLeft, hs, searchPathKeys, hy_lt_x,
                  hy_lt_rk, hnot_rk_lt_y, hy_lt_k]
                tauto
          · subst y
            have hk_lt_rk :
                k < rk :=
              (forallTree_iff_forall_mem.mp hright) rk
                (by simp [BinaryTree.toKeyList])
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST rr x hbst_rr hxmem
            cases hs : splay rr x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                simp [searchPathKeys] at hkey
                right
                have hnot_rk_lt_k : ¬ rk < k := by omega
                simp [rotate, rotateLeft, hs, searchPathKeys,
                  hk_lt_x, hnot_rk_lt_k, hk_lt_rk, hkey]
          · have hk_lt_rk :
                k < rk :=
              (forallTree_iff_forall_mem.mp hright) rk
                (by simp [BinaryTree.toKeyList])
            have hy_lt_rk :
                y < rk :=
              (forallTree_iff_forall_mem.mp hrl_left) y hymem_rl
            have hy_right_mem :
                y ∈ (BinaryTree.node rl rk rr).toKeyList := by
              simp [BinaryTree.toKeyList, hymem_rl]
            have k_lt_y :
                k < y :=
              (forallTree_iff_forall_mem.mp hright) y hy_right_mem
            have hy_lt_x : y < x := by omega
            have hnot_y_lt_k : ¬ y < k := by omega
            have hnot_rk_lt_y : ¬ rk < y := by omega
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST rr x hbst_rr hxmem
            cases hs : splay rr x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                simp [searchPathKeys, hnot_y_lt_k, k_lt_y, hy_lt_rk] at hkey
                right
                simp [rotate, rotateLeft, hs, searchPathKeys, hy_lt_x,
                  hy_lt_rk, hnot_rk_lt_y, hnot_y_lt_k, k_lt_y]
                tauto
          · subst y
            have hk_lt_rk :
                k < rk :=
              (forallTree_iff_forall_mem.mp hright) rk
                (by simp [BinaryTree.toKeyList])
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST rr x hbst_rr hxmem
            cases hs : splay rr x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                have hnot_rk_lt_k : ¬ rk < k := by omega
                simp [searchPathKeys, hk_lt_rk, hnot_rk_lt_k] at hkey
                rcases hkey with hkey_k | hkey_rk
                · left
                  simp [searchPathKeys, hnot_x_lt_k, hk_lt_x,
                    hnot_x_lt_rk, hrk_lt_x, hkey_k]
                · right
                  simp [rotate, rotateLeft, hs, searchPathKeys,
                    hrk_lt_x, hkey_rk]
          · have hrk_lt_y :
                rk < y :=
              (forallTree_iff_forall_mem.mp hrr_right) y hymem_rr
            have hy_right_mem :
                y ∈ (BinaryTree.node rl rk rr).toKeyList := by
              simp [BinaryTree.toKeyList, hymem_rr]
            have k_lt_y :
                k < y :=
              (forallTree_iff_forall_mem.mp hright) y hy_right_mem
            have hnot_y_lt_k : ¬ y < k := by omega
            have hnot_y_lt_rk : ¬ y < rk := by omega
            simp [searchPathKeys, hnot_y_lt_k, k_lt_y,
              hnot_y_lt_rk, hrk_lt_y] at hkey
            rcases hkey with hkey_root | hkey_rk | hkey_inner
            · left
              simp [searchPathKeys, hnot_x_lt_k, hk_lt_x,
                hnot_x_lt_rk, hrk_lt_x, hkey_root]
            · left
              simp [searchPathKeys, hnot_x_lt_k, hk_lt_x,
                hnot_x_lt_rk, hrk_lt_x, hkey_rk]
            · rcases hinner y key hymem_rr hkey_inner with
                hkey_x_inner | hkey_after_inner
              · left
                simp [searchPathKeys, hnot_x_lt_k, hk_lt_x,
                  hnot_x_lt_rk, hrk_lt_x, hkey_x_inner]
              · right
                exact
                  searchPathKeys_splay_inner_subset_zagZag_after
                    (l := l) (rl := rl) (rr := rr) (k := k) (rk := rk)
                    (x := x) (y := y) (key := key)
                    (IsBST.node k l (BinaryTree.node rl rk rr)
                      hleft hright hbst_left
                      (IsBST.node rk rl rr hrl_left hrr_right
                        hbst_rl hbst_rr))
                    hxmem hymem_rr hkey_after_inner

private theorem searchPathKeys_splay_zagZag_branch_old_subset_of_inner
    {l rl rr : BinaryTree} {k rk x y key : Nat}
    (hbst : IsBST (BinaryTree.node l k (BinaryTree.node rl rk rr)))
    (hxmem : x ∈ rr.toKeyList)
    (hymem : y ∈
      (BinaryTree.node l k (BinaryTree.node rl rk rr)).toKeyList)
    (hinner : ∀ z key, z ∈ rr.toKeyList →
      key ∈ searchPathKeys rr z →
        key ∈ searchPathKeys rr x ∨
          key ∈ searchPathKeys (splay rr x) z)
    (hkey :
      key ∈ searchPathKeys
        (BinaryTree.node l k (BinaryTree.node rl rk rr)) y) :
    key ∈ searchPathKeys
        (BinaryTree.node l k (BinaryTree.node rl rk rr)) x ∨
      key ∈ searchPathKeys
        (splay (BinaryTree.node l k (BinaryTree.node rl rk rr)) x) y := by
  cases hbst with
  | node _ _ _ _hleft hright _hbst_left hbst_right =>
      cases hbst_right with
      | node _ _ _ _hrl_left hrr_right _hbst_rl _hbst_rr =>
          have hx_right_mem :
              x ∈ (BinaryTree.node rl rk rr).toKeyList := by
            simp [BinaryTree.toKeyList, hxmem]
          have hk_lt_x :=
            (forallTree_iff_forall_mem.mp hright) x hx_right_mem
          have hrk_lt_x :=
            (forallTree_iff_forall_mem.mp hrr_right) x hxmem
          have hx_ne_k : x ≠ k := by omega
          have hnot_x_lt_k : ¬ x < k := by omega
          have hnot_x_lt_rk : ¬ x < rk := by omega
          have hsplay :
              splay (BinaryTree.node l k (BinaryTree.node rl rk rr)) x =
                rotate
                  (BinaryTree.node l k
                    (BinaryTree.node rl rk (splay rr x)))
                  .zagZag := by
            cases rr with
            | empty =>
                simp [BinaryTree.toKeyList] at hxmem
            | node a q b =>
                conv_lhs => unfold splay
                simp [hx_ne_k, hnot_x_lt_k, hnot_x_lt_rk, hrk_lt_x]
          rw [hsplay]
          exact
            searchPathKeys_zagZag_old_subset_union_of_inner
              (l := l) (rl := rl) (rr := rr) (k := k) (rk := rk)
              (x := x) (y := y) (key := key)
              (IsBST.node k l (BinaryTree.node rl rk rr)
                _hleft hright _hbst_left
                (IsBST.node rk rl rr _hrl_left hrr_right
                  _hbst_rl _hbst_rr))
              hxmem hymem hinner hkey

private theorem searchPathKeys_splay_zig_child_branch_old_subset
    {ll lr r : BinaryTree} {lk k x y key : Nat}
    (hbst : IsBST (BinaryTree.node (BinaryTree.node ll lk lr) k r))
    (hx : x = lk)
    (hymem : y ∈
      (BinaryTree.node (BinaryTree.node ll lk lr) k r).toKeyList)
    (hkey :
      key ∈ searchPathKeys
        (BinaryTree.node (BinaryTree.node ll lk lr) k r) y) :
    key ∈ searchPathKeys
        (BinaryTree.node (BinaryTree.node ll lk lr) k r) x ∨
      key ∈ searchPathKeys
        (splay (BinaryTree.node (BinaryTree.node ll lk lr) k r) x) y := by
  subst x
  cases hbst with
  | node _ _ _ hleft hright hbst_left hbst_right =>
      cases hbst_left with
      | node _ _ _ hll_left hlr_right hbst_ll hbst_lr =>
          have hlk_mem_left :
              lk ∈ (BinaryTree.node ll lk lr).toKeyList := by
            simp [BinaryTree.toKeyList]
          have hlk_lt_k :=
            (forallTree_iff_forall_mem.mp hleft) lk hlk_mem_left
          have hlk_ne_k : lk ≠ k := by omega
          have hsplay :
              splay (BinaryTree.node (BinaryTree.node ll lk lr) k r) lk =
                rotate (BinaryTree.node (BinaryTree.node ll lk lr) k r) .zig := by
            conv_lhs => unfold splay
            simp [hlk_ne_k, hlk_lt_k]
          rw [hsplay]
          simp only [BinaryTree.toKeyList, List.mem_append,
            List.mem_singleton] at hymem
          rcases hymem with (((hymem_ll | hy_eq_lk) | hymem_lr) | hy_eq_k) | hymem_r
          · have hy_lt_lk :=
              (forallTree_iff_forall_mem.mp hll_left) y hymem_ll
            have hy_lt_k : y < k := by omega
            simp [searchPathKeys, hy_lt_k, hy_lt_lk] at hkey
            rcases hkey with hkey_k | hkey_lk | hkey_inner
            · left
              simp [searchPathKeys, hlk_lt_k, hkey_k]
            · right
              simp [rotate, rotateRight, searchPathKeys, hy_lt_lk, hkey_lk]
            · right
              simp [rotate, rotateRight, searchPathKeys, hy_lt_lk, hkey_inner]
          · subst y
            simp [searchPathKeys, hlk_lt_k] at hkey
            rcases hkey with hkey_k | hkey_lk
            · left
              simp [searchPathKeys, hlk_lt_k, hkey_k]
            · right
              simp [rotate, rotateRight, searchPathKeys, hkey_lk]
          · have hlk_lt_y :=
              (forallTree_iff_forall_mem.mp hlr_right) y hymem_lr
            have hy_left_mem :
                y ∈ (BinaryTree.node ll lk lr).toKeyList := by
              simp [BinaryTree.toKeyList, hymem_lr]
            have hy_lt_k :=
              (forallTree_iff_forall_mem.mp hleft) y hy_left_mem
            have hnot_y_lt_lk : ¬ y < lk := by omega
            simp [searchPathKeys, hy_lt_k, hnot_y_lt_lk, hlk_lt_y] at hkey
            right
            simp [rotate, rotateRight, searchPathKeys, hnot_y_lt_lk,
              hlk_lt_y, hy_lt_k]
            tauto
          · subst y
            simp [searchPathKeys] at hkey
            left
            simp [searchPathKeys, hlk_lt_k, hkey]
          · have k_lt_y :=
              (forallTree_iff_forall_mem.mp hright) y hymem_r
            have hlk_lt_y : lk < y := by omega
            have hnot_y_lt_lk : ¬ y < lk := by omega
            have hnot_y_lt_k : ¬ y < k := by omega
            simp [searchPathKeys, hnot_y_lt_k, k_lt_y] at hkey
            right
            simp [rotate, rotateRight, searchPathKeys, hnot_y_lt_lk,
              hlk_lt_y, hnot_y_lt_k, k_lt_y]
            tauto

private theorem searchPathKeys_splay_zag_child_branch_old_subset
    {l rl rr : BinaryTree} {k rk x y key : Nat}
    (hbst : IsBST (BinaryTree.node l k (BinaryTree.node rl rk rr)))
    (hx : x = rk)
    (hymem : y ∈
      (BinaryTree.node l k (BinaryTree.node rl rk rr)).toKeyList)
    (hkey :
      key ∈ searchPathKeys
        (BinaryTree.node l k (BinaryTree.node rl rk rr)) y) :
    key ∈ searchPathKeys
        (BinaryTree.node l k (BinaryTree.node rl rk rr)) x ∨
      key ∈ searchPathKeys
        (splay (BinaryTree.node l k (BinaryTree.node rl rk rr)) x) y := by
  subst x
  cases hbst with
  | node _ _ _ hleft hright hbst_left hbst_right =>
      cases hbst_right with
      | node _ _ _ hrl_left hrr_right hbst_rl hbst_rr =>
          have hrk_mem_right :
              rk ∈ (BinaryTree.node rl rk rr).toKeyList := by
            simp [BinaryTree.toKeyList]
          have hk_lt_rk :=
            (forallTree_iff_forall_mem.mp hright) rk hrk_mem_right
          have hrk_ne_k : rk ≠ k := by omega
          have hnot_rk_lt_k : ¬ rk < k := by omega
          have hsplay :
              splay (BinaryTree.node l k (BinaryTree.node rl rk rr)) rk =
                rotate (BinaryTree.node l k (BinaryTree.node rl rk rr)) .zag := by
            conv_lhs => unfold splay
            simp [hrk_ne_k, hnot_rk_lt_k]
          rw [hsplay]
          simp only [BinaryTree.toKeyList, List.mem_append,
            List.mem_singleton] at hymem
          rcases hymem with (hymem_l | hy_eq_k) | ((hymem_rl | hy_eq_rk) | hymem_rr)
          · have hy_lt_k :=
              (forallTree_iff_forall_mem.mp hleft) y hymem_l
            have hy_lt_rk : y < rk := by omega
            simp [searchPathKeys, hy_lt_k] at hkey
            right
            simp [rotate, rotateLeft, searchPathKeys, hy_lt_k, hy_lt_rk]
            tauto
          · subst y
            simp [searchPathKeys] at hkey
            left
            simp [searchPathKeys, hnot_rk_lt_k, hk_lt_rk, hkey]
          · have hy_lt_rk :=
              (forallTree_iff_forall_mem.mp hrl_left) y hymem_rl
            have hy_right_mem :
                y ∈ (BinaryTree.node rl rk rr).toKeyList := by
              simp [BinaryTree.toKeyList, hymem_rl]
            have k_lt_y :=
              (forallTree_iff_forall_mem.mp hright) y hy_right_mem
            have hnot_y_lt_k : ¬ y < k := by omega
            simp [searchPathKeys, hnot_y_lt_k, k_lt_y, hy_lt_rk] at hkey
            right
            simp [rotate, rotateLeft, searchPathKeys, hy_lt_rk,
              hnot_y_lt_k, k_lt_y]
            tauto
          · subst y
            simp [searchPathKeys, hnot_rk_lt_k, hk_lt_rk] at hkey
            rcases hkey with hkey_k | hkey_rk
            · left
              simp [searchPathKeys, hnot_rk_lt_k, hk_lt_rk, hkey_k]
            · right
              simp [rotate, rotateLeft, searchPathKeys, hkey_rk]
          · have hrk_lt_y :=
              (forallTree_iff_forall_mem.mp hrr_right) y hymem_rr
            have hy_right_mem :
                y ∈ (BinaryTree.node rl rk rr).toKeyList := by
              simp [BinaryTree.toKeyList, hymem_rr]
            have k_lt_y :=
              (forallTree_iff_forall_mem.mp hright) y hy_right_mem
            have hnot_y_lt_k : ¬ y < k := by omega
            have hnot_y_lt_rk : ¬ y < rk := by omega
            simp [searchPathKeys, hnot_y_lt_k, k_lt_y,
              hnot_y_lt_rk, hrk_lt_y] at hkey
            rcases hkey with hkey_k | hkey_rk | hkey_tail
            · left
              simp [searchPathKeys, hnot_rk_lt_k, hk_lt_rk, hkey_k]
            · right
              simp [rotate, rotateLeft, searchPathKeys, hnot_y_lt_rk,
                hrk_lt_y, hkey_rk]
            · right
              simp [rotate, rotateLeft, searchPathKeys, hnot_y_lt_rk,
                hrk_lt_y, hkey_tail]

private theorem searchPathKeys_splay_inner_subset_zigZag_after
    {ll lr r : BinaryTree} {lk k x y key : Nat}
    (hbst : IsBST (BinaryTree.node (BinaryTree.node ll lk lr) k r))
    (hxmem : x ∈ lr.toKeyList)
    (hymem : y ∈ lr.toKeyList)
    (hkey : key ∈ searchPathKeys (splay lr x) y) :
    key ∈ searchPathKeys
      (rotate
        (BinaryTree.node (BinaryTree.node ll lk (splay lr x)) k r)
        .zigZag) y := by
  cases hbst with
  | node _ _ _ hleft _hright hbst_left _hbst_right =>
      cases hbst_left with
      | node _ _ _ _hll_left hlr_right _hbst_ll hbst_lr =>
          have hlk_lt_x :
              lk < x :=
            (forallTree_iff_forall_mem.mp hlr_right) x hxmem
          have hlk_lt_y :
              lk < y :=
            (forallTree_iff_forall_mem.mp hlr_right) y hymem
          have hx_left_mem :
              x ∈ (BinaryTree.node ll lk lr).toKeyList := by
            simp [BinaryTree.toKeyList, hxmem]
          have hx_lt_k :
              x < k :=
            (forallTree_iff_forall_mem.mp hleft) x hx_left_mem
          have hy_left_mem :
              y ∈ (BinaryTree.node ll lk lr).toKeyList := by
            simp [BinaryTree.toKeyList, hymem]
          have hy_lt_k :
              y < k :=
            (forallTree_iff_forall_mem.mp hleft) y hy_left_mem
          have hroot_inner :=
            splay_rootKey_eq_some_of_mem_isBST lr x hbst_lr hxmem
          cases hs : splay lr x with
          | empty =>
              simp [rootKey, hs] at hroot_inner
          | node sl sk sr =>
              simp [rootKey, hs] at hroot_inner
              subst sk
              by_cases hy_lt_x : y < x
              · have hnot_y_lt_lk : ¬ y < lk := by omega
                simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                  hy_lt_x, hnot_y_lt_lk, hlk_lt_y] at hkey ⊢
                tauto
              · by_cases hx_lt_y : x < y
                · have hnot_y_lt_k : ¬ k < y := by omega
                  simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                    hy_lt_x, hx_lt_y, hy_lt_k, hnot_y_lt_k] at hkey ⊢
                  tauto
                · have hy_eq_x : y = x := by omega
                  subst y
                  simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys] at hkey ⊢
                  exact hkey

private theorem searchPathKeys_zigZag_old_subset_union_of_inner
    {ll lr r : BinaryTree} {lk k x y key : Nat}
    (hbst : IsBST (BinaryTree.node (BinaryTree.node ll lk lr) k r))
    (hxmem : x ∈ lr.toKeyList)
    (hymem : y ∈
      (BinaryTree.node (BinaryTree.node ll lk lr) k r).toKeyList)
    (hinner : ∀ z key, z ∈ lr.toKeyList →
      key ∈ searchPathKeys lr z →
        key ∈ searchPathKeys lr x ∨
          key ∈ searchPathKeys (splay lr x) z)
    (hkey :
      key ∈ searchPathKeys
        (BinaryTree.node (BinaryTree.node ll lk lr) k r) y) :
    key ∈ searchPathKeys
        (BinaryTree.node (BinaryTree.node ll lk lr) k r) x ∨
      key ∈ searchPathKeys
        (rotate
          (BinaryTree.node (BinaryTree.node ll lk (splay lr x)) k r)
          .zigZag) y := by
  cases hbst with
  | node _ _ _ hleft hright hbst_left hbst_right =>
      cases hbst_left with
      | node _ _ _ hll_left hlr_right hbst_ll hbst_lr =>
          have hlk_lt_x :
              lk < x :=
            (forallTree_iff_forall_mem.mp hlr_right) x hxmem
          have hx_left_mem :
              x ∈ (BinaryTree.node ll lk lr).toKeyList := by
            simp [BinaryTree.toKeyList, hxmem]
          have hx_lt_k :
              x < k :=
            (forallTree_iff_forall_mem.mp hleft) x hx_left_mem
          have hnot_x_lt_lk : ¬ x < lk := by omega
          simp only [BinaryTree.toKeyList, List.mem_append,
            List.mem_singleton] at hymem
          rcases hymem with (((hymem_ll | hy_eq_lk) | hymem_lr) | hy_eq_k) | hymem_r
          · have hy_lt_lk :=
              (forallTree_iff_forall_mem.mp hll_left) y hymem_ll
            have hy_lt_x : y < x := by omega
            have hy_lt_k : y < k := by omega
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST lr x hbst_lr hxmem
            cases hs : splay lr x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                simp [searchPathKeys, hy_lt_k, hy_lt_lk] at hkey
                rcases hkey with hkey_k | hkey_lk | hkey_tail
                · left
                  simp [searchPathKeys, hx_lt_k, hnot_x_lt_lk,
                    hlk_lt_x, hkey_k]
                · right
                  simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                    hy_lt_x, hy_lt_lk, hkey_lk]
                · right
                  simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                    hy_lt_x, hy_lt_lk, hkey_tail]
          · subst y
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST lr x hbst_lr hxmem
            cases hs : splay lr x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                have hlk_lt_k : lk < k := by omega
                simp [searchPathKeys, hx_lt_k, hlk_lt_k] at hkey
                rcases hkey with hkey_k | hkey_lk
                · left
                  simp [searchPathKeys, hx_lt_k, hnot_x_lt_lk,
                    hlk_lt_x, hkey_k]
                · right
                  simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                    hlk_lt_x, hkey_lk]
          · have hlk_lt_y :=
              (forallTree_iff_forall_mem.mp hlr_right) y hymem_lr
            have hy_left_mem :
                y ∈ (BinaryTree.node ll lk lr).toKeyList := by
              simp [BinaryTree.toKeyList, hymem_lr]
            have hy_lt_k :=
              (forallTree_iff_forall_mem.mp hleft) y hy_left_mem
            have hnot_y_lt_lk : ¬ y < lk := by omega
            simp [searchPathKeys, hy_lt_k, hnot_y_lt_lk, hlk_lt_y] at hkey
            rcases hkey with hkey_k | hkey_lk | hkey_inner
            · left
              simp [searchPathKeys, hx_lt_k, hnot_x_lt_lk,
                hlk_lt_x, hkey_k]
            · left
              simp [searchPathKeys, hx_lt_k, hnot_x_lt_lk,
                hlk_lt_x, hkey_lk]
            · rcases hinner y key hymem_lr hkey_inner with
                hkey_x_inner | hkey_after_inner
              · left
                simp [searchPathKeys, hx_lt_k, hnot_x_lt_lk,
                  hlk_lt_x, hkey_x_inner]
              · right
                exact
                  searchPathKeys_splay_inner_subset_zigZag_after
                    (ll := ll) (lr := lr) (r := r) (lk := lk) (k := k)
                    (x := x) (y := y) (key := key)
                    (IsBST.node k (BinaryTree.node ll lk lr) r
                      hleft hright
                      (IsBST.node lk ll lr hll_left hlr_right
                        hbst_ll hbst_lr)
                      hbst_right)
                    hxmem hymem_lr hkey_after_inner
          · subst y
            simp [searchPathKeys] at hkey
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST lr x hbst_lr hxmem
            cases hs : splay lr x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                right
                have hnot_k_lt_x : ¬ k < x := by omega
                simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                  hnot_k_lt_x, hx_lt_k, hkey]
          · have k_lt_y :=
              (forallTree_iff_forall_mem.mp hright) y hymem_r
            have x_lt_y : x < y := by omega
            have hnot_y_lt_x : ¬ y < x := by omega
            have hnot_y_lt_k : ¬ y < k := by omega
            simp [searchPathKeys, hnot_y_lt_k, k_lt_y] at hkey
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST lr x hbst_lr hxmem
            cases hs : splay lr x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                right
                simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                  hnot_y_lt_x, x_lt_y, hnot_y_lt_k, k_lt_y]
                tauto

private theorem searchPathKeys_splay_zigZag_branch_old_subset_of_inner
    {ll lr r : BinaryTree} {lk k x y key : Nat}
    (hbst : IsBST (BinaryTree.node (BinaryTree.node ll lk lr) k r))
    (hxmem : x ∈ lr.toKeyList)
    (hymem : y ∈
      (BinaryTree.node (BinaryTree.node ll lk lr) k r).toKeyList)
    (hinner : ∀ z key, z ∈ lr.toKeyList →
      key ∈ searchPathKeys lr z →
        key ∈ searchPathKeys lr x ∨
          key ∈ searchPathKeys (splay lr x) z)
    (hkey :
      key ∈ searchPathKeys
        (BinaryTree.node (BinaryTree.node ll lk lr) k r) y) :
    key ∈ searchPathKeys
        (BinaryTree.node (BinaryTree.node ll lk lr) k r) x ∨
      key ∈ searchPathKeys
        (splay (BinaryTree.node (BinaryTree.node ll lk lr) k r) x) y := by
  cases hbst with
  | node _ _ _ hleft _hright hbst_left _hbst_right =>
      cases hbst_left with
      | node _ _ _ _hll_left hlr_right _hbst_ll _hbst_lr =>
          have hx_left_mem :
              x ∈ (BinaryTree.node ll lk lr).toKeyList := by
            simp [BinaryTree.toKeyList, hxmem]
          have hx_lt_k :=
            (forallTree_iff_forall_mem.mp hleft) x hx_left_mem
          have hlk_lt_x :=
            (forallTree_iff_forall_mem.mp hlr_right) x hxmem
          have hx_ne_k : x ≠ k := by omega
          have hnot_x_lt_lk : ¬ x < lk := by omega
          have hsplay :
              splay (BinaryTree.node (BinaryTree.node ll lk lr) k r) x =
                rotate
                  (BinaryTree.node
                    (BinaryTree.node ll lk (splay lr x)) k r)
                  .zigZag := by
            cases lr with
            | empty =>
                simp [BinaryTree.toKeyList] at hxmem
            | node a q b =>
                conv_lhs => unfold splay
                simp [hx_ne_k, hx_lt_k, hnot_x_lt_lk, hlk_lt_x]
          rw [hsplay]
          exact
            searchPathKeys_zigZag_old_subset_union_of_inner
              (ll := ll) (lr := lr) (r := r) (lk := lk) (k := k)
              (x := x) (y := y) (key := key)
              (IsBST.node k (BinaryTree.node ll lk lr) r
                hleft _hright
                (IsBST.node lk ll lr _hll_left hlr_right
                  _hbst_ll _hbst_lr)
                _hbst_right)
              hxmem hymem hinner hkey

private theorem searchPathKeys_splay_inner_subset_zagZig_after
    {l rl rr : BinaryTree} {k rk x y key : Nat}
    (hbst : IsBST (BinaryTree.node l k (BinaryTree.node rl rk rr)))
    (hxmem : x ∈ rl.toKeyList)
    (hymem : y ∈ rl.toKeyList)
    (hkey : key ∈ searchPathKeys (splay rl x) y) :
    key ∈ searchPathKeys
      (rotate
        (BinaryTree.node l k (BinaryTree.node (splay rl x) rk rr))
        .zagZig) y := by
  cases hbst with
  | node _ _ _ _hleft hright _hbst_left hbst_right =>
      cases hbst_right with
      | node _ _ _ hrl_left _hrr_right hbst_rl _hbst_rr =>
          have k_lt_x : k < x := by
            exact (forallTree_iff_forall_mem.mp hright) x
              (by simp [BinaryTree.toKeyList, hxmem])
          have k_lt_y : k < y := by
            exact (forallTree_iff_forall_mem.mp hright) y
              (by simp [BinaryTree.toKeyList, hymem])
          have hx_lt_rk :
              x < rk :=
            (forallTree_iff_forall_mem.mp hrl_left) x hxmem
          have hy_lt_rk :
              y < rk :=
            (forallTree_iff_forall_mem.mp hrl_left) y hymem
          have hroot_inner :=
            splay_rootKey_eq_some_of_mem_isBST rl x hbst_rl hxmem
          cases hs : splay rl x with
          | empty =>
              simp [rootKey, hs] at hroot_inner
          | node sl sk sr =>
              simp [rootKey, hs] at hroot_inner
              subst sk
              by_cases hy_lt_x : y < x
              · have hnot_y_lt_k : ¬ y < k := by omega
                simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                  hy_lt_x, hnot_y_lt_k, k_lt_y] at hkey ⊢
                tauto
              · by_cases hx_lt_y : x < y
                · have hnot_y_lt_rk : ¬ rk < y := by omega
                  simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                    hy_lt_x, hx_lt_y, hy_lt_rk, hnot_y_lt_rk] at hkey ⊢
                  tauto
                · have hy_eq_x : y = x := by omega
                  subst y
                  simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys] at hkey ⊢
                  exact hkey

private theorem searchPathKeys_zagZig_old_subset_union_of_inner
    {l rl rr : BinaryTree} {k rk x y key : Nat}
    (hbst : IsBST (BinaryTree.node l k (BinaryTree.node rl rk rr)))
    (hxmem : x ∈ rl.toKeyList)
    (hymem : y ∈
      (BinaryTree.node l k (BinaryTree.node rl rk rr)).toKeyList)
    (hinner : ∀ z key, z ∈ rl.toKeyList →
      key ∈ searchPathKeys rl z →
        key ∈ searchPathKeys rl x ∨
          key ∈ searchPathKeys (splay rl x) z)
    (hkey :
      key ∈ searchPathKeys
        (BinaryTree.node l k (BinaryTree.node rl rk rr)) y) :
    key ∈ searchPathKeys
        (BinaryTree.node l k (BinaryTree.node rl rk rr)) x ∨
      key ∈ searchPathKeys
        (rotate
          (BinaryTree.node l k (BinaryTree.node (splay rl x) rk rr))
          .zagZig) y := by
  cases hbst with
  | node _ _ _ hleft hright hbst_left hbst_right =>
      cases hbst_right with
      | node _ _ _ hrl_left hrr_right hbst_rl hbst_rr =>
          have hx_right_mem :
              x ∈ (BinaryTree.node rl rk rr).toKeyList := by
            simp [BinaryTree.toKeyList, hxmem]
          have k_lt_x :
              k < x :=
            (forallTree_iff_forall_mem.mp hright) x hx_right_mem
          have hx_lt_rk :
              x < rk :=
            (forallTree_iff_forall_mem.mp hrl_left) x hxmem
          have hnot_x_lt_k : ¬ x < k := by omega
          simp only [BinaryTree.toKeyList, List.mem_append,
            List.mem_singleton] at hymem
          rcases hymem with (hymem_l | hy_eq_k) | ((hymem_rl | hy_eq_rk) | hymem_rr)
          · have hy_lt_k :=
              (forallTree_iff_forall_mem.mp hleft) y hymem_l
            have hy_lt_x : y < x := by omega
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST rl x hbst_rl hxmem
            cases hs : splay rl x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                simp [searchPathKeys, hy_lt_k] at hkey
                right
                simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                  hy_lt_x, hy_lt_k]
                tauto
          · subst y
            simp [searchPathKeys] at hkey
            have hroot_inner :=
              splay_rootKey_eq_some_of_mem_isBST rl x hbst_rl hxmem
            cases hs : splay rl x with
            | empty =>
                simp [rootKey, hs] at hroot_inner
            | node sl sk sr =>
                simp [rootKey, hs] at hroot_inner
                subst sk
                right
                simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                  k_lt_x, hkey]
          · have k_lt_y := by
              exact (forallTree_iff_forall_mem.mp hright) y
                (by simp [BinaryTree.toKeyList, hymem_rl])
            have hy_lt_rk :=
              (forallTree_iff_forall_mem.mp hrl_left) y hymem_rl
            have hnot_y_lt_k : ¬ y < k := by omega
            simp [searchPathKeys, hnot_y_lt_k, k_lt_y, hy_lt_rk] at hkey
            rcases hkey with hkey_k | hkey_rk | hkey_inner
            · left
              simp [searchPathKeys, hnot_x_lt_k, k_lt_x,
                hx_lt_rk, hkey_k]
            · left
              simp [searchPathKeys, hnot_x_lt_k, k_lt_x,
                hx_lt_rk, hkey_rk]
            · rcases hinner y key hymem_rl hkey_inner with
                hkey_x_inner | hkey_after_inner
              · left
                simp [searchPathKeys, hnot_x_lt_k, k_lt_x,
                  hx_lt_rk, hkey_x_inner]
              · right
                exact
                  searchPathKeys_splay_inner_subset_zagZig_after
                    (l := l) (rl := rl) (rr := rr) (k := k) (rk := rk)
                    (x := x) (y := y) (key := key)
                    (IsBST.node k l (BinaryTree.node rl rk rr)
                      hleft hright hbst_left
                      (IsBST.node rk rl rr hrl_left hrr_right
                        hbst_rl hbst_rr))
                    hxmem hymem_rl hkey_after_inner
          · subst y
            have hk_lt_rk :=
              (forallTree_iff_forall_mem.mp hright) rk
                (by simp [BinaryTree.toKeyList])
            have hnot_rk_lt_k : ¬ rk < k := by omega
            simp [searchPathKeys, hk_lt_rk, hnot_rk_lt_k] at hkey
            rcases hkey with hkey_k | hkey_rk
            · left
              simp [searchPathKeys, hnot_x_lt_k, k_lt_x,
                hx_lt_rk, hkey_k]
            · right
              have hroot_inner :=
                splay_rootKey_eq_some_of_mem_isBST rl x hbst_rl hxmem
              cases hs : splay rl x with
              | empty =>
                  simp [rootKey, hs] at hroot_inner
              | node sl sk sr =>
                  simp [rootKey, hs] at hroot_inner
                  subst sk
                  have hnot_rk_lt_x : ¬ rk < x := by omega
                  simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                    hx_lt_rk, hnot_rk_lt_x, hkey_rk]
          · have rk_lt_y :=
              (forallTree_iff_forall_mem.mp hrr_right) y hymem_rr
            have y_right_mem :
                y ∈ (BinaryTree.node rl rk rr).toKeyList := by
              simp [BinaryTree.toKeyList, hymem_rr]
            have k_lt_y :=
              (forallTree_iff_forall_mem.mp hright) y y_right_mem
            have x_lt_y : x < y := by omega
            have hnot_y_lt_k : ¬ y < k := by omega
            have hnot_y_lt_rk : ¬ y < rk := by omega
            simp [searchPathKeys, hnot_y_lt_k, k_lt_y,
              hnot_y_lt_rk, rk_lt_y] at hkey
            rcases hkey with hkey_k | hkey_rk | hkey_tail
            · left
              simp [searchPathKeys, hnot_x_lt_k, k_lt_x,
                hx_lt_rk, hkey_k]
            · right
              have hroot_inner :=
                splay_rootKey_eq_some_of_mem_isBST rl x hbst_rl hxmem
              cases hs : splay rl x with
              | empty =>
                  simp [rootKey, hs] at hroot_inner
              | node sl sk sr =>
                  simp [rootKey, hs] at hroot_inner
                  subst sk
                  have hnot_y_lt_x : ¬ y < x := by omega
                  simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                    hnot_y_lt_x, x_lt_y, hnot_y_lt_rk, rk_lt_y, hkey_rk]
            · right
              have hroot_inner :=
                splay_rootKey_eq_some_of_mem_isBST rl x hbst_rl hxmem
              cases hs : splay rl x with
              | empty =>
                  simp [rootKey, hs] at hroot_inner
              | node sl sk sr =>
                  simp [rootKey, hs] at hroot_inner
                  subst sk
                  have hnot_y_lt_x : ¬ y < x := by omega
                  simp [rotate, rotateLeft, rotateRight, hs, searchPathKeys,
                    hnot_y_lt_x, x_lt_y, hnot_y_lt_rk, rk_lt_y, hkey_tail]

private theorem searchPathKeys_splay_zagZig_branch_old_subset_of_inner
    {l rl rr : BinaryTree} {k rk x y key : Nat}
