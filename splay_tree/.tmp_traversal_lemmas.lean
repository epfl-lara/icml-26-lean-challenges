private theorem suffix_pathSum_le_strictLowerPair_add_two_length_of_tail_dominance
    {n : Nat} {X : Fin n → Nat} {m : Fin n} {ts : BinaryTree}
    (htail_dom :
      ∀ (t : BinaryTree) (i : Fin (n - (m.val + 1)))
          (xs : List (Fin (n - (m.val + 1)))),
        rootKey t = some (X m) →
        suffixSeq X m i < X m →
        (∀ j : Fin (n - (m.val + 1)), j ∈ xs →
          suffixSeq X m j ≤ X m) →
        splayPathSum (suffixSeq X m) (splay t (suffixSeq X m i)) xs ≤
          ((splay t (suffixSeq X m i)).search_path_len (X m) : ℝ) +
            suffixResetUpperPathSum (suffixSeq X m) (X m)
              (splay (splay t (suffixSeq X m i)) (X m)) xs +
            xs.length)
    (hroot : rootKey ts = some (X m))
    (hsuf_le :
      ∀ j : Fin (n - (m.val + 1)), suffixSeq X m j ≤ X m) :
    splayPathSum (suffixSeq X m) ts
        (List.finRange (n - (m.val + 1))) ≤
      pivotResetPairPathSum (strictLowerSuffixSeq X m) (X m) ts
          (List.finRange (strictLowerSuffixIndices X m).length) +
        2 * ((n - (m.val + 1) : Nat) : ℝ) := by
  have hupper :=
    rooted_upper_pathSum_le_pivotResetPairPathSum_add_two_length
      (suffixSeq X m) (X m) htail_dom
      (List.finRange (n - (m.val + 1))) ts hroot
      (by
        intro i _hi
        exact hsuf_le i)
  have hfilter :
      (List.finRange (n - (m.val + 1))).filter
          (fun i => decide (suffixSeq X m i < X m)) =
        strictLowerSuffixIndices X m := by
    rfl
  rw [hfilter] at hupper
  rw [pivotResetPairPathSum_strictLowerSuffixIndices_eq X m ts] at hupper
  simpa [List.length_finRange] using hupper

