  have hreset :
      suffixResetTreeAfter Y q t [i] = splay (splay t (Y i)) q := by
    simpa using suffixResetTreeAfter_append_singleton_lt Y q [] t i hi_lt
  have hfin : 0 ≤ Ψ ([i] ++ xs) [] := hfinal_nonneg [i] xs
  rw [hactual, hreset] at hmain
  nlinarith

private theorem rooted_upper_tailWithFinal_dominance_of_prefix_pair_bound
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ) (hD : 0 ≤ D)
    (hle_all : ∀ i : Fin n, Y i ≤ q)
    (hpair :
      ∀ (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
