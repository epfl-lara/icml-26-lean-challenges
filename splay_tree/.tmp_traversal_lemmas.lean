      (∀ y : Nat, y ∈ (attachRightFrames t fs).toKeyList → y ≤ q) →
      splay.cost (attachRightFrames t fs) q +
          reverseStrongSequentialPotential (splayMaxUnwindResult t fs) ≤
        reverseStrongSequentialPotential (attachRightFrames t fs) +
          (fs.length : ℝ) + (rightMaxDepth t : ℝ)
| .empty, fs, q, _hbst, hmem, _hmax => by
    simp [BinaryTree.toKeyList] at hmem
| .node l k .empty, fs, q, hbst, hmem, hmax => by
    have h :=
      splayMaxContext_right_empty_amortized_of_max
        (l := l) (k := k) (q := q) (fs := fs) hbst hmem hmax
    simpa [splayMaxUnwindResult, rightMaxDepth, add_assoc] using h
| .node l k (.node rl rk .empty), fs, q, hbst, hmem, hmax => by
