private theorem rooted_upper_tail_dominance_singleton
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (t : BinaryTree)
    (i j : Fin n)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (_hi_mem : Y i ∈ t.toKeyList)
    (_hi_lt : Y i < q)
    (hj_mem : Y j ∈ t.toKeyList)
    (hj_le : Y j ≤ q) :
    splayPathSum Y (splay t (Y i)) [j] ≤
      ((splay t (Y i)).search_path_len q : ℝ) +
        suffixResetUpperPathSum Y q
          (splay (splay t (Y i)) q) [j] +
        1 := by
  let tx := splay t (Y i)
  let tr := splay tx q
  have hbst_tx : IsBST tx := by
    unfold tx
    exact splay_isBST t (Y i) hbst
  have hq_mem_tx : q ∈ tx.toKeyList := by
    unfold tx
    rw [splay_toKeyList]
    exact rootKey_mem_toKeyList hroot
  have hj_mem_tx : Y j ∈ tx.toKeyList := by
    unfold tx
    rw [splay_toKeyList]
    exact hj_mem
  rcases lt_or_eq_of_le hj_le with hj_lt | hj_eq
  · have hpath :=
      search_path_len_real_le_reset_search_path_add_of_mem
        (t := tx) (q := q) (y := Y j)
        hbst_tx hq_mem_tx hj_mem_tx
    change
      splayPathSum Y tx [j] ≤
        (tx.search_path_len q : ℝ) +
          suffixResetUpperPathSum Y q tr [j] + 1
    simp [splayPathSum, suffixResetUpperPathSum, tr, hj_lt]
    nlinarith [show 0 ≤ ((splay tr (Y j)).search_path_len q : ℝ) by positivity]
  · change
      splayPathSum Y tx [j] ≤
        (tx.search_path_len q : ℝ) +
          suffixResetUpperPathSum Y q tr [j] + 1
    have hnot : ¬ Y j < q := by omega
    simp [splayPathSum, suffixResetUpperPathSum, hj_eq, hnot]
    nlinarith [show 0 ≤ (tx.search_path_len q : ℝ) by positivity]

private theorem rooted_upper_tail_dominance_length_le_one
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (t : BinaryTree)
    (i : Fin n) (xs : List (Fin n))
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hi_mem : Y i ∈ t.toKeyList)
    (hi_lt : Y i < q)
    (hmem : ∀ j : Fin n, j ∈ xs → Y j ∈ t.toKeyList)
    (hle : ∀ j : Fin n, j ∈ xs → Y j ≤ q)
    (hxs : xs.length ≤ 1) :
    splayPathSum Y (splay t (Y i)) xs ≤
      ((splay t (Y i)).search_path_len q : ℝ) +
        suffixResetUpperPathSum Y q
          (splay (splay t (Y i)) q) xs +
        xs.length := by
  cases xs with
  | nil =>
      simp [splayPathSum, suffixResetUpperPathSum]
  | cons j xs =>
      cases xs with
      | nil =>
          simpa using rooted_upper_tail_dominance_singleton
            Y q t i j hbst hroot hi_mem hi_lt
            (hmem j (by simp)) (hle j (by simp))
      | cons k xs =>
          simp at hxs

private theorem resetRelation_pathSum_le_suffixReset
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (R : BinaryTree → BinaryTree → Prop) (D : ℝ) (hD : 0 ≤ D)
    (hpair :
      ∀ (a b : BinaryTree) (i : Fin n),
        R a b →
        IsBST a →
        IsBST b →
        rootKey b = some q →
        q ∈ a.toKeyList →
        Y i ∈ a.toKeyList →
        Y i ∈ b.toKeyList →
        Y i < q →
        (a.search_path_len (Y i) : ℝ) +
            ((splay a (Y i)).search_path_len q : ℝ) ≤
          (a.search_path_len q : ℝ) +
            (b.search_path_len (Y i) : ℝ) +
            ((splay b (Y i)).search_path_len q : ℝ) + D)
    (hpres_lt :
      ∀ (a b : BinaryTree) (i : Fin n),
        R a b →
        Y i < q →
        R (splay a (Y i)) (splay (splay b (Y i)) q))
    (hpres_eq :
      ∀ (a b : BinaryTree) (i : Fin n),
        R a b →
        Y i = q →
        R (splay a (Y i)) b) :
    ∀ (xs : List (Fin n)) (a b : BinaryTree),
      R a b →
      IsBST a →
      IsBST b →
      rootKey b = some q →
      q ∈ a.toKeyList →
      (∀ i : Fin n, i ∈ xs → Y i ∈ a.toKeyList) →
      (∀ i : Fin n, i ∈ xs → Y i ∈ b.toKeyList) →
      (∀ i : Fin n, i ∈ xs → Y i ≤ q) →
      splayPathSum Y a xs ≤
        (a.search_path_len q : ℝ) +
          suffixResetUpperPathSum Y q b xs + D * xs.length
| [], a, b, _hR, _hbst_a, _hbst_b, _hroot_b, _hq_a,
    _hmem_a, _hmem_b, _hle => by
    simp [splayPathSum, suffixResetUpperPathSum]
| i :: xs, a, b, hR, hbst_a, hbst_b, hroot_b, hq_a,
    hmem_a, hmem_b, hle => by
    have hi_mem_a : Y i ∈ a.toKeyList := hmem_a i (by simp)
    have hi_mem_b : Y i ∈ b.toKeyList := hmem_b i (by simp)
    have hmem_tail_a :
        ∀ j : Fin n, j ∈ xs → Y j ∈ a.toKeyList := by
      intro j hj
      exact hmem_a j (by simp [hj])
    have hmem_tail_b :
        ∀ j : Fin n, j ∈ xs → Y j ∈ b.toKeyList := by
      intro j hj
      exact hmem_b j (by simp [hj])
    have hle_tail :
        ∀ j : Fin n, j ∈ xs → Y j ≤ q := by
      intro j hj
      exact hle j (by simp [hj])
    have hi_le : Y i ≤ q := hle i (by simp)
    by_cases hi_lt : Y i < q
    · let a' := splay a (Y i)
      let b' := splay (splay b (Y i)) q
      have hR' : R a' b' := by
        unfold a' b'
        exact hpres_lt a b i hR hi_lt
      have hbst_a' : IsBST a' := by
        unfold a'
        exact splay_isBST a (Y i) hbst_a
      have hbst_b' : IsBST b' := by
        unfold b'
        exact splay_isBST (splay b (Y i)) q
          (splay_isBST b (Y i) hbst_b)
      have hroot_b' : rootKey b' = some q := by
        unfold b'
        exact rootKey_after_pivot_reset_of_root hbst_b hroot_b
      have hq_a' : q ∈ a'.toKeyList := by
        unfold a'
        rw [splay_toKeyList]
        exact hq_a
      have hmem_tail_a' :
          ∀ j : Fin n, j ∈ xs → Y j ∈ a'.toKeyList := by
        intro j hj
        unfold a'
        rw [splay_toKeyList]
        exact hmem_tail_a j hj
      have hmem_tail_b' :
          ∀ j : Fin n, j ∈ xs → Y j ∈ b'.toKeyList := by
        intro j hj
        unfold b'
        rw [splay_toKeyList, splay_toKeyList]
        exact hmem_tail_b j hj
      have ih :=
        resetRelation_pathSum_le_suffixReset Y q R D hD
          hpair hpres_lt hpres_eq xs a' b' hR'
          hbst_a' hbst_b' hroot_b' hq_a'
          hmem_tail_a' hmem_tail_b' hle_tail
      have hp :=
        hpair a b i hR hbst_a hbst_b hroot_b hq_a
          hi_mem_a hi_mem_b hi_lt
      simp [splayPathSum, suffixResetUpperPathSum, hi_lt, a', b']
      nlinarith
    · have hi_eq : Y i = q := by omega
      let a' := splay a (Y i)
      have hR' : R a' b := by
        unfold a'
        exact hpres_eq a b i hR hi_eq
      have hbst_a' : IsBST a' := by
        unfold a'
        exact splay_isBST a (Y i) hbst_a
      have hq_a' : q ∈ a'.toKeyList := by
        unfold a'
        rw [splay_toKeyList]
        exact hq_a
      have hmem_tail_a' :
          ∀ j : Fin n, j ∈ xs → Y j ∈ a'.toKeyList := by
        intro j hj
        unfold a'
        rw [splay_toKeyList]
        exact hmem_tail_a j hj
      have ih :=
        resetRelation_pathSum_le_suffixReset Y q R D hD
          hpair hpres_lt hpres_eq xs a' b hR'
          hbst_a' hbst_b hroot_b hq_a'
          hmem_tail_a' hmem_tail_b hle_tail
      have hroot_a' : rootKey a' = some q := by
        unfold a'
        rw [hi_eq]
        exact splay_rootKey_eq_some_of_mem_isBST a q hbst_a hq_a
      have hpath_a' : a'.search_path_len q = 1 :=
        search_path_len_eq_one_of_rootKey_eq_some hroot_a'
      rw [hpath_a'] at ih
      simp [splayPathSum, suffixResetUpperPathSum, hi_eq, a'] at ih ⊢
      nlinarith

private theorem resetRelation_pathWithFinal_le_suffixReset
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (R : BinaryTree → BinaryTree → Prop) (D : ℝ) (hD : 0 ≤ D)
    (hpair :
      ∀ (a b : BinaryTree) (i : Fin n),
        R a b →
        IsBST a →
        IsBST b →
        rootKey b = some q →
        q ∈ a.toKeyList →
        Y i ∈ a.toKeyList →
        Y i ∈ b.toKeyList →
        Y i < q →
        (a.search_path_len (Y i) : ℝ) +
            ((splay a (Y i)).search_path_len q : ℝ) ≤
          (a.search_path_len q : ℝ) +
            (b.search_path_len (Y i) : ℝ) +
            ((splay b (Y i)).search_path_len q : ℝ) + D)
    (hpres_lt :
      ∀ (a b : BinaryTree) (i : Fin n),
        R a b →
        Y i < q →
        R (splay a (Y i)) (splay (splay b (Y i)) q))
    (hpres_eq :
      ∀ (a b : BinaryTree) (i : Fin n),
        R a b →
        Y i = q →
        R (splay a (Y i)) b) :
    ∀ (xs : List (Fin n)) (a b : BinaryTree),
      R a b →
      IsBST a →
      IsBST b →
      rootKey b = some q →
      q ∈ a.toKeyList →
      (∀ i : Fin n, i ∈ xs → Y i ∈ a.toKeyList) →
      (∀ i : Fin n, i ∈ xs → Y i ∈ b.toKeyList) →
      (∀ i : Fin n, i ∈ xs → Y i ≤ q) →
      splayPathSumWithFinal Y q a xs ≤
        (a.search_path_len q : ℝ) +
          suffixResetUpperPathSum Y q b xs + D * xs.length
| [], a, b, _hR, _hbst_a, _hbst_b, _hroot_b, _hq_a,
    _hmem_a, _hmem_b, _hle => by
    simp [splayPathSumWithFinal, suffixResetUpperPathSum]
| i :: xs, a, b, hR, hbst_a, hbst_b, hroot_b, hq_a,
    hmem_a, hmem_b, hle => by
    have hi_mem_a : Y i ∈ a.toKeyList := hmem_a i (by simp)
    have hi_mem_b : Y i ∈ b.toKeyList := hmem_b i (by simp)
    have hmem_tail_a :
        ∀ j : Fin n, j ∈ xs → Y j ∈ a.toKeyList := by
      intro j hj
      exact hmem_a j (by simp [hj])
    have hmem_tail_b :
        ∀ j : Fin n, j ∈ xs → Y j ∈ b.toKeyList := by
      intro j hj
      exact hmem_b j (by simp [hj])
    have hle_tail :
        ∀ j : Fin n, j ∈ xs → Y j ≤ q := by
      intro j hj
      exact hle j (by simp [hj])
    have hi_le : Y i ≤ q := hle i (by simp)
    by_cases hi_lt : Y i < q
    · let a' := splay a (Y i)
      let b' := splay (splay b (Y i)) q
      have hR' : R a' b' := by
        unfold a' b'
        exact hpres_lt a b i hR hi_lt
      have hbst_a' : IsBST a' := by
        unfold a'
        exact splay_isBST a (Y i) hbst_a
      have hbst_b' : IsBST b' := by
        unfold b'
        exact splay_isBST (splay b (Y i)) q
          (splay_isBST b (Y i) hbst_b)
      have hroot_b' : rootKey b' = some q := by
        unfold b'
        exact rootKey_after_pivot_reset_of_root hbst_b hroot_b
      have hq_a' : q ∈ a'.toKeyList := by
        unfold a'
        rw [splay_toKeyList]
        exact hq_a
      have hmem_tail_a' :
          ∀ j : Fin n, j ∈ xs → Y j ∈ a'.toKeyList := by
        intro j hj
        unfold a'
        rw [splay_toKeyList]
        exact hmem_tail_a j hj
      have hmem_tail_b' :
          ∀ j : Fin n, j ∈ xs → Y j ∈ b'.toKeyList := by
        intro j hj
        unfold b'
        rw [splay_toKeyList, splay_toKeyList]
        exact hmem_tail_b j hj
      have ih :=
        resetRelation_pathWithFinal_le_suffixReset Y q R D hD
          hpair hpres_lt hpres_eq xs a' b' hR'
          hbst_a' hbst_b' hroot_b' hq_a'
          hmem_tail_a' hmem_tail_b' hle_tail
      have hp :=
        hpair a b i hR hbst_a hbst_b hroot_b hq_a
          hi_mem_a hi_mem_b hi_lt
      simp [splayPathSumWithFinal, suffixResetUpperPathSum, hi_lt, a', b']
      nlinarith [hD, show 0 ≤ (xs.length : ℝ) by positivity]
    · have hi_eq : Y i = q := by omega
      let a' := splay a (Y i)
      have hR' : R a' b := by
        unfold a'
        exact hpres_eq a b i hR hi_eq
      have hbst_a' : IsBST a' := by
        unfold a'
        exact splay_isBST a (Y i) hbst_a
      have hq_a' : q ∈ a'.toKeyList := by
        unfold a'
        rw [splay_toKeyList]
        exact hq_a
      have hmem_tail_a' :
          ∀ j : Fin n, j ∈ xs → Y j ∈ a'.toKeyList := by
        intro j hj
        unfold a'
        rw [splay_toKeyList]
        exact hmem_tail_a j hj
      have ih :=
        resetRelation_pathWithFinal_le_suffixReset Y q R D hD
          hpair hpres_lt hpres_eq xs a' b hR'
          hbst_a' hbst_b hroot_b hq_a'
          hmem_tail_a' hmem_tail_b hle_tail
      have hroot_a' : rootKey a' = some q := by
        unfold a'
        rw [hi_eq]
        exact splay_rootKey_eq_some_of_mem_isBST a q hbst_a hq_a
      have hpath_a' : a'.search_path_len q = 1 :=
        search_path_len_eq_one_of_rootKey_eq_some hroot_a'
      rw [hpath_a'] at ih
      have hsplay_q_alias : splay a q = a' := by
        unfold a'
        rw [hi_eq]
      have hlen_le :
          (xs.length : ℝ) ≤ (xs.length : ℝ) + 1 := by
        nlinarith
      have hD_len :
          D * (xs.length : ℝ) ≤
            D * ((xs.length : ℝ) + 1) := by
        exact mul_le_mul_of_nonneg_left hlen_le hD
      have ih_mono :
          splayPathSumWithFinal Y q a' xs ≤
            (1 : ℝ) + suffixResetUpperPathSum Y q b xs +
              D * ((xs.length : ℝ) + 1) := by
        calc
          splayPathSumWithFinal Y q a' xs
              ≤ (1 : ℝ) + suffixResetUpperPathSum Y q b xs +
                  D * (xs.length : ℝ) := by
                simpa using ih
          _ ≤ (1 : ℝ) + suffixResetUpperPathSum Y q b xs +
                  D * ((xs.length : ℝ) + 1) := by
                linarith
      simp [splayPathSumWithFinal, suffixResetUpperPathSum, hi_eq,
        hsplay_q_alias]
      nlinarith

private theorem rooted_upper_tail_dominance_of_resetRelation
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (R : BinaryTree → BinaryTree → Prop) (D : ℝ) (hD : 0 ≤ D)
    (hpair :
      ∀ (a b : BinaryTree) (i : Fin n),
        R a b →
        IsBST a →
        IsBST b →
        rootKey b = some q →
        q ∈ a.toKeyList →
        Y i ∈ a.toKeyList →
        Y i ∈ b.toKeyList →
        Y i < q →
        (a.search_path_len (Y i) : ℝ) +
            ((splay a (Y i)).search_path_len q : ℝ) ≤
          (a.search_path_len q : ℝ) +
            (b.search_path_len (Y i) : ℝ) +
            ((splay b (Y i)).search_path_len q : ℝ) + D)
    (hpres_lt :
      ∀ (a b : BinaryTree) (i : Fin n),
        R a b →
        Y i < q →
        R (splay a (Y i)) (splay (splay b (Y i)) q))
    (hpres_eq :
      ∀ (a b : BinaryTree) (i : Fin n),
        R a b →
        Y i = q →
        R (splay a (Y i)) b)
    (hinit :
      ∀ (t : BinaryTree) (i : Fin n),
        IsBST t →
        rootKey t = some q →
        Y i ∈ t.toKeyList →
        Y i < q →
        R (splay t (Y i)) (splay (splay t (Y i)) q)) :
    ∀ (t : BinaryTree) (i : Fin n) (xs : List (Fin n)),
      IsBST t →
      rootKey t = some q →
      Y i ∈ t.toKeyList →
      Y i < q →
      (∀ j : Fin n, j ∈ xs → Y j ∈ t.toKeyList) →
      (∀ j : Fin n, j ∈ xs → Y j ≤ q) →
      splayPathSum Y (splay t (Y i)) xs ≤
        ((splay t (Y i)).search_path_len q : ℝ) +
          suffixResetUpperPathSum Y q
            (splay (splay t (Y i)) q) xs +
          D * xs.length := by
  intro t i xs hbst hroot hi_mem hi_lt hmem hle
  let a := splay t (Y i)
  let b := splay (splay t (Y i)) q
  have hR : R a b := by
    unfold a b
    exact hinit t i hbst hroot hi_mem hi_lt
  have hbst_a : IsBST a := by
    unfold a
    exact splay_isBST t (Y i) hbst
  have hbst_b : IsBST b := by
    unfold b
    exact splay_isBST (splay t (Y i)) q
      (splay_isBST t (Y i) hbst)
  have hroot_b : rootKey b = some q := by
    unfold b
    exact rootKey_after_pivot_reset_of_root hbst hroot
  have hq_a : q ∈ a.toKeyList := by
    unfold a
    rw [splay_toKeyList]
    exact rootKey_mem_toKeyList hroot
  have hmem_a : ∀ j : Fin n, j ∈ xs → Y j ∈ a.toKeyList := by
    intro j hj
    unfold a
    rw [splay_toKeyList]
    exact hmem j hj
  have hmem_b : ∀ j : Fin n, j ∈ xs → Y j ∈ b.toKeyList := by
    intro j hj
    unfold b
    rw [splay_toKeyList, splay_toKeyList]
    exact hmem j hj
  exact
    resetRelation_pathSum_le_suffixReset
      Y q R D hD hpair hpres_lt hpres_eq xs a b hR
      hbst_a hbst_b hroot_b hq_a hmem_a hmem_b hle

private theorem splayPathSum_le_suffixResetUpperPathSum_of_lower_reset_step
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (hstep :
      ∀ (t : BinaryTree) (i : Fin n) (xs : List (Fin n)),
        IsBST t → q ∈ t.toKeyList →
        Y i ∈ t.toKeyList → Y i < q →
        (∀ j : Fin n, j ∈ xs → Y j ∈ t.toKeyList) →
        (∀ j : Fin n, j ∈ xs → Y j ≤ q) →
        (t.search_path_len (Y i) : ℝ) +
            (splay t (Y i)).search_path_len q +
            suffixResetUpperPathSum Y q
              (splay (splay t (Y i)) q) xs ≤
          t.search_path_len q +
            suffixResetUpperPathSum Y q (splay t q) (i :: xs)) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t → q ∈ t.toKeyList →
      (∀ i : Fin n, i ∈ xs → Y i ∈ t.toKeyList) →
      (∀ i : Fin n, i ∈ xs → Y i ≤ q) →
      splayPathSum Y t xs ≤
        t.search_path_len q +
          suffixResetUpperPathSum Y q (splay t q) xs
| [], t, _hbst, _hqmem, _hmem, _hle => by
    simp [splayPathSum, suffixResetUpperPathSum]
| i :: xs, t, hbst, hqmem, hmem, hle => by
    have hi_mem : Y i ∈ t.toKeyList := hmem i (by simp)
    have hi_le : Y i ≤ q := hle i (by simp)
    have hmem_tail : ∀ j : Fin n, j ∈ xs → Y j ∈ t.toKeyList := by
      intro j hj
      exact hmem j (by simp [hj])
    have hle_tail : ∀ j : Fin n, j ∈ xs → Y j ≤ q := by
      intro j hj
      exact hle j (by simp [hj])
    by_cases hi_lt : Y i < q
    · have htail :=
        splayPathSum_le_suffixResetUpperPathSum_of_lower_reset_step
          Y q hstep xs (splay t (Y i))
          (splay_isBST t (Y i) hbst)
          (by
            rw [splay_toKeyList]
            exact hqmem)
          (by
            intro j hj
            rw [splay_toKeyList]
            exact hmem_tail j hj)
          hle_tail
      have hstep_i :=
        hstep t i xs hbst hqmem hi_mem hi_lt hmem_tail hle_tail
      simp [splayPathSum]
      nlinarith
    · have hi_eq : Y i = q := by omega
      have htail :=
        splayPathSum_le_suffixResetUpperPathSum_of_lower_reset_step
          Y q hstep xs (splay t q)
          (splay_isBST t q hbst)
          (by
            rw [splay_toKeyList]
            exact hqmem)
          (by
            intro j hj
            rw [splay_toKeyList]
            exact hmem_tail j hj)
          hle_tail
      have hroot_s : rootKey (splay t q) = some q :=
        splay_rootKey_eq_some_of_mem_isBST t q hbst hqmem
      have hpath_s : (splay t q).search_path_len q = 1 :=
        search_path_len_eq_one_of_rootKey_eq_some hroot_s
      have hsplay_s : splay (splay t q) q = splay t q :=
        splay_eq_self_of_rootKey_eq_some hroot_s
      rw [hpath_s, hsplay_s] at htail
      norm_num at htail
      simp [splayPathSum, suffixResetUpperPathSum, hi_eq]
      nlinarith

private theorem lower_continuation_of_lower_reset_step
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (hstep :
      ∀ (t : BinaryTree) (i : Fin n) (xs : List (Fin n)),
        IsBST t → q ∈ t.toKeyList →
        Y i ∈ t.toKeyList → Y i < q →
        (∀ j : Fin n, j ∈ xs → Y j ∈ t.toKeyList) →
        (∀ j : Fin n, j ∈ xs → Y j ≤ q) →
        (t.search_path_len (Y i) : ℝ) +
            (splay t (Y i)).search_path_len q +
            suffixResetUpperPathSum Y q
              (splay (splay t (Y i)) q) xs ≤
          t.search_path_len q +
            suffixResetUpperPathSum Y q (splay t q) (i :: xs)) :
      ∀ (t : BinaryTree) (i : Fin n) (xs : List (Fin n)),
        IsBST t → rootKey t = some q →
        Y i ∈ t.toKeyList → Y i < q →
        (∀ j : Fin n, j ∈ xs → Y j ∈ t.toKeyList) →
        (∀ j : Fin n, j ∈ xs → Y j ≤ q) →
        splayPathSum Y (splay t (Y i)) xs ≤
          (splay t (Y i)).search_path_len q +
            suffixResetUpperPathSum Y q
              (splay (splay t (Y i)) q) xs := by
  intro t i xs hbst hroot hi_mem _hi_lt hmem_tail hle_tail
  have hqmem : q ∈ t.toKeyList := rootKey_mem_toKeyList hroot
  exact
    splayPathSum_le_suffixResetUpperPathSum_of_lower_reset_step
      Y q hstep xs (splay t (Y i))
      (splay_isBST t (Y i) hbst)
      (by
        rw [splay_toKeyList]
        exact hqmem)
      (by
        intro j hj
        rw [splay_toKeyList]
        exact hmem_tail j hj)
      hle_tail

private noncomputable def activeHullKeys {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (xs : List (Fin n)) : List Nat :=
  t.toKeyList.filter (fun key =>
    decide (∃ i : Fin n, i ∈ xs ∧ key ∈ searchPathKeys t (X i)))

private noncomputable def activeHullSize {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (xs : List (Fin n)) : Nat :=
  (activeHullKeys X t xs).length

private theorem activeHullKeys_subset_toKeyList {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n))
    {key : Nat} :
    key ∈ activeHullKeys X t xs → key ∈ t.toKeyList := by
  intro hkey
  unfold activeHullKeys at hkey
  exact List.mem_of_mem_filter hkey

private theorem mem_activeHullKeys_iff {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n))
    {key : Nat} :
    key ∈ activeHullKeys X t xs ↔
      key ∈ t.toKeyList ∧
        ∃ i : Fin n, i ∈ xs ∧ key ∈ searchPathKeys t (X i) := by
  unfold activeHullKeys
  rw [List.mem_filter]
  simp

private theorem activeHullKeys_nodup_of_isBST {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n))
    (hbst : IsBST t) :
    (activeHullKeys X t xs).Nodup := by
  unfold activeHullKeys
  exact List.Nodup.filter _
    (isBST_toKeyList_nodup hbst)

private theorem mem_activeHullKeys_of_mem_searchPath {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n))
    {i : Fin n} {key : Nat}
    (hi : i ∈ xs) (hpath : key ∈ searchPathKeys t (X i)) :
    key ∈ activeHullKeys X t xs := by
  unfold activeHullKeys
  refine List.mem_filter_of_mem ?_ ?_
  · exact searchPathKeys_subset_toKeyList t (X i) key hpath
  · exact decide_eq_true
      (show ∃ j : Fin n, j ∈ xs ∧ key ∈ searchPathKeys t (X j) from
        ⟨i, hi, hpath⟩)

private theorem filter_sublist_filter_of_imp {α : Type}
    (p q : α → Bool)
    (himp : ∀ x, p x = true → q x = true) :
    ∀ xs : List α, (xs.filter p).Sublist (xs.filter q)
| [] => by
    simp
| x :: xs => by
    have ih := filter_sublist_filter_of_imp p q himp xs
    by_cases hp : p x = true
    · have hq : q x = true := himp x hp
      simp [List.filter, hp, hq, ih]
    · by_cases hq : q x = true
      · simp [List.filter, hp, hq]
        exact List.Sublist.cons x ih
      · simp [List.filter, hp, hq, ih]

private theorem activeHullKeys_sublist_of_sublist {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) {xs ys : List (Fin n)}
    (hsub : xs.Sublist ys) :
    (activeHullKeys X t xs).Sublist (activeHullKeys X t ys) := by
  unfold activeHullKeys
  apply filter_sublist_filter_of_imp
  intro key hkey
  simp at hkey ⊢
  rcases hkey with ⟨i, hi, hpath⟩
  exact ⟨i, hsub.subset hi, hpath⟩

private theorem activeHullSize_sublist_le {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) {xs ys : List (Fin n)}
    (hsub : xs.Sublist ys) :
    activeHullSize X t xs ≤ activeHullSize X t ys := by
  unfold activeHullSize
  exact List.Sublist.length_le
    (activeHullKeys_sublist_of_sublist X t hsub)

private theorem activeHullSize_le_num_nodes {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) :
    activeHullSize X t xs ≤ t.num_nodes := by
  unfold activeHullSize activeHullKeys
  have hlen := List.length_eq_length_filter_add
    (l := t.toKeyList)
    (f := fun key =>
      decide (∃ i : Fin n, i ∈ xs ∧ key ∈ searchPathKeys t (X i)))
  rw [toKeyList_length] at hlen
  omega

private theorem activeHullSize_append_le {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs ys : List (Fin n))
    (hbst : IsBST t) :
    activeHullSize X t (xs ++ ys) ≤
      activeHullSize X t xs + activeHullSize X t ys := by
  have happ_nodup :
      (activeHullKeys X t (xs ++ ys)).Nodup :=
    activeHullKeys_nodup_of_isBST X (xs ++ ys) hbst
  have hxs_nodup :
      (activeHullKeys X t xs).Nodup :=
    activeHullKeys_nodup_of_isBST X xs hbst
  have hys_nodup :
      (activeHullKeys X t ys).Nodup :=
    activeHullKeys_nodup_of_isBST X ys hbst
  have happ_card :
      (activeHullKeys X t (xs ++ ys)).toFinset.card =
        activeHullSize X t (xs ++ ys) := by
    unfold activeHullSize
    exact List.toFinset_card_of_nodup happ_nodup
  have hxs_card :
      (activeHullKeys X t xs).toFinset.card =
        activeHullSize X t xs := by
    unfold activeHullSize
    exact List.toFinset_card_of_nodup hxs_nodup
  have hys_card :
      (activeHullKeys X t ys).toFinset.card =
        activeHullSize X t ys := by
    unfold activeHullSize
    exact List.toFinset_card_of_nodup hys_nodup
  rw [← happ_card, ← hxs_card, ← hys_card]
  calc
    (activeHullKeys X t (xs ++ ys)).toFinset.card
        ≤ ((activeHullKeys X t xs).toFinset ∪
            (activeHullKeys X t ys).toFinset).card := by
          apply Finset.card_le_card
          intro key hkey
          have hmem : key ∈ activeHullKeys X t (xs ++ ys) := by
            simpa using hkey
          rw [Finset.mem_union]
          rcases (mem_activeHullKeys_iff X t (xs ++ ys)).mp hmem with
            ⟨hkey_tree, i, hi, hpath⟩
          simp at hi
          rcases hi with hix | hiy
          · left
            simpa using
              (mem_activeHullKeys_iff X t xs).mpr
                ⟨hkey_tree, i, hix, hpath⟩
          · right
            simpa using
              (mem_activeHullKeys_iff X t ys).mpr
                ⟨hkey_tree, i, hiy, hpath⟩
    _ ≤ (activeHullKeys X t xs).toFinset.card +
          (activeHullKeys X t ys).toFinset.card :=
        Finset.card_union_le _ _

private theorem activeHullKeys_append_toFinset_subset_union {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs ys : List (Fin n)) :
    (activeHullKeys X t (xs ++ ys)).toFinset ⊆
      (activeHullKeys X t xs).toFinset ∪
        (activeHullKeys X t ys).toFinset := by
  intro key hkey
  have hmem : key ∈ activeHullKeys X t (xs ++ ys) := by
    simpa using hkey
  rw [Finset.mem_union]
  rcases (mem_activeHullKeys_iff X t (xs ++ ys)).mp hmem with
    ⟨hkey_tree, i, hi, hpath⟩
  simp at hi
  rcases hi with hix | hiy
  · left
    simpa using
      (mem_activeHullKeys_iff X t xs).mpr
        ⟨hkey_tree, i, hix, hpath⟩
  · right
    simpa using
      (mem_activeHullKeys_iff X t ys).mpr
        ⟨hkey_tree, i, hiy, hpath⟩

private theorem activeHullKeys_append_inter_card_le {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs ys : List (Fin n))
    (P : Finset Nat) :
    ((activeHullKeys X t (xs ++ ys)).toFinset ∩ P).card ≤
      ((activeHullKeys X t xs).toFinset ∩ P).card +
        ((activeHullKeys X t ys).toFinset ∩ P).card := by
  classical
  have hsub :
      (activeHullKeys X t (xs ++ ys)).toFinset ∩ P ⊆
        ((activeHullKeys X t xs).toFinset ∩ P) ∪
          ((activeHullKeys X t ys).toFinset ∩ P) := by
    intro key hkey
    rw [Finset.mem_inter] at hkey
    rcases hkey with ⟨hkey_hull, hkey_P⟩
    have hsplit :=
      activeHullKeys_append_toFinset_subset_union X t xs ys hkey_hull
    rw [Finset.mem_union] at hsplit ⊢
    rcases hsplit with hxs | hys
    · left
      exact Finset.mem_inter.mpr ⟨hxs, hkey_P⟩
    · right
      exact Finset.mem_inter.mpr ⟨hys, hkey_P⟩
  calc
    ((activeHullKeys X t (xs ++ ys)).toFinset ∩ P).card
        ≤ (((activeHullKeys X t xs).toFinset ∩ P) ∪
            ((activeHullKeys X t ys).toFinset ∩ P)).card :=
          Finset.card_le_card hsub
    _ ≤ ((activeHullKeys X t xs).toFinset ∩ P).card +
          ((activeHullKeys X t ys).toFinset ∩ P).card :=
        Finset.card_union_le _ _

private theorem activeHullKeys_after_splay_key_le_of_tail_le {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hle_tail : ∀ j : Fin n, j ∈ xs → X j ≤ X i)
    {key : Nat}
    (hkey : key ∈ activeHullKeys X (splay t (X i)) xs) :
    key ≤ X i := by
  rcases (mem_activeHullKeys_iff X (splay t (X i)) xs).mp hkey with
    ⟨_hkey_tree, j, hj, hpath⟩
  have hbst_s : IsBST (splay t (X i)) :=
    splay_isBST t (X i) hbst
  have hroot_s :
      rootKey (splay t (X i)) = some (X i) :=
    splay_rootKey_eq_some_of_mem_isBST t (X i) hbst hi_mem
  exact
    searchPathKeys_key_le_root_of_target_le_root
      (splay t (X i)) hbst_s hroot_s (hle_tail j hj) hpath

private theorem activeHullKeys_after_splay_root_le_key_of_tail_ge {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hle_tail : ∀ j : Fin n, j ∈ xs → X i ≤ X j)
    {key : Nat}
    (hkey : key ∈ activeHullKeys X (splay t (X i)) xs) :
    X i ≤ key := by
  rcases (mem_activeHullKeys_iff X (splay t (X i)) xs).mp hkey with
    ⟨_hkey_tree, j, hj, hpath⟩
  have hbst_s : IsBST (splay t (X i)) :=
    splay_isBST t (X i) hbst
  have hroot_s :
      rootKey (splay t (X i)) = some (X i) :=
    splay_rootKey_eq_some_of_mem_isBST t (X i) hbst hi_mem
  exact
    root_le_searchPathKeys_key_of_root_le_target
      (splay t (X i)) hbst_s hroot_s (hle_tail j hj) hpath

private theorem search_path_len_le_activeHullSize_of_mem {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n))
    (hbst : IsBST t) {i : Fin n} (hi : i ∈ xs) :
    t.search_path_len (X i) ≤ activeHullSize X t xs := by
  rw [← searchPathKeys_length_eq_search_path_len]
  have hpath_nodup : (searchPathKeys t (X i)).Nodup :=
    searchPathKeys_nodup_of_isBST t (X i) hbst
  have hhull_nodup : (activeHullKeys X t xs).Nodup :=
    activeHullKeys_nodup_of_isBST X xs hbst
  have hpath_card :
      (searchPathKeys t (X i)).toFinset.card =
        (searchPathKeys t (X i)).length :=
    List.toFinset_card_of_nodup hpath_nodup
  have hhull_card :
      (activeHullKeys X t xs).toFinset.card =
        activeHullSize X t xs := by
    unfold activeHullSize
    exact List.toFinset_card_of_nodup hhull_nodup
  rw [← hpath_card, ← hhull_card]
  apply Finset.card_le_card
  intro key hkey
  simp at hkey ⊢
  exact mem_activeHullKeys_of_mem_searchPath X t xs hi hkey

private theorem activeHullKeys_nil {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) :
    activeHullKeys X t [] = [] := by
  unfold activeHullKeys
  apply List.eq_nil_iff_forall_not_mem.mpr
  intro key hkey
  have hactive := (List.mem_filter.mp hkey).2
  simp at hactive

private theorem activeHullSize_nil {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) :
    activeHullSize X t [] = 0 := by
  unfold activeHullSize
  rw [activeHullKeys_nil]
  simp

private theorem search_path_len_real_le_activeHullSize_of_mem {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n))
    (hbst : IsBST t) {i : Fin n} (hi : i ∈ xs) :
    (t.search_path_len (X i) : ℝ) ≤ activeHullSize X t xs := by
  exact_mod_cast search_path_len_le_activeHullSize_of_mem X xs hbst hi

private theorem activeHullKeys_after_splay_sublist_cons {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList) :
    (activeHullKeys X (splay t (X i)) xs).Sublist
      (activeHullKeys X t (i :: xs)) := by
  unfold activeHullKeys
  rw [splay_toKeyList]
  apply filter_sublist_filter_of_imp
  intro key hkey
  simp at hkey ⊢
  rcases hkey with ⟨j, hj, hpath⟩
  have hor :=
    searchPathKeys_splay_subset_union t (X i) (X j) key
      hbst hi_mem (hmem_tail j hj) hpath
  rcases hor with hi_path | hj_path
  · exact Or.inl hi_path
  · exact Or.inr ⟨j, by simp [hj], hj_path⟩

private theorem activeHullSize_after_splay_le_cons {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList) :
    activeHullSize X (splay t (X i)) xs ≤
      activeHullSize X t (i :: xs) := by
  unfold activeHullSize
  exact List.Sublist.length_le
    (activeHullKeys_after_splay_sublist_cons
      X i xs hbst hi_mem hmem_tail)

private theorem activeHullKeys_after_splay_length_add_path_len_le_cons_add_inter
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList) :
    (activeHullKeys X (splay t (X i)) xs).length +
        t.search_path_len (X i) ≤
      (activeHullKeys X t (i :: xs)).length +
        ((activeHullKeys X (splay t (X i)) xs).toFinset ∩
          (searchPathKeys t (X i)).toFinset).card := by
  classical
  let newKeys := activeHullKeys X (splay t (X i)) xs
  let oldKeys := activeHullKeys X t (i :: xs)
  let pathKeys := searchPathKeys t (X i)
  have hnew_nodup : newKeys.Nodup := by
    unfold newKeys
    exact activeHullKeys_nodup_of_isBST X xs
      (splay_isBST t (X i) hbst)
  have hold_nodup : oldKeys.Nodup := by
    unfold oldKeys
    exact activeHullKeys_nodup_of_isBST X (i :: xs) hbst
  have hpath_nodup : pathKeys.Nodup := by
    unfold pathKeys
    exact searchPathKeys_nodup_of_isBST t (X i) hbst
  have hnew_card : newKeys.toFinset.card = newKeys.length :=
    List.toFinset_card_of_nodup hnew_nodup
  have hold_card : oldKeys.toFinset.card = oldKeys.length :=
    List.toFinset_card_of_nodup hold_nodup
  have hpath_card : pathKeys.toFinset.card = pathKeys.length :=
    List.toFinset_card_of_nodup hpath_nodup
  have hnew_subset : newKeys.toFinset ⊆ oldKeys.toFinset := by
    intro key hkey
    have hkey_new : key ∈ activeHullKeys X (splay t (X i)) xs := by
      simpa [newKeys] using hkey
    have hsub :=
      activeHullKeys_after_splay_sublist_cons
        X i xs hbst hi_mem hmem_tail
    simpa [oldKeys] using hsub.subset hkey_new
  have hpath_subset : pathKeys.toFinset ⊆ oldKeys.toFinset := by
    intro key hkey
    have hkey_path : key ∈ searchPathKeys t (X i) := by
      simpa [pathKeys] using hkey
    have hkey_old : key ∈ activeHullKeys X t (i :: xs) :=
      mem_activeHullKeys_of_mem_searchPath X t (i :: xs)
        (i := i) (by simp) hkey_path
    simpa [oldKeys] using hkey_old
  have hunion_subset :
      newKeys.toFinset ∪ pathKeys.toFinset ⊆ oldKeys.toFinset := by
    intro key hkey
    rw [Finset.mem_union] at hkey
    rcases hkey with hkey_new | hkey_path
    · exact hnew_subset hkey_new
    · exact hpath_subset hkey_path
  have hcard_union_bound :
      (newKeys.toFinset ∪ pathKeys.toFinset).card ≤
        oldKeys.toFinset.card :=
    Finset.card_le_card hunion_subset
  have hcard_sum :
      newKeys.toFinset.card + pathKeys.toFinset.card ≤
        oldKeys.toFinset.card +
          (newKeys.toFinset ∩ pathKeys.toFinset).card := by
    have hinc :=
      Finset.card_union_add_card_inter newKeys.toFinset pathKeys.toFinset
    omega
  have hlen :
      newKeys.length + pathKeys.length ≤
        oldKeys.length +
          (newKeys.toFinset ∩ pathKeys.toFinset).card := by
    omega
  rw [show pathKeys.length = t.search_path_len (X i) by
    unfold pathKeys
    exact searchPathKeys_length_eq_search_path_len t (X i)] at hlen
  simpa [newKeys, oldKeys, pathKeys] using hlen

private theorem search_path_len_add_activeHullSize_after_splay_le_two_cons
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList) :
    t.search_path_len (X i) + activeHullSize X (splay t (X i)) xs ≤
      2 * activeHullSize X t (i :: xs) := by
  have hpath :
      t.search_path_len (X i) ≤ activeHullSize X t (i :: xs) := by
    exact search_path_len_le_activeHullSize_of_mem
      X (i :: xs) hbst (i := i) (by simp)
  have hafter :=
    activeHullSize_after_splay_le_cons X i xs hbst hi_mem hmem_tail
  omega

private noncomputable def activeBudget {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (xs : List (Fin n)) : ℝ :=
  (xs.length : ℝ) + activeHullSize X t xs

private theorem activeBudget_nonneg {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) :
    0 ≤ activeBudget X t xs := by
  unfold activeBudget
  positivity

private theorem activeBudget_sublist_le {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) {xs ys : List (Fin n)}
    (hsub : xs.Sublist ys) :
    activeBudget X t xs ≤ activeBudget X t ys := by
  have hlen := List.Sublist.length_le hsub
  have hhull := activeHullSize_sublist_le X t hsub
  unfold activeBudget
  exact_mod_cast Nat.add_le_add hlen hhull

private theorem activeBudget_after_splay_le_cons {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList) :
    activeBudget X (splay t (X i)) xs ≤
      activeBudget X t (i :: xs) := by
  have hlen : xs.length ≤ (i :: xs).length := by simp
  have hhull :=
    activeHullSize_after_splay_le_cons X i xs hbst hi_mem hmem_tail
  unfold activeBudget
  exact_mod_cast Nat.add_le_add hlen hhull

private theorem activeBudget_drop_le_of_intersection_bound_32
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList)
    (hinter :
      32 *
          ((activeHullKeys X (splay t (X i)) xs).toFinset ∩
            (searchPathKeys t (X i)).toFinset).card ≤
        31 * t.search_path_len (X i) + 304) :
    (t.search_path_len (X i) : ℝ) +
        32 * activeBudget X (splay t (X i)) xs ≤
      272 + 32 * activeBudget X t (i :: xs) := by
  let newKeys := activeHullKeys X (splay t (X i)) xs
  let oldKeys := activeHullKeys X t (i :: xs)
  let pathKeys := searchPathKeys t (X i)
  let m := (newKeys.toFinset ∩ pathKeys.toFinset).card
  have hcount :
      newKeys.length + t.search_path_len (X i) ≤
        oldKeys.length + m := by
    simpa [newKeys, oldKeys, pathKeys, m] using
      activeHullKeys_after_splay_length_add_path_len_le_cons_add_inter
        X i xs hbst hi_mem hmem_tail
  have hinter' : 32 * m ≤ 31 * t.search_path_len (X i) + 304 := by
    simpa [newKeys, pathKeys, m] using hinter
  have hnat :
      t.search_path_len (X i) +
          32 * (xs.length + newKeys.length) ≤
        272 + 32 * ((i :: xs).length + oldKeys.length) := by
    simp
    omega
  have hreal :
      ((t.search_path_len (X i) +
          32 * (xs.length + newKeys.length) : Nat) : ℝ) ≤
        (272 + 32 * ((i :: xs).length + oldKeys.length) : Nat) := by
    exact_mod_cast hnat
  unfold activeBudget activeHullSize
  change
    (t.search_path_len (X i) : ℝ) +
        32 * ((xs.length : ℝ) +
          (activeHullKeys X (splay t (X i)) xs).length) ≤
      272 + 32 * (((i :: xs).length : ℝ) +
        (activeHullKeys X t (i :: xs)).length)
  norm_num [Nat.cast_add, Nat.cast_mul] at hreal ⊢
  simpa [newKeys, oldKeys] using hreal

private theorem activeBudget_drop_le_of_intersection_bound_four
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList)
    (hinter :
      4 *
          ((activeHullKeys X (splay t (X i)) xs).toFinset ∩
            (searchPathKeys t (X i)).toFinset).card ≤
        3 * t.search_path_len (X i) + 12) :
    (t.search_path_len (X i) : ℝ) +
        4 * activeBudget X (splay t (X i)) xs ≤
      8 + 4 * activeBudget X t (i :: xs) := by
  let newKeys := activeHullKeys X (splay t (X i)) xs
  let oldKeys := activeHullKeys X t (i :: xs)
  let pathKeys := searchPathKeys t (X i)
  let m := (newKeys.toFinset ∩ pathKeys.toFinset).card
  have hcount :
      newKeys.length + t.search_path_len (X i) ≤
        oldKeys.length + m := by
    simpa [newKeys, oldKeys, pathKeys, m] using
      activeHullKeys_after_splay_length_add_path_len_le_cons_add_inter
        X i xs hbst hi_mem hmem_tail
  have hinter' : 4 * m ≤ 3 * t.search_path_len (X i) + 12 := by
    simpa [newKeys, pathKeys, m] using hinter
  have hnat :
      t.search_path_len (X i) +
          4 * (xs.length + newKeys.length) ≤
        8 + 4 * ((i :: xs).length + oldKeys.length) := by
    simp
    omega
  have hreal :
      ((t.search_path_len (X i) +
          4 * (xs.length + newKeys.length) : Nat) : ℝ) ≤
        (8 + 4 * ((i :: xs).length + oldKeys.length) : Nat) := by
    exact_mod_cast hnat
  unfold activeBudget activeHullSize
  change
    (t.search_path_len (X i) : ℝ) +
        4 * ((xs.length : ℝ) +
          (activeHullKeys X (splay t (X i)) xs).length) ≤
      8 + 4 * (((i :: xs).length : ℝ) +
        (activeHullKeys X t (i :: xs)).length)
  norm_num [Nat.cast_add, Nat.cast_mul] at hreal ⊢
  simpa [newKeys, oldKeys] using hreal

private theorem activeBudget_drop_le_of_intersection_card_bound
    {n : Nat} (C : Nat) (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList)
    (hinter :
      ((activeHullKeys X (splay t (X i)) xs).toFinset ∩
        (searchPathKeys t (X i)).toFinset).card ≤ C + 1) :
    (t.search_path_len (X i) : ℝ) +
        activeBudget X (splay t (X i)) xs ≤
      (C : ℝ) + activeBudget X t (i :: xs) := by
  let newKeys := activeHullKeys X (splay t (X i)) xs
