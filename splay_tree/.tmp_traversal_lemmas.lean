private theorem traversal_conjecture_of_mixed_boundary_blocks
    (Ks Ku : ℝ) (hKs : 0 ≤ Ks) (hKu : 0 ≤ Ku)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          Ks * boundaryBudget Y t (List.finRange N) q)
    (hupper :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i ≤ q) →
        splayPathSum Y t (List.finRange N) ≤
          Ku * boundaryBudget Y t (List.finRange N) q) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  refine ⟨2 * (Ks + Ku), ?_⟩
  intro n X havoid init h_size hbst hmem
  by_cases hn : 0 < n
  · have hcost_path := sequence_cost_add_length_eq_pathSum X init hmem
    obtain ⟨m, _hmax, _hfirst, hpreAvoid, _hsufAvoid, hpre_lt,
        hsuf_le, _hpre_suf, hrec⟩ :=
      exists_first_max_path_decomp hn X havoid init
    let tp := splayTreeAfter (prefixSeq X m) init (List.finRange m.val)
    let ts := splay tp (X m)
    let B := boundaryBudget X init (List.finRange n) (X m)
    have hprefix :
        splayPathSum (prefixSeq X m) init (List.finRange m.val) +
            ((tp.search_path_len (X m) : ℝ)) ≤
          Ks * B := by
      unfold B tp
      exact
        prefix_pivot_pathSum_le_full_boundaryBudget_of_bound
          Ks hKs hstrict hbst hmem hpreAvoid hpre_lt
    have hsuffix :
        splayPathSum (suffixSeq X m) ts
            (List.finRange (n - (m.val + 1))) ≤
          Ku * B := by
      unfold B ts tp
      exact
        suffix_pathSum_le_full_boundary_of_upper_bound
          Ku hKu hupper (m := m) havoid hbst hmem hsuf_le
    have hB_le : B ≤ 2 * (n : ℝ) := by
      unfold B
      have hb :=
        boundaryBudget_le_length_add_num_nodes
          X init (List.finRange n) (X m)
      rw [List.length_finRange, h_size] at hb
      nlinarith
    have hpath :
        splayPathSum X init (List.finRange n) ≤
          (Ks + Ku) * B := by
      rw [hrec]
      change
        splayPathSum (prefixSeq X m) init (List.finRange m.val) +
            ((tp.search_path_len (X m) : ℝ) +
              splayPathSum (suffixSeq X m) ts
                (List.finRange (n - (m.val + 1)))) ≤
          (Ks + Ku) * B
      nlinarith
    have hpath_linear :
        splayPathSum X init (List.finRange n) ≤
          2 * (Ks + Ku) * (n : ℝ) := by
      have hcoef : 0 ≤ Ks + Ku := by nlinarith
      have hmul :
          (Ks + Ku) * B ≤ (Ks + Ku) * (2 * (n : ℝ)) := by
        exact mul_le_mul_of_nonneg_left hB_le hcoef
      nlinarith
    nlinarith [show 0 ≤ (n : ℝ) by positivity, hcost_path, hpath_linear]
  · have hn_zero : n = 0 := by omega
    have hcost := sequence_cost_le_num_nodes_mul_length X init
    have hcost0 : splay.sequence_cost init X ≤ 0 := by
      have hcost' := hcost
      rw [h_size] at hcost'
      have hnR : (n : ℝ) = 0 := by
        exact_mod_cast hn_zero
      nlinarith
    have hgoal : (2 * (Ks + Ku)) * (n : ℝ) = 0 := by
      rw [hn_zero]
      norm_num
    rw [hgoal]
    exact hcost0

private theorem traversal_conjecture_of_potential_upper_blocks
    (Ks K D P : ℝ) (hKs : 0 ≤ Ks) (hK : 0 ≤ K)
    (hD : 0 ≤ D) (hP : 0 ≤ P)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          Ks * boundaryBudget Y t (List.finRange N) q)
    (hlower :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        pivotResetLowerPathSum Y q t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q)
    (Ψ :
      ∀ {N : Nat}, (Fin N → Nat) → Nat → BinaryTree →
        List (Fin N) → List (Fin N) → ℝ)
    (hlt_step :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree)
          (done : List (Fin N)) (i : Fin N) (future : List (Fin N)),
        IsBST t →
        rootKey t = some q →
        (Y avoids ![2, 3, 1]) →
        (∀ j : Fin N, Y j ≤ q) →
        (done ++ i :: future).Sublist (List.finRange N) →
        (∀ j : Fin N, j ∈ done ++ i :: future → Y j ∈ t.toKeyList) →
        Y i ∈ (splayTreeAfter Y t done).toKeyList →
        Y i < q →
        ((splayTreeAfter Y t done).search_path_len (Y i) : ℝ) +
            ((splay (splayTreeAfter Y t done) (Y i)).search_path_len q : ℝ) +
            Ψ Y q t (done ++ [i]) future ≤
          ((splayTreeAfter Y t done).search_path_len q : ℝ) +
            ((suffixResetTreeAfter Y q t done).search_path_len (Y i) : ℝ) +
            ((splay (suffixResetTreeAfter Y q t done) (Y i)).search_path_len q : ℝ) +
            D + Ψ Y q t done (i :: future))
    (heq_step :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree)
          (done : List (Fin N)) (i : Fin N) (future : List (Fin N)),
        IsBST t →
        rootKey t = some q →
        (Y avoids ![2, 3, 1]) →
        (∀ j : Fin N, Y j ≤ q) →
        (done ++ i :: future).Sublist (List.finRange N) →
        (∀ j : Fin N, j ∈ done ++ i :: future → Y j ∈ t.toKeyList) →
        Y i = q →
        Ψ Y q t (done ++ [i]) future ≤
          D + Ψ Y q t done (i :: future))
    (hfinal_nonneg :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i ≤ q) →
        0 ≤ Ψ Y q t (List.finRange N) [])
    (hinit_potential :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i ≤ q) →
        Ψ Y q t [] (List.finRange N) ≤
          P * boundaryBudget Y t (List.finRange N) q) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  let Ku : ℝ := 2 * K + D + P + 2
  have hKu : 0 ≤ Ku := by
    unfold Ku
    nlinarith
  have hupper :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i ≤ q) →
        splayPathSum Y t (List.finRange N) ≤
          Ku * boundaryBudget Y t (List.finRange N) q := by
    intro N Y q t hbst hroot hmem havoid hle
    unfold Ku
    exact
      rooted_upper_pathSum_le_boundaryBudget_of_lower_reset_potential_finRange
        Y q t K D P hK hD (Ψ Y q t) hlower
        (fun done i future hsub hmem_sub hi_mem hi_lt =>
          hlt_step Y q t done i future hbst hroot havoid hle
            hsub hmem_sub hi_mem hi_lt)
        (fun done i future hsub hmem_sub hi_eq =>
          heq_step Y q t done i future hbst hroot havoid hle
            hsub hmem_sub hi_eq)
        (hfinal_nonneg Y q t hbst hroot hmem havoid hle)
        (hinit_potential Y q t hbst hroot hmem havoid hle)
        hbst hroot hmem havoid hle
  exact
    traversal_conjecture_of_mixed_boundary_blocks
      Ks Ku hKs hKu hstrict hupper

