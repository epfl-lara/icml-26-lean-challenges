private theorem last_pivot_state_split_or_all_done_strict
    {n : Nat} {Y : Fin n → Nat} {q : Nat}
    {done future : List (Fin n)} {i : Fin n}
    (t : BinaryTree)
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    (hle : ∀ j : Fin n, Y j ≤ q) :
    (∀ j : Fin n, j ∈ done → Y j < q) ∨
      ∃ left : List (Fin n), ∃ p : Fin n, ∃ right : List (Fin n),
        done = left ++ p :: right ∧
          Y p = q ∧
          (∀ c : Fin right.length, Y (right.get c) < q) ∧
          (∀ a : Fin left.length,
            Y (left.get a) < q → Y (left.get a) ≤ Y i) ∧
          (∀ a : Fin left.length, ∀ c : Fin right.length,
            Y (left.get a) < q → Y (left.get a) ≤ Y (right.get c)) ∧
          splayTreeAfter Y t done =
            splayTreeAfter Y
              (splay (splayTreeAfter Y t left) q) right ∧
          suffixResetTreeAfter Y q t done =
            suffixResetTreeAfter Y q
              (suffixResetTreeAfter Y q t left) right := by
  by_cases hpivot : ∃ p : Fin n, p ∈ done ∧ Y p = q
  · right
    exact
      exists_last_pivot_state_split_with_barriers
        (Y := Y) (q := q) (done := done) (future := future)
        (i := i) t hsub havoid hle hpivot
  · left
    intro j hj
    have hj_le : Y j ≤ q := hle j
    by_contra hj_not_lt
    have hj_eq : Y j = q := by omega
    exact hpivot ⟨j, hj, hj_eq⟩

private theorem prefix_pair_bound_of_last_pivot_split
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (havoid : Y avoids ![2, 3, 1])
    (hle : ∀ j : Fin n, Y j ≤ q)
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (hall_strict :
      (∀ j : Fin n, j ∈ done → Y j < q) →
        ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
            ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) ≤
          ((splayTreeAfter Y init done).search_path_len q : ℝ) +
            ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
            ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
            D)
    (hlast_pivot :
      ∀ (left : List (Fin n)) (p : Fin n) (right : List (Fin n)),
        done = left ++ p :: right →
        Y p = q →
        (∀ c : Fin right.length, Y (right.get c) < q) →
        (∀ a : Fin left.length,
          Y (left.get a) < q → Y (left.get a) ≤ Y i) →
        (∀ a : Fin left.length, ∀ c : Fin right.length,
          Y (left.get a) < q → Y (left.get a) ≤ Y (right.get c)) →
        splayTreeAfter Y init done =
          splayTreeAfter Y
            (splay (splayTreeAfter Y init left) q) right →
        suffixResetTreeAfter Y q init done =
          suffixResetTreeAfter Y q
            (suffixResetTreeAfter Y q init left) right →
        ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
            ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) ≤
          ((splayTreeAfter Y init done).search_path_len q : ℝ) +
            ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
            ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
            D) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
        ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init done).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
        D := by
  rcases last_pivot_state_split_or_all_done_strict
      (Y := Y) (q := q) (done := done) (future := future)
      (i := i) init hsub havoid hle with hstrict | hpivot
  · exact hall_strict hstrict
  · rcases hpivot with
      ⟨left, p, right, hsplit, hp_eq, hright_lt,
        hleft_current, hleft_right, hactual, hreset⟩
    exact
      hlast_pivot left p right hsplit hp_eq hright_lt
        hleft_current hleft_right hactual hreset

private theorem resetPairDominatesAbove_threshold_of_last_pivot_split
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
