      exact hi_mem
    · exact hmem_tail j hjxs
  have hmain :=
    splayPathSum_add_potential_le_suffixResetUpperPathSum_of_prefix_pair_potential_mem_done
      Y q t D hD Ψ hbst hroot hle_all
      (fun done j future hsub' hmem' hj_mem hj_lt =>
        hlt_step t done j future hbst hroot hsub' hmem' hj_mem hj_lt)
      (fun done j future hsub' hmem' hj_eq =>
