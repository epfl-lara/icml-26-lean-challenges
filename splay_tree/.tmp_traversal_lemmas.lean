private theorem boundaryBudget_suffixSeq_after_prefix_pivot_le_finRange
    {n : Nat} {X : Fin n → Nat} {init : BinaryTree} {m : Fin n}
    (hbst : IsBST init)
    (hmem : ∀ i : Fin n, X i ∈ init.toKeyList) :
    let ts :=
      splay
        (splayTreeAfter (prefixSeq X m) init (List.finRange m.val))
        (X m)
    boundaryBudget (suffixSeq X m) ts
        (List.finRange (n - (m.val + 1))) (X m) ≤
      boundaryBudget X init (List.finRange n) (X m) := by
  let consumed := ((List.finRange n).take m.val) ++ [m]
  let suffixOrig := (List.finRange n).drop (m.val + 1)
  let ts :=
    splay
      (splayTreeAfter (prefixSeq X m) init (List.finRange m.val))
      (X m)
  have hts_eq :
      ts = splayTreeAfter X init consumed := by
    unfold ts consumed
    exact splayTreeAfter_prefix_pivot_eq_original_take_cons X init m
  have hmem_consumed_suffix :
      ∀ i : Fin n, i ∈ consumed ++ suffixOrig → X i ∈ init.toKeyList := by
    intro i _hi
    exact hmem i
  have hbudget_orig :
      boundaryBudget X (splayTreeAfter X init consumed) suffixOrig (X m) ≤
        boundaryBudget X init (consumed ++ suffixOrig) (X m) :=
    boundaryBudget_after_splayTreeAfter_le_append
      X consumed suffixOrig init (X m) hbst (hmem m) hmem_consumed_suffix
  have hmap :
      boundaryBudget X ts suffixOrig (X m) =
        boundaryBudget (suffixSeq X m) ts
          (List.finRange (n - (m.val + 1))) (X m) := by
    unfold suffixOrig
    rw [finRange_drop_eq_map_suffixIndex m,
      boundaryBudget_map_comp X (suffixIndex m) ts
        (List.finRange (n - (m.val + 1))) (X m)]
    rfl
  have hsplit : consumed ++ suffixOrig = List.finRange n := by
    unfold consumed suffixOrig
    simpa [List.append_assoc] using (finRange_split_at m).symm
  change
    boundaryBudget (suffixSeq X m) ts
        (List.finRange (n - (m.val + 1))) (X m) ≤
      boundaryBudget X init (List.finRange n) (X m)
  rw [← hmap]
  rw [hts_eq]
  rw [hsplit] at hbudget_orig
  exact hbudget_orig

