    splay_rootKey_eq_some_of_mem_isBST
      (.node a x b) q hbst_inner hmem_inner
  have hright_inner :=
    splay_rightSubtree_empty_of_max_isBST
      (.node a x b) q hbst_inner hmem_inner hmax_inner
  cases hs : splay (.node a x b) q with
  | empty =>
      simp [rootKey, hs] at hroot_inner
  | node sl sk sr =>
      simp [rootKey, hs] at hroot_inner
      subst sk
      cases sr with
      | empty =>
          have hcost_outer :
              splay.cost (.node l k (.node rl rk (.node a x b))) q =
                splay.cost (.node a x b) q + 2 := by
            rw [splay.cost.eq_def]
            simp [hq_ne_k, hnot_q_lt_k, hnot_q_lt_rk, hrk_lt_q]
          have hsplay_outer :
              splay (.node l k (.node rl rk (.node a x b))) q =
                .node (.node (.node l k rl) rk sl) q .empty := by
            rw [splay.eq_def]
            simp [hq_ne_k, hnot_q_lt_k, hnot_q_lt_rk, hrk_lt_q, hs,
              rotate, rotateLeft]
          rw [hs] at hinner
          simp [leftSubtree] at hinner
          rw [hcost_outer, hsplay_outer]
          simp [leftSubtree, reverseStrongSequentialPotential_node_eq,
            nonemptyIndicator] at hinner ⊢
          cases rl <;>
            simp [reverseStrongSequentialPotential, leftEdges, rightEdges,
              nonemptyIndicator] at hinner ⊢ <;>
            nlinarith
      | node srl srk srr =>
          simp [rightSubtree, hs] at hright_inner

private theorem sequentialDeletePotential_rightSubtree_le_five_num_nodes
