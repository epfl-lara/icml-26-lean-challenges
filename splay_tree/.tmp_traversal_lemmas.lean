        K * boundaryBudget X init (List.finRange n) (X m) := by
    exact mul_le_mul_of_nonneg_left hbudget hK
  exact le_trans hsuf_bound hmul

set_option linter.flexible false in
private theorem contains231_iff_exists_triple {n : Nat} {X : Fin n → Nat} :
    contains_pattern X (![2, 3, 1] : Fin 3 → Nat) ↔
      ∃ i j k : Fin n, i < j ∧ j < k ∧ X k < X i ∧ X i < X j := by
  constructor
  · rintro ⟨f, hf, hcmp⟩
    refine ⟨f (0 : Fin 3), f (1 : Fin 3), f (2 : Fin 3), ?_, ?_, ?_, ?_⟩
    · exact hf (show (0 : Fin 3) < (1 : Fin 3) by decide)
    · exact hf (show (1 : Fin 3) < (2 : Fin 3) by decide)
    · exact (hcmp (2 : Fin 3) (0 : Fin 3)).mp (by decide)
    · exact (hcmp (0 : Fin 3) (1 : Fin 3)).mp (by decide)
  · rintro ⟨i, j, k, hij, hjk, hki, hijv⟩
    refine ⟨(fun p : Fin 3 => ![i, j, k] p), ?_, ?_⟩
    · intro a b hab
      fin_cases a <;> fin_cases b <;> simp at hab ⊢
      · exact hij
      · exact lt_trans hij hjk
      · exact hjk
    · intro a b
      fin_cases a <;> fin_cases b <;> simp
      all_goals omega

private theorem avoids231_no_triple {n : Nat} {X : Fin n → Nat}
    (havoid : X avoids ![2, 3, 1]) {i j k : Fin n}
    (hij : i < j) (hjk : j < k) :
    ¬ (X k < X i ∧ X i < X j) := by
  intro hx
  exact havoid (contains231_iff_exists_triple.mpr ⟨i, j, k, hij, hjk, hx.1, hx.2⟩)

private theorem avoids231_subroot_order_contradiction {n : Nat}
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {r p q : Fin n} (hrp : r < p) (hpq : p < q)
    (hqr : X q < X r) (hrp_val : X r < X p) :
    False := by
  exact avoids231_no_triple havoid hrp hpq ⟨hqr, hrp_val⟩

private theorem preorder_next_staticSubRoot_no_smaller {n : Nat}
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {p : Fin n} {small : Nat}
    (hp_sub :
      staticSubRootByTouched X (insertionTreeOfSeq X)
        ((List.finRange n).take p.val) (X p))
    (hsmall_sub :
      staticSubRootByTouched X (insertionTreeOfSeq X)
        ((List.finRange n).take p.val) small)
    (hsmall_lt : small < X p) :
    False := by
  rcases exists_touched_between_of_two_staticSubRoots
      (insertionTreeOfSeq_isBST X) hsmall_sub hp_sub hsmall_lt with
    ⟨sep, hsep_touched, hsmall_sep, hsep_p⟩
  rcases hsep_touched with ⟨i, hi_done, hi_sep⟩
  have hi_lt_p : i < p := mem_take_finRange_lt hi_done
  have hsmall_mem : small ∈ (insertionTreeOfSeq X).toKeyList :=
    hsmall_sub.1
  rcases (mem_insertionTreeOfSeq_iff X small).mp hsmall_mem with
    ⟨j, hj_small⟩
  have hp_lt_j : p < j := by
    have hnot_j_lt_p : ¬ j < p := by
      intro hjp
      have hj_done : j ∈ (List.finRange n).take p.val :=
        mem_take_finRange_of_lt hjp
      exact hsmall_sub.2.1 ⟨j, hj_done, hj_small⟩
    have hp_le_j : p ≤ j := le_of_not_gt hnot_j_lt_p
    have hp_ne_j : p ≠ j := by
      intro hpj
      subst j
      omega
    exact lt_of_le_of_ne hp_le_j hp_ne_j
  have hj_lt_i : X j < X i := by
    rw [hj_small, hi_sep]
    exact hsmall_sep
  have hi_lt_p_value : X i < X p := by
    rw [hi_sep]
    exact hsep_p
  exact avoids231_subroot_order_contradiction
    (X := X) havoid (r := i) (p := p) (q := j)
    hi_lt_p hp_lt_j hj_lt_i hi_lt_p_value

private theorem preorder_first_occurrence_staticSubRoot_smallest {n : Nat}
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {p : Fin n} (hfirst : ∀ i : Fin n, i < p → X i ≠ X p)
    {small : Nat}
    (hsmall_sub :
      staticSubRootByTouched X (insertionTreeOfSeq X)
        ((List.finRange n).take p.val) small)
    (hsmall_lt : small < X p) :
    False := by
  exact preorder_next_staticSubRoot_no_smaller havoid
    (current_first_occurrence_staticSubRootByTouched hfirst)
    hsmall_sub hsmall_lt

private theorem avoids231_left_le_right_of_left_lt_mid {n : Nat}
    {X : Fin n → Nat} (havoid : X avoids ![2, 3, 1])
    {i j k : Fin n} (hij : i < j) (hjk : j < k)
    (hijv : X i < X j) :
    X i ≤ X k := by
  by_contra hnot
  have hki : X k < X i := Nat.lt_of_not_ge hnot
  exact avoids231_no_triple havoid hij hjk ⟨hki, hijv⟩

private theorem listSeq_left_le_right_of_left_lt_mid {n : Nat}
    {Y : Fin n → Nat} {xs : List (Fin n)}
    (hsub : xs.Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    {i j k : Fin xs.length} (hij : i < j) (hjk : j < k)
    (hijv : listSeq Y xs i < listSeq Y xs j) :
    listSeq Y xs i ≤ listSeq Y xs k := by
  exact
    avoids231_left_le_right_of_left_lt_mid
      (listSeq_avoids231_of_sublist_finRange hsub havoid)
      hij hjk hijv

private theorem done_left_le_current_of_pivot_between_avoids231
    {n : Nat} {Y : Fin n → Nat} {done future : List (Fin n)}
    {i : Fin n} {q : Nat}
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    {a b : Fin done.length} (hab : a < b)
    (ha_lt_q : Y (done.get a) < q)
    (hb_eq_q : Y (done.get b) = q) :
    Y (done.get a) ≤ Y i := by
  let xs : List (Fin n) := done ++ i :: future
  let ia : Fin xs.length := ⟨a.val, by
    have ha : a.val < done.length := a.isLt
    simp [xs]
    omega⟩
  let ib : Fin xs.length := ⟨b.val, by
    have hb : b.val < done.length := b.isLt
    simp [xs]
    omega⟩
  let ii : Fin xs.length := ⟨done.length, by
    simp [xs]⟩
  have hia_ib : ia < ib := by
    change a.val < b.val
    exact hab
  have hib_ii : ib < ii := by
    change b.val < done.length
    exact b.isLt
  have ha_lt_b : Y (done.get a) < Y (done.get b) := by
    rw [hb_eq_q]
    exact ha_lt_q
  have hlt :
      listSeq Y xs ia < listSeq Y xs ib := by
    simpa [listSeq, xs, ia, ib] using ha_lt_b
  have hle :=
    listSeq_left_le_right_of_left_lt_mid
      (Y := Y) (xs := xs) hsub havoid hia_ib hib_ii hlt
  simpa [listSeq, xs, ia, ii] using hle

private theorem done_left_le_done_right_of_pivot_between_avoids231
    {n : Nat} {Y : Fin n → Nat} {done future : List (Fin n)}
    {i : Fin n} {q : Nat}
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    {a b c : Fin done.length} (hab : a < b) (hbc : b < c)
    (ha_lt_q : Y (done.get a) < q)
    (hb_eq_q : Y (done.get b) = q) :
    Y (done.get a) ≤ Y (done.get c) := by
  let xs : List (Fin n) := done ++ i :: future
  let ia : Fin xs.length := ⟨a.val, by
    have ha : a.val < done.length := a.isLt
    simp [xs]
    omega⟩
  let ib : Fin xs.length := ⟨b.val, by
    have hb : b.val < done.length := b.isLt
    simp [xs]
    omega⟩
  let ic : Fin xs.length := ⟨c.val, by
    have hc : c.val < done.length := c.isLt
    simp [xs]
    omega⟩
  have hia_ib : ia < ib := by
    change a.val < b.val
    exact hab
  have hib_ic : ib < ic := by
    change b.val < c.val
    exact hbc
  have ha_lt_b : Y (done.get a) < Y (done.get b) := by
    rw [hb_eq_q]
    exact ha_lt_q
  have hlt :
      listSeq Y xs ia < listSeq Y xs ib := by
    simpa [listSeq, xs, ia, ib] using ha_lt_b
  have hle :=
    listSeq_left_le_right_of_left_lt_mid
      (Y := Y) (xs := xs) hsub havoid hia_ib hib_ic hlt
  simpa [listSeq, xs, ia, ic] using hle

private theorem done_later_le_earlier_of_current_lt_earlier_avoids231
    {n : Nat} {Y : Fin n → Nat} {done future : List (Fin n)}
    {i : Fin n}
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    {a b : Fin done.length} (hab : a < b)
    (hcurrent_lt_a : Y i < Y (done.get a)) :
    Y (done.get b) ≤ Y (done.get a) := by
  let xs : List (Fin n) := done ++ i :: future
  let ia : Fin xs.length := ⟨a.val, by
    have ha : a.val < done.length := a.isLt
    simp [xs]
    omega⟩
  let ib : Fin xs.length := ⟨b.val, by
    have hb : b.val < done.length := b.isLt
    simp [xs]
    omega⟩
  let ii : Fin xs.length := ⟨done.length, by
    simp [xs]⟩
  have hia_ib : ia < ib := by
    change a.val < b.val
    exact hab
  have hib_ii : ib < ii := by
    change b.val < done.length
    exact b.isLt
  by_contra hnot
  have hlt_ab : Y (done.get a) < Y (done.get b) := by omega
  have hlt :
      listSeq Y xs ia < listSeq Y xs ib := by
    simpa [listSeq, xs, ia, ib] using hlt_ab
  have hle :=
    listSeq_left_le_right_of_left_lt_mid
      (Y := Y) (xs := xs) hsub havoid hia_ib hib_ii hlt
  have ha_le_i : Y (done.get a) ≤ Y i := by
    simpa [listSeq, xs, ia, ii] using hle
  omega

private theorem done_lower_le_future_of_current_pivot_avoids231
    {n : Nat} {Y : Fin n → Nat} {done future : List (Fin n)}
    {i : Fin n} {q : Nat}
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    (hi_eq : Y i = q)
    {a : Fin done.length} {b : Fin future.length}
    (ha_lt_q : Y (done.get a) < q) :
    Y (done.get a) ≤ Y (future.get b) := by
  let xs : List (Fin n) := done ++ i :: future
  let ia : Fin xs.length := ⟨a.val, by
    have ha : a.val < done.length := a.isLt
    simp [xs]
    omega⟩
  let ii : Fin xs.length := ⟨done.length, by
    simp [xs]⟩
  let ib : Fin xs.length := ⟨done.length + 1 + b.val, by
    have hb : b.val < future.length := b.isLt
    simp [xs]
    omega⟩
  have hia_ii : ia < ii := by
    change a.val < done.length
    exact a.isLt
  have hii_ib : ii < ib := by
    change done.length < done.length + 1 + b.val
    omega
  have ha_lt_i : Y (done.get a) < Y i := by
    rw [hi_eq]
    exact ha_lt_q
  have hlt :
      listSeq Y xs ia < listSeq Y xs ii := by
    simpa [listSeq, xs, ia, ii] using ha_lt_i
  have hle :=
    listSeq_left_le_right_of_left_lt_mid
      (Y := Y) (xs := xs) hsub havoid hia_ii hii_ib hlt
  have hget_b : xs.get ib = future.get b := by
    rcases b with ⟨bv, hbv⟩
    simp [xs, ib, Nat.add_assoc]
    have hs : bv + 1 < (i :: future).length := by
      simpa [Nat.add_comm] using Nat.succ_lt_succ hbv
    simpa [Nat.add_comm] using (List.getElem_cons_succ i future bv hs)
  have hget_a : xs.get ia = done.get a := by
    simp [xs, ia]
  have hle' : Y (xs.get ia) ≤ Y (xs.get ib) := by
    simpa [listSeq] using hle
  rw [hget_a, hget_b] at hle'
  exact hle'

private theorem done_lower_le_futureLowerKey_of_current_pivot_avoids231
    {n : Nat} {Y : Fin n → Nat} {done future : List (Fin n)}
    {i : Fin n} {q x : Nat}
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    (hi_eq : Y i = q)
    (hx : x ∈ futureLowerKeys Y q future)
    {j : Fin n} (hj_done : j ∈ done) (hj_lt_q : Y j < q) :
    Y j ≤ x := by
  rcases (mem_futureLowerKeys_iff Y q x future).mp hx with
    ⟨k, hk_future, hk_eq, _hk_lt⟩
  rcases List.mem_iff_getElem.mp hj_done with ⟨a, ha, hget_j⟩
  rcases List.mem_iff_getElem.mp hk_future with ⟨b, hb, hget_k⟩
  let ia : Fin done.length := ⟨a, ha⟩
  let ib : Fin future.length := ⟨b, hb⟩
  have hja : Y (done.get ia) = Y j := by
    simpa [ia] using congrArg Y hget_j
  have hkb : Y (future.get ib) = x := by
    have hkb' : Y (future.get ib) = Y k := by
      simpa [ib] using congrArg Y hget_k
    exact hkb'.trans hk_eq
  have ha_lt :
      Y (done.get ia) < q := by
    rw [hja]
    exact hj_lt_q
  have hle :=
    done_lower_le_future_of_current_pivot_avoids231
      (Y := Y) (done := done) (future := future) (i := i)
      (q := q) hsub havoid hi_eq (a := ia) (b := ib) ha_lt
  rw [hja, hkb] at hle
  exact hle

private theorem filter_get_order_in_base {α : Type}
    (p : α → Bool) (xs : List α)
    {a b : Fin (xs.filter p).length} (hab : a < b) :
    ∃ ia : Fin xs.length, ∃ ib : Fin xs.length,
      ia < ib ∧
        xs.get ia = (xs.filter p).get a ∧
        xs.get ib = (xs.filter p).get b := by
  let ys := xs.filter p
  have hsub : ys.Sublist xs := by
    unfold ys
    exact List.filter_sublist
  rcases (List.sublist_iff_exists_fin_orderEmbedding_get_eq.mp hsub) with
    ⟨e, he⟩
  refine ⟨e a, e b, e.strictMono hab, ?_, ?_⟩
  · exact (he a).symm
  · exact (he b).symm

private theorem done_gt_current_filter_nonincreasing_of_avoids231
    {n : Nat} {Y : Fin n → Nat} {done future : List (Fin n)}
    {i : Fin n}
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1]) :
    ∀ {a b : Fin (done.filter (fun j => decide (Y i < Y j))).length},
      a < b →
        Y ((done.filter (fun j => decide (Y i < Y j))).get b) ≤
          Y ((done.filter (fun j => decide (Y i < Y j))).get a) := by
  intro a b hab
  let p : Fin n → Bool := fun j => decide (Y i < Y j)
  obtain ⟨ia, ib, hiaib, hgeta, hgetb⟩ :=
    filter_get_order_in_base p done hab
  have hmem_a :
      (done.filter p).get a ∈ done.filter p :=
    List.getElem_mem a.isLt
  have hp_a_bool : p ((done.filter p).get a) = true :=
    (List.mem_filter.mp hmem_a).2
  have hcurrent_lt_a_filter :
      Y i < Y ((done.filter p).get a) := by
    exact of_decide_eq_true hp_a_bool
  have hcurrent_lt_a_done : Y i < Y (done.get ia) := by
    rw [hgeta]
    exact hcurrent_lt_a_filter
  have hle_done :=
    done_later_le_earlier_of_current_lt_earlier_avoids231
      (Y := Y) (done := done) (future := future) (i := i)
      hsub havoid hiaib hcurrent_lt_a_done
  rw [hgeta, hgetb] at hle_done
  simpa [p] using hle_done

private theorem done_gt_current_filter_antitone_of_avoids231
    {n : Nat} {Y : Fin n → Nat} {done future : List (Fin n)}
    {i : Fin n}
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1]) :
    ∀ {a b : Fin (done.filter (fun j => decide (Y i < Y j))).length},
      a ≤ b →
        Y ((done.filter (fun j => decide (Y i < Y j))).get b) ≤
          Y ((done.filter (fun j => decide (Y i < Y j))).get a) := by
  intro a b hab
  by_cases hEq : a = b
  · subst b
    exact le_rfl
  · have hlt : a < b := lt_of_le_of_ne hab hEq
    exact done_gt_current_filter_nonincreasing_of_avoids231
      hsub havoid hlt

private theorem done_gt_current_filter_head_dominates_of_avoids231
    {n : Nat} {Y : Fin n → Nat} {done future : List (Fin n)}
    {i : Fin n}
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    (hpos :
      0 < (done.filter (fun j => decide (Y i < Y j))).length) :
    ∀ r : Fin (done.filter (fun j => decide (Y i < Y j))).length,
      Y ((done.filter (fun j => decide (Y i < Y j))).get r) ≤
        Y ((done.filter (fun j => decide (Y i < Y j))).get
          (⟨0, hpos⟩ :
            Fin (done.filter (fun j => decide (Y i < Y j))).length)) := by
  intro r
  exact
    done_gt_current_filter_antitone_of_avoids231
      (Y := Y) (done := done) (future := future) (i := i)
      hsub havoid (Nat.zero_le r.val)

private theorem done_gt_current_filter_get_gt {n : Nat}
    {Y : Fin n → Nat} {done : List (Fin n)} {i : Fin n} :
    ∀ a : Fin (done.filter (fun j => decide (Y i < Y j))).length,
      Y i < Y ((done.filter (fun j => decide (Y i < Y j))).get a) := by
  intro a
  let p : Fin n → Bool := fun j => decide (Y i < Y j)
  have hmem :
      (done.filter p).get a ∈ done.filter p :=
    List.getElem_mem a.isLt
  have hp : p ((done.filter p).get a) = true :=
    (List.mem_filter.mp hmem).2
  simpa [p] using (of_decide_eq_true hp)

private theorem done_gt_current_filter_sublist_finRange
    {n : Nat} {Y : Fin n → Nat} {done future : List (Fin n)}
    {i : Fin n}
    (hsub : (done ++ i :: future).Sublist (List.finRange n)) :
    (done.filter (fun j => decide (Y i < Y j))).Sublist
      (List.finRange n) := by
  have hdone : done.Sublist (List.finRange n) := by
    exact (List.sublist_append_left done (i :: future)).trans hsub
