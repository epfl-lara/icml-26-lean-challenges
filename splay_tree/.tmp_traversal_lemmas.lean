  unfold upperResetDistinctPotential
  have hb :
      0 ≤ boundaryBudget X (suffixResetTreeAfter X q init done) future q :=
    boundaryBudget_nonneg X (suffixResetTreeAfter X q init done) future q
  have hg :
      0 ≤ actualResetDistinctGapPotential X q init done future :=
    actualResetDistinctGapPotential_nonneg X q init done future
