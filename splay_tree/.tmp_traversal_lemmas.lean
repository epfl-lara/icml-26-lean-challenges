private theorem resetPairDominatesAbove_after_strict_lists_of_contextual_preservation
    {n : Nat}
    (Y : Fin n → Nat) (q lo : Nat) (D : ℝ)
    (xs : List (Fin n)) (actual reset : BinaryTree)
    (hpres_lt :
      ∀ (pre : List (Fin n)) (i : Fin n) (tail : List (Fin n)),
        xs = pre ++ i :: tail →
        resetPairDominatesAbove q lo D
          (splayTreeAfter Y actual pre)
          (suffixResetTreeAfter Y q reset pre) →
        Y i ∈ (splayTreeAfter Y actual pre).toKeyList →
        Y i < q →
        resetPairDominatesAbove q lo D
          (splay (splayTreeAfter Y actual pre) (Y i))
          (splay (splay (suffixResetTreeAfter Y q reset pre) (Y i)) q))
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hmem : ∀ i : Fin n, i ∈ xs → Y i ∈ actual.toKeyList)
    (hlt : ∀ i : Fin n, i ∈ xs → Y i < q) :
    resetPairDominatesAbove q lo D
      (splayTreeAfter Y actual xs)
      (suffixResetTreeAfter Y q reset xs) := by
  induction xs generalizing actual reset with
  | nil =>
      simpa [splayTreeAfter, suffixResetTreeAfter] using hdom
  | cons i tail ih =>
      have hi_mem : Y i ∈ actual.toKeyList := hmem i (by simp)
      have hi_lt : Y i < q := hlt i (by simp)
      let actual' := splay actual (Y i)
      let reset' := splay (splay reset (Y i)) q
      have hdom' : resetPairDominatesAbove q lo D actual' reset' := by
        unfold actual' reset'
        simpa [splayTreeAfter, suffixResetTreeAfter, hi_lt] using
          hpres_lt [] i tail (by simp) hdom hi_mem hi_lt
      have hmem_tail' :
          ∀ j : Fin n, j ∈ tail → Y j ∈ actual'.toKeyList := by
        intro j hj
        unfold actual'
        rw [splay_toKeyList]
        exact hmem j (by simp [hj])
      have hlt_tail : ∀ j : Fin n, j ∈ tail → Y j < q := by
        intro j hj
        exact hlt j (by simp [hj])
      have hpres_tail :
          ∀ (pre : List (Fin n)) (j : Fin n)
              (rest : List (Fin n)),
            tail = pre ++ j :: rest →
            resetPairDominatesAbove q lo D
              (splayTreeAfter Y actual' pre)
              (suffixResetTreeAfter Y q reset' pre) →
            Y j ∈ (splayTreeAfter Y actual' pre).toKeyList →
            Y j < q →
            resetPairDominatesAbove q lo D
              (splay (splayTreeAfter Y actual' pre) (Y j))
              (splay
                (splay (suffixResetTreeAfter Y q reset' pre) (Y j)) q) := by
        intro pre j rest hsplit hdom_pre hj_mem hj_lt
        have hsplit_full : i :: tail = (i :: pre) ++ j :: rest := by
          simp [hsplit]
        have hdom_full :
            resetPairDominatesAbove q lo D
              (splayTreeAfter Y actual (i :: pre))
              (suffixResetTreeAfter Y q reset (i :: pre)) := by
          simpa [splayTreeAfter, suffixResetTreeAfter, hi_lt,
            actual', reset'] using hdom_pre
        have hj_mem_full :
            Y j ∈ (splayTreeAfter Y actual (i :: pre)).toKeyList := by
          simpa [splayTreeAfter, actual'] using hj_mem
        have hstep :=
          hpres_lt (i :: pre) j rest hsplit_full
            hdom_full hj_mem_full hj_lt
        simpa [splayTreeAfter, suffixResetTreeAfter, hi_lt,
          actual', reset'] using hstep
      have htail :=
        ih actual' reset' hpres_tail hdom' hmem_tail' hlt_tail
      simpa [splayTreeAfter, suffixResetTreeAfter, hi_lt, actual', reset']
        using htail

