private theorem pivotResetLowerPathSum_finRange_prefix_pivot_suffix
    {n : Nat} (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (m : Fin n) :
    pivotResetLowerPathSum X q init (List.finRange n) =
      pivotResetLowerPathSum (prefixSeq X m) q init
          (List.finRange m.val) +
        (((pivotResetTreeAfter (prefixSeq X m) q init
            (List.finRange m.val)).search_path_len (X m) : ℝ) +
          pivotResetLowerPathSum (suffixSeq X m) q
            (splay
              (splay
                (pivotResetTreeAfter (prefixSeq X m) q init
                  (List.finRange m.val))
                (X m))
              q)
            (List.finRange (n - (m.val + 1)))) := by
  let pre := (List.finRange n).take m.val
  let suf := (List.finRange n).drop (m.val + 1)
  have hsplit : List.finRange n = pre ++ [m] ++ suf := by
    unfold pre suf
    exact finRange_split_at m
  rw [hsplit]
  rw [pivotResetLowerPathSum_split_singleton X q pre suf m init]
  rw [pivotResetLowerPathSum_take_eq_prefixSeq X q init m]
  rw [pivotResetTreeAfter_take_eq_prefixSeq X q init m]
  rw [pivotResetLowerPathSum_drop_eq_suffixSeq X q
    (splay
      (splay
        (pivotResetTreeAfter (prefixSeq X m) q init
          (List.finRange m.val))
        (X m))
      q) m]

private theorem splayPathSum_finRange_prefix_pivot_suffix {n : Nat}
    (X : Fin n → Nat) (init : BinaryTree) (m : Fin n) :
    splayPathSum X init (List.finRange n) =
      splayPathSum (prefixSeq X m) init (List.finRange m.val) +
        ((splayTreeAfter (prefixSeq X m) init
            (List.finRange m.val)).search_path_len (X m) +
          splayPathSum (suffixSeq X m)
            (splay
              (splayTreeAfter (prefixSeq X m) init
                (List.finRange m.val))
              (X m))
            (List.finRange (n - (m.val + 1)))) := by
  have hsplit := splayPathSum_finRange_split_at X init m
  rw [splayPathSum_take_eq_prefixSeq X init m] at hsplit
  rw [splayTreeAfter_take_eq_prefixSeq X init m] at hsplit
  rw [splayPathSum_drop_eq_suffixSeq X
    (splay
      (splayTreeAfter (prefixSeq X m) init (List.finRange m.val))
      (X m)) m] at hsplit
  exact hsplit

private theorem splayPathSumWithFinal_finRange_prefix_pivot_suffix
    {n : Nat} (X : Fin n → Nat) (init : BinaryTree) (m : Fin n)
    (q : Nat) :
    splayPathSumWithFinal X q init (List.finRange n) =
      splayPathSum (prefixSeq X m) init (List.finRange m.val) +
        ((splayTreeAfter (prefixSeq X m) init
            (List.finRange m.val)).search_path_len (X m) +
          splayPathSumWithFinal (suffixSeq X m) q
            (splay
              (splayTreeAfter (prefixSeq X m) init
                (List.finRange m.val))
              (X m))
            (List.finRange (n - (m.val + 1)))) := by
  let pre := (List.finRange n).take m.val
  let suf := (List.finRange n).drop (m.val + 1)
  have hsplit : List.finRange n = pre ++ [m] ++ suf := by
    unfold pre suf
    exact finRange_split_at m
  change
    splayPathSumWithFinal X q init (List.finRange n) =
      splayPathSum (prefixSeq X m) init (List.finRange m.val) +
        (↑((splayTreeAfter (prefixSeq X m) init
            (List.finRange m.val)).search_path_len (X m)) +
          splayPathSumWithFinal (suffixSeq X m) q
            (splay
              (splayTreeAfter (prefixSeq X m) init
                (List.finRange m.val))
              (X m))
            (List.finRange (n - (m.val + 1))))
  rw [hsplit]
  rw [List.append_assoc]
  rw [splayPathSumWithFinal_append X q pre ([m] ++ suf) init]
  rw [splayPathSum_take_eq_prefixSeq X init m]
  rw [splayTreeAfter_take_eq_prefixSeq X init m]
  simp [splayPathSumWithFinal]
  rw [splayPathSumWithFinal_drop_eq_suffixSeq X
    (splay
      (splayTreeAfter (prefixSeq X m) init (List.finRange m.val))
      (X m)) m q]

