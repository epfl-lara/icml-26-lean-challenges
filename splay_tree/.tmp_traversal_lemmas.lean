              have hcredit_outer :
                  twoFrameCredit ((b, bl) :: (a, al) :: fr1 :: fr2 :: rs) =
                    2 := by
                simp [twoFrameCredit]
              have hprev_nonneg :=
                reverseStrongSequentialPotential_nonneg
                  (splayMaxFramesRev l (fr1 :: fr2 :: rs))
              have hattach_nonempty :
                  nonemptyIndicator
                    (attachRightFrames (.node l k .empty)
