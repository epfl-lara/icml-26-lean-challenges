private theorem prefix_pair_bound_root_prefix_singleton_current_le_previous
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (rootDone : List (Fin n)) (j i : Fin n)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hrootDone : ∀ a : Fin n, a ∈ rootDone → Y a = q)
    (hj_mem : Y j ∈ init.toKeyList)
    (hi_mem : Y i ∈ init.toKeyList)
    (hj_lt : Y j < q)
    (hi_lt : Y i < q)
    (hle : Y i ≤ Y j) :
    ((splayTreeAfter Y init (rootDone ++ [j])).search_path_len (Y i) : ℝ) +
        ((splay (splayTreeAfter Y init (rootDone ++ [j]))
            (Y i)).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init (rootDone ++ [j])).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init
            (rootDone ++ [j])).search_path_len (Y i) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init (rootDone ++ [j]))
            (Y i)).search_path_len q : ℝ) := by
  have hactual_prefix :
      splayTreeAfter Y init rootDone = init :=
    splayTreeAfter_eq_self_of_all_eq_root Y q rootDone init hroot hrootDone
  have hreset_prefix :
      suffixResetTreeAfter Y q init rootDone = init :=
    suffixResetTreeAfter_eq_self_of_all_eq Y q rootDone init hrootDone
  have hactual_done :
      splayTreeAfter Y init (rootDone ++ [j]) =
        splay init (Y j) := by
    rw [splayTreeAfter_append_singleton, hactual_prefix]
  have hreset_done :
      suffixResetTreeAfter Y q init (rootDone ++ [j]) =
        splay (splay init (Y j)) q := by
    rw [suffixResetTreeAfter_append_singleton_lt Y q rootDone init j hj_lt,
      hreset_prefix]
  have hcore :=
