                simpa [List.reverse_cons] using hattach_nonempty
              simp [List.reverse_cons, List.append_assoc] at hattach_inner_nonempty
              simp [splayMaxFramesRev, reverseStrongSequentialPotential_node_eq] at ih0
              have hprev_ind :
