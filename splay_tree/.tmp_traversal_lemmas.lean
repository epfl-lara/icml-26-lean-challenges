        (((strictLowerSuffixIndices X m).length : ℝ) *
          boundaryBudget X init (List.finRange n) (X m)) := by
  let tp :=
    splayTreeAfter (prefixSeq X m) init (List.finRange m.val)
  let ts := splay tp (X m)
  have htp_bst : IsBST tp := by
    unfold tp
    exact splayTreeAfter_isBST (prefixSeq X m)
