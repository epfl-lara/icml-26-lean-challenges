  A * boundaryBudget X (suffixResetTreeAfter X q init done) future q +
    G * actualResetFirstLowerPairGapPotential X q init done future +
      H * ((splayTreeAfter X init done).search_path_len q : ℝ)

private theorem current_path_len_bound_of_prefix_pair_bound_and_q_cancel
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D E : ℝ)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (hpair :
      ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
          ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) ≤
        ((splayTreeAfter Y init done).search_path_len q : ℝ) +
          ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
          ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
          D)
    (hcancel :
      ((splayTreeAfter Y init done).search_path_len q : ℝ) +
          ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) ≤
        ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) + E) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) ≤
      ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
        (D + E) := by
  nlinarith

private theorem single_lower_prefix_pair_bound_of_current_le_previous
    {t : BinaryTree} {q y x : Nat}
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hy_mem : y ∈ t.toKeyList)
    (hx_mem : x ∈ t.toKeyList)
    (hy_lt : y < q)
    (hx_lt : x < q)
    (hxy : x ≤ y) :
    let actual := splay t y
    let reset := splay (splay t y) q
    (actual.search_path_len x : ℝ) +
        ((splay actual x).search_path_len q : ℝ) ≤
      (actual.search_path_len q : ℝ) +
        (reset.search_path_len x : ℝ) +
        ((splay reset x).search_path_len q : ℝ) := by
  let actual := splay t y
  let reset := splay (splay t y) q
  have hq_mem : q ∈ t.toKeyList := rootKey_mem_toKeyList hroot
  have hbst_actual : IsBST actual := by
    unfold actual
    exact splay_isBST t y hbst
  have hbst_reset : IsBST reset := by
    unfold reset
    exact splay_isBST (splay t y) q (splay_isBST t y hbst)
  have hroot_reset : rootKey reset = some q := by
    unfold reset
    exact rootKey_after_pivot_reset_of_root hbst hroot
  have hkeys : reset.toKeyList = actual.toKeyList := by
    unfold reset actual
    rw [splay_toKeyList]
  have hx_mem_actual : x ∈ actual.toKeyList := by
    unfold actual
    rw [splay_toKeyList]
    exact hx_mem
  have hpath_x :
      actual.search_path_len x ≤ reset.search_path_len x := by
    rcases lt_or_eq_of_le hxy with hx_lt_y | hx_eq
    · unfold actual reset
      exact
        lower_path_after_access_le_after_boundary_reset
          hbst hy_mem hq_mem hx_mem hx_lt_y hy_lt
    · have hroot_actual : rootKey actual = some y := by
        unfold actual
        exact splay_rootKey_eq_some_of_mem_isBST t y hbst hy_mem
      have hactual_y : actual.search_path_len y = 1 :=
        search_path_len_eq_one_of_rootKey_eq_some hroot_actual
      have hy_mem_reset : y ∈ reset.toKeyList := by
        unfold reset
        rw [splay_toKeyList, splay_toKeyList]
        exact hy_mem
      have hreset_pos : 0 < reset.search_path_len y :=
        search_path_len_pos_of_mem reset y hy_mem_reset
      have hpath_y : actual.search_path_len y ≤ reset.search_path_len y := by
        rw [hactual_y]
        omega
      simpa [hx_eq] using hpath_y
  have hpath_q :
      (splay actual x).search_path_len q ≤
        actual.search_path_len q + (splay reset x).search_path_len q := by
    exact
      search_path_len_after_lower_access_le_actual_boundary_add_reset_access
        hbst_actual hbst_reset hroot_reset hkeys hx_mem_actual hx_lt
  have hpath_x_real :
      (actual.search_path_len x : ℝ) ≤ reset.search_path_len x := by
    exact_mod_cast hpath_x
  have hpath_q_real :
      ((splay actual x).search_path_len q : ℝ) ≤
        actual.search_path_len q + (splay reset x).search_path_len q := by
    exact_mod_cast hpath_q
  nlinarith

private theorem single_lower_prefix_pair_bound_of_previous_lt_current_add_two
    {t : BinaryTree} {q y x : Nat}
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hy_mem : y ∈ t.toKeyList)
    (hx_mem : x ∈ t.toKeyList)
    (hy_lt : y < q)
    (hx_lt : x < q)
    (hyx : y < x) :
    let actual := splay t y
    let reset := splay (splay t y) q
    (actual.search_path_len x : ℝ) +
        ((splay actual x).search_path_len q : ℝ) ≤
      (actual.search_path_len q : ℝ) +
        (reset.search_path_len x : ℝ) +
        ((splay reset x).search_path_len q : ℝ) + 2 := by
  let actual := splay t y
  let reset := splay (splay t y) q
  have hq_mem : q ∈ t.toKeyList := rootKey_mem_toKeyList hroot
  have hbst_actual : IsBST actual := by
    unfold actual
    exact splay_isBST t y hbst
  have hbst_reset : IsBST reset := by
    unfold reset
    exact splay_isBST (splay t y) q (splay_isBST t y hbst)
  have hx_mem_actual : x ∈ actual.toKeyList := by
    unfold actual
    rw [splay_toKeyList]
    exact hx_mem
  have hq_mem_actual : q ∈ actual.toKeyList := by
    unfold actual
    rw [splay_toKeyList]
    exact hq_mem
  have hpath_x :
      actual.search_path_len x ≤ reset.search_path_len x + 1 := by
    unfold actual reset
    exact
      upper_path_after_lower_access_le_after_boundary_reset_add_one
        hbst hroot hy_mem hx_mem hyx hx_lt
  have hpath_q :
      (splay actual x).search_path_len q ≤ actual.search_path_len q + 2 :=
    search_path_len_after_splay_lower_le_add_two_strong
      hbst_actual hx_mem_actual hq_mem_actual hx_lt
  have hx_mem_reset : x ∈ reset.toKeyList := by
    unfold reset
    rw [splay_toKeyList, splay_toKeyList]
    exact hx_mem
  have hbst_srx : IsBST (splay reset x) :=
    splay_isBST reset x hbst_reset
  have hroot_srx : rootKey (splay reset x) = some x :=
    splay_rootKey_eq_some_of_mem_isBST reset x hbst_reset hx_mem_reset
  have hq_mem_srx : q ∈ (splay reset x).toKeyList := by
    unfold reset
    rw [splay_toKeyList, splay_toKeyList, splay_toKeyList]
    exact hq_mem
  have hq_ne_x : q ≠ x := by omega
  have hsrx_q_ge_two : 2 ≤ (splay reset x).search_path_len q :=
    two_le_search_path_len_of_rootKey_ne_of_mem_isBST
      hbst_srx hroot_srx hq_mem_srx hq_ne_x
  have hpath_x_real :
      (actual.search_path_len x : ℝ) ≤
        (reset.search_path_len x : ℝ) + 1 := by
    exact_mod_cast hpath_x
  have hpath_q_real :
      ((splay actual x).search_path_len q : ℝ) ≤
        (actual.search_path_len q : ℝ) + 2 := by
    exact_mod_cast hpath_q
  have hsrx_q_ge_two_real :
      (2 : ℝ) ≤ (splay reset x).search_path_len q := by
    exact_mod_cast hsrx_q_ge_two
  nlinarith

private theorem single_lower_root_pair_bound_of_q_cancel
    {t : BinaryTree} {q y x : Nat}
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hy_mem : y ∈ t.toKeyList)
    (hx_mem : x ∈ t.toKeyList)
    (hy_lt : y < q)
    (hx_lt : x < q)
    (hcancel :
      y < x →
        ((splay (splay t y) x).search_path_len q : ℝ) + 1 ≤
          ((splay t y).search_path_len q : ℝ) +
            ((splay (splay (splay t y) q) x).search_path_len q : ℝ)) :
    let actual := splay t y
    let reset := splay (splay t y) q
    (actual.search_path_len x : ℝ) +
        ((splay actual x).search_path_len q : ℝ) ≤
      (actual.search_path_len q : ℝ) +
        (reset.search_path_len x : ℝ) +
        ((splay reset x).search_path_len q : ℝ) := by
  by_cases hyx : y < x
  · let actual := splay t y
    let reset := splay (splay t y) q
    have hpath_nat :
        actual.search_path_len x ≤ reset.search_path_len x + 1 := by
      unfold actual reset
      exact
        upper_path_after_lower_access_le_after_boundary_reset_add_one
          hbst hroot hy_mem hx_mem hyx hx_lt
    have hpath :
        (actual.search_path_len x : ℝ) ≤
          (reset.search_path_len x : ℝ) + 1 := by
      exact_mod_cast hpath_nat
    have hcancel' :
        ((splay actual x).search_path_len q : ℝ) + 1 ≤
          (actual.search_path_len q : ℝ) +
            ((splay reset x).search_path_len q : ℝ) := by
      simpa [actual, reset] using hcancel hyx
    nlinarith
  · have hx_le_y : x ≤ y := by omega
    exact
      single_lower_prefix_pair_bound_of_current_le_previous
        (t := t) (q := q) (y := y) (x := x)
        hbst hroot hy_mem hx_mem hy_lt hx_lt hx_le_y

