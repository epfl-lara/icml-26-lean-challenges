        splayBoundaryBudgetSum (fun i : Fin m => X (g i)) q t xs
| [], t => by
    simpa [splayBoundaryBudgetSum] using
      (boundaryBudget_map_comp X g t ([] : List (Fin m)) q)
| i :: xs, t => by
    have hhead :
        boundaryBudget X t (g i :: xs.map g) q =
          boundaryBudget (fun i : Fin m => X (g i)) t (i :: xs) q := by
      simpa using boundaryBudget_map_comp X g t (i :: xs) q
    have htail :=
      splayBoundaryBudgetSum_map_comp X g q xs
        (splay t (X (g i)))
    simp [splayBoundaryBudgetSum, hhead, htail]

