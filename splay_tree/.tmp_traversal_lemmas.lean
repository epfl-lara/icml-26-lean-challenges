    (K : ℝ) (hK : 3 ≤ K) :
    ∀ (N : Nat), N ≤ 2 →
      ∀ (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i ≤ q) →
        splayPathSum Y t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q := by
  intro N hN
  rcases N with _ | N
  · intro Y q t hbst _hroot _hmem _havoid _hle
    simp [splayPathSum]
    have hB_nonneg :=
      boundaryBudget_nonneg Y t ([] : List (Fin 0)) q
    nlinarith
  rcases N with _ | N
  · let i : Fin 1 := 0
    intro Y q t hbst _hroot _hmem _havoid _hle
    have hfin : List.finRange 1 = [i] := by
      native_decide
    rw [hfin]
    have hiB :=
      search_path_len_real_le_boundaryBudget_of_mem
        Y [i] q hbst (i := i) (by simp)
    have hB_nonneg := boundaryBudget_nonneg Y t [i] q
    simp [splayPathSum]
    nlinarith
  rcases N with _ | N
  · let i : Fin 2 := 0
    let j : Fin 2 := 1
    intro Y q t hbst _hroot hmem _havoid _hle
    have hfin : List.finRange 2 = [i, j] := by
      native_decide
    rw [hfin]
    let t1 := splay t (Y i)
    have hiB :=
      search_path_len_real_le_boundaryBudget_of_mem
        Y [i, j] q hbst (i := i) (by simp)
    have hjB :=
      search_path_len_real_le_boundaryBudget_of_mem
        Y [i, j] q hbst (i := j) (by simp)
    have hafterNat :
        t1.search_path_len (Y j) ≤
          t.search_path_len (Y i) + t.search_path_len (Y j) := by
      unfold t1
      exact search_path_len_after_splay_le_path_add_of_mem
        hbst (hmem i) (hmem j)
    have hafter :
        (t1.search_path_len (Y j) : ℝ) ≤
          (t.search_path_len (Y i) : ℝ) +
            t.search_path_len (Y j) := by
      exact_mod_cast hafterNat
    have hB_nonneg := boundaryBudget_nonneg Y t [i, j] q
    simp [splayPathSum, t1]
    nlinarith
  · omega

private theorem upper_block_bound_of_induction_le_two
    (K : ℝ) (hK : 3 ≤ K)
    (hstep :
      ∀ N, 2 < N →
        (∀ k, k < N → ∀ (Y : Fin k → Nat) (q : Nat)
            (t : BinaryTree),
          IsBST t →
          rootKey t = some q →
          (∀ i : Fin k, Y i ∈ t.toKeyList) →
          (Y avoids ![2, 3, 1]) →
          (∀ i : Fin k, Y i ≤ q) →
          splayPathSum Y t (List.finRange k) ≤
            K * boundaryBudget Y t (List.finRange k) q) →
        ∀ (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
          IsBST t →
          rootKey t = some q →
          (∀ i : Fin N, Y i ∈ t.toKeyList) →
          (Y avoids ![2, 3, 1]) →
          (∀ i : Fin N, Y i ≤ q) →
          splayPathSum Y t (List.finRange N) ≤
            K * boundaryBudget Y t (List.finRange N) q) :
    ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
      IsBST t →
      rootKey t = some q →
      (∀ i : Fin N, Y i ∈ t.toKeyList) →
      (Y avoids ![2, 3, 1]) →
      (∀ i : Fin N, Y i ≤ q) →
      splayPathSum Y t (List.finRange N) ≤
        K * boundaryBudget Y t (List.finRange N) q := by
  intro N
  induction N using Nat.strong_induction_on with
  | h N ih =>
      intro Y q t hbst hroot hmem havoid hle
      by_cases hNsmall : N ≤ 2
      · exact upper_block_bound_le_two K hK N hNsmall
          Y q t hbst hroot hmem havoid hle
      · have hNlarge : 2 < N := Nat.lt_of_not_ge hNsmall
        exact hstep N hNlarge
          (fun k hk Y q t hbst hroot hmem havoid hle =>
            ih k hk Y q t hbst hroot hmem havoid hle)
          Y q t hbst hroot hmem havoid hle

private theorem upper_block_bound_of_all_strict
    (K : ℝ)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q)
    {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem : ∀ i : Fin N, Y i ∈ t.toKeyList)
    (havoid : Y avoids ![2, 3, 1])
    (hlt : ∀ i : Fin N, Y i < q) :
    splayPathSum Y t (List.finRange N) ≤
      K * boundaryBudget Y t (List.finRange N) q := by
  have hq_mem : q ∈ t.toKeyList := rootKey_mem_toKeyList hroot
  exact le_trans
    (splayPathSum_le_splayPathSumWithFinal
      Y q (List.finRange N) t)
    (hstrict Y q t hbst hq_mem hmem havoid hlt)

private theorem upper_block_bound_of_no_root_occurrence
    (K : ℝ)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q)
    {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem : ∀ i : Fin N, Y i ∈ t.toKeyList)
    (havoid : Y avoids ![2, 3, 1])
    (hle : ∀ i : Fin N, Y i ≤ q)
    (hno_occ : ¬ ∃ i : Fin N, Y i = q) :
    splayPathSum Y t (List.finRange N) ≤
      K * boundaryBudget Y t (List.finRange N) q := by
  have hlt : ∀ i : Fin N, Y i < q := by
    intro i
    exact lt_of_le_of_ne (hle i) (by
      intro heq
      exact hno_occ ⟨i, heq⟩)
  exact upper_block_bound_of_all_strict
    K hstrict Y q t hbst hroot hmem havoid hlt

private theorem splayPathSum_le_num_nodes_mul_length {n : Nat}
    (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      splayPathSum X t xs ≤ (t.num_nodes : ℝ) * xs.length
| [], t => by
    simp [splayPathSum]
| i :: xs, t => by
    have ih := splayPathSum_le_num_nodes_mul_length X xs (splay t (X i))
    have hstep := search_path_len_le_num_nodes t (X i)
    have hstepR : (t.search_path_len (X i) : ℝ) ≤ t.num_nodes := by
      exact_mod_cast hstep
    change
      ↑(t.search_path_len (X i)) + splayPathSum X (splay t (X i)) xs ≤
        (t.num_nodes : ℝ) * ((i :: xs).length)
    rw [splay_num_nodes] at ih
    calc
      ↑(t.search_path_len (X i)) + splayPathSum X (splay t (X i)) xs
          ≤ (t.num_nodes : ℝ) + (t.num_nodes : ℝ) * xs.length := by
            nlinarith [hstepR, ih]
      _ = (t.num_nodes : ℝ) * ((i :: xs).length) := by
            simp only [List.length_cons, Nat.cast_add, Nat.cast_one]
            ring

private theorem fold_splayStep_bound {n : Nat} (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (c0 : ℝ),
      ((xs.foldl (splayStep X) (t, c0)).2 ≤
          c0 + (t.num_nodes : ℝ) * xs.length) ∧
        ((xs.foldl (splayStep X) (t, c0)).1.num_nodes = t.num_nodes)
| [], t, c0 => by
    simp
| i :: xs, t, c0 => by
    dsimp [List.foldl, splayStep]
    have ih := fold_splayStep_bound X xs (splay t (X i))
      (c0 + splay.cost t (X i))
    rcases ih with ⟨hcosts, hnodes⟩
    constructor
    · calc
        (xs.foldl (splayStep X)
            (splay t (X i), c0 + splay.cost t (X i))).2
            ≤ c0 + splay.cost t (X i) +
                ((splay t (X i)).num_nodes : ℝ) * xs.length := hcosts
        _ ≤ c0 + (t.num_nodes : ℝ) +
              (t.num_nodes : ℝ) * xs.length := by
            rw [splay_num_nodes]
            nlinarith [splay_cost_le_num_nodes t (X i)]
        _ = c0 + (t.num_nodes : ℝ) * (i :: xs).length := by
            simp
            ring
    · rw [hnodes, splay_num_nodes]

private theorem fold_splayStep_toKeyList {n : Nat} (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (c0 : ℝ),
      ((xs.foldl (splayStep X) (t, c0)).1.toKeyList = t.toKeyList)
| [], t, c0 => by
    simp
| i :: xs, t, c0 => by
    dsimp [List.foldl, splayStep]
    rw [fold_splayStep_toKeyList X xs (splay t (X i))
      (c0 + splay.cost t (X i)), splay_toKeyList]

private theorem fold_splayStep_isBST {n : Nat} (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (c0 : ℝ),
      IsBST t → IsBST ((xs.foldl (splayStep X) (t, c0)).1)
| [], t, c0, hbst => by
    simpa using hbst
| i :: xs, t, c0, hbst => by
    dsimp [List.foldl, splayStep]
    exact fold_splayStep_isBST X xs (splay t (X i))
      (c0 + splay.cost t (X i)) (splay_isBST t (X i) hbst)

private theorem fold_splayStep_cost_add_length_eq_pathSum {n : Nat}
    (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (c0 : ℝ),
      (∀ i : Fin n, i ∈ xs → X i ∈ t.toKeyList) →
      ((xs.foldl (splayStep X) (t, c0)).2 + (xs.length : ℝ) =
        c0 + splayPathSum X t xs)
| [], t, c0, _hmem => by
    simp [splayPathSum]
| i :: xs, t, c0, hmem => by
    dsimp [List.foldl, splayStep, splayPathSum]
    have hi_mem : X i ∈ t.toKeyList := hmem i (by simp)
    have hcost_path :=
      splay_cost_add_one_eq_search_path_len_of_mem t (X i) hi_mem
    have hmem_tail : ∀ j : Fin n, j ∈ xs →
        X j ∈ (splay t (X i)).toKeyList := by
      intro j hj
      rw [splay_toKeyList]
      exact hmem j (by simp [hj])
    have ih := fold_splayStep_cost_add_length_eq_pathSum X xs
      (splay t (X i)) (c0 + splay.cost t (X i)) hmem_tail
    calc
      (xs.foldl (splayStep X)
          (splay t (X i), c0 + splay.cost t (X i))).2 +
          ((i :: xs).length : ℝ)
          = ((xs.foldl (splayStep X)
              (splay t (X i), c0 + splay.cost t (X i))).2 +
              (xs.length : ℝ)) + 1 := by
              simp
              ring
      _ = (c0 + splay.cost t (X i) +
            splayPathSum X (splay t (X i)) xs) + 1 := by
              rw [ih]
      _ = c0 + ↑(t.search_path_len (X i)) +
            splayPathSum X (splay t (X i)) xs := by
              linarith
      _ = c0 + (↑(t.search_path_len (X i)) +
            splayPathSum X (splay t (X i)) xs) := by
              ring

private theorem sequence_cost_le_num_nodes_mul_length {n : Nat}
    (X : Fin n → Nat) (init : BinaryTree) :
    splay.sequence_cost init X ≤ (init.num_nodes : ℝ) * n := by
  have h := (fold_splayStep_bound X (List.finRange n) init 0).1
  simpa [splay.sequence_cost] using h

private theorem sequence_cost_add_length_eq_pathSum {n : Nat}
    (X : Fin n → Nat) (init : BinaryTree)
    (hmem : ∀ i : Fin n, X i ∈ init.toKeyList) :
    splay.sequence_cost init X + (n : ℝ) =
      splayPathSum X init (List.finRange n) := by
  have h := fold_splayStep_cost_add_length_eq_pathSum X
    (List.finRange n) init 0 (by
      intro i _hi
      exact hmem i)
  simpa [splay.sequence_cost] using h

private theorem sequence_cost_const_le_num_nodes {n : Nat}
    (X : Fin n → Nat) (init : BinaryTree) (q : Nat)
    (hbst : IsBST init) (hmemq : q ∈ init.toKeyList)
    (hconst : ∀ i : Fin n, X i = q) :
    splay.sequence_cost init X ≤ init.num_nodes := by
  have hmem : ∀ i : Fin n, X i ∈ init.toKeyList := by
    intro i
    rw [hconst i]
    exact hmemq
  have hcost_path := sequence_cost_add_length_eq_pathSum X init hmem
  have hpath :=
    splayPathSum_const_le_num_nodes_add_length X (List.finRange n)
      init q hbst hmemq (by
        intro i _hi
        exact hconst i)
  rw [List.length_finRange] at hpath
  nlinarith [hcost_path]

private theorem finRange_split_at {n : Nat} (m : Fin n) :
    List.finRange n =
      (List.finRange n).take m.val ++ [m] ++
        (List.finRange n).drop (m.val + 1) := by
  have hlen : m.val < (List.finRange n).length := by
    simp [List.length_finRange, m.isLt]
  have hdrop := List.drop_eq_getElem_cons (l := List.finRange n) hlen
  have hget : (List.finRange n)[m.val] = m := by
    rw [List.getElem_finRange]
    exact Fin.ext (by simp)
  rw [hget] at hdrop
  calc
    List.finRange n =
        (List.finRange n).take m.val ++
          (List.finRange n).drop m.val := by
            rw [List.take_append_drop]
    _ = (List.finRange n).take m.val ++
          (m :: (List.finRange n).drop (m.val + 1)) := by
            rw [hdrop]
    _ = (List.finRange n).take m.val ++ [m] ++
          (List.finRange n).drop (m.val + 1) := by
            simp [List.append_assoc]

private theorem splayPathSum_finRange_split_at {n : Nat}
    (X : Fin n → Nat) (init : BinaryTree) (m : Fin n) :
    splayPathSum X init (List.finRange n) =
      splayPathSum X init ((List.finRange n).take m.val) +
        ((splayTreeAfter X init ((List.finRange n).take m.val)).search_path_len
            (X m) +
          splayPathSum X
            (splay
              (splayTreeAfter X init ((List.finRange n).take m.val))
              (X m))
            ((List.finRange n).drop (m.val + 1))) := by
  let pre := (List.finRange n).take m.val
  let suf := (List.finRange n).drop (m.val + 1)
  have hsplit : List.finRange n = pre ++ [m] ++ suf := by
    unfold pre suf
    exact finRange_split_at m
  change splayPathSum X init (List.finRange n) =
      splayPathSum X init pre +
        (↑((splayTreeAfter X init pre).search_path_len (X m)) +
          splayPathSum X (splay (splayTreeAfter X init pre) (X m)) suf)
  rw [hsplit]
  rw [List.append_assoc]
  rw [splayPathSum_append X pre ([m] ++ suf) init]
  simp [splayPathSum]

private theorem mem_take_finRange_lt {n : Nat} {m i : Fin n}
    (hmem : i ∈ (List.finRange n).take m.val) :
    i < m := by
  have hidx := (List.mem_take_iff_idxOf_lt
    (a := i) (n := m.val) (l := List.finRange n)
    (List.mem_finRange i)).mp hmem
  simpa [List.idxOf_finRange] using hidx

private theorem mem_take_finRange_of_lt {n : Nat} {m i : Fin n}
    (hi : i < m) :
    i ∈ (List.finRange n).take m.val := by
  have hidx :
      (List.finRange n).idxOf i < m.val := by
    simpa [List.idxOf_finRange] using hi
  exact (List.mem_take_iff_idxOf_lt
    (a := i) (n := m.val) (l := List.finRange n)
    (List.mem_finRange i)).mpr hidx

private theorem mem_drop_finRange_gt {n : Nat} {m i : Fin n}
    (hmem : i ∈ (List.finRange n).drop (m.val + 1)) :
    m < i := by
  rcases (List.mem_iff_getElem.mp hmem) with ⟨j, hj, hget⟩
  have hlen : m.val + 1 + j < (List.finRange n).length := by
    have hj' : j < n - (m.val + 1) := by
      simpa [List.length_drop, List.length_finRange] using hj
    have hm : m.val + 1 ≤ n := by omega
    have hnat : m.val + 1 + j < n := by omega
    simpa [List.length_finRange] using hnat
  have hfull :
      (List.finRange n)[m.val + 1 + j] = i := by
    rw [← hget]
    simp [List.getElem_drop]
  rw [List.getElem_finRange] at hfull
  have hval : m.val + 1 + j = i.val := by
    exact Fin.ext_iff.mp hfull
  change m.val < i.val
  omega

private theorem searchPathKeys_insertionTreeOfSeq_eq_after_index
    {n : Nat} (X : Fin n → Nat) (p : Fin n) :
    searchPathKeys (insertionTreeOfSeq X) (X p) =
      searchPathKeys
        (bstInsert (X p)
          (((List.finRange n).take p.val).foldl
            (fun t i => bstInsert (X i) t) .empty))
        (X p) := by
  let pre := (List.finRange n).take p.val
  let suf := (List.finRange n).drop (p.val + 1)
  let tp := pre.foldl (fun t i => bstInsert (X i) t) .empty
  have hsplit : List.finRange n = pre ++ [p] ++ suf := by
    unfold pre suf
    exact finRange_split_at p
  have htree :
      insertionTreeOfSeq X =
        suf.foldl (fun t i => bstInsert (X i) t)
          (bstInsert (X p) tp) := by
    unfold insertionTreeOfSeq
    rw [hsplit]
    simp [List.foldl_append, tp, pre, suf]
  have hbst_tp : IsBST tp := by
    unfold tp
    exact foldl_bstInsert_isBST X pre .empty IsBST.left
  have hbst_after : IsBST (bstInsert (X p) tp) :=
    bstInsert_isBST (X p) tp hbst_tp
  have hmem_after : X p ∈ (bstInsert (X p) tp).toKeyList := by
    rw [mem_bstInsert_iff]
    exact Or.inl rfl
  rw [htree]
  exact searchPathKeys_foldl_bstInsert_eq_of_mem
    X suf (bstInsert (X p) tp) (X p) hbst_after hmem_after

private theorem current_first_occurrence_staticSubRootByTouched
    {n : Nat} {X : Fin n → Nat} {p : Fin n}
    (hfirst : ∀ i : Fin n, i < p → X i ≠ X p) :
    staticSubRootByTouched X (insertionTreeOfSeq X)
      ((List.finRange n).take p.val) (X p) := by
  refine ⟨?_, ?_, ?_⟩
  · exact (mem_insertionTreeOfSeq_iff X (X p)).mpr ⟨p, rfl⟩
  · intro htouched
    rcases htouched with ⟨i, hi_done, hi_eq⟩
    exact hfirst i (mem_take_finRange_lt hi_done) hi_eq
  · intro a hanc
    let pre := (List.finRange n).take p.val
    let tp := pre.foldl (fun t i => bstInsert (X i) t) .empty
    have hpath_after :
        a ∈ searchPathKeys (bstInsert (X p) tp) (X p) := by
      change
        a ∈ searchPathKeys
          (bstInsert (X p)
            (((List.finRange n).take p.val).foldl
              (fun t i => bstInsert (X i) t) .empty)) (X p)
      rw [← searchPathKeys_insertionTreeOfSeq_eq_after_index X p]
      exact hanc.1
    have hmem_after :
        a ∈ (bstInsert (X p) tp).toKeyList :=
      searchPathKeys_subset_toKeyList
        (bstInsert (X p) tp) (X p) a hpath_after
    have hmem_tp : a ∈ tp.toKeyList := by
      rcases (mem_bstInsert_iff (X p) a tp).mp hmem_after with
        ha_eq | ha_mem
      · exact False.elim (hanc.2 ha_eq)
      · exact ha_mem
    have hmem_pre :
        a ∈
          (((List.finRange n).take p.val).foldl
            (fun t i => bstInsert (X i) t) .empty).toKeyList := by
      simpa [tp, pre] using hmem_tp
    have hiff :=
      mem_foldl_bstInsert_iff X ((List.finRange n).take p.val)
        .empty a
    rw [hiff] at hmem_pre
    simp [BinaryTree.toKeyList] at hmem_pre
    rcases hmem_pre with ⟨i, hi, hi_eq⟩
    exact ⟨i, hi, hi_eq⟩

private theorem insertionTree_first_occurrence_search_path_len_le_sourcePotential
    {n : Nat} {X : Fin n → Nat} {p : Fin n}
    (future : List (Fin n))
    (hfirst : ∀ i : Fin n, i < p → X i ≠ X p) :
    ((insertionTreeOfSeq X).search_path_len (X p) : ℝ) ≤
      sourcePotential X (insertionTreeOfSeq X)
          ((List.finRange n).take p.val) (p :: future) / 2 + 1 := by
  exact
    search_path_len_real_le_sourcePotential_staticSubRoot_add_one
      X (t := insertionTreeOfSeq X)
      (done := (List.finRange n).take p.val)
      (future := future) (i := p)
      (insertionTreeOfSeq_isBST X)
      (current_first_occurrence_staticSubRootByTouched hfirst)

private theorem avoids_comp_strictMono
    {α β γ : Type*} [LinearOrder α] [LinearOrder β] [LinearOrder γ]
    {X : α → Nat} {P : γ → Nat} {g : β → α}
    (havoid : X avoids P) (hg : StrictMono g) :
    (fun b => X (g b)) avoids P := by
  intro hcontains
  rcases hcontains with ⟨f, hf, hcmp⟩
  exact havoid ⟨fun c => g (f c), hg.comp hf, hcmp⟩

private theorem filteredFinRangeSeq_avoids231 {n : Nat}
    {Y : Fin n → Nat} (p : Fin n → Bool)
    (havoid : Y avoids ![2, 3, 1]) :
    (fun i : Fin ((List.finRange n).filter p).length =>
      Y (((List.finRange n).filter p).get i)) avoids ![2, 3, 1] := by
  refine avoids_comp_strictMono havoid ?_
  intro a b hab
  exact filteredFinRange_get_lt_of_lt p hab

private theorem sublist_finRange_get_lt_of_lt {n : Nat}
    {xs : List (Fin n)} (hsub : xs.Sublist (List.finRange n))
    {a b : Fin xs.length} (hab : a < b) :
    xs.get a < xs.get b := by
  rcases (List.sublist_iff_exists_fin_orderEmbedding_get_eq.mp hsub) with
    ⟨e, he⟩
  have hea := he a
  have heb := he b
  have he_lt : e a < e b := e.strictMono hab
  rw [hea, heb]
  exact (List.sortedLT_finRange n).getElem_lt_getElem_of_lt he_lt

private def listSeq {n : Nat} (Y : Fin n → Nat)
    (xs : List (Fin n)) : Fin xs.length → Nat :=
  fun i => Y (xs.get i)

