            ((splayTreeAfter Y t left).search_path_len (Y p) : ℝ) +
              splayPathSum Y
                (splay (splayTreeAfter Y t left) (Y p)) right := by
  obtain ⟨left, p, right, hsplit, hp_eq, hright_ne⟩ :=
    exists_last_pivot_split Y q done hpivot
  refine ⟨left, p, right, hsplit, hp_eq, ?_, ?_⟩
  · intro c
    exact
      last_pivot_right_strict_of_le_all hle hright_ne
        (right.get c) (List.getElem_mem c.isLt)
  · rw [hsplit]
    exact splayPathSum_split_pivot Y t left p right

