    simpa [newKeys, oldKeys, pathKeys, m] using
      activeHullKeys_after_splay_length_add_path_len_le_cons_add_inter
        X i xs hbst hi_mem hmem_tail
  have hm : m ≤ C + 1 := by
    simpa [newKeys, pathKeys, m] using hinter
  have hnat :
      t.search_path_len (X i) + (xs.length + newKeys.length) ≤
        C + ((i :: xs).length + oldKeys.length) := by
    simp
    omega
  have hreal :
      ((t.search_path_len (X i) + (xs.length + newKeys.length) : Nat) : ℝ) ≤
        (C + ((i :: xs).length + oldKeys.length) : Nat) := by
    exact_mod_cast hnat
  unfold activeBudget activeHullSize
  change
    (t.search_path_len (X i) : ℝ) +
        ((xs.length : ℝ) +
          (activeHullKeys X (splay t (X i)) xs).length) ≤
      (C : ℝ) + (((i :: xs).length : ℝ) +
        (activeHullKeys X t (i :: xs)).length)
  norm_num [Nat.cast_add] at hreal ⊢
  simpa [newKeys, oldKeys] using hreal

private theorem activeBudget_drop_le_of_hull_length_bound
    {n : Nat} (C : Nat) (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hhull :
      (activeHullKeys X (splay t (X i)) xs).length +
