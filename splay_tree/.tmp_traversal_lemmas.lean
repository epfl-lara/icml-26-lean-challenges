        544 + 64 * boundaryBudget Y t (i :: xs) q := by
  intro N Y q t i xs hbst hroot hi_mem hi_lt hmem_tail hlt_tail hsub havoid
  let tx := splay t (Y i)
  let tr := splay tx q
  let before := boundaryBudget Y t (i :: xs) q
  let after_splay := boundaryBudget Y tx xs q
  let after_reset := boundaryBudget Y tr xs q
  have hq_mem : q ∈ t.toKeyList :=
    rootKey_mem_toKeyList hroot
  have hpair :
      (t.search_path_len (Y i) : ℝ) +
          ((splay t (Y i)).search_path_len q : ℝ) ≤
