private theorem maxSequential_activeBudget_step_of_intersection_bound
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList)
    (hinter :
      maxSequentialPotential (splay t (X i)) +
          32 *
            (((activeHullKeys X (splay t (X i)) xs).toFinset ∩
              (searchPathKeys t (X i)).toFinset).card : ℝ) ≤
        maxSequentialPotential t +
          31 * (t.search_path_len (X i) : ℝ) + 32) :
    (t.search_path_len (X i) : ℝ) +
        maxSequentialPotential (splay t (X i)) +
        32 * activeBudget X (splay t (X i)) xs ≤
      maxSequentialPotential t +
        32 * activeBudget X t (i :: xs) := by
  let newKeys := activeHullKeys X (splay t (X i)) xs
  let oldKeys := activeHullKeys X t (i :: xs)
  let pathKeys := searchPathKeys t (X i)
  let m := (newKeys.toFinset ∩ pathKeys.toFinset).card
  have hcount_nat :
      newKeys.length + t.search_path_len (X i) ≤ oldKeys.length + m := by
    simpa [newKeys, oldKeys, pathKeys, m] using
      activeHullKeys_after_splay_length_add_path_len_le_cons_add_inter
        X i xs hbst hi_mem hmem_tail
  have hcount :
      (newKeys.length : ℝ) + (t.search_path_len (X i) : ℝ) ≤
        (oldKeys.length : ℝ) + (m : ℝ) := by
    exact_mod_cast hcount_nat
  have hinter' :
      maxSequentialPotential (splay t (X i)) + 32 * (m : ℝ) ≤
        maxSequentialPotential t +
          31 * (t.search_path_len (X i) : ℝ) + 32 := by
    simpa [newKeys, pathKeys, m] using hinter
  unfold activeBudget activeHullSize
  change
    (t.search_path_len (X i) : ℝ) +
        maxSequentialPotential (splay t (X i)) +
        32 * ((xs.length : ℝ) + newKeys.length) ≤
      maxSequentialPotential t +
        32 * (((i :: xs).length : ℝ) + oldKeys.length)
  simp only [List.length_cons, Nat.cast_add, Nat.cast_one]
  nlinarith

private theorem activeHullKeys_inter_searchPath_card_le_path_len
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t) :
    ((activeHullKeys X (splay t (X i)) xs).toFinset ∩
        (searchPathKeys t (X i)).toFinset).card ≤
      t.search_path_len (X i) := by
  let pathKeys := searchPathKeys t (X i)
  have hpath_nodup : pathKeys.Nodup := by
    unfold pathKeys
    exact searchPathKeys_nodup_of_isBST t (X i) hbst
  have hpath_card :
      pathKeys.toFinset.card = pathKeys.length :=
    List.toFinset_card_of_nodup hpath_nodup
  have hcard :
      ((activeHullKeys X (splay t (X i)) xs).toFinset ∩
          pathKeys.toFinset).card ≤ pathKeys.toFinset.card :=
    Finset.card_le_card Finset.inter_subset_right
  have hlen : pathKeys.length = t.search_path_len (X i) := by
    unfold pathKeys
    exact searchPathKeys_length_eq_search_path_len t (X i)
  have hcard' :
      ((activeHullKeys X (splay t (X i)) xs).toFinset ∩
          (searchPathKeys t (X i)).toFinset).card ≤
        pathKeys.toFinset.card := by
    simpa [pathKeys] using hcard
  rw [hpath_card, hlen] at hcard'
  exact hcard'

private theorem maxSequential_active_intersection_bound_of_access_potential
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    {B : ℝ}
    (hpot :
      maxSequentialPotential (splay t (X i)) +
          (t.search_path_len (X i) : ℝ) ≤
        maxSequentialPotential t + B) :
    maxSequentialPotential (splay t (X i)) +
        32 *
          (((activeHullKeys X (splay t (X i)) xs).toFinset ∩
            (searchPathKeys t (X i)).toFinset).card : ℝ) ≤
      maxSequentialPotential t +
        31 * (t.search_path_len (X i) : ℝ) + B := by
  have hcard_nat :=
    activeHullKeys_inter_searchPath_card_le_path_len
      X i xs hbst
  have hcard :
      (((activeHullKeys X (splay t (X i)) xs).toFinset ∩
        (searchPathKeys t (X i)).toFinset).card : ℝ) ≤
        t.search_path_len (X i) := by
    exact_mod_cast hcard_nat
  nlinarith

private theorem maxSequential_activeBudget_step_of_access_potential_bound
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList)
    {B : ℝ}
    (hpot :
      maxSequentialPotential (splay t (X i)) +
          (t.search_path_len (X i) : ℝ) ≤
        maxSequentialPotential t + B) :
    (t.search_path_len (X i) : ℝ) +
        maxSequentialPotential (splay t (X i)) +
        32 * activeBudget X (splay t (X i)) xs ≤
      B + maxSequentialPotential t +
        32 * activeBudget X t (i :: xs) := by
  have hinter :
    maxSequentialPotential (splay t (X i)) +
          32 *
            (((activeHullKeys X (splay t (X i)) xs).toFinset ∩
              (searchPathKeys t (X i)).toFinset).card : ℝ) ≤
        maxSequentialPotential t +
          31 * (t.search_path_len (X i) : ℝ) + B :=
    maxSequential_active_intersection_bound_of_access_potential
      X i xs hbst hpot
  let newKeys := activeHullKeys X (splay t (X i)) xs
  let oldKeys := activeHullKeys X t (i :: xs)
  let pathKeys := searchPathKeys t (X i)
  let m := (newKeys.toFinset ∩ pathKeys.toFinset).card
  have hcount_nat :
      newKeys.length + t.search_path_len (X i) ≤ oldKeys.length + m := by
    simpa [newKeys, oldKeys, pathKeys, m] using
      activeHullKeys_after_splay_length_add_path_len_le_cons_add_inter
        X i xs hbst hi_mem hmem_tail
  have hcount :
      (newKeys.length : ℝ) + (t.search_path_len (X i) : ℝ) ≤
        (oldKeys.length : ℝ) + (m : ℝ) := by
    exact_mod_cast hcount_nat
  have hinter' :
      maxSequentialPotential (splay t (X i)) + 32 * (m : ℝ) ≤
        maxSequentialPotential t +
          31 * (t.search_path_len (X i) : ℝ) + B := by
    simpa [newKeys, pathKeys, m] using hinter
  unfold activeBudget activeHullSize
  change
    (t.search_path_len (X i) : ℝ) +
        maxSequentialPotential (splay t (X i)) +
        32 * ((xs.length : ℝ) + newKeys.length) ≤
      B + maxSequentialPotential t +
        32 * (((i :: xs).length : ℝ) + oldKeys.length)
  simp only [List.length_cons, Nat.cast_add, Nat.cast_one]
  nlinarith

private theorem activeHullSize_after_splay_le_path_add {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (q : Nat)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hq_mem : q ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList) :
    activeHullSize X (splay t q) xs ≤
      activeHullSize X t xs + t.search_path_len q := by
  let newKeys := activeHullKeys X (splay t q) xs
  let oldKeys := activeHullKeys X t xs
  let qKeys := searchPathKeys t q
  have hbst_s : IsBST (splay t q) := splay_isBST t q hbst
  have hnew_nodup : newKeys.Nodup := by
    unfold newKeys
    exact activeHullKeys_nodup_of_isBST X xs hbst_s
  have hold_nodup : oldKeys.Nodup := by
    unfold oldKeys
    exact activeHullKeys_nodup_of_isBST X xs hbst
  have hq_nodup : qKeys.Nodup := by
    unfold qKeys
    exact searchPathKeys_nodup_of_isBST t q hbst
  have hnew_card :
      newKeys.toFinset.card =
        activeHullSize X (splay t q) xs := by
    unfold newKeys activeHullSize
    exact List.toFinset_card_of_nodup hnew_nodup
  have hold_card :
      oldKeys.toFinset.card = activeHullSize X t xs := by
    unfold oldKeys activeHullSize
    exact List.toFinset_card_of_nodup hold_nodup
  have hq_card : qKeys.toFinset.card = t.search_path_len q := by
    unfold qKeys
    rw [List.toFinset_card_of_nodup hq_nodup]
    exact searchPathKeys_length_eq_search_path_len t q
  have hsubset_card :
      newKeys.toFinset.card ≤
        (oldKeys.toFinset ∪ qKeys.toFinset).card := by
    apply Finset.card_le_card
    intro key hkey
    have hkey_new : key ∈ newKeys := by
      simpa [newKeys] using hkey
    rw [Finset.mem_union]
    rcases (mem_activeHullKeys_iff X (splay t q) xs).mp
        (by simpa [newKeys] using hkey_new) with
      ⟨_hkey_tree, j, hj, hpath⟩
    have hor :=
      searchPathKeys_splay_subset_union t q (X j) key
        hbst hq_mem (hmem_tail j hj) hpath
    rcases hor with hq_path | hj_path
    · right
      simpa [qKeys] using hq_path
    · left
      have hkey_old : key ∈ oldKeys := by
        unfold oldKeys
        exact mem_activeHullKeys_of_mem_searchPath X t xs hj hj_path
      simpa [oldKeys] using hkey_old
  have hunion_card :
      (oldKeys.toFinset ∪ qKeys.toFinset).card ≤
        oldKeys.toFinset.card + qKeys.toFinset.card :=
    Finset.card_union_le _ _
  omega

private theorem activeBudget_after_splay_le_path_add {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (q : Nat)
    (xs : List (Fin n))
    (hbst : IsBST t)
    (hq_mem : q ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList) :
    activeBudget X (splay t q) xs ≤
      activeBudget X t xs + (t.search_path_len q : ℝ) := by
  have hhull :=
    activeHullSize_after_splay_le_path_add X q xs hbst hq_mem hmem_tail
  have hnat :
      xs.length + activeHullSize X (splay t q) xs ≤
        xs.length + activeHullSize X t xs + t.search_path_len q := by
    omega
  unfold activeBudget
  exact_mod_cast hnat

private theorem length_le_activeBudget {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) :
    (xs.length : ℝ) ≤ activeBudget X t xs := by
  have hhull_nonneg : 0 ≤ (activeHullSize X t xs : ℝ) := by
    positivity
  unfold activeBudget
  nlinarith

private theorem finRange_length_le_activeBudget {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) :
    (n : ℝ) ≤ activeBudget X t (List.finRange n) := by
  simpa [List.length_finRange] using
    length_le_activeBudget X t (List.finRange n)

private theorem activeBudget_le_length_add_num_nodes {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) :
    activeBudget X t xs ≤ (xs.length : ℝ) + t.num_nodes := by
  have hhull := activeHullSize_le_num_nodes X t xs
  unfold activeBudget
  exact_mod_cast Nat.add_le_add_left hhull xs.length

private theorem activeBudget_finRange_le_two_mul_size {n : Nat}
    (X : Fin n → Nat) (init : BinaryTree)
    (h_size : init.num_nodes = n) :
    activeBudget X init (List.finRange n) ≤ 2 * (n : ℝ) := by
  have hbudget :=
    activeBudget_le_length_add_num_nodes X init (List.finRange n)
  rw [List.length_finRange, h_size] at hbudget
  calc
    activeBudget X init (List.finRange n) ≤ (n : ℝ) + n := hbudget
    _ = 2 * (n : ℝ) := by ring

private theorem search_path_len_real_le_activeBudget_of_mem {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n))
    (hbst : IsBST t) {i : Fin n} (hi : i ∈ xs) :
    (t.search_path_len (X i) : ℝ) ≤ activeBudget X t xs := by
  have hpath := search_path_len_real_le_activeHullSize_of_mem X xs hbst hi
  unfold activeBudget
  nlinarith [show 0 ≤ (xs.length : ℝ) by positivity]

private theorem splayPathSum_le_length_mul_activeBudget {n : Nat}
    (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree), IsBST t →
      (∀ i : Fin n, i ∈ xs → X i ∈ t.toKeyList) →
      splayPathSum X t xs ≤
        (xs.length : ℝ) * activeBudget X t xs
| [], t, _hbst, _hmem => by
    simp [splayPathSum]
| i :: xs, t, hbst, hmem => by
    have hi_mem : X i ∈ t.toKeyList := hmem i (by simp)
    have hmem_tail_t :
        ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList := by
      intro j hj
      exact hmem j (by simp [hj])
    have hmem_tail_splay :
        ∀ j : Fin n, j ∈ xs → X j ∈ (splay t (X i)).toKeyList := by
      intro j hj
      rw [splay_toKeyList]
      exact hmem_tail_t j hj
    have htail :=
      splayPathSum_le_length_mul_activeBudget X xs (splay t (X i))
        (splay_isBST t (X i) hbst) hmem_tail_splay
    have hbudget_after :=
      activeBudget_after_splay_le_cons X i xs hbst hi_mem hmem_tail_t
    have htail_bound :
        splayPathSum X (splay t (X i)) xs ≤
          (xs.length : ℝ) * activeBudget X t (i :: xs) := by
      exact le_trans htail
        (mul_le_mul_of_nonneg_left hbudget_after
          (show 0 ≤ (xs.length : ℝ) by positivity))
    have hhead :=
      search_path_len_real_le_activeBudget_of_mem X (i :: xs) hbst
        (i := i) (by simp)
    simp [splayPathSum]
    nlinarith [show 0 ≤ (xs.length : ℝ) by positivity]

private theorem activeBudget_append_le {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs ys : List (Fin n))
    (hbst : IsBST t) :
    activeBudget X t (xs ++ ys) ≤
      activeBudget X t xs + activeBudget X t ys := by
  have hhull := activeHullSize_append_le X xs ys hbst
  have hhullR :
      (activeHullSize X t (xs ++ ys) : ℝ) ≤
        activeHullSize X t xs + activeHullSize X t ys := by
    exact_mod_cast hhull
  unfold activeBudget
  simp [List.length_append]
  nlinarith

private theorem activeBudget_split_singleton_le {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree}
    (xs ys : List (Fin n)) (i : Fin n)
    (hbst : IsBST t) :
    activeBudget X t (xs ++ [i] ++ ys) ≤
      activeBudget X t xs + activeBudget X t ys +
        (1 + t.num_nodes : ℝ) := by
  have hmain :
      activeBudget X t (xs ++ ([i] ++ ys)) ≤
        activeBudget X t xs + activeBudget X t ([i] ++ ys) :=
    activeBudget_append_le X xs ([i] ++ ys) hbst
  have htail :
      activeBudget X t ([i] ++ ys) ≤
        activeBudget X t [i] + activeBudget X t ys :=
    activeBudget_append_le X [i] ys hbst
  have hsingle :
      activeBudget X t [i] ≤ (1 : ℝ) + t.num_nodes := by
    simpa using activeBudget_le_length_add_num_nodes X t [i]
  rw [List.append_assoc]
  nlinarith

private theorem activeHullKeys_map_comp {n m : Nat}
    (X : Fin n → Nat) (g : Fin m → Fin n)
    (t : BinaryTree) (xs : List (Fin m)) :
    activeHullKeys X t (xs.map g) =
      activeHullKeys (fun i : Fin m => X (g i)) t xs := by
  unfold activeHullKeys
  apply List.filter_congr
  intro key _hkey
  have hiff :
      (∃ j : Fin n, j ∈ xs.map g ∧ key ∈ searchPathKeys t (X j)) ↔
        ∃ i : Fin m, i ∈ xs ∧
          key ∈ searchPathKeys t ((fun i : Fin m => X (g i)) i) := by
    constructor
    · rintro ⟨j, hj, hpath⟩
      rcases List.mem_map.mp hj with ⟨i, hi, hgi⟩
      subst j
      exact ⟨i, hi, hpath⟩
    · rintro ⟨i, hi, hpath⟩
      exact ⟨g i, List.mem_map.mpr ⟨i, hi, rfl⟩, hpath⟩
  by_cases hp :
      ∃ j : Fin n, j ∈ xs.map g ∧ key ∈ searchPathKeys t (X j)
  · have hq :
        ∃ i : Fin m, i ∈ xs ∧
          key ∈ searchPathKeys t ((fun i : Fin m => X (g i)) i) :=
      hiff.mp hp
    simp [hp, hq]
  · have hq :
        ¬ (∃ i : Fin m, i ∈ xs ∧
          key ∈ searchPathKeys t ((fun i : Fin m => X (g i)) i)) := by
      intro hq
      exact hp (hiff.mpr hq)
    simp [hp, hq]

private theorem activeHullSize_map_comp {n m : Nat}
    (X : Fin n → Nat) (g : Fin m → Fin n)
    (t : BinaryTree) (xs : List (Fin m)) :
    activeHullSize X t (xs.map g) =
      activeHullSize (fun i : Fin m => X (g i)) t xs := by
  unfold activeHullSize
  rw [activeHullKeys_map_comp X g t xs]

private theorem activeBudget_map_comp {n m : Nat}
    (X : Fin n → Nat) (g : Fin m → Fin n)
    (t : BinaryTree) (xs : List (Fin m)) :
    activeBudget X t (xs.map g) =
      activeBudget (fun i : Fin m => X (g i)) t xs := by
  unfold activeBudget
  rw [List.length_map, activeHullSize_map_comp X g t xs]

private noncomputable def boundaryHullKeys {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (xs : List (Fin n)) (q : Nat) : List Nat :=
  t.toKeyList.filter (fun key =>
    decide (key ∈ searchPathKeys t q ∨
      ∃ i : Fin n, i ∈ xs ∧ key ∈ searchPathKeys t (X i)))

private noncomputable def boundaryHullSize {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (xs : List (Fin n)) (q : Nat) : Nat :=
  (boundaryHullKeys X t xs q).length

private noncomputable def boundaryBudget {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (xs : List (Fin n)) (q : Nat) : ℝ :=
  (xs.length : ℝ) + boundaryHullSize X t xs q

private theorem boundaryHullKeys_cons_pivot_eq {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (i : Fin n)
    (xs : List (Fin n)) (q : Nat) (hi : X i = q) :
    boundaryHullKeys X t (i :: xs) q =
      boundaryHullKeys X t xs q := by
  unfold boundaryHullKeys
  apply List.filter_congr
  intro key _hkey
  let P :=
    key ∈ searchPathKeys t q ∨
      ∃ j : Fin n, j ∈ i :: xs ∧ key ∈ searchPathKeys t (X j)
  let Q :=
    key ∈ searchPathKeys t q ∨
      ∃ j : Fin n, j ∈ xs ∧ key ∈ searchPathKeys t (X j)
  have hiff : P ↔ Q := by
    constructor
    · intro h
      rcases h with hq | hfuture
      · exact Or.inl hq
      · rcases hfuture with ⟨j, hj, hpath⟩
        simp at hj
        rcases hj with hji | hjxs
        · subst j
          rw [hi] at hpath
          exact Or.inl hpath
        · exact Or.inr ⟨j, hjxs, hpath⟩
    · intro h
      rcases h with hq | hfuture
      · exact Or.inl hq
      · rcases hfuture with ⟨j, hjxs, hpath⟩
        exact Or.inr ⟨j, by simp [hjxs], hpath⟩
  change decide P = decide Q
  by_cases hp : P
  · have hq : Q := hiff.mp hp
    simp [hp, hq]
  · have hq : ¬ Q := by
      intro hq
      exact hp (hiff.mpr hq)
    simp [hp, hq]

private theorem boundaryHullSize_cons_pivot_eq {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (i : Fin n)
    (xs : List (Fin n)) (q : Nat) (hi : X i = q) :
    boundaryHullSize X t (i :: xs) q =
      boundaryHullSize X t xs q := by
  unfold boundaryHullSize
  rw [boundaryHullKeys_cons_pivot_eq X t i xs q hi]

private theorem boundaryBudget_cons_pivot_eq {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (i : Fin n)
    (xs : List (Fin n)) (q : Nat) (hi : X i = q) :
    boundaryBudget X t (i :: xs) q =
      boundaryBudget X t xs q + 1 := by
  unfold boundaryBudget
  rw [boundaryHullSize_cons_pivot_eq X t i xs q hi]
  simp
  ring

private theorem boundaryHullKeys_cons_cons_pivot_eq {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (i j : Fin n)
    (xs : List (Fin n)) (q : Nat) (hj : X j = q) :
    boundaryHullKeys X t (i :: j :: xs) q =
      boundaryHullKeys X t (i :: xs) q := by
  unfold boundaryHullKeys
  apply List.filter_congr
  intro key _hkey
  let P :=
    key ∈ searchPathKeys t q ∨
      ∃ a : Fin n, a ∈ i :: j :: xs ∧ key ∈ searchPathKeys t (X a)
  let Q :=
    key ∈ searchPathKeys t q ∨
      ∃ a : Fin n, a ∈ i :: xs ∧ key ∈ searchPathKeys t (X a)
  have hiff : P ↔ Q := by
    constructor
    · intro h
      rcases h with hq | hfuture
      · exact Or.inl hq
      · rcases hfuture with ⟨a, ha, hpath⟩
        simp at ha
        rcases ha with hai | haj | haxs
        · exact Or.inr ⟨a, by simp [hai], hpath⟩
        · subst a
          rw [hj] at hpath
          exact Or.inl hpath
        · exact Or.inr ⟨a, by simp [haxs], hpath⟩
    · intro h
      rcases h with hq | hfuture
      · exact Or.inl hq
      · rcases hfuture with ⟨a, ha, hpath⟩
        simp at ha
        rcases ha with hai | haxs
        · exact Or.inr ⟨a, by simp [hai], hpath⟩
        · exact Or.inr ⟨a, by simp [haxs], hpath⟩
  change decide P = decide Q
  by_cases hp : P
  · have hq : Q := hiff.mp hp
    simp [hp, hq]
  · have hq : ¬ Q := by
      intro hq
      exact hp (hiff.mpr hq)
    simp [hp, hq]

private theorem boundaryHullSize_cons_cons_pivot_eq {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (i j : Fin n)
    (xs : List (Fin n)) (q : Nat) (hj : X j = q) :
    boundaryHullSize X t (i :: j :: xs) q =
      boundaryHullSize X t (i :: xs) q := by
  unfold boundaryHullSize
  rw [boundaryHullKeys_cons_cons_pivot_eq X t i j xs q hj]

private theorem boundaryBudget_cons_cons_pivot_eq {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (i j : Fin n)
    (xs : List (Fin n)) (q : Nat) (hj : X j = q) :
    boundaryBudget X t (i :: j :: xs) q =
      boundaryBudget X t (i :: xs) q + 1 := by
  unfold boundaryBudget
  rw [boundaryHullSize_cons_cons_pivot_eq X t i j xs q hj]
  simp
  ring

private noncomputable def weightedBoundaryBudget {n : Nat}
    (A : ℝ) (X : Fin n → Nat) (t : BinaryTree)
    (xs : List (Fin n)) (q : Nat) : ℝ :=
  A * (xs.length : ℝ) + boundaryHullSize X t xs q

private def touchedByList {n : Nat} (X : Fin n → Nat)
    (done : List (Fin n)) (key : Nat) : Prop :=
  ∃ i : Fin n, i ∈ done ∧ X i = key

private def properAncestorKey (t : BinaryTree) (a b : Nat) : Prop :=
  a ∈ searchPathKeys t b ∧ a ≠ b

private def leftDepthToKey : BinaryTree → Nat → Nat
| .empty, _q => 0
| .node l k r, q =>
    if q < k then 1 + leftDepthToKey l q
    else if k < q then leftDepthToKey r q
    else 0

private theorem leftDepthToKey_le_search_path_len :
    ∀ (t : BinaryTree) (q : Nat),
      leftDepthToKey t q ≤ t.search_path_len q
| .empty, q => by
    simp [leftDepthToKey, BinaryTree.search_path_len]
| .node l k r, q => by
    by_cases hqk : q < k
    · have ih := leftDepthToKey_le_search_path_len l q
      simp [leftDepthToKey, BinaryTree.search_path_len, hqk]
      omega
    · by_cases hkq : k < q
      · have ih := leftDepthToKey_le_search_path_len r q
        simp [leftDepthToKey, BinaryTree.search_path_len, hqk, hkq]
        omega
      · simp [leftDepthToKey, BinaryTree.search_path_len, hqk, hkq]

private theorem leftDepthToKey_eq_zero_of_rootKey_eq_some
    {t : BinaryTree} {q : Nat} (hroot : rootKey t = some q) :
    leftDepthToKey t q = 0 := by
  cases t with
  | empty =>
      simp [rootKey] at hroot
  | node l k r =>
      simp [rootKey] at hroot
      subst k
      simp [leftDepthToKey]

private theorem leftDepthToKey_node_left
    {l r : BinaryTree} {k q : Nat} (hqk : q < k) :
    leftDepthToKey (BinaryTree.node l k r) q =
      1 + leftDepthToKey l q := by
  simp [leftDepthToKey, hqk]

private theorem leftDepthToKey_node_right
    {l r : BinaryTree} {k q : Nat} (hkq : k < q) :
    leftDepthToKey (BinaryTree.node l k r) q =
      leftDepthToKey r q := by
  have hnqk : ¬ q < k := by omega
  simp [leftDepthToKey, hnqk, hkq]

private theorem leftDepthToKey_node_eq
    {l r : BinaryTree} {k q : Nat} (hq : q = k) :
    leftDepthToKey (BinaryTree.node l k r) q = 0 := by
  subst q
  simp [leftDepthToKey]

private def staticSubRootByTouched {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (done : List (Fin n)) (key : Nat) : Prop :=
  key ∈ t.toKeyList ∧
    ¬ touchedByList X done key ∧
    ∀ a : Nat, properAncestorKey t a key → touchedByList X done a

private def staticSubRootsLeftDepthLeOne {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (done : List (Fin n)) : Prop :=
  ∀ key : Nat, staticSubRootByTouched X t done key →
    leftDepthToKey t key ≤ 1

private noncomputable def sourcePotentialKeys {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (done future : List (Fin n)) : List Nat := by
  classical
  exact
    t.toKeyList.filter (fun key =>
      decide (touchedByList X done key ∧
        ∃ j : Fin n, j ∈ future ∧ key ∈ searchPathKeys t (X j)))

private noncomputable def sourcePotential {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (done future : List (Fin n)) : ℝ :=
  2 * (sourcePotentialKeys X t done future).length

private theorem mem_sourcePotentialKeys_iff {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (done future : List (Fin n))
    {key : Nat} :
    key ∈ sourcePotentialKeys X t done future ↔
      key ∈ t.toKeyList ∧ touchedByList X done key ∧
        ∃ j : Fin n, j ∈ future ∧ key ∈ searchPathKeys t (X j) := by
  unfold sourcePotentialKeys
  rw [List.mem_filter]
  simp [and_assoc]

private theorem not_touchedByList_nil {n : Nat} (X : Fin n → Nat)
    (key : Nat) :
    ¬ touchedByList X [] key := by
  intro h
  rcases h with ⟨i, hi, _hxi⟩
  simp at hi

private theorem sourcePotentialKeys_nil_done {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (future : List (Fin n)) :
    sourcePotentialKeys X t [] future = [] := by
  apply List.eq_nil_iff_forall_not_mem.mpr
  intro key hkey
  have htouched :=
    (mem_sourcePotentialKeys_iff X t [] future).mp hkey |>.2.1
  exact not_touchedByList_nil X key htouched

private theorem sourcePotential_nil_done {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (future : List (Fin n)) :
    sourcePotential X t [] future = 0 := by
  unfold sourcePotential
  rw [sourcePotentialKeys_nil_done]
  norm_num

private theorem sourcePotentialKeys_nil_future {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (done : List (Fin n)) :
    sourcePotentialKeys X t done [] = [] := by
  apply List.eq_nil_iff_forall_not_mem.mpr
  intro key hkey
  have hfuture :=
    (mem_sourcePotentialKeys_iff X t done []).mp hkey |>.2.2
  rcases hfuture with ⟨j, hj, _hpath⟩
  simp at hj

private theorem sourcePotential_nil_future {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (done : List (Fin n)) :
    sourcePotential X t done [] = 0 := by
  unfold sourcePotential
  rw [sourcePotentialKeys_nil_future]
  norm_num

private theorem touchedByList_append_singleton_iff {n : Nat}
    (X : Fin n → Nat) (done : List (Fin n)) (i : Fin n)
    (key : Nat) :
    touchedByList X (done ++ [i]) key ↔
      touchedByList X (i :: done) key := by
  unfold touchedByList
  constructor
  · rintro ⟨j, hj, hj_eq⟩
    rcases List.mem_append.mp hj with hj_done | hj_last
    · exact ⟨j, by simp [hj_done], hj_eq⟩
    · have hji : j = i := by simpa using hj_last
      subst j
      exact ⟨i, by simp, hj_eq⟩
  · rintro ⟨j, hj, hj_eq⟩
    rcases (List.mem_cons.mp hj) with hji | hj_done
    · subst j
      exact ⟨i, by simp, hj_eq⟩
    · exact ⟨j, by simp [hj_done], hj_eq⟩

private theorem sourcePotentialKeys_append_singleton_eq_cons {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) :
    sourcePotentialKeys X t (done ++ [i]) future =
      sourcePotentialKeys X t (i :: done) future := by
  classical
  unfold sourcePotentialKeys
  apply List.filter_congr
  intro key _hkey
  let P :=
    touchedByList X (done ++ [i]) key ∧
      ∃ j : Fin n, j ∈ future ∧ key ∈ searchPathKeys t (X j)
  let Q :=
    touchedByList X (i :: done) key ∧
      ∃ j : Fin n, j ∈ future ∧ key ∈ searchPathKeys t (X j)
  have hiff : P ↔ Q := by
    unfold P Q
    rw [touchedByList_append_singleton_iff X done i key]
  change decide P = decide Q
  by_cases hp : P
  · have hq : Q := hiff.mp hp
    simp [hp, hq]
  · have hq : ¬ Q := by
      intro hq
      exact hp (hiff.mpr hq)
    simp [hp, hq]

private theorem sourcePotential_append_singleton_eq_cons {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) :
    sourcePotential X t (done ++ [i]) future =
      sourcePotential X t (i :: done) future := by
  unfold sourcePotential
  rw [sourcePotentialKeys_append_singleton_eq_cons X t done future i]

private theorem staticSubRootByTouched_mem {n : Nat}
    {X : Fin n → Nat} {t : BinaryTree} {done : List (Fin n)}
    {key : Nat} (hsub : staticSubRootByTouched X t done key) :
    key ∈ t.toKeyList :=
  hsub.1

private theorem staticSubRootByTouched_not_touched {n : Nat}
    {X : Fin n → Nat} {t : BinaryTree} {done : List (Fin n)}
    {key : Nat} (hsub : staticSubRootByTouched X t done key) :
    ¬ touchedByList X done key :=
  hsub.2.1

private theorem staticSubRootsLeftDepthLeOne_nil {n : Nat}
    (X : Fin n → Nat) :
    ∀ (t : BinaryTree), IsBST t →
      staticSubRootsLeftDepthLeOne X t []
| .empty, _hbst, key, hsub => by
    simp [staticSubRootByTouched, BinaryTree.toKeyList] at hsub
| .node l k r, hbst, key, hsub => by
    cases hbst with
    | node _ _ _ hleft hright hbst_left hbst_right =>
        have hmem : key ∈ (BinaryTree.node l k r).toKeyList := hsub.1
        simp only [BinaryTree.toKeyList, List.mem_append,
          List.mem_singleton] at hmem
        rcases hmem with ((hmem_l | hkey_root) | hmem_r)
        · have hkey_lt_k :
              key < k :=
            (forallTree_iff_forall_mem.mp hleft) key hmem_l
          have hk_anc :
              properAncestorKey (BinaryTree.node l k r) k key :=
            by
              unfold properAncestorKey
              exact ⟨by simp [searchPathKeys, hkey_lt_k], by omega⟩
          exact False.elim
            (not_touchedByList_nil X k (hsub.2.2 k hk_anc))
        · subst key
          simp [leftDepthToKey]
        · have hk_lt_key :
              k < key :=
            (forallTree_iff_forall_mem.mp hright) key hmem_r
          have hk_anc :
              properAncestorKey (BinaryTree.node l k r) k key :=
            by
              unfold properAncestorKey
              have hnkey : ¬ key < k := by omega
              exact ⟨by simp [searchPathKeys, hnkey, hk_lt_key], by omega⟩
          exact False.elim
            (not_touchedByList_nil X k (hsub.2.2 k hk_anc))

private theorem properAncestorKey_node_left
    {l r : BinaryTree} {k a q : Nat} (hqk : q < k) :
    properAncestorKey l a q →
      properAncestorKey (BinaryTree.node l k r) a q := by
  intro hanc
  unfold properAncestorKey at hanc ⊢
  rcases hanc with ⟨hpath, hneq⟩
  exact ⟨by simp [searchPathKeys, hqk, hpath], hneq⟩

private theorem properAncestorKey_node_right
    {l r : BinaryTree} {k a q : Nat} (hkq : k < q) :
    properAncestorKey r a q →
      properAncestorKey (BinaryTree.node l k r) a q := by
  intro hanc
  unfold properAncestorKey at hanc ⊢
  rcases hanc with ⟨hpath, hneq⟩
  have hnqk : ¬ q < k := by omega
  exact ⟨by simp [searchPathKeys, hnqk, hkq, hpath], hneq⟩

private theorem root_properAncestorKey_node_left
    {l r : BinaryTree} {k q : Nat} (hqk : q < k) :
    properAncestorKey (BinaryTree.node l k r) k q := by
  unfold properAncestorKey
  exact ⟨by simp [searchPathKeys, hqk], by omega⟩

private theorem root_properAncestorKey_node_right
    {l r : BinaryTree} {k q : Nat} (hkq : k < q) :
    properAncestorKey (BinaryTree.node l k r) k q := by
  unfold properAncestorKey
  have hnqk : ¬ q < k := by omega
  exact ⟨by simp [searchPathKeys, hnqk, hkq], by omega⟩

private theorem exists_touched_between_of_two_staticSubRoots {n : Nat}
    {X : Fin n → Nat} :
    ∀ {t : BinaryTree} {done : List (Fin n)} {q p : Nat},
      IsBST t →
      staticSubRootByTouched X t done q →
      staticSubRootByTouched X t done p →
      q < p →
      ∃ r : Nat, touchedByList X done r ∧ q < r ∧ r < p
| .empty, done, q, p, _hbst, hq, _hp, _hqp => by
    simp [staticSubRootByTouched, BinaryTree.toKeyList] at hq
| .node l k r, done, q, p, hbst, hq, hp, hqp => by
    cases hbst with
    | node _ _ _ hleft hright hbst_left hbst_right =>
        have hqmem : q ∈ (BinaryTree.node l k r).toKeyList := hq.1
        have hpmem : p ∈ (BinaryTree.node l k r).toKeyList := hp.1
        simp only [BinaryTree.toKeyList, List.mem_append,
          List.mem_singleton] at hqmem hpmem
        rcases hqmem with ((hq_l | hq_root) | hq_r)
        · have hq_lt_k : q < k :=
            (forallTree_iff_forall_mem.mp hleft) q hq_l
          rcases hpmem with ((hp_l | hp_root) | hp_r)
          · have hp_lt_k : p < k :=
              (forallTree_iff_forall_mem.mp hleft) p hp_l
            have hq_sub_l : staticSubRootByTouched X l done q := by
              refine ⟨hq_l, hq.2.1, ?_⟩
              intro a ha
              exact hq.2.2 a
                (properAncestorKey_node_left hq_lt_k ha)
            have hp_sub_l : staticSubRootByTouched X l done p := by
              refine ⟨hp_l, hp.2.1, ?_⟩
              intro a ha
              exact hp.2.2 a
                (properAncestorKey_node_left hp_lt_k ha)
            exact exists_touched_between_of_two_staticSubRoots
              hbst_left hq_sub_l hp_sub_l hqp
          · subst p
            have hk_touched : touchedByList X done k :=
              hq.2.2 k (root_properAncestorKey_node_left hq_lt_k)
            exact False.elim (hp.2.1 hk_touched)
          · have hk_lt_p : k < p :=
              (forallTree_iff_forall_mem.mp hright) p hp_r
            refine ⟨k, ?_, hq_lt_k, hk_lt_p⟩
            exact hq.2.2 k
              (root_properAncestorKey_node_left hq_lt_k)
        · subst q
          rcases hpmem with ((hp_l | hp_root) | hp_r)
          · have hp_lt_k : p < k :=
              (forallTree_iff_forall_mem.mp hleft) p hp_l
            omega
          · subst p
            omega
          · have hk_lt_p : k < p :=
              (forallTree_iff_forall_mem.mp hright) p hp_r
            have hk_touched : touchedByList X done k :=
              hp.2.2 k (root_properAncestorKey_node_right hk_lt_p)
            exact False.elim (hq.2.1 hk_touched)
        · have hk_lt_q : k < q :=
            (forallTree_iff_forall_mem.mp hright) q hq_r
          rcases hpmem with ((hp_l | hp_root) | hp_r)
          · have hp_lt_k : p < k :=
              (forallTree_iff_forall_mem.mp hleft) p hp_l
            omega
          · subst p
            omega
          · have hk_lt_p : k < p :=
              (forallTree_iff_forall_mem.mp hright) p hp_r
            have hq_sub_r : staticSubRootByTouched X r done q := by
              refine ⟨hq_r, hq.2.1, ?_⟩
              intro a ha
              exact hq.2.2 a
                (properAncestorKey_node_right hk_lt_q ha)
            have hp_sub_r : staticSubRootByTouched X r done p := by
              refine ⟨hp_r, hp.2.1, ?_⟩
              intro a ha
              exact hp.2.2 a
                (properAncestorKey_node_right hk_lt_p ha)
            exact exists_touched_between_of_two_staticSubRoots
              hbst_right hq_sub_r hp_sub_r hqp

private theorem sourcePotentialKeys_sublist_toKeyList {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree)
    (done future : List (Fin n)) :
    (sourcePotentialKeys X t done future).Sublist t.toKeyList := by
  unfold sourcePotentialKeys
  exact List.filter_sublist

private theorem sourcePotentialKeys_nodup_of_isBST {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree}
    (done future : List (Fin n)) (hbst : IsBST t) :
    (sourcePotentialKeys X t done future).Nodup := by
  exact (isBST_toKeyList_nodup hbst).sublist
    (sourcePotentialKeys_sublist_toKeyList X t done future)

private theorem sourcePotential_nonneg {n : Nat} (X : Fin n → Nat)
    (t : BinaryTree) (done future : List (Fin n)) :
    0 ≤ sourcePotential X t done future := by
  unfold sourcePotential
  positivity

private theorem sourcePotential_le_two_num_nodes {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree)
    (done future : List (Fin n)) :
    sourcePotential X t done future ≤ 2 * (t.num_nodes : ℝ) := by
  have hsub :=
    List.Sublist.length_le
      (sourcePotentialKeys_sublist_toKeyList X t done future)
  have hlen :
      ((sourcePotentialKeys X t done future).length : ℝ) ≤
        t.num_nodes := by
    rw [← toKeyList_length t]
    exact_mod_cast hsub
  unfold sourcePotential
  nlinarith

private theorem searchPathKeys_staticSubRoot_toFinset_subset_sourcePotentialKeys_union
    {n : Nat} {X : Fin n → Nat} {t : BinaryTree}
    {done future : List (Fin n)} {i : Fin n}
    (hsub : staticSubRootByTouched X t done (X i)) :
    (searchPathKeys t (X i)).toFinset ⊆
      (sourcePotentialKeys X t done (i :: future)).toFinset ∪ {X i} := by
  intro key hkey
  have hkey_path : key ∈ searchPathKeys t (X i) := by
    simpa using hkey
  rw [Finset.mem_union]
  by_cases hkey_eq : key = X i
  · right
    simp [hkey_eq]
  · left
    have hkey_mem_tree : key ∈ t.toKeyList :=
      searchPathKeys_subset_toKeyList t (X i) key hkey_path
    have hkey_touched : touchedByList X done key :=
      hsub.2.2 key ⟨hkey_path, hkey_eq⟩
    have hkey_pot : key ∈ sourcePotentialKeys X t done (i :: future) :=
      (mem_sourcePotentialKeys_iff X t done (i :: future)).mpr
        ⟨hkey_mem_tree, hkey_touched,
          ⟨i, by simp, hkey_path⟩⟩
    simpa using hkey_pot

private theorem search_path_len_le_sourcePotentialKeys_staticSubRoot_add_one
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree}
    {done future : List (Fin n)} {i : Fin n}
    (hbst : IsBST t)
    (hsub : staticSubRootByTouched X t done (X i)) :
    t.search_path_len (X i) ≤
      (sourcePotentialKeys X t done (i :: future)).length + 1 := by
  let pathKeys := searchPathKeys t (X i)
  let potKeys := sourcePotentialKeys X t done (i :: future)
  have hpath_nodup : pathKeys.Nodup := by
    unfold pathKeys
    exact searchPathKeys_nodup_of_isBST t (X i) hbst
  have hpot_nodup : potKeys.Nodup := by
    unfold potKeys
    exact sourcePotentialKeys_nodup_of_isBST X done (i :: future) hbst
  have hpath_card :
      pathKeys.toFinset.card = pathKeys.length :=
    List.toFinset_card_of_nodup hpath_nodup
  have hpot_card :
      potKeys.toFinset.card = potKeys.length :=
    List.toFinset_card_of_nodup hpot_nodup
  have hcard_subset :
      pathKeys.toFinset.card ≤ (potKeys.toFinset ∪ {X i}).card := by
    apply Finset.card_le_card
    intro key hkey
    have hsubset :=
      searchPathKeys_staticSubRoot_toFinset_subset_sourcePotentialKeys_union
        (X := X) (t := t) (done := done) (future := future)
        (i := i) hsub
    exact hsubset hkey
  have hunion_card :
      (potKeys.toFinset ∪ {X i}).card ≤ potKeys.toFinset.card + 1 := by
    calc
      (potKeys.toFinset ∪ {X i}).card
          ≤ potKeys.toFinset.card + ({X i} : Finset Nat).card :=
            Finset.card_union_le _ _
      _ = potKeys.toFinset.card + 1 := by simp
  have hlen : pathKeys.length ≤ potKeys.length + 1 := by
    omega
  rw [show pathKeys.length = t.search_path_len (X i) by
    unfold pathKeys
    exact searchPathKeys_length_eq_search_path_len t (X i)] at hlen
  simpa [potKeys] using hlen

private theorem search_path_len_real_le_sourcePotential_staticSubRoot_add_one
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree}
    {done future : List (Fin n)} {i : Fin n}
    (hbst : IsBST t)
    (hsub : staticSubRootByTouched X t done (X i)) :
    (t.search_path_len (X i) : ℝ) ≤
      sourcePotential X t done (i :: future) / 2 + 1 := by
  let pathKeys := searchPathKeys t (X i)
  let potKeys := sourcePotentialKeys X t done (i :: future)
  have hpath_nodup : pathKeys.Nodup := by
    unfold pathKeys
    exact searchPathKeys_nodup_of_isBST t (X i) hbst
  have hpot_nodup : potKeys.Nodup := by
    unfold potKeys
    exact sourcePotentialKeys_nodup_of_isBST X done (i :: future) hbst
  have hpath_card :
      pathKeys.toFinset.card = pathKeys.length :=
    List.toFinset_card_of_nodup hpath_nodup
  have hpot_card :
      potKeys.toFinset.card = potKeys.length :=
    List.toFinset_card_of_nodup hpot_nodup
  have hcard_subset :
      pathKeys.toFinset.card ≤ (potKeys.toFinset ∪ {X i}).card := by
    apply Finset.card_le_card
    intro key hkey
    have hkey_path : key ∈ searchPathKeys t (X i) := by
      simpa [pathKeys] using hkey
    rw [Finset.mem_union]
    by_cases hkey_eq : key = X i
    · right
      simp [hkey_eq]
    · left
      have hkey_mem_tree : key ∈ t.toKeyList :=
        searchPathKeys_subset_toKeyList t (X i) key hkey_path
      have hkey_touched : touchedByList X done key :=
        hsub.2.2 key ⟨hkey_path, hkey_eq⟩
      have hkey_pot : key ∈ sourcePotentialKeys X t done (i :: future) :=
        (mem_sourcePotentialKeys_iff X t done (i :: future)).mpr
          ⟨hkey_mem_tree, hkey_touched,
            ⟨i, by simp, hkey_path⟩⟩
      simpa [potKeys] using hkey_pot
  have hunion_card :
      (potKeys.toFinset ∪ {X i}).card ≤ potKeys.toFinset.card + 1 := by
    calc
      (potKeys.toFinset ∪ {X i}).card
          ≤ potKeys.toFinset.card + ({X i} : Finset Nat).card :=
            Finset.card_union_le _ _
      _ = potKeys.toFinset.card + 1 := by simp
  have hlen : pathKeys.length ≤ potKeys.length + 1 := by
    omega
  have hlen_real :
      (pathKeys.length : ℝ) ≤ (potKeys.length : ℝ) + 1 := by
    exact_mod_cast hlen
  rw [show pathKeys.length = t.search_path_len (X i) by
    unfold pathKeys
    exact searchPathKeys_length_eq_search_path_len t (X i)] at hlen_real
  unfold sourcePotential
  nlinarith

private theorem sourcePotentialKeys_after_splay_sublist_cons_future
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree}
    (done future : List (Fin n)) (i : Fin n)
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hfuture_mem : ∀ j : Fin n, j ∈ future → X j ∈ t.toKeyList) :
    (sourcePotentialKeys X (splay t (X i)) done future).Sublist
      (sourcePotentialKeys X t done (i :: future)) := by
  unfold sourcePotentialKeys
  rw [splay_toKeyList]
  apply filter_sublist_filter_of_imp
  intro key hkey
  simp at hkey ⊢
  rcases hkey with ⟨htouched, j, hj, hpath⟩
  have hor :=
    searchPathKeys_splay_subset_union t (X i) (X j) key
      hbst hi_mem (hfuture_mem j hj) hpath
  rcases hor with hi_path | hj_path
  · exact ⟨htouched, Or.inl hi_path⟩
  · exact ⟨htouched, Or.inr ⟨j, hj, hj_path⟩⟩

private theorem sourcePotentialKeys_cons_done_toFinset_subset_union
    {n : Nat} (X : Fin n → Nat) (t : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) :
    (sourcePotentialKeys X t (i :: done) future).toFinset ⊆
      (sourcePotentialKeys X t done future).toFinset ∪ {X i} := by
  intro key hkey
  have hkey_new : key ∈ sourcePotentialKeys X t (i :: done) future := by
    simpa using hkey
  rcases (mem_sourcePotentialKeys_iff X t (i :: done) future).mp hkey_new with
    ⟨hmem_tree, htouched, hfuture⟩
  rw [Finset.mem_union]
  rcases htouched with ⟨j, hj, hjkey⟩
  simp at hj
  rcases hj with hji | hjdone
  · right
    subst j
    simpa using hjkey.symm
  · left
    have hkey_old : key ∈ sourcePotentialKeys X t done future :=
      (mem_sourcePotentialKeys_iff X t done future).mpr
        ⟨hmem_tree, ⟨j, hjdone, hjkey⟩, hfuture⟩
    simpa using hkey_old

private theorem sourcePotentialKeys_after_append_mark_splay_toFinset_subset_union
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree}
    (done future : List (Fin n)) (i : Fin n)
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hfuture_mem : ∀ j : Fin n, j ∈ future → X j ∈ t.toKeyList) :
    (sourcePotentialKeys X (splay t (X i)) (done ++ [i]) future).toFinset ⊆
      (sourcePotentialKeys X t done (i :: future)).toFinset ∪ {X i} := by
  intro key hkey
  have hkey_cons :
      key ∈ sourcePotentialKeys X (splay t (X i)) (i :: done) future := by
    rw [← sourcePotentialKeys_append_singleton_eq_cons]
    simpa using hkey
  have hmid :
      key ∈ sourcePotentialKeys X t (i :: done) (i :: future) := by
    have hsub :=
      sourcePotentialKeys_after_splay_sublist_cons_future
        X (i :: done) future i hbst hi_mem hfuture_mem
    exact hsub.subset hkey_cons
  have hsubset :=
    sourcePotentialKeys_cons_done_toFinset_subset_union
      X t done (i :: future) i
  exact hsubset (by simpa using hmid)

private theorem sourcePotentialKeys_card_drop_of_staticSubRoot_inter_singleton
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree}
    {done future : List (Fin n)} {i : Fin n}
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hfuture_mem : ∀ j : Fin n, j ∈ future → X j ∈ t.toKeyList)
    (hsub : staticSubRootByTouched X t done (X i))
    (hinter :
      ∀ key : Nat,
        key ∈ sourcePotentialKeys X (splay t (X i)) (done ++ [i]) future →
        key ∈ searchPathKeys t (X i) →
        key = X i) :
    (sourcePotentialKeys X (splay t (X i)) (done ++ [i]) future).length +
        t.search_path_len (X i) ≤
      (sourcePotentialKeys X t done (i :: future)).length + 2 := by
  classical
  let newKeys :=
    sourcePotentialKeys X (splay t (X i)) (done ++ [i]) future
  let oldKeys := sourcePotentialKeys X t done (i :: future)
  let pathKeys := searchPathKeys t (X i)
  have hnew_nodup : newKeys.Nodup := by
    unfold newKeys
    exact sourcePotentialKeys_nodup_of_isBST
      X (done ++ [i]) future (splay_isBST t (X i) hbst)
  have hold_nodup : oldKeys.Nodup := by
    unfold oldKeys
    exact sourcePotentialKeys_nodup_of_isBST X done (i :: future) hbst
  have hpath_nodup : pathKeys.Nodup := by
    unfold pathKeys
    exact searchPathKeys_nodup_of_isBST t (X i) hbst
  have hnew_card : newKeys.toFinset.card = newKeys.length :=
    List.toFinset_card_of_nodup hnew_nodup
  have hold_card : oldKeys.toFinset.card = oldKeys.length :=
    List.toFinset_card_of_nodup hold_nodup
  have hpath_card : pathKeys.toFinset.card = pathKeys.length :=
    List.toFinset_card_of_nodup hpath_nodup
  have hnew_subset :
      newKeys.toFinset ⊆ oldKeys.toFinset ∪ {X i} := by
    intro key hkey
    have hsubset :=
      sourcePotentialKeys_after_append_mark_splay_toFinset_subset_union
        X done future i hbst hi_mem hfuture_mem
    exact hsubset (by simpa [newKeys] using hkey)
  have hpath_subset :
      pathKeys.toFinset ⊆ oldKeys.toFinset ∪ {X i} := by
    intro key hkey
    have hsubset :=
      searchPathKeys_staticSubRoot_toFinset_subset_sourcePotentialKeys_union
        (X := X) (t := t) (done := done) (future := future)
        (i := i) hsub
    exact hsubset (by simpa [oldKeys, pathKeys] using hkey)
  have hunion_subset :
      newKeys.toFinset ∪ pathKeys.toFinset ⊆ oldKeys.toFinset ∪ {X i} := by
    intro key hkey
    rw [Finset.mem_union] at hkey
    rcases hkey with hkey_new | hkey_path
    · exact hnew_subset hkey_new
    · exact hpath_subset hkey_path
  have hcard_union_bound :
      (newKeys.toFinset ∪ pathKeys.toFinset).card ≤ oldKeys.toFinset.card + 1 := by
    calc
      (newKeys.toFinset ∪ pathKeys.toFinset).card
          ≤ (oldKeys.toFinset ∪ {X i}).card :=
            Finset.card_le_card hunion_subset
      _ ≤ oldKeys.toFinset.card + ({X i} : Finset Nat).card :=
            Finset.card_union_le _ _
      _ = oldKeys.toFinset.card + 1 := by simp
  have hinter_subset :
      newKeys.toFinset ∩ pathKeys.toFinset ⊆ ({X i} : Finset Nat) := by
    intro key hkey
    rw [Finset.mem_inter] at hkey
    have hkey_eq :
        key = X i :=
      hinter key
        (by simpa [newKeys] using hkey.1)
        (by simpa [pathKeys] using hkey.2)
    simp [hkey_eq]
  have hcard_inter_bound :
      (newKeys.toFinset ∩ pathKeys.toFinset).card ≤ 1 := by
    calc
      (newKeys.toFinset ∩ pathKeys.toFinset).card
          ≤ ({X i} : Finset Nat).card :=
            Finset.card_le_card hinter_subset
      _ = 1 := by simp
  have hcard_sum :
      newKeys.toFinset.card + pathKeys.toFinset.card ≤
        oldKeys.toFinset.card + 2 := by
    have hinc :=
      Finset.card_union_add_card_inter newKeys.toFinset pathKeys.toFinset
    have hsum :
        newKeys.toFinset.card + pathKeys.toFinset.card =
          (newKeys.toFinset ∪ pathKeys.toFinset).card +
            (newKeys.toFinset ∩ pathKeys.toFinset).card := by
      exact hinc.symm
    omega
  have hlen :
      newKeys.length + pathKeys.length ≤ oldKeys.length + 2 := by
    omega
  rw [show pathKeys.length = t.search_path_len (X i) by
    unfold pathKeys
    exact searchPathKeys_length_eq_search_path_len t (X i)] at hlen
  simpa [newKeys, oldKeys] using hlen

private theorem sourcePotential_after_splay_le_cons_future
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree}
    (done future : List (Fin n)) (i : Fin n)
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hfuture_mem : ∀ j : Fin n, j ∈ future → X j ∈ t.toKeyList) :
    sourcePotential X (splay t (X i)) done future ≤
      sourcePotential X t done (i :: future) := by
  have hlen :=
    List.Sublist.length_le
      (sourcePotentialKeys_after_splay_sublist_cons_future
        X done future i hbst hi_mem hfuture_mem)
  have hlen_real :
      ((sourcePotentialKeys X (splay t (X i)) done future).length : ℝ) ≤
        (sourcePotentialKeys X t done (i :: future)).length := by
    exact_mod_cast hlen
  unfold sourcePotential
  nlinarith

private theorem sourcePotential_cons_done_le_add_two {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree}
    (done future : List (Fin n)) (i : Fin n)
    (hbst : IsBST t) :
    sourcePotential X t (i :: done) future ≤
      sourcePotential X t done future + 2 := by
  let newKeys := sourcePotentialKeys X t (i :: done) future
  let oldKeys := sourcePotentialKeys X t done future
  have hnew_nodup : newKeys.Nodup := by
    unfold newKeys
    exact sourcePotentialKeys_nodup_of_isBST X (i :: done) future hbst
  have hold_nodup : oldKeys.Nodup := by
    unfold oldKeys
    exact sourcePotentialKeys_nodup_of_isBST X done future hbst
  have hnew_card : newKeys.toFinset.card = newKeys.length :=
    List.toFinset_card_of_nodup hnew_nodup
  have hold_card : oldKeys.toFinset.card = oldKeys.length :=
    List.toFinset_card_of_nodup hold_nodup
  have hsubset_card :
      newKeys.toFinset.card ≤ (oldKeys.toFinset ∪ {X i}).card := by
    apply Finset.card_le_card
    intro key hkey
    have hkey_new : key ∈ sourcePotentialKeys X t (i :: done) future := by
      simpa [newKeys] using hkey
    rcases (mem_sourcePotentialKeys_iff X t (i :: done) future).mp hkey_new with
      ⟨hmem_tree, htouched, hfuture⟩
    rw [Finset.mem_union]
    rcases htouched with ⟨j, hj, hjkey⟩
    simp at hj
    rcases hj with hji | hjdone
    · right
      subst j
      simpa using hjkey.symm
    · left
      have hold :
          key ∈ sourcePotentialKeys X t done future :=
        (mem_sourcePotentialKeys_iff X t done future).mpr
          ⟨hmem_tree, ⟨j, hjdone, hjkey⟩, hfuture⟩
      simpa [oldKeys] using hold
  have hunion_card :
      (oldKeys.toFinset ∪ {X i}).card ≤ oldKeys.toFinset.card + 1 := by
    calc
      (oldKeys.toFinset ∪ {X i}).card
          ≤ oldKeys.toFinset.card + ({X i} : Finset Nat).card :=
            Finset.card_union_le _ _
      _ = oldKeys.toFinset.card + 1 := by simp
  have hlen : newKeys.length ≤ oldKeys.length + 1 := by
    omega
  have hlen_real : (newKeys.length : ℝ) ≤ (oldKeys.length : ℝ) + 1 := by
    exact_mod_cast hlen
  unfold sourcePotential newKeys oldKeys at hlen_real
  unfold sourcePotential
  nlinarith

private theorem sourcePotential_after_mark_splay_le_add_two {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree}
    (done future : List (Fin n)) (i : Fin n)
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hfuture_mem : ∀ j : Fin n, j ∈ future → X j ∈ t.toKeyList) :
    sourcePotential X (splay t (X i)) (i :: done) future ≤
      sourcePotential X t done (i :: future) + 2 := by
  have hsplay :
      sourcePotential X (splay t (X i)) (i :: done) future ≤
        sourcePotential X t (i :: done) (i :: future) :=
    sourcePotential_after_splay_le_cons_future
      X (i :: done) future i hbst hi_mem hfuture_mem
  have hmark :
      sourcePotential X t (i :: done) (i :: future) ≤
        sourcePotential X t done (i :: future) + 2 :=
    sourcePotential_cons_done_le_add_two X done (i :: future) i hbst
  exact le_trans hsplay hmark

private theorem sourcePotential_after_append_mark_splay_le_add_two
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree}
    (done future : List (Fin n)) (i : Fin n)
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hfuture_mem : ∀ j : Fin n, j ∈ future → X j ∈ t.toKeyList) :
    sourcePotential X (splay t (X i)) (done ++ [i]) future ≤
      sourcePotential X t done (i :: future) + 2 := by
  rw [sourcePotential_append_singleton_eq_cons]
  exact
    sourcePotential_after_mark_splay_le_add_two
      X done future i hbst hi_mem hfuture_mem

private noncomputable def sourceActivePotential
    (α β γ : ℝ) {n : Nat} (X : Fin n → Nat)
    (init t : BinaryTree) (done future : List (Fin n)) : ℝ :=
  α * sourcePotential X t done future +
    β * activeBudget X t future +
    γ * activeBudget X init future

private theorem sourceActivePotential_initial_le
    (α β γ : ℝ) (hβ : 0 ≤ β) (hγ : 0 ≤ γ)
    {n : Nat} (X : Fin n → Nat) (init : BinaryTree)
    (h_size : init.num_nodes = n) :
    sourceActivePotential α β γ X init init [] (List.finRange n) ≤
      2 * (β + γ) * (n : ℝ) := by
  have hbudget :=
    activeBudget_finRange_le_two_mul_size X init h_size
  unfold sourceActivePotential
  rw [sourcePotential_nil_done]
  nlinarith [show 0 ≤ (n : ℝ) by positivity]

private theorem sourceActivePotential_nonneg
    (α β γ : ℝ) (hα : 0 ≤ α) (hβ : 0 ≤ β) (hγ : 0 ≤ γ)
    {n : Nat} (X : Fin n → Nat) (init t : BinaryTree)
    (done future : List (Fin n)) :
    0 ≤ sourceActivePotential α β γ X init t done future := by
  have hsource := sourcePotential_nonneg X t done future
  have hactive_t := activeBudget_nonneg X t future
  have hactive_init := activeBudget_nonneg X init future
  unfold sourceActivePotential
  nlinarith

private noncomputable def sourceSequentialActivePotential
    (α β γ δ : ℝ) {n : Nat} (X : Fin n → Nat)
    (init t : BinaryTree) (done future : List (Fin n)) : ℝ :=
  α * sourcePotential X t done future +
    β * strongSequentialPotential t +
    γ * reverseStrongSequentialPotential t +
    δ * activeBudget X t future

private theorem sourceSequentialActivePotential_initial_le
    (α β γ δ : ℝ) (hβ : 0 ≤ β) (hγ : 0 ≤ γ) (hδ : 0 ≤ δ)
    {n : Nat} (X : Fin n → Nat) (init : BinaryTree)
    (h_size : init.num_nodes = n) :
    sourceSequentialActivePotential α β γ δ X init init [] (List.finRange n) ≤
      (15 * β + 15 * γ + 2 * δ) * (n : ℝ) := by
  have hstrong := strongSequentialPotential_le_fifteen_num_nodes init
  have hrev := reverseStrongSequentialPotential_le_fifteen_num_nodes init
  have hactive := activeBudget_finRange_le_two_mul_size X init h_size
  rw [h_size] at hstrong hrev
  unfold sourceSequentialActivePotential
  rw [sourcePotential_nil_done]
  nlinarith [show 0 ≤ (n : ℝ) by positivity]

private theorem sourceSequentialActivePotential_nonneg
    (α β γ δ : ℝ) (hα : 0 ≤ α) (hβ : 0 ≤ β)
    (hγ : 0 ≤ γ) (hδ : 0 ≤ δ)
    {n : Nat} (X : Fin n → Nat) (init t : BinaryTree)
    (done future : List (Fin n)) :
    0 ≤ sourceSequentialActivePotential α β γ δ X init t done future := by
  have hsource := sourcePotential_nonneg X t done future
  have hstrong := strongSequentialPotential_nonneg t
  have hrev := reverseStrongSequentialPotential_nonneg t
  have hactive := activeBudget_nonneg X t future
  unfold sourceSequentialActivePotential
  nlinarith

private theorem splayPathSum_le_of_sourcePotential_step {n : Nat}
    (X : Fin n → Nat) (C : ℝ)
    (hstep :
      ∀ (t : BinaryTree) (done : List (Fin n))
          (i : Fin n) (future : List (Fin n)),
        (t.search_path_len (X i) : ℝ) +
            sourcePotential X (splay t (X i)) (i :: done) future ≤
          C + sourcePotential X t done (i :: future)) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (done : List (Fin n)),
      splayPathSum X t xs ≤
        C * (xs.length : ℝ) + sourcePotential X t done xs
| [], t, done => by
    simp [splayPathSum, sourcePotential_nil_future]
| i :: xs, t, done => by
    have ih :=
      splayPathSum_le_of_sourcePotential_step
        X C hstep xs (splay t (X i)) (i :: done)
    have hs := hstep t done i xs
    simp only [splayPathSum, List.length_cons, Nat.cast_add, Nat.cast_one]
    nlinarith

private theorem splayPathSum_finRange_le_of_sourcePotential_step {n : Nat}
    (X : Fin n → Nat) (init : BinaryTree) (C : ℝ)
    (hstep :
      ∀ (t : BinaryTree) (done : List (Fin n))
          (i : Fin n) (future : List (Fin n)),
        (t.search_path_len (X i) : ℝ) +
            sourcePotential X (splay t (X i)) (i :: done) future ≤
          C + sourcePotential X t done (i :: future)) :
    splayPathSum X init (List.finRange n) ≤ C * (n : ℝ) := by
  have h :=
    splayPathSum_le_of_sourcePotential_step
      X C hstep (List.finRange n) init []
  rw [List.length_finRange, sourcePotential_nil_done] at h
  simpa using h

private theorem mem_boundaryHullKeys_iff {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (q : Nat)
    {key : Nat} :
    key ∈ boundaryHullKeys X t xs q ↔
      key ∈ t.toKeyList ∧
        (key ∈ searchPathKeys t q ∨
          ∃ i : Fin n, i ∈ xs ∧ key ∈ searchPathKeys t (X i)) := by
  unfold boundaryHullKeys
  rw [List.mem_filter]
  simp

private theorem boundaryHullKeys_nodup_of_isBST {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n)) (q : Nat)
    (hbst : IsBST t) :
    (boundaryHullKeys X t xs q).Nodup := by
  unfold boundaryHullKeys
  exact List.Nodup.filter _ (isBST_toKeyList_nodup hbst)

private theorem mem_boundaryHullKeys_of_mem_boundaryPath {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (q : Nat)
    {key : Nat}
    (hpath : key ∈ searchPathKeys t q) :
    key ∈ boundaryHullKeys X t xs q := by
  unfold boundaryHullKeys
  refine List.mem_filter_of_mem ?_ ?_
  · exact searchPathKeys_subset_toKeyList t q key hpath
  · exact decide_eq_true (Or.inl hpath)

private theorem mem_boundaryHullKeys_of_mem_searchPath {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (q : Nat)
    {i : Fin n} {key : Nat}
    (hi : i ∈ xs) (hpath : key ∈ searchPathKeys t (X i)) :
    key ∈ boundaryHullKeys X t xs q := by
  unfold boundaryHullKeys
  refine List.mem_filter_of_mem ?_ ?_
  · exact searchPathKeys_subset_toKeyList t (X i) key hpath
  · exact decide_eq_true (Or.inr ⟨i, hi, hpath⟩)

private theorem activeHullKeys_sublist_boundaryHullKeys {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (q : Nat) :
    (activeHullKeys X t xs).Sublist (boundaryHullKeys X t xs q) := by
  unfold activeHullKeys boundaryHullKeys
  apply filter_sublist_filter_of_imp
  intro key hkey
  simp at hkey ⊢
  exact Or.inr hkey

private theorem activeHullSize_le_boundaryHullSize {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (q : Nat) :
    activeHullSize X t xs ≤ boundaryHullSize X t xs q := by
  unfold activeHullSize boundaryHullSize
  exact List.Sublist.length_le
    (activeHullKeys_sublist_boundaryHullKeys X t xs q)

private theorem boundaryHullKeys_sublist_of_sublist {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (q : Nat)
    {xs ys : List (Fin n)}
    (hsub : xs.Sublist ys) :
    (boundaryHullKeys X t xs q).Sublist (boundaryHullKeys X t ys q) := by
  unfold boundaryHullKeys
  apply filter_sublist_filter_of_imp
  intro key hkey
  simp at hkey ⊢
  rcases hkey with hq | ⟨i, hi, hpath⟩
  · exact Or.inl hq
  · exact Or.inr ⟨i, hsub.subset hi, hpath⟩

private theorem boundaryHullSize_sublist_le {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (q : Nat)
    {xs ys : List (Fin n)}
    (hsub : xs.Sublist ys) :
    boundaryHullSize X t xs q ≤ boundaryHullSize X t ys q := by
  unfold boundaryHullSize
  exact List.Sublist.length_le
    (boundaryHullKeys_sublist_of_sublist X t q hsub)

private theorem boundaryHullKeys_boundary_mem_sublist {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n))
    (q : Nat) {i : Fin n} (hi : i ∈ xs) :
    (boundaryHullKeys X t xs (X i)).Sublist
      (boundaryHullKeys X t xs q) := by
  unfold boundaryHullKeys
  apply filter_sublist_filter_of_imp
  intro key hkey
  simp at hkey ⊢
  rcases hkey with hboundary | hactive
  · exact Or.inr ⟨i, hi, hboundary⟩
  · exact Or.inr hactive

private theorem boundaryHullSize_boundary_mem_le {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n))
    (q : Nat) {i : Fin n} (hi : i ∈ xs) :
    boundaryHullSize X t xs (X i) ≤ boundaryHullSize X t xs q := by
  unfold boundaryHullSize
  exact List.Sublist.length_le
    (boundaryHullKeys_boundary_mem_sublist X t xs q hi)

private theorem boundaryBudget_boundary_mem_le {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n))
    (q : Nat) {i : Fin n} (hi : i ∈ xs) :
    boundaryBudget X t xs (X i) ≤ boundaryBudget X t xs q := by
  have hhull := boundaryHullSize_boundary_mem_le X t xs q hi
  unfold boundaryBudget
  exact_mod_cast Nat.add_le_add_left hhull xs.length

private theorem boundaryHullSize_le_num_nodes {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (q : Nat) :
    boundaryHullSize X t xs q ≤ t.num_nodes := by
  unfold boundaryHullSize boundaryHullKeys
  have hlen := List.length_eq_length_filter_add
    (l := t.toKeyList)
    (f := fun key =>
      decide (key ∈ searchPathKeys t q ∨
        ∃ i : Fin n, i ∈ xs ∧ key ∈ searchPathKeys t (X i)))
  rw [toKeyList_length] at hlen
  omega

private theorem search_path_len_le_boundaryHullSize_of_boundary {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n)) (q : Nat)
    (hbst : IsBST t) :
    t.search_path_len q ≤ boundaryHullSize X t xs q := by
  rw [← searchPathKeys_length_eq_search_path_len]
  have hpath_nodup : (searchPathKeys t q).Nodup :=
    searchPathKeys_nodup_of_isBST t q hbst
  have hhull_nodup : (boundaryHullKeys X t xs q).Nodup :=
    boundaryHullKeys_nodup_of_isBST X xs q hbst
  have hpath_card :
      (searchPathKeys t q).toFinset.card =
        (searchPathKeys t q).length :=
    List.toFinset_card_of_nodup hpath_nodup
  have hhull_card :
      (boundaryHullKeys X t xs q).toFinset.card =
        boundaryHullSize X t xs q := by
    unfold boundaryHullSize
    exact List.toFinset_card_of_nodup hhull_nodup
  rw [← hpath_card, ← hhull_card]
  apply Finset.card_le_card
  intro key hkey
  simp at hkey ⊢
  exact mem_boundaryHullKeys_of_mem_boundaryPath X t xs q hkey

private theorem search_path_len_real_le_boundaryHullSize_of_boundary {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n)) (q : Nat)
    (hbst : IsBST t) :
    (t.search_path_len q : ℝ) ≤ boundaryHullSize X t xs q := by
  exact_mod_cast
    search_path_len_le_boundaryHullSize_of_boundary X xs q hbst

private theorem search_path_len_real_le_boundaryBudget_of_boundary {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n)) (q : Nat)
    (hbst : IsBST t) :
    (t.search_path_len q : ℝ) ≤ boundaryBudget X t xs q := by
  have hpath :=
    search_path_len_real_le_boundaryHullSize_of_boundary X xs q hbst
  unfold boundaryBudget
  nlinarith [show 0 ≤ (xs.length : ℝ) by positivity]

private theorem search_path_len_real_le_boundaryBudget_of_mem {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n)) (q : Nat)
    (hbst : IsBST t) {i : Fin n} (hi : i ∈ xs) :
    (t.search_path_len (X i) : ℝ) ≤ boundaryBudget X t xs q := by
  have hpath := search_path_len_real_le_activeHullSize_of_mem X xs hbst hi
  have hhull := activeHullSize_le_boundaryHullSize X t xs q
  have hhullR :
      (activeHullSize X t xs : ℝ) ≤ boundaryHullSize X t xs q := by
    exact_mod_cast hhull
  unfold boundaryBudget
  nlinarith [show 0 ≤ (xs.length : ℝ) by positivity, hhullR]

private theorem boundaryBudget_nonneg {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (q : Nat) :
    0 ≤ boundaryBudget X t xs q := by
  unfold boundaryBudget
  positivity

private theorem length_le_boundaryBudget {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (q : Nat) :
    (xs.length : ℝ) ≤ boundaryBudget X t xs q := by
  unfold boundaryBudget
  nlinarith [show 0 ≤ (boundaryHullSize X t xs q : ℝ) by positivity]

private theorem pivotResetPairPathSum_le_boundaryBudget_of_potential {n : Nat}
    (Y : Fin n → Nat) (q : Nat)
    (Φ : BinaryTree → List (Fin n) → ℝ) (C A : ℝ)
    (hC : 0 ≤ C)
    (hstep :
      ∀ (t : BinaryTree) (i : Fin n) (xs : List (Fin n)),
        (t.search_path_len (Y i) : ℝ) +
            ((splay t (Y i)).search_path_len q : ℝ) +
            Φ (splay (splay t (Y i)) q) xs ≤
          C + Φ t (i :: xs))
    (hnil : ∀ t : BinaryTree, 0 ≤ Φ t [])
    (hΦ :
      ∀ (xs : List (Fin n)) (t : BinaryTree),
        Φ t xs ≤ A * boundaryBudget Y t xs q)
    (xs : List (Fin n)) (t : BinaryTree) :
    pivotResetPairPathSum Y q t xs ≤
      (C + A) * boundaryBudget Y t xs q := by
  have hpair :=
    pivotResetPairPathSum_le_of_potential Y q Φ C hstep hnil xs t
  have hlen := length_le_boundaryBudget Y t xs q
  have hC_len :
      C * (xs.length : ℝ) ≤ C * boundaryBudget Y t xs q := by
    exact mul_le_mul_of_nonneg_left hlen hC
  have hPhi := hΦ xs t
  nlinarith

private theorem pivotResetPairPathSum_le_length_add_boundaryBudget_of_weighted_step_of_lt
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (A C : ℝ)
    (hA : 0 ≤ A) (hC : 0 ≤ C)
    (hstep :
      ∀ (t : BinaryTree) (i : Fin n) (xs : List (Fin n)),
        IsBST t →
        rootKey t = some q →
        Y i ∈ t.toKeyList →
        Y i < q →
        (∀ j : Fin n, j ∈ xs → Y j ∈ t.toKeyList) →
        (∀ j : Fin n, j ∈ xs → Y j < q) →
        (t.search_path_len (Y i) : ℝ) +
            ((splay t (Y i)).search_path_len q : ℝ) +
            A *
              boundaryBudget Y (splay (splay t (Y i)) q) xs q ≤
          C + A * boundaryBudget Y t (i :: xs) q) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t →
      rootKey t = some q →
      (∀ i : Fin n, i ∈ xs → Y i ∈ t.toKeyList) →
      (∀ i : Fin n, i ∈ xs → Y i < q) →
      pivotResetPairPathSum Y q t xs ≤
        C * (xs.length : ℝ) + A * boundaryBudget Y t xs q
| [], t, hbst, hroot, _hmem, _hlt => by
    have hB := boundaryBudget_nonneg Y t ([] : List (Fin n)) q
    simp [pivotResetPairPathSum]
    exact mul_nonneg hA hB
| i :: xs, t, hbst, hroot, hmem, hlt => by
    have hi_mem : Y i ∈ t.toKeyList := hmem i (by simp)
    have hi_lt : Y i < q := hlt i (by simp)
    have hmem_tail : ∀ j : Fin n, j ∈ xs → Y j ∈ t.toKeyList := by
      intro j hj
      exact hmem j (by simp [hj])
    have hlt_tail : ∀ j : Fin n, j ∈ xs → Y j < q := by
      intro j hj
      exact hlt j (by simp [hj])
    let tr := splay (splay t (Y i)) q
    have hbst_tr : IsBST tr := by
      unfold tr
      exact splay_isBST (splay t (Y i)) q
        (splay_isBST t (Y i) hbst)
    have hroot_tr : rootKey tr = some q := by
      unfold tr
      exact rootKey_after_pivot_reset_of_root hbst hroot
    have hmem_tail_tr :
        ∀ j : Fin n, j ∈ xs → Y j ∈ tr.toKeyList := by
      intro j hj
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hmem_tail j hj
    have ih :=
      pivotResetPairPathSum_le_length_add_boundaryBudget_of_weighted_step_of_lt
        Y q A C hA hC hstep xs tr hbst_tr hroot_tr
        hmem_tail_tr hlt_tail
    have hs :=
      hstep t i xs hbst hroot hi_mem hi_lt hmem_tail hlt_tail
    simp [pivotResetPairPathSum, tr]
    nlinarith

private theorem pivotResetPairPathSum_le_boundaryBudget_of_weighted_step_of_lt
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (A C : ℝ)
    (hA : 0 ≤ A) (hC : 0 ≤ C)
    (hstep :
      ∀ (t : BinaryTree) (i : Fin n) (xs : List (Fin n)),
        IsBST t →
        rootKey t = some q →
        Y i ∈ t.toKeyList →
        Y i < q →
        (∀ j : Fin n, j ∈ xs → Y j ∈ t.toKeyList) →
