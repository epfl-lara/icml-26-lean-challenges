private theorem rooted_upper_pathSum_le_boundaryBudget_of_pair_bound
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (t : BinaryTree)
    (K : ℝ)
    (htail_dom :
      ∀ (t' : BinaryTree) (i : Fin n) (xs : List (Fin n)),
        rootKey t' = some q →
        Y i < q →
        (∀ j : Fin n, j ∈ xs → Y j ≤ q) →
        splayPathSum Y (splay t' (Y i)) xs ≤
          ((splay t' (Y i)).search_path_len q : ℝ) +
            suffixResetUpperPathSum Y q
              (splay (splay t' (Y i)) q) xs +
            xs.length)
    (hroot : rootKey t = some q)
    (hle : ∀ i : Fin n, Y i ≤ q)
    (hpair :
      pivotResetPairPathSum Y q t
          ((List.finRange n).filter (fun i => decide (Y i < q))) ≤
        K * boundaryBudget Y t (List.finRange n) q) :
    splayPathSum Y t (List.finRange n) ≤
      (K + 2) * boundaryBudget Y t (List.finRange n) q := by
  have hupper :=
    rooted_upper_pathSum_le_pivotResetPairPathSum_add_two_length
      Y q htail_dom (List.finRange n) t hroot
      (by
        intro i _hi
        exact hle i)
  have hN_le_B :
      (n : ℝ) ≤ boundaryBudget Y t (List.finRange n) q := by
    unfold boundaryBudget
    rw [List.length_finRange]
    nlinarith [show 0 ≤
      (boundaryHullSize Y t (List.finRange n) q : ℝ) by positivity]
  rw [List.length_finRange] at hupper
  nlinarith [hupper, hpair, hN_le_B]

private theorem rooted_upper_pathSum_le_boundaryBudget_of_pair_bound_of_mem_tail
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (t : BinaryTree)
    (K : ℝ)
    (htail_dom :
