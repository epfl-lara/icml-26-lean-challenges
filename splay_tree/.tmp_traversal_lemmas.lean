private theorem pivotResetLowerPathSum_sublist_le_of_finRange_bound
    (K : ℝ) (_hK : 0 ≤ K)
    (hlower :
      ∀ {N : Nat} (Z : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin N, Z i ∈ t.toKeyList) →
        (Z avoids ![2, 3, 1]) →
        (∀ i : Fin N, Z i < q) →
        pivotResetLowerPathSum Z q t (List.finRange N) ≤
          K * boundaryBudget Z t (List.finRange N) q)
    {n : Nat} {Y : Fin n → Nat} {q : Nat} {t : BinaryTree}
    {xs : List (Fin n)}
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem : ∀ i : Fin n, i ∈ xs → Y i ∈ t.toKeyList)
    (havoid : Y avoids ![2, 3, 1])
    (hlt : ∀ i : Fin n, i ∈ xs → Y i < q)
    (hsub : xs.Sublist (List.finRange n)) :
    pivotResetLowerPathSum Y q t xs ≤
      K * boundaryBudget Y t xs q := by
  let Z := listSeq Y xs
  have hmemZ : ∀ i : Fin xs.length, Z i ∈ t.toKeyList := by
    intro i
    exact listSeq_mem_of_mem hmem i
  have hltZ : ∀ i : Fin xs.length, Z i < q := by
    intro i
    exact listSeq_lt_of_lt hlt i
  have havoidZ : Z avoids ![2, 3, 1] := by
    simpa [Z] using listSeq_avoids231_of_sublist_finRange
      (Y := Y) (xs := xs) hsub havoid
  have hZ :=
    hlower Z q t hbst hroot hmemZ havoidZ hltZ
  have hsum := pivotResetLowerPathSum_listSeq_finRange Y q xs t
  have hbudget := boundaryBudget_listSeq_finRange Y q xs t
  rw [hsum, hbudget]
  exact hZ

