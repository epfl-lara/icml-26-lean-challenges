private theorem all_done_le_current_q_cancel_of_root_low_cancel
    {n : Nat} (Y : Fin n → Nat) (q E : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hroot_low_cancel :
      ∀ {q x r : Nat} {actual reset : BinaryTree},
        IsBST actual →
        IsBST reset →
        rootKey reset = some q →
        reset.toKeyList = actual.toKeyList →
        rootKey actual = some r →
        r ≤ x →
        x ∈ actual.toKeyList →
        x < q →
        actual.search_path_len q +
            (splay reset x).search_path_len q ≤
          (splay actual x).search_path_len q + E)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (_havoid : Y avoids ![2, 3, 1])
    (_hle : ∀ j : Fin n, Y j ≤ q)
    (_hsub : (done ++ i :: future).Sublist (List.finRange n))
    (hmem_prefix :
      ∀ j : Fin n, j ∈ done ++ i :: future → Y j ∈ init.toKeyList)
    (hi_mem : Y i ∈ (splayTreeAfter Y init done).toKeyList)
    (hi_lt : Y i < q)
    (hlarge : 1 < done.length)
    (hall_le : ∀ j : Fin n, j ∈ done → Y j ≤ Y i) :
    ((splayTreeAfter Y init done).search_path_len q : ℝ) +
        ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) ≤
      ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) +
        E := by
  have hdone_ne : done ≠ [] := by
    intro hnil
    rw [hnil] at hlarge
    simp at hlarge
  have hmem_done :
      ∀ j : Fin n, j ∈ done → Y j ∈ init.toKeyList := by
    intro j hj
    exact hmem_prefix j (by simp [hj])
  rcases
      exists_rootKey_splayTreeAfter_done_le_current
        Y init done i hbst hmem_done hall_le hdone_ne with
    ⟨r, hroot_actual, hr_le⟩
  rcases reachable_actual_reset_state Y q init done hbst hroot with
    ⟨hbst_actual, hbst_reset, hroot_reset, hkeys⟩
  have hnat :
      (splayTreeAfter Y init done).search_path_len q +
          (splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q ≤
        (splay (splayTreeAfter Y init done) (Y i)).search_path_len q + E :=
    hroot_low_cancel hbst_actual hbst_reset hroot_reset hkeys
      hroot_actual hr_le hi_mem hi_lt
  exact_mod_cast hnat

