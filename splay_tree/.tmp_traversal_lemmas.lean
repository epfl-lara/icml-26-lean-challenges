private theorem current_path_len_all_done_le_current_of_ordered_low_pair_and_q_cancel
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (Cp D E : ℝ)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hD : 0 ≤ D)
    (hCpD : Cp ≤ D)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hmem_prefix :
      ∀ j : Fin n, j ∈ done ++ i :: future → Y j ∈ init.toKeyList)
    (hi_mem : Y i ∈ (splayTreeAfter Y init done).toKeyList)
    (hi_lt : Y i < q)
    (hall_le : ∀ j : Fin n, j ∈ done → Y j ≤ Y i)
    (hordered_low_pair :
      ∀ {q lo x y : Nat} {actual reset : BinaryTree},
        IsBST actual →
        IsBST reset →
        rootKey reset = some q →
        reset.toKeyList = actual.toKeyList →
        x ∈ actual.toKeyList →
        x < q →
        x ≤ lo →
        y ∈ (splay actual x).toKeyList →
        lo ≤ y →
        y < q →
        ((splay actual x).search_path_len y : ℝ) +
            ((splay (splay actual x) y).search_path_len q : ℝ) ≤
          ((splay actual x).search_path_len q : ℝ) +
            ((splay (splay reset x) q).search_path_len y : ℝ) +
            ((splay (splay (splay reset x) q) y).search_path_len q : ℝ) +
            Cp)
    (hcancel :
      ((splayTreeAfter Y init done).search_path_len q : ℝ) +
          ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) ≤
        ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) +
          E) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) ≤
      ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
        (D + E) := by
  have hdom :
      resetPairDominatesAbove q (Y i) D
        (splayTreeAfter Y init done)
        (suffixResetTreeAfter Y q init done) := by
    refine
      resetPairDominatesAbove_threshold_of_all_done_le_current
        Y q D init done i hD hbst hroot ?_ hi_lt hall_le ?_
    · intro j hj
      exact hmem_prefix j (by simp [hj])
    · intro actual reset x hdom hx_mem hx_lt hx_le
      exact
        resetPairDominatesAbove_preserve_low_access_of_ordered_low_pair
          (q := q) (lo := Y i) (x := x) (C := Cp) (D := D)
          hCpD hordered_low_pair hdom hx_mem hx_lt hx_le
  exact
    current_path_len_le_of_resetPairDominatesAbove_and_q_cancel
      (q := q) (lo := Y i) (x := Y i) (D := D) (E := E)
      hdom hi_mem le_rfl hi_lt hcancel

private theorem resetPairDominatesAbove_preserve_low_access_of_path_bound_mono
    {q lo x : Nat} {C D : ℝ} {actual reset : BinaryTree}
    (hCD : C ≤ D)
    (hpath_low :
      ∀ {q lo x y : Nat} {actual reset : BinaryTree},
        resetPairDominatesAbove q lo D actual reset →
        x ∈ actual.toKeyList →
        x < q →
        x ≤ lo →
        y ∈ (splay actual x).toKeyList →
        lo ≤ y →
        y < q →
        ((splay actual x).search_path_len y : ℝ) ≤
          ((splay (splay reset x) q).search_path_len y : ℝ) + C)
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hx_mem : x ∈ actual.toKeyList)
    (hx_lt : x < q)
    (hx_le : x ≤ lo) :
    resetPairDominatesAbove q lo D
      (splay actual x) (splay (splay reset x) q) := by
  refine
    resetPairDominatesAbove_preserve_strict_of_path_len_bound_mono
      (q := q) (lo := lo) (x := x) (C := C) (D := D)
      hCD hdom hx_mem hx_lt ?_
  intro y hy_mem hlo hy_lt
  have hy_mem_after : y ∈ (splay actual x).toKeyList := by
    simpa [splay_toKeyList] using hy_mem
  exact hpath_low hdom hx_mem hx_lt hx_le hy_mem_after hlo hy_lt

