private theorem upperResetDistinctPotential_nonneg {n : Nat}
    (A G : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (hA : 0 ≤ A) (hG : 0 ≤ G) :
