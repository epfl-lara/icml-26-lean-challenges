      (BinaryTree.node l k (.node rl rk (.node a x b))).toKeyList)
    (hmax : ∀ y : Nat,
      y ∈ (BinaryTree.node l k (.node rl rk (.node a x b))).toKeyList →
        y ≤ q)
    (hinner :
      splay.cost (.node a x b) q + 2 +
          reverseStrongSequentialPotential
            (.node (.node l k rl) rk
              (leftSubtree (splay (.node a x b) q))) ≤
        reverseStrongSequentialPotential
          (.node (.node l k rl) rk (.node a x b))) :
    splay.cost (.node l k (.node rl rk (.node a x b))) q + 2 +
