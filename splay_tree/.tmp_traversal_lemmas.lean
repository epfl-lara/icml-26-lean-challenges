private theorem upperResetDistinctPotential_pivot_step_of_gap_growth {n : Nat}
    (A G E : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n)
    (hA : 0 ≤ A) (hG : 0 ≤ G) (hi : X i = q)
    (hgap :
      actualResetDistinctGapPotential X q init (done ++ [i]) future ≤
        actualResetDistinctGapPotential X q init done future + E) :
    upperResetDistinctPotential A G X q init (done ++ [i]) future ≤
      G * E + upperResetDistinctPotential A G X q init done (i :: future) := by
  have hnot : ¬ X i < q := by
    rw [hi]
    omega
  have hreset :
      suffixResetTreeAfter X q init (done ++ [i]) =
        suffixResetTreeAfter X q init done :=
    suffixResetTreeAfter_append_singleton_not_lt X q done init i hnot
  have hgap_mul :
      G * actualResetDistinctGapPotential X q init (done ++ [i]) future ≤
        G * (actualResetDistinctGapPotential X q init done future + E) := by
    exact mul_le_mul_of_nonneg_left hgap hG
  have hcons :=
    upperResetDistinctPotential_cons_pivot_eq
      A G X q init done future i hi
  rw [hcons]
  unfold upperResetDistinctPotential
  rw [hreset]
  nlinarith

