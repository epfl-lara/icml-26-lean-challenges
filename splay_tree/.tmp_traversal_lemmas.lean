private theorem upperResetMaxQPotential_pivot_step_of_gap_growth {n : Nat}
    (A G H E : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n)
    (hA : 0 ≤ A) (hG : 0 ≤ G) (hH : 0 ≤ H)
    (hbst : IsBST init) (hroot : rootKey init = some q)
    (hi : X i = q)
    (hgap :
      actualResetDistinctGapMaxPotential X q init (done ++ [i]) future ≤
        actualResetDistinctGapMaxPotential X q init done future + E) :
    upperResetMaxQPotential A G H X q init (done ++ [i]) future ≤
      G * E + H +
        upperResetMaxQPotential A G H X q init done (i :: future) := by
  have hnot : ¬ X i < q := by
    rw [hi]
    omega
  have hreset :
      suffixResetTreeAfter X q init (done ++ [i]) =
        suffixResetTreeAfter X q init done :=
    suffixResetTreeAfter_append_singleton_not_lt X q done init i hnot
  have hactual_next :
      splayTreeAfter X init (done ++ [i]) =
        splay (splayTreeAfter X init done) q := by
    rw [splayTreeAfter_append]
    simp [splayTreeAfter, hi]
  have hbst_actual : IsBST (splayTreeAfter X init done) :=
    splayTreeAfter_isBST X done init hbst
  have hq_mem_actual : q ∈ (splayTreeAfter X init done).toKeyList := by
    rw [splayTreeAfter_toKeyList]
    exact rootKey_mem_toKeyList hroot
  have hroot_after :
      rootKey (splay (splayTreeAfter X init done) q) = some q :=
    splay_rootKey_eq_some_of_mem_isBST
      (splayTreeAfter X init done) q hbst_actual hq_mem_actual
  have hpath_after :
      ((splayTreeAfter X init (done ++ [i])).search_path_len q : ℝ) = 1 := by
    rw [hactual_next]
    have hpath :
        (splay (splayTreeAfter X init done) q).search_path_len q = 1 :=
      search_path_len_eq_one_of_rootKey_eq_some hroot_after
    exact_mod_cast hpath
  have hgap_mul :
      G * actualResetDistinctGapMaxPotential X q init (done ++ [i]) future ≤
        G * (actualResetDistinctGapMaxPotential X q init done future + E) := by
    exact mul_le_mul_of_nonneg_left hgap hG
  have hcons :=
    upperResetMaxQPotential_cons_pivot_eq
      A G H X q init done future i hi
  rw [hcons]
  unfold upperResetMaxQPotential
  rw [hreset, hpath_after]
  have hq_nonneg :
      0 ≤ ((splayTreeAfter X init done).search_path_len q : ℝ) := by
    positivity
  nlinarith [mul_nonneg hH hq_nonneg]

private theorem upperResetMaxQPotential_pivot_step_of_qpath_growth {n : Nat}
    (A G H : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n)
    (hA : 0 ≤ A) (hG : 0 ≤ G) (hHgeG : G ≤ H)
    (hbst : IsBST init) (hroot : rootKey init = some q)
    (hi : X i = q)
    (hmem_future : ∀ j : Fin n, j ∈ future → X j ∈ init.toKeyList) :
    upperResetMaxQPotential A G H X q init (done ++ [i]) future ≤
      H + upperResetMaxQPotential A G H X q init done (i :: future) := by
  have hnot : ¬ X i < q := by
    rw [hi]
    omega
  have hreset :
      suffixResetTreeAfter X q init (done ++ [i]) =
        suffixResetTreeAfter X q init done :=
    suffixResetTreeAfter_append_singleton_not_lt X q done init i hnot
  have hactual_next :
      splayTreeAfter X init (done ++ [i]) =
        splay (splayTreeAfter X init done) q := by
    rw [splayTreeAfter_append]
    simp [splayTreeAfter, hi]
  have hbst_actual : IsBST (splayTreeAfter X init done) :=
    splayTreeAfter_isBST X done init hbst
  have hq_mem_actual : q ∈ (splayTreeAfter X init done).toKeyList := by
    rw [splayTreeAfter_toKeyList]
    exact rootKey_mem_toKeyList hroot
  have hroot_after :
      rootKey (splay (splayTreeAfter X init done) q) = some q :=
    splay_rootKey_eq_some_of_mem_isBST
      (splayTreeAfter X init done) q hbst_actual hq_mem_actual
  have hpath_after :
      ((splayTreeAfter X init (done ++ [i])).search_path_len q : ℝ) = 1 := by
    rw [hactual_next]
    have hpath :
        (splay (splayTreeAfter X init done) q).search_path_len q = 1 :=
      search_path_len_eq_one_of_rootKey_eq_some hroot_after
    exact_mod_cast hpath
  have hgap :
      actualResetDistinctGapMaxPotential X q init (done ++ [i]) future ≤
        actualResetDistinctGapMaxPotential X q init done future +
          ((splayTreeAfter X init done).search_path_len q : ℝ) :=
    actualResetDistinctGapMaxPotential_pivot_growth_le_qpath
      X q init done future i hbst hroot hi hmem_future
  have hgap_mul :
      G * actualResetDistinctGapMaxPotential X q init (done ++ [i]) future ≤
        G * (actualResetDistinctGapMaxPotential X q init done future +
          ((splayTreeAfter X init done).search_path_len q : ℝ)) := by
    exact mul_le_mul_of_nonneg_left hgap hG
  have hcons :=
    upperResetMaxQPotential_cons_pivot_eq
      A G H X q init done future i hi
  rw [hcons]
  unfold upperResetMaxQPotential
  rw [hreset, hpath_after]
  have hq_nonneg :
      0 ≤ ((splayTreeAfter X init done).search_path_len q : ℝ) := by
    positivity
  have hGq_le_Hq :
      G * ((splayTreeAfter X init done).search_path_len q : ℝ) ≤
        H * ((splayTreeAfter X init done).search_path_len q : ℝ) := by
    exact mul_le_mul_of_nonneg_right hHgeG hq_nonneg
  nlinarith

private theorem suffixResetTreeAfter_split_lt_eq {n : Nat}
    (X : Fin n → Nat) (q : Nat)
    (left right : List (Fin n)) (t : BinaryTree) (p : Fin n)
    (hp : X p < q) :
    suffixResetTreeAfter X q t (left ++ p :: right) =
      suffixResetTreeAfter X q
        (splay (splay (suffixResetTreeAfter X q t left) (X p)) q)
        right := by
  rw [suffixResetTreeAfter_append X q left (p :: right) t]
  simp [suffixResetTreeAfter, hp]

private theorem suffixResetTreeAfter_split_pivot_eq {n : Nat}
    (X : Fin n → Nat) (q : Nat)
    (left right : List (Fin n)) (t : BinaryTree) (p : Fin n)
    (hp : X p = q) :
    suffixResetTreeAfter X q t (left ++ p :: right) =
      suffixResetTreeAfter X q
        (suffixResetTreeAfter X q t left) right := by
  rw [suffixResetTreeAfter_append X q left (p :: right) t]
  have hp_not : ¬ X p < q := by
    rw [hp]
    omega
  simp [suffixResetTreeAfter, hp_not]

private theorem splayTreeAfter_split_pivot_eq {n : Nat}
    (X : Fin n → Nat)
    (left right : List (Fin n)) (t : BinaryTree) (p : Fin n) :
    splayTreeAfter X t (left ++ p :: right) =
      splayTreeAfter X
        (splay (splayTreeAfter X t left) (X p)) right := by
  simpa [List.singleton_append] using
    splayTreeAfter_split_singleton X left right t p

private theorem splayTreeAfter_split_pivot_eq_root {n : Nat}
    (X : Fin n → Nat) (q : Nat)
    (left right : List (Fin n)) (t : BinaryTree) (p : Fin n)
    (hp : X p = q) :
    splayTreeAfter X t (left ++ p :: right) =
      splayTreeAfter X
        (splay (splayTreeAfter X t left) q) right := by
  rw [splayTreeAfter_split_pivot_eq, hp]

private theorem suffixResetTreeAfter_eq_pivotResetTreeAfter_of_all_lt
    {n : Nat} (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      (∀ i : Fin n, i ∈ xs → X i < q) →
      suffixResetTreeAfter X q t xs = pivotResetTreeAfter X q t xs
| [], t, _hlt => by
    simp [suffixResetTreeAfter, pivotResetTreeAfter]
| i :: xs, t, hlt => by
    have hi_lt : X i < q := hlt i (by simp)
    have htail_lt : ∀ j : Fin n, j ∈ xs → X j < q := by
      intro j hj
      exact hlt j (by simp [hj])
    simp [suffixResetTreeAfter, pivotResetTreeAfter, hi_lt,
      suffixResetTreeAfter_eq_pivotResetTreeAfter_of_all_lt
        X q xs (splay (splay t (X i)) q) htail_lt]

private theorem suffixResetTreeAfter_eq_self_of_all_not_lt
    {n : Nat} (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      (∀ i : Fin n, i ∈ xs → ¬ X i < q) →
      suffixResetTreeAfter X q t xs = t
| [], t, _hnot => by
    simp [suffixResetTreeAfter]
| i :: xs, t, hnot => by
    have hi_not : ¬ X i < q := hnot i (by simp)
    have htail_not : ∀ j : Fin n, j ∈ xs → ¬ X j < q := by
      intro j hj
      exact hnot j (by simp [hj])
    simp [suffixResetTreeAfter, hi_not,
      suffixResetTreeAfter_eq_self_of_all_not_lt X q xs t htail_not]

private theorem suffixResetTreeAfter_eq_self_of_all_eq
    {n : Nat} (X : Fin n → Nat) (q : Nat)
    (xs : List (Fin n)) (t : BinaryTree)
    (heq : ∀ i : Fin n, i ∈ xs → X i = q) :
    suffixResetTreeAfter X q t xs = t := by
  exact suffixResetTreeAfter_eq_self_of_all_not_lt X q xs t
    (by
      intro i hi
      rw [heq i hi]
      omega)

private theorem suffixResetTreeAfter_eq_pivotResetTreeAfter_filter_lt
    {n : Nat} (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      suffixResetTreeAfter X q t xs =
        pivotResetTreeAfter X q t
          (xs.filter (fun i => decide (X i < q)))
| [], t => by
    simp [suffixResetTreeAfter, pivotResetTreeAfter]
| i :: xs, t => by
    by_cases hi : X i < q
    · simp [suffixResetTreeAfter, pivotResetTreeAfter, hi,
        suffixResetTreeAfter_eq_pivotResetTreeAfter_filter_lt
          X q xs (splay (splay t (X i)) q)]
    · simp [suffixResetTreeAfter, pivotResetTreeAfter, hi,
        suffixResetTreeAfter_eq_pivotResetTreeAfter_filter_lt
          X q xs t]

private theorem splayTreeAfter_eq_self_of_all_eq_root
    {n : Nat} (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      rootKey t = some q →
      (∀ i : Fin n, i ∈ xs → X i = q) →
      splayTreeAfter X t xs = t
| [], t, _hroot, _heq => by
    simp [splayTreeAfter]
| i :: xs, t, hroot, heq => by
    have hi_eq : X i = q := heq i (by simp)
    have hsplay : splay t (X i) = t := by
      rw [hi_eq]
      exact splay_eq_self_of_rootKey_eq_some hroot
    have htail_eq : ∀ j : Fin n, j ∈ xs → X j = q := by
      intro j hj
      exact heq j (by simp [hj])
    simp [splayTreeAfter, hsplay,
      splayTreeAfter_eq_self_of_all_eq_root X q xs t hroot htail_eq]

private theorem prefix_pair_bound_nil
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (i : Fin n) :
    ((splayTreeAfter Y init []).search_path_len (Y i) : ℝ) +
        ((splay (splayTreeAfter Y init []) (Y i)).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init []).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init []).search_path_len (Y i) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init []) (Y i)).search_path_len q : ℝ) := by
  simp [splayTreeAfter, suffixResetTreeAfter]

private theorem prefix_pair_bound_of_all_eq_root
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (hroot : rootKey init = some q)
    (heq : ∀ j : Fin n, j ∈ done → Y j = q) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
        ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init done).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) := by
  have hactual :=
    splayTreeAfter_eq_self_of_all_eq_root Y q done init hroot heq
  have hreset :=
    suffixResetTreeAfter_eq_self_of_all_eq Y q done init heq
  rw [hactual, hreset]
  have hnonneg : 0 ≤ (init.search_path_len q : ℝ) := by
    exact_mod_cast (Nat.zero_le (init.search_path_len q))
  nlinarith

private theorem strict_prefix_pair_bound_of_pathWithFinal_increment
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (hdone_lt : ∀ j : Fin n, j ∈ done → Y j < q)
    (hinc :
      splayPathSumWithFinal Y q init (done ++ [i]) ≤
        splayPathSumWithFinal Y q init done +
          ((pivotResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
          ((splay (pivotResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
          D) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
        ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init done).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
        D := by
  have hreset :
      suffixResetTreeAfter Y q init done =
        pivotResetTreeAfter Y q init done := by
    exact suffixResetTreeAfter_eq_pivotResetTreeAfter_of_all_lt
      Y q done init hdone_lt
  have hnext_path :
      splayPathSum Y init (done ++ [i]) =
        splayPathSum Y init done +
          ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) := by
    have hsplit := splayPathSum_split_singleton Y done [] init i
    simpa [splayPathSum, add_assoc] using hsplit
  have hnext_tree :
      splayTreeAfter Y init (done ++ [i]) =
        splay (splayTreeAfter Y init done) (Y i) := by
    rw [splayTreeAfter_append]
    simp [splayTreeAfter]
  rw [splayPathSumWithFinal_eq_pathSum_add_final Y q (done ++ [i]) init,
    splayPathSumWithFinal_eq_pathSum_add_final Y q done init] at hinc
  rw [hnext_path, hnext_tree] at hinc
  rw [hreset]
  nlinarith

private def prefixResetPairDominates {n : Nat} (Y : Fin n → Nat)
    (q : Nat) (D : ℝ) (actual reset : BinaryTree) : Prop :=
  IsBST actual ∧
    IsBST reset ∧
    rootKey reset = some q ∧
    reset.toKeyList = actual.toKeyList ∧
    ∀ i : Fin n,
      Y i ∈ actual.toKeyList →
      Y i < q →
      (actual.search_path_len (Y i) : ℝ) +
          ((splay actual (Y i)).search_path_len q : ℝ) ≤
        (actual.search_path_len q : ℝ) +
          (reset.search_path_len (Y i) : ℝ) +
          ((splay reset (Y i)).search_path_len q : ℝ) + D

private def resetPairDominatesAll
    (q : Nat) (D : ℝ) (actual reset : BinaryTree) : Prop :=
  IsBST actual ∧
    IsBST reset ∧
    rootKey reset = some q ∧
    reset.toKeyList = actual.toKeyList ∧
    ∀ x : Nat,
      x ∈ actual.toKeyList →
      x < q →
      (actual.search_path_len x : ℝ) +
          ((splay actual x).search_path_len q : ℝ) ≤
        (actual.search_path_len q : ℝ) +
          (reset.search_path_len x : ℝ) +
          ((splay reset x).search_path_len q : ℝ) + D

private def resetPairDominatesAbove
    (q lo : Nat) (D : ℝ) (actual reset : BinaryTree) : Prop :=
  IsBST actual ∧
    IsBST reset ∧
    rootKey reset = some q ∧
    reset.toKeyList = actual.toKeyList ∧
    ∀ x : Nat,
      x ∈ actual.toKeyList →
      lo ≤ x →
      x < q →
      (actual.search_path_len x : ℝ) +
          ((splay actual x).search_path_len q : ℝ) ≤
          (actual.search_path_len q : ℝ) +
            (reset.search_path_len x : ℝ) +
            ((splay reset x).search_path_len q : ℝ) + D

private def resetPathDominatesAbove
    (q lo : Nat) (D : ℝ) (actual reset : BinaryTree) : Prop :=
  IsBST actual ∧
    IsBST reset ∧
    rootKey reset = some q ∧
    reset.toKeyList = actual.toKeyList ∧
    ∀ x : Nat,
      x ∈ actual.toKeyList →
      lo ≤ x →
      x < q →
      (actual.search_path_len x : ℝ) ≤
        (reset.search_path_len x : ℝ) + D

private theorem resetPathDominatesAbove.refl_root
    (q lo : Nat) (D : ℝ) (t : BinaryTree)
    (hD : 0 ≤ D)
    (hbst : IsBST t)
    (hroot : rootKey t = some q) :
    resetPathDominatesAbove q lo D t t := by
  refine ⟨hbst, hbst, hroot, rfl, ?_⟩
  intro x _hx_mem _hlo _hx_lt
  nlinarith

private theorem resetPathDominatesAbove.mono_D
    {q lo : Nat} {C D : ℝ} {actual reset : BinaryTree}
    (hCD : C ≤ D)
    (hdom : resetPathDominatesAbove q lo C actual reset) :
    resetPathDominatesAbove q lo D actual reset := by
  rcases hdom with ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, hpath⟩
  refine ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, ?_⟩
  intro x hx_mem hlo hx_lt
  have h := hpath x hx_mem hlo hx_lt
  nlinarith

private theorem resetPathDominatesAbove.mono_lo
    {q lo hi : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hlohi : lo ≤ hi)
    (hdom : resetPathDominatesAbove q lo D actual reset) :
    resetPathDominatesAbove q hi D actual reset := by
  rcases hdom with ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, hpath⟩
  refine ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, ?_⟩
  intro x hx_mem hhi hx_lt
  exact hpath x hx_mem (le_trans hlohi hhi) hx_lt

private theorem resetPathDominatesAbove.path
    {q lo x : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPathDominatesAbove q lo D actual reset)
    (hx_mem : x ∈ actual.toKeyList)
    (hlo : lo ≤ x)
    (hx_lt : x < q) :
    (actual.search_path_len x : ℝ) ≤
      (reset.search_path_len x : ℝ) + D := by
  exact hdom.2.2.2.2 x hx_mem hlo hx_lt

private theorem resetPairDominatesAll.to_above
    {q : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAll q D actual reset) (lo : Nat) :
    resetPairDominatesAbove q lo D actual reset := by
  rcases hdom with ⟨hbst_actual, hbst_reset, hroot_reset,
    hkeys, hpair⟩
  refine ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, ?_⟩
  intro x hx_mem _hlo hx_lt
  exact hpair x hx_mem hx_lt

private theorem resetPairDominatesAbove.to_prefix {n : Nat}
    (Y : Fin n → Nat) (q lo : Nat) (D : ℝ)
    {actual reset : BinaryTree}
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hlo : ∀ i : Fin n, Y i < q → lo ≤ Y i) :
    prefixResetPairDominates Y q D actual reset := by
  rcases hdom with ⟨hbst_actual, hbst_reset, hroot_reset,
    hkeys, hpair⟩
  refine ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, ?_⟩
  intro i hi_mem hi_lt
  exact hpair (Y i) hi_mem (hlo i hi_lt) hi_lt

private theorem resetPairDominatesAbove.mono_lo
    {q lo hi : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hlohi : lo ≤ hi)
    (hdom : resetPairDominatesAbove q lo D actual reset) :
    resetPairDominatesAbove q hi D actual reset := by
  rcases hdom with ⟨hbst_actual, hbst_reset, hroot_reset,
    hkeys, hpair⟩
  refine ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, ?_⟩
  intro x hx_mem hhi hx_lt
  exact hpair x hx_mem (le_trans hlohi hhi) hx_lt

private theorem resetPairDominatesAbove.mono_D
    {q lo : Nat} {D E : ℝ} {actual reset : BinaryTree}
    (hDE : D ≤ E)
    (hdom : resetPairDominatesAbove q lo D actual reset) :
    resetPairDominatesAbove q lo E actual reset := by
  rcases hdom with ⟨hbst_actual, hbst_reset, hroot_reset,
    hkeys, hpair⟩
  refine ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, ?_⟩
  intro x hx_mem hlo hx_lt
  have h := hpair x hx_mem hlo hx_lt
  nlinarith

private theorem resetPairDominatesAbove_refl_root
    (q lo : Nat) (D : ℝ) (t : BinaryTree)
    (hD : 0 ≤ D)
    (hbst : IsBST t)
    (hroot : rootKey t = some q) :
    resetPairDominatesAbove q lo D t t := by
  refine ⟨hbst, hbst, hroot, rfl, ?_⟩
  intro x _hx_mem _hlo _hx_lt
  have hq_nonneg : 0 ≤ (t.search_path_len q : ℝ) := by
    exact_mod_cast (Nat.zero_le (t.search_path_len q))
  nlinarith

private theorem resetPairDominatesAbove.q_mem_actual
    {q lo : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAbove q lo D actual reset) :
    q ∈ actual.toKeyList := by
  rcases hdom with ⟨_hbst_actual, _hbst_reset, hroot_reset,
    hkeys, _hpair⟩
  rw [← hkeys]
  exact rootKey_mem_toKeyList hroot_reset

private theorem resetPairDominatesAbove.q_mem_reset
    {q lo : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAbove q lo D actual reset) :
    q ∈ reset.toKeyList := by
  exact rootKey_mem_toKeyList hdom.2.2.1

private theorem resetPairDominatesAbove.pair
    {q lo x : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hx_mem : x ∈ actual.toKeyList)
    (hlo : lo ≤ x)
    (hx_lt : x < q) :
    (actual.search_path_len x : ℝ) +
        ((splay actual x).search_path_len q : ℝ) ≤
      (actual.search_path_len q : ℝ) +
        (reset.search_path_len x : ℝ) +
        ((splay reset x).search_path_len q : ℝ) + D := by
  exact hdom.2.2.2.2 x hx_mem hlo hx_lt

private theorem current_path_len_le_of_resetPairDominatesAbove_and_q_cancel
    {q lo x : Nat} {D E : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hx_mem : x ∈ actual.toKeyList)
    (hlo : lo ≤ x)
    (hx_lt : x < q)
    (hcancel :
      (actual.search_path_len q : ℝ) +
          ((splay reset x).search_path_len q : ℝ) ≤
        ((splay actual x).search_path_len q : ℝ) + E) :
    (actual.search_path_len x : ℝ) ≤
      (reset.search_path_len x : ℝ) + (D + E) := by
  have hpair :=
    resetPairDominatesAbove.pair
      (q := q) (lo := lo) (x := x) (D := D)
      hdom hx_mem hlo hx_lt
  nlinarith

private theorem reachable_actual_reset_state
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n))
    (hbst : IsBST init)
    (hroot : rootKey init = some q) :
    IsBST (splayTreeAfter Y init done) ∧
      IsBST (suffixResetTreeAfter Y q init done) ∧
      rootKey (suffixResetTreeAfter Y q init done) = some q ∧
      (suffixResetTreeAfter Y q init done).toKeyList =
        (splayTreeAfter Y init done).toKeyList := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact splayTreeAfter_isBST Y done init hbst
  · exact suffixResetTreeAfter_isBST Y q done init hbst
  · exact suffixResetTreeAfter_rootKey Y q done init hbst hroot
  · rw [suffixResetTreeAfter_toKeyList, splayTreeAfter_toKeyList]

private theorem resetPairDominatesAbove_of_reachable_pair
    {n : Nat} (Y : Fin n → Nat) (q lo : Nat) (D : ℝ)
    (init : BinaryTree) (done : List (Fin n))
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hpair :
      ∀ x : Nat,
        x ∈ (splayTreeAfter Y init done).toKeyList →
        lo ≤ x →
        x < q →
        ((splayTreeAfter Y init done).search_path_len x : ℝ) +
            ((splay (splayTreeAfter Y init done) x).search_path_len q : ℝ) ≤
          ((splayTreeAfter Y init done).search_path_len q : ℝ) +
            ((suffixResetTreeAfter Y q init done).search_path_len x : ℝ) +
            ((splay (suffixResetTreeAfter Y q init done) x).search_path_len q : ℝ) +
            D) :
    resetPairDominatesAbove q lo D
      (splayTreeAfter Y init done)
      (suffixResetTreeAfter Y q init done) := by
  rcases reachable_actual_reset_state Y q init done hbst hroot with
    ⟨hbst_actual, hbst_reset, hroot_reset, hkeys⟩
  exact ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, hpair⟩

private theorem resetPairDominatesAbove.eq_splay_state
    {q lo x : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hx_eq : x = q) :
    IsBST (splay actual x) ∧
      IsBST reset ∧
      rootKey reset = some q ∧
      reset.toKeyList = (splay actual x).toKeyList := by
  subst x
  refine ⟨splay_isBST actual q hdom.1, hdom.2.1, hdom.2.2.1, ?_⟩
  rw [splay_toKeyList]
  exact hdom.2.2.2.1

private theorem resetPairDominatesAbove.lt_splay_reset_state
    {q lo x : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAbove q lo D actual reset) :
    IsBST (splay actual x) ∧
      IsBST (splay (splay reset x) q) ∧
      rootKey (splay (splay reset x) q) = some q ∧
      (splay (splay reset x) q).toKeyList =
        (splay actual x).toKeyList := by
  refine
    ⟨splay_isBST actual x hdom.1,
      splay_isBST (splay reset x) q
        (splay_isBST reset x hdom.2.1),
      rootKey_after_pivot_reset_of_root hdom.2.1 hdom.2.2.1,
      ?_⟩
  rw [splay_toKeyList, splay_toKeyList, splay_toKeyList]
  exact hdom.2.2.2.1

private theorem resetPairDominatesAbove_preserve_eq_of_pair_bound
    {q lo x : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hx_eq : x = q)
    (hpair :
      ∀ y : Nat,
        y ∈ (splay actual x).toKeyList →
        lo ≤ y →
        y < q →
        ((splay actual x).search_path_len y : ℝ) +
            ((splay (splay actual x) y).search_path_len q : ℝ) ≤
          ((splay actual x).search_path_len q : ℝ) +
            (reset.search_path_len y : ℝ) +
            ((splay reset y).search_path_len q : ℝ) + D) :
    resetPairDominatesAbove q lo D (splay actual x) reset := by
  rcases resetPairDominatesAbove.eq_splay_state
      (x := x) hdom hx_eq with
    ⟨hbst_actual, hbst_reset, hroot_reset, hkeys⟩
  exact ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, hpair⟩

private theorem resetPairDominatesAbove_preserve_strict_of_pair_bound
    {q lo x : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (_hx_mem : x ∈ actual.toKeyList)
    (_hx_lt : x < q)
    (hpair :
      ∀ y : Nat,
        y ∈ (splay actual x).toKeyList →
        lo ≤ y →
        y < q →
        ((splay actual x).search_path_len y : ℝ) +
            ((splay (splay actual x) y).search_path_len q : ℝ) ≤
          ((splay actual x).search_path_len q : ℝ) +
            ((splay (splay reset x) q).search_path_len y : ℝ) +
            ((splay (splay (splay reset x) q) y).search_path_len q : ℝ) +
            D) :
    resetPairDominatesAbove q lo D
      (splay actual x) (splay (splay reset x) q) := by
  rcases resetPairDominatesAbove.lt_splay_reset_state
      (x := x) hdom with
    ⟨hbst_actual, hbst_reset, hroot_reset, hkeys⟩
  exact ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, hpair⟩

private theorem resetPairDominatesAbove_preserve_eq_of_pair_bound_mono
    {q lo x : Nat} {C D : ℝ} {actual reset : BinaryTree}
    (hCD : C ≤ D)
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hx_eq : x = q)
    (hpair :
      ∀ y : Nat,
        y ∈ (splay actual x).toKeyList →
        lo ≤ y →
        y < q →
        ((splay actual x).search_path_len y : ℝ) +
            ((splay (splay actual x) y).search_path_len q : ℝ) ≤
          ((splay actual x).search_path_len q : ℝ) +
            (reset.search_path_len y : ℝ) +
            ((splay reset y).search_path_len q : ℝ) + C) :
    resetPairDominatesAbove q lo D (splay actual x) reset := by
  refine
    resetPairDominatesAbove_preserve_eq_of_pair_bound
      (q := q) (lo := lo) (x := x) (D := D)
      hdom hx_eq ?_
  intro y hy_mem hlo hy_lt
  have h := hpair y hy_mem hlo hy_lt
  nlinarith

private theorem resetPairDominatesAbove_preserve_strict_of_pair_bound_mono
    {q lo x : Nat} {C D : ℝ} {actual reset : BinaryTree}
    (hCD : C ≤ D)
    (hdom : resetPairDominatesAbove q lo D actual reset)
    (hx_mem : x ∈ actual.toKeyList)
    (hx_lt : x < q)
    (hpair :
      ∀ y : Nat,
        y ∈ (splay actual x).toKeyList →
        lo ≤ y →
        y < q →
        ((splay actual x).search_path_len y : ℝ) +
            ((splay (splay actual x) y).search_path_len q : ℝ) ≤
          ((splay actual x).search_path_len q : ℝ) +
            ((splay (splay reset x) q).search_path_len y : ℝ) +
            ((splay (splay (splay reset x) q) y).search_path_len q : ℝ) +
            C) :
    resetPairDominatesAbove q lo D
      (splay actual x) (splay (splay reset x) q) := by
  refine
    resetPairDominatesAbove_preserve_strict_of_pair_bound
      (q := q) (lo := lo) (x := x) (D := D)
      hdom hx_mem hx_lt ?_
  intro y hy_mem hlo hy_lt
  have h := hpair y hy_mem hlo hy_lt
  nlinarith

private theorem resetPairDominatesAll.to_prefix {n : Nat}
    (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    {actual reset : BinaryTree}
    (hdom : resetPairDominatesAll q D actual reset) :
    prefixResetPairDominates Y q D actual reset := by
  rcases hdom with ⟨hbst_actual, hbst_reset, hroot_reset,
    hkeys, hpair⟩
  refine ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, ?_⟩
  intro i hi_mem hi_lt
  exact hpair (Y i) hi_mem hi_lt

private theorem resetPairDominatesAll_refl_root
    (q : Nat) (D : ℝ) (t : BinaryTree)
    (hD : 0 ≤ D)
    (hbst : IsBST t)
    (hroot : rootKey t = some q) :
    resetPairDominatesAll q D t t := by
  refine ⟨hbst, hbst, hroot, rfl, ?_⟩
  intro x _hx_mem _hx_lt
  have hq_nonneg : 0 ≤ (t.search_path_len q : ℝ) := by
    exact_mod_cast (Nat.zero_le (t.search_path_len q))
  nlinarith

private theorem resetPairDominatesAll.q_mem_actual
    {q : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAll q D actual reset) :
    q ∈ actual.toKeyList := by
  rcases hdom with ⟨_hbst_actual, _hbst_reset, hroot_reset,
    hkeys, _hpair⟩
  rw [← hkeys]
  exact rootKey_mem_toKeyList hroot_reset

private theorem resetPairDominatesAll.q_mem_reset
    {q : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAll q D actual reset) :
    q ∈ reset.toKeyList := by
  exact rootKey_mem_toKeyList hdom.2.2.1

private theorem resetPairDominatesAll.eq_splay_state
    {q x : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAll q D actual reset)
    (hx_eq : x = q) :
    IsBST (splay actual x) ∧
      IsBST reset ∧
      rootKey reset = some q ∧
      reset.toKeyList = (splay actual x).toKeyList := by
  subst x
  refine ⟨splay_isBST actual q hdom.1, hdom.2.1, hdom.2.2.1, ?_⟩
  rw [splay_toKeyList]
  exact hdom.2.2.2.1

private theorem resetPairDominatesAll.lt_splay_reset_state
    {q x : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hdom : resetPairDominatesAll q D actual reset) :
    IsBST (splay actual x) ∧
      IsBST (splay (splay reset x) q) ∧
      rootKey (splay (splay reset x) q) = some q ∧
      (splay (splay reset x) q).toKeyList =
        (splay actual x).toKeyList := by
  refine
    ⟨splay_isBST actual x hdom.1,
      splay_isBST (splay reset x) q
        (splay_isBST reset x hdom.2.1),
      rootKey_after_pivot_reset_of_root hdom.2.1 hdom.2.2.1,
      ?_⟩
  rw [splay_toKeyList, splay_toKeyList, splay_toKeyList]
  exact hdom.2.2.2.1

private theorem search_path_len_after_splay_lower_le_add_two_strong
    {t : BinaryTree} {q x : Nat}
    (hbst : IsBST t)
    (hxmem : x ∈ t.toKeyList)
    (hqmem : q ∈ t.toKeyList)
    (hxlt : x < q) :
    (splay t x).search_path_len q ≤ t.search_path_len q + 2 := by
  induction hN : t.num_nodes using Nat.strong_induction_on generalizing t x q with
  | h n ih =>
      cases t with
      | empty =>
          simp [BinaryTree.toKeyList] at hxmem
      | node l k r =>
          cases hbst with
          | node _ _ _ hleft hright hbst_left hbst_right =>
              simp [BinaryTree.toKeyList] at hxmem hqmem
              rcases hxmem with hx_l | hx_eq | hx_r
              · have hx_lt_k : x < k :=
                  (forallTree_iff_forall_mem.mp hleft) x hx_l
                rcases hqmem with hq_l | hq_eq | hq_r
                · have hq_lt_k : q < k :=
                    (forallTree_iff_forall_mem.mp hleft) q hq_l
                  cases l with
                  | empty =>
                      simp [BinaryTree.toKeyList] at hx_l
                  | node ll lk lr =>
                      cases hbst_left with
                      | node _ _ _ hll_left hlr_right hbst_ll hbst_lr =>
                          simp [BinaryTree.toKeyList] at hx_l hq_l
                          rcases hx_l with hx_ll | hx_eq_lk | hx_lr
                          · have hx_lt_lk : x < lk :=
                              (forallTree_iff_forall_mem.mp hll_left) x hx_ll
                            rcases hq_l with hq_ll | hq_eq_lk | hq_lr
                            · have hq_lt_lk : q < lk :=
                                (forallTree_iff_forall_mem.mp hll_left) q hq_ll
                              have hlt_ll : ll.num_nodes < n := by
                                rw [← hN]
                                simp [BinaryTree.num_nodes]
                                omega
                              have hinner :=
                                ih ll.num_nodes hlt_ll (t := ll)
                                  hbst_ll hx_ll hq_ll hxlt rfl
                              cases ll with
                              | empty =>
                                  simp [BinaryTree.toKeyList] at hx_ll
                              | node a y b =>
                                  have hroot_inner :=
                                    splay_rootKey_eq_some_of_mem_isBST
                                      (BinaryTree.node a y b) x hbst_ll hx_ll
                                  rw [splay.eq_def]
                                  have hx_ne_k : x ≠ k := by omega
                                  cases hs :
                                      splay (BinaryTree.node a y b) x with
                                  | empty =>
                                      simp [rootKey, hs] at hroot_inner
                                  | node sl sk sr =>
                                      simp [rootKey, hs] at hroot_inner
                                      subst sk
                                      have hnot_q_lt_x : ¬ q < x := by
                                        omega
                                      simp [hx_ne_k, hx_lt_k, hx_lt_lk,
                                        hq_lt_k, hq_lt_lk, hnot_q_lt_x,
                                        hxlt, hs, BinaryTree.search_path_len,
                                        rotate, rotateRight] at hinner ⊢
                                      omega
                            · subst q
                              cases ll with
                              | empty =>
                                  simp [BinaryTree.toKeyList] at hx_ll
                              | node a y b =>
                                  have hroot_inner :=
                                    splay_rootKey_eq_some_of_mem_isBST
                                      (BinaryTree.node a y b) x hbst_ll hx_ll
                                  rw [splay.eq_def]
                                  have hx_ne_k : x ≠ k := by omega
                                  have hnot_lk_lt_x : ¬ lk < x := by
                                    omega
                                  have hx_lt_lk' : x < lk := hx_lt_lk
                                  cases hs :
                                      splay (BinaryTree.node a y b) x with
                                  | empty =>
                                      simp [rootKey, hs] at hroot_inner
                                  | node sl sk sr =>
                                      simp [rootKey, hs] at hroot_inner
                                      subst sk
                                      simp [hx_ne_k, hx_lt_k, hx_lt_lk',
                                        hnot_lk_lt_x, hq_lt_k, hs,
                                        BinaryTree.search_path_len, rotate,
                                        rotateRight]
                            · have hlk_lt_q : lk < q :=
                                (forallTree_iff_forall_mem.mp hlr_right) q hq_lr
                              cases ll with
                              | empty =>
                                  simp [BinaryTree.toKeyList] at hx_ll
                              | node a y b =>
                                  have hroot_inner :=
                                    splay_rootKey_eq_some_of_mem_isBST
                                      (BinaryTree.node a y b) x hbst_ll hx_ll
                                  rw [splay.eq_def]
                                  have hx_ne_k : x ≠ k := by omega
                                  have hnot_q_lt_lk : ¬ q < lk := by omega
                                  cases hs :
                                      splay (BinaryTree.node a y b) x with
                                  | empty =>
                                      simp [rootKey, hs] at hroot_inner
                                  | node sl sk sr =>
                                      simp [rootKey, hs] at hroot_inner
                                      subst sk
                                      have hnot_q_lt_x : ¬ q < x := by
                                        omega
                                      simp [hx_ne_k, hx_lt_k, hx_lt_lk, hs,
                                        hq_lt_k, hnot_q_lt_lk, hlk_lt_q,
                                        hnot_q_lt_x, hxlt,
                                        BinaryTree.search_path_len, rotate,
                                        rotateRight]
                                      omega
                          · subst x
                            rcases hq_l with hq_ll | hq_eq_lk | hq_lr
                            · have hq_lt_lk : q < lk :=
                                (forallTree_iff_forall_mem.mp hll_left) q hq_ll
                              omega
                            · omega
                            · have hsplay :
                                  splay ((ll.node lk lr).node k r) lk =
                                    rotate ((ll.node lk lr).node k r)
                                      Rot.zig := by
                                rw [splay.eq_def]
                                have hne_lk_k : ¬ lk = k := by omega
                                have hnot_lk_lt_lk : ¬ lk < lk := by
                                  omega
                                have hnot_k_lt_lk : ¬ k < lk := by
                                  omega
                                simp [hne_lk_k, hx_lt_k,
                                  hnot_lk_lt_lk, hnot_k_lt_lk]
                              rw [hsplay]
                              have hnot_q_lt_lk : ¬ q < lk := by omega
                              simp [hq_lt_k, hxlt, hnot_q_lt_lk,
                                BinaryTree.search_path_len, rotate,
                                rotateRight]
                          · have hlk_lt_x : lk < x :=
                              (forallTree_iff_forall_mem.mp hlr_right) x hx_lr
                            rcases hq_l with hq_ll | hq_eq_lk | hq_lr
                            · have hq_lt_lk : q < lk :=
                                (forallTree_iff_forall_mem.mp hll_left) q hq_ll
                              omega
                            · omega
                            · have hlk_lt_q : lk < q :=
                                (forallTree_iff_forall_mem.mp hlr_right) q hq_lr
                              have hlt_lr : lr.num_nodes < n := by
                                rw [← hN]
                                simp [BinaryTree.num_nodes]
                                omega
                              have hinner :=
                                ih lr.num_nodes hlt_lr (t := lr)
                                  hbst_lr hx_lr hq_lr hxlt rfl
                              cases lr with
                              | empty =>
                                  simp [BinaryTree.toKeyList] at hx_lr
                              | node a y b =>
                                  have hroot_inner :=
                                    splay_rootKey_eq_some_of_mem_isBST
                                      (BinaryTree.node a y b) x hbst_lr hx_lr
                                  rw [splay.eq_def]
                                  have hx_ne_k : x ≠ k := by omega
                                  have hnot_x_lt_lk : ¬ x < lk := by
                                    omega
                                  have hnot_q_lt_lk : ¬ q < lk := by
                                    omega
                                  cases hs :
                                      splay (BinaryTree.node a y b) x with
                                  | empty =>
                                      simp [rootKey, hs] at hroot_inner
                                  | node sl sk sr =>
                                      simp [rootKey, hs] at hroot_inner
                                      subst sk
                                      have hnot_q_lt_x : ¬ q < x := by
                                        omega
                                      simp [hx_ne_k, hx_lt_k, hnot_x_lt_lk,
                                        hlk_lt_x, hq_lt_k, hnot_q_lt_lk,
                                        hlk_lt_q, hnot_q_lt_x, hxlt, hs,
                                        BinaryTree.search_path_len, rotate,
                                        rotateLeft, rotateRight] at hinner ⊢
                                      omega
                · subst q
                  cases l with
                  | empty =>
                      simp [BinaryTree.toKeyList] at hx_l
                  | node ll lk lr =>
                      cases hbst_left with
                      | node _ _ _ hll_left hlr_right hbst_ll hbst_lr =>
                          cases hleft with
                          | node _ _ _ hll_k hlk_lt_k hlr_k =>
                              simp [BinaryTree.toKeyList] at hx_l
                              rcases hx_l with hx_ll | hx_eq_lk | hx_lr
                              · have hx_lt_lk : x < lk :=
                                  (forallTree_iff_forall_mem.mp hll_left)
                                    x hx_ll
                                cases ll with
                                | empty =>
                                    simp [BinaryTree.toKeyList] at hx_ll
                                | node a y b =>
                                    have hroot_inner :=
                                      splay_rootKey_eq_some_of_mem_isBST
                                        (BinaryTree.node a y b) x
                                        hbst_ll hx_ll
                                    rw [splay.eq_def]
                                    have hx_ne_k : x ≠ k := by omega
                                    have hnot_k_lt_x : ¬ k < x := by
                                      omega
                                    have hnot_k_lt_lk : ¬ k < lk := by
                                      omega
                                    cases hs :
                                        splay (BinaryTree.node a y b) x with
                                    | empty =>
                                        simp [rootKey, hs] at hroot_inner
                                    | node sl sk sr =>
                                        simp [rootKey, hs] at hroot_inner
                                        subst sk
                                        simp [hx_ne_k, hx_lt_k, hx_lt_lk,
                                          hnot_k_lt_x, hnot_k_lt_lk,
                                          hlk_lt_k, hs,
                                          BinaryTree.search_path_len, rotate,
                                          rotateRight]
                              · subst x
                                rw [splay.eq_def]
                                have hlk_ne_k : lk ≠ k := by omega
                                have hnot_lk_lt_lk : ¬ lk < lk := by
                                  omega
                                have hnot_k_lt_lk : ¬ k < lk := by
                                  omega
                                simp [hlk_ne_k, hx_lt_k, hnot_lk_lt_lk,
                                  hnot_k_lt_lk, hlk_lt_k,
                                  BinaryTree.search_path_len, rotate,
                                  rotateRight]
                              · have hlk_lt_x : lk < x :=
                                  (forallTree_iff_forall_mem.mp hlr_right)
                                    x hx_lr
                                cases lr with
                                | empty =>
                                    simp [BinaryTree.toKeyList] at hx_lr
                                | node a y b =>
                                    have hroot_inner :=
                                      splay_rootKey_eq_some_of_mem_isBST
                                        (BinaryTree.node a y b) x
                                        hbst_lr hx_lr
                                    rw [splay.eq_def]
                                    have hx_ne_k : x ≠ k := by omega
                                    have hnot_x_lt_lk : ¬ x < lk := by
                                      omega
                                    have hnot_k_lt_x : ¬ k < x := by
                                      omega
                                    have hnot_k_lt_lk : ¬ k < lk := by
                                      omega
                                    cases hs :
                                        splay (BinaryTree.node a y b) x with
                                    | empty =>
                                        simp [rootKey, hs] at hroot_inner
                                    | node sl sk sr =>
                                        simp [rootKey, hs] at hroot_inner
                                        subst sk
                                        simp [hx_ne_k, hx_lt_k,
                                          hnot_x_lt_lk, hlk_lt_x,
                                          hnot_k_lt_x, hnot_k_lt_lk,
                                          hlk_lt_k, hs,
                                          BinaryTree.search_path_len, rotate,
                                          rotateLeft, rotateRight]
                · have hk_lt_q : k < q :=
                    (forallTree_iff_forall_mem.mp hright) q hq_r
                  cases l with
                  | empty =>
                      simp [BinaryTree.toKeyList] at hx_l
                  | node ll lk lr =>
                      cases hbst_left with
                      | node _ _ _ hll_left hlr_right hbst_ll hbst_lr =>
                          cases hleft with
                          | node _ _ _ hll_k hlk_lt_k hlr_k =>
                              simp [BinaryTree.toKeyList] at hx_l
                              rcases hx_l with hx_ll | hx_eq_lk | hx_lr
                              · have hx_lt_lk : x < lk :=
                                  (forallTree_iff_forall_mem.mp hll_left)
                                    x hx_ll
                                have hlk_lt_q : lk < q := by omega
                                have hnot_q_lt_lk : ¬ q < lk := by omega
                                have hnot_q_lt_k : ¬ q < k := by omega
                                cases ll with
                                | empty =>
                                    simp [BinaryTree.toKeyList] at hx_ll
                                | node a y b =>
                                    have hroot_inner :=
                                      splay_rootKey_eq_some_of_mem_isBST
                                        (BinaryTree.node a y b) x
                                        hbst_ll hx_ll
                                    rw [splay.eq_def]
                                    have hx_ne_k : x ≠ k := by omega
                                    have hnot_q_lt_x : ¬ q < x := by
                                      omega
                                    cases hs :
                                        splay (BinaryTree.node a y b) x with
                                    | empty =>
                                        simp [rootKey, hs] at hroot_inner
                                    | node sl sk sr =>
                                        simp [rootKey, hs] at hroot_inner
                                        subst sk
                                        simp [hx_ne_k, hx_lt_k, hx_lt_lk,
                                          hnot_q_lt_x, hnot_q_lt_lk,
                                          hlk_lt_q, hnot_q_lt_k, hk_lt_q,
                                          hxlt, hs,
                                          BinaryTree.search_path_len, rotate,
                                          rotateRight]
                                        omega
                              · subst x
                                rw [splay.eq_def]
                                have hlk_ne_k : lk ≠ k := by omega
                                have hnot_q_lt_lk : ¬ q < lk := by omega
                                have hnot_q_lt_k : ¬ q < k := by omega
                                simp [hlk_ne_k, hx_lt_k, hnot_q_lt_lk,
                                  hnot_q_lt_k, hk_lt_q, hxlt,
                                  BinaryTree.search_path_len, rotate,
                                  rotateRight]
                                omega
                              · have hlk_lt_x : lk < x :=
                                  (forallTree_iff_forall_mem.mp hlr_right)
                                    x hx_lr
                                have hlk_lt_q : lk < q := by omega
                                have hnot_x_lt_lk : ¬ x < lk := by omega
                                have hnot_q_lt_lk : ¬ q < lk := by omega
                                have hnot_q_lt_k : ¬ q < k := by omega
                                cases lr with
                                | empty =>
                                    simp [BinaryTree.toKeyList] at hx_lr
                                | node a y b =>
                                    have hroot_inner :=
                                      splay_rootKey_eq_some_of_mem_isBST
                                        (BinaryTree.node a y b) x
                                        hbst_lr hx_lr
                                    rw [splay.eq_def]
                                    have hx_ne_k : x ≠ k := by omega
                                    have hnot_q_lt_x : ¬ q < x := by
                                      omega
                                    cases hs :
                                        splay (BinaryTree.node a y b) x with
                                    | empty =>
                                        simp [rootKey, hs] at hroot_inner
                                    | node sl sk sr =>
                                        simp [rootKey, hs] at hroot_inner
                                        subst sk
                                        simp [hx_ne_k, hx_lt_k,
                                          hnot_x_lt_lk, hlk_lt_x,
                                          hnot_q_lt_x, hnot_q_lt_lk,
                                          hlk_lt_q, hnot_q_lt_k, hk_lt_q,
                                          hxlt, hs,
                                          BinaryTree.search_path_len, rotate,
                                          rotateLeft, rotateRight]
                                        omega
              · subst x
                rcases hqmem with hq_l | hq_eq | hq_r
                · have hq_lt_k : q < k :=
                    (forallTree_iff_forall_mem.mp hleft) q hq_l
                  omega
                · omega
                · rw [splay.eq_def]
                  simp [BinaryTree.search_path_len]
              · have hk_lt_x : k < x :=
                  (forallTree_iff_forall_mem.mp hright) x hx_r
                rcases hqmem with hq_l | hq_eq | hq_r
                · have hq_lt_k : q < k :=
                    (forallTree_iff_forall_mem.mp hleft) q hq_l
                  omega
                · omega
                · have hk_lt_q : k < q :=
                    (forallTree_iff_forall_mem.mp hright) q hq_r
                  cases r with
                  | empty =>
                      simp [BinaryTree.toKeyList] at hx_r
                  | node rl rk rr =>
                      cases hbst_right with
                      | node _ _ _ hrl_left hrr_right hbst_rl hbst_rr =>
                          simp [BinaryTree.toKeyList] at hx_r hq_r
                          rcases hx_r with hx_rl | hx_eq_rk | hx_rr
                          · have hx_lt_rk : x < rk :=
                              (forallTree_iff_forall_mem.mp hrl_left) x hx_rl
                            rcases hq_r with hq_rl | hq_eq_rk | hq_rr
                            · have hq_lt_rk : q < rk :=
                                (forallTree_iff_forall_mem.mp hrl_left) q hq_rl
                              have hlt_rl : rl.num_nodes < n := by
                                rw [← hN]
                                simp [BinaryTree.num_nodes]
                                omega
                              have hinner :=
                                ih rl.num_nodes hlt_rl (t := rl)
                                  hbst_rl hx_rl hq_rl hxlt rfl
                              cases rl with
                              | empty =>
                                  simp [BinaryTree.toKeyList] at hx_rl
                              | node a y b =>
                                  have hroot_inner :=
                                    splay_rootKey_eq_some_of_mem_isBST
                                      (BinaryTree.node a y b) x hbst_rl hx_rl
                                  rw [splay.eq_def]
                                  have hx_ne_k : x ≠ k := by omega
                                  have hnot_x_lt_k : ¬ x < k := by omega
                                  have hnot_q_lt_k : ¬ q < k := by omega
                                  cases hs :
                                      splay (BinaryTree.node a y b) x with
                                  | empty =>
                                      simp [rootKey, hs] at hroot_inner
                                  | node sl sk sr =>
                                      simp [rootKey, hs] at hroot_inner
                                      subst sk
                                      have hnot_q_lt_x : ¬ q < x := by
                                        omega
                                      simp [hx_ne_k, hnot_x_lt_k, hk_lt_x,
                                        hx_lt_rk, hnot_q_lt_k, hk_lt_q,
                                        hq_lt_rk, hnot_q_lt_x, hxlt, hs,
                                        BinaryTree.search_path_len, rotate,
                                        rotateLeft, rotateRight] at hinner ⊢
                                      omega
                            · subst q
                              cases rl with
                              | empty =>
                                  simp [BinaryTree.toKeyList] at hx_rl
                              | node a y b =>
                                  have hroot_inner :=
                                    splay_rootKey_eq_some_of_mem_isBST
                                      (BinaryTree.node a y b) x hbst_rl hx_rl
                                  rw [splay.eq_def]
                                  have hx_ne_k : x ≠ k := by omega
                                  have hnot_x_lt_k : ¬ x < k := by omega
                                  have hnot_rk_lt_x : ¬ rk < x := by
                                    omega
                                  cases hs :
                                      splay (BinaryTree.node a y b) x with
                                  | empty =>
                                      simp [rootKey, hs] at hroot_inner
                                  | node sl sk sr =>
                                      simp [rootKey, hs] at hroot_inner
                                      subst sk
                                      simp [hx_ne_k, hnot_x_lt_k, hk_lt_x,
                                        hx_lt_rk, hnot_rk_lt_x, hk_lt_q, hs,
                                        BinaryTree.search_path_len, rotate,
                                        rotateLeft, rotateRight]
                            · have hrk_lt_q : rk < q :=
                                (forallTree_iff_forall_mem.mp hrr_right) q hq_rr
                              cases rl with
                              | empty =>
                                  simp [BinaryTree.toKeyList] at hx_rl
                              | node a y b =>
                                  have hroot_inner :=
                                    splay_rootKey_eq_some_of_mem_isBST
                                      (BinaryTree.node a y b) x hbst_rl hx_rl
                                  rw [splay.eq_def]
                                  have hx_ne_k : x ≠ k := by omega
                                  have hnot_x_lt_k : ¬ x < k := by omega
                                  have hnot_q_lt_k : ¬ q < k := by omega
                                  have hnot_q_lt_rk : ¬ q < rk := by
                                    omega
                                  cases hs :
                                      splay (BinaryTree.node a y b) x with
                                  | empty =>
                                      simp [rootKey, hs] at hroot_inner
                                  | node sl sk sr =>
                                      simp [rootKey, hs] at hroot_inner
                                      subst sk
                                      have hnot_q_lt_x : ¬ q < x := by
                                        omega
                                      simp [hx_ne_k, hnot_x_lt_k, hk_lt_x,
                                        hx_lt_rk, hnot_q_lt_k, hk_lt_q,
                                        hnot_q_lt_rk, hrk_lt_q,
                                        hnot_q_lt_x, hxlt, hs,
                                        BinaryTree.search_path_len, rotate,
                                        rotateLeft, rotateRight]
                          · subst x
                            rcases hq_r with hq_rl | hq_eq_rk | hq_rr
                            · have hq_lt_rk : q < rk :=
                                (forallTree_iff_forall_mem.mp hrl_left) q hq_rl
                              omega
                            · omega
                            · have hsplay :
                                  splay (l.node k (rl.node rk rr)) rk =
                                    rotate (l.node k (rl.node rk rr))
                                      Rot.zag := by
                                rw [splay.eq_def]
                                have hne_rk_k : ¬ rk = k := by omega
                                have hnot_rk_lt_k : ¬ rk < k := by omega
                                have hnot_rk_lt_rk : ¬ rk < rk := by
                                  omega
                                simp [hne_rk_k, hnot_rk_lt_k, hk_lt_x,
                                  hnot_rk_lt_rk]
                              rw [hsplay]
                              have hnot_q_lt_k : ¬ q < k := by omega
                              have hnot_q_lt_rk : ¬ q < rk := by omega
                              simp [hnot_q_lt_k, hk_lt_q, hnot_q_lt_rk,
                                hxlt, BinaryTree.search_path_len, rotate,
                                rotateLeft]
                              omega
                          · have hrk_lt_x : rk < x :=
                              (forallTree_iff_forall_mem.mp hrr_right) x hx_rr
                            rcases hq_r with hq_rl | hq_eq_rk | hq_rr
                            · have hq_lt_rk : q < rk :=
                                (forallTree_iff_forall_mem.mp hrl_left) q hq_rl
                              omega
                            · omega
                            · have hrk_lt_q : rk < q :=
                                (forallTree_iff_forall_mem.mp hrr_right) q hq_rr
                              have hlt_rr : rr.num_nodes < n := by
                                rw [← hN]
                                simp [BinaryTree.num_nodes]
                                omega
                              have hinner :=
                                ih rr.num_nodes hlt_rr (t := rr)
                                  hbst_rr hx_rr hq_rr hxlt rfl
                              cases rr with
                              | empty =>
                                  simp [BinaryTree.toKeyList] at hx_rr
                              | node a y b =>
                                  have hroot_inner :=
                                    splay_rootKey_eq_some_of_mem_isBST
                                      (BinaryTree.node a y b) x hbst_rr hx_rr
                                  rw [splay.eq_def]
                                  have hx_ne_k : x ≠ k := by omega
                                  have hnot_x_lt_k : ¬ x < k := by omega
                                  have hnot_x_lt_rk : ¬ x < rk := by omega
                                  have hnot_q_lt_k : ¬ q < k := by omega
                                  have hnot_q_lt_rk : ¬ q < rk := by omega
                                  cases hs :
                                      splay (BinaryTree.node a y b) x with
                                  | empty =>
                                      simp [rootKey, hs] at hroot_inner
                                  | node sl sk sr =>
                                      simp [rootKey, hs] at hroot_inner
                                      subst sk
                                      have hnot_q_lt_x : ¬ q < x := by
                                        omega
                                      simp [hx_ne_k, hnot_x_lt_k, hk_lt_x,
                                        hnot_x_lt_rk, hrk_lt_x,
                                        hnot_q_lt_k, hk_lt_q,
                                        hnot_q_lt_rk, hrk_lt_q,
                                        hnot_q_lt_x, hxlt, hs,
                                        BinaryTree.search_path_len, rotate,
                                        rotateLeft] at hinner ⊢
                                      omega

private theorem search_path_len_after_splay_root_lt_same_right_le_add_one
    {t : BinaryTree} {root x q : Nat}
    (hbst : IsBST t)
    (hroot : rootKey t = some root)
    (hxmem : x ∈ t.toKeyList)
    (hqmem : q ∈ t.toKeyList)
    (hroot_lt_x : root < x)
    (hxlt : x < q) :
    (splay t x).search_path_len q ≤ t.search_path_len q + 1 := by
  cases t with
  | empty =>
      simp [BinaryTree.toKeyList] at hxmem
  | node l k r =>
      cases hbst with
      | node _ _ _ hleft hright hbst_left hbst_right =>
          simp [rootKey] at hroot
          subst k
          simp [BinaryTree.toKeyList] at hxmem hqmem
          rcases hxmem with hx_l | hx_eq | hx_r
          · have hx_lt_root : x < root :=
              (forallTree_iff_forall_mem.mp hleft) x hx_l
            omega
          · subst x
            omega
          · have hroot_lt_q : root < q := by omega
            rcases hqmem with hq_l | hq_eq | hq_r
            · have hq_lt_root : q < root :=
                (forallTree_iff_forall_mem.mp hleft) q hq_l
              omega
            · subst q
              omega
            · cases r with
              | empty =>
                  simp [BinaryTree.toKeyList] at hx_r
              | node rl rk rr =>
                  cases hbst_right with
                  | node _ _ _ hrl_left hrr_right hbst_rl hbst_rr =>
                      simp [BinaryTree.toKeyList] at hx_r hq_r
                      rcases hx_r with hx_rl | hx_eq_rk | hx_rr
                      · have hx_lt_rk : x < rk :=
                          (forallTree_iff_forall_mem.mp hrl_left) x hx_rl
                        rcases hq_r with hq_rl | hq_eq_rk | hq_rr
                        · have hq_lt_rk : q < rk :=
                            (forallTree_iff_forall_mem.mp hrl_left) q hq_rl
                          have hinner :=
                            search_path_len_after_splay_lower_le_add_two_strong
                              hbst_rl hx_rl hq_rl hxlt
                          cases rl with
                          | empty =>
                              simp [BinaryTree.toKeyList] at hx_rl
                          | node a y b =>
                              have hroot_inner :=
                                splay_rootKey_eq_some_of_mem_isBST
                                  (BinaryTree.node a y b) x hbst_rl hx_rl
                              rw [splay.eq_def]
                              have hx_ne_root : x ≠ root := by omega
                              have hnot_x_lt_root : ¬ x < root := by omega
                              have hnot_q_lt_root : ¬ q < root := by omega
                              cases hs :
                                  splay (BinaryTree.node a y b) x with
                              | empty =>
                                  simp [rootKey, hs] at hroot_inner
                              | node sl sk sr =>
                                  simp [rootKey, hs] at hroot_inner
                                  subst sk
                                  have hnot_q_lt_x : ¬ q < x := by omega
                                  simp [hx_ne_root, hnot_x_lt_root,
                                    hroot_lt_x, hx_lt_rk, hnot_q_lt_root,
                                    hroot_lt_q, hq_lt_rk, hnot_q_lt_x,
                                    hxlt, hs, BinaryTree.search_path_len,
                                    rotate, rotateLeft, rotateRight] at hinner ⊢
                                  omega
                        · subst q
                          cases rl with
                          | empty =>
                              simp [BinaryTree.toKeyList] at hx_rl
                          | node a y b =>
                              have hroot_inner :=
                                splay_rootKey_eq_some_of_mem_isBST
                                  (BinaryTree.node a y b) x hbst_rl hx_rl
                              rw [splay.eq_def]
                              have hx_ne_root : x ≠ root := by omega
                              have hnot_x_lt_root : ¬ x < root := by omega
                              have hnot_rk_lt_x : ¬ rk < x := by omega
                              have hnot_rk_lt_root : ¬ rk < root := by omega
                              cases hs :
                                  splay (BinaryTree.node a y b) x with
                              | empty =>
                                  simp [rootKey, hs] at hroot_inner
                              | node sl sk sr =>
                                  simp [rootKey, hs] at hroot_inner
                                  subst sk
                                  simp [hx_ne_root, hnot_x_lt_root,
                                    hroot_lt_x, hx_lt_rk, hnot_rk_lt_x,
                                    hnot_rk_lt_root, hroot_lt_q, hs,
                                    BinaryTree.search_path_len, rotate,
                                    rotateLeft, rotateRight]
                        · have hrk_lt_q : rk < q :=
                            (forallTree_iff_forall_mem.mp hrr_right) q hq_rr
                          cases rl with
                          | empty =>
                              simp [BinaryTree.toKeyList] at hx_rl
                          | node a y b =>
                              have hroot_inner :=
                                splay_rootKey_eq_some_of_mem_isBST
                                  (BinaryTree.node a y b) x hbst_rl hx_rl
                              rw [splay.eq_def]
                              have hx_ne_root : x ≠ root := by omega
                              have hnot_x_lt_root : ¬ x < root := by omega
                              have hnot_q_lt_root : ¬ q < root := by omega
                              have hnot_q_lt_rk : ¬ q < rk := by omega
                              cases hs :
                                  splay (BinaryTree.node a y b) x with
                              | empty =>
                                  simp [rootKey, hs] at hroot_inner
                              | node sl sk sr =>
                                  simp [rootKey, hs] at hroot_inner
                                  subst sk
                                  have hnot_q_lt_x : ¬ q < x := by omega
                                  simp [hx_ne_root, hnot_x_lt_root,
                                    hroot_lt_x, hx_lt_rk, hnot_q_lt_root,
                                    hroot_lt_q, hnot_q_lt_rk, hrk_lt_q,
                                    hnot_q_lt_x, hxlt, hs,
                                    BinaryTree.search_path_len, rotate,
                                    rotateLeft, rotateRight]
                      · subst x
                        rcases hq_r with hq_rl | hq_eq_rk | hq_rr
                        · have hq_lt_rk : q < rk :=
                            (forallTree_iff_forall_mem.mp hrl_left) q hq_rl
                          omega
                        · omega
                        · have hsplay :
                              splay (l.node root (rl.node rk rr)) rk =
                                rotate (l.node root (rl.node rk rr))
                                  Rot.zag := by
                            rw [splay.eq_def]
                            have hne_rk_root : ¬ rk = root := by omega
                            have hnot_rk_lt_root : ¬ rk < root := by omega
                            have hnot_rk_lt_rk : ¬ rk < rk := by omega
                            simp [hne_rk_root, hnot_rk_lt_root,
                              hroot_lt_x, hnot_rk_lt_rk]
                          rw [hsplay]
                          have hnot_q_lt_root : ¬ q < root := by omega
                          have hnot_q_lt_rk : ¬ q < rk := by omega
                          simp [hnot_q_lt_root, hroot_lt_q, hnot_q_lt_rk,
                            hxlt, BinaryTree.search_path_len, rotate,
                            rotateLeft]
                          omega
                      · have hrk_lt_x : rk < x :=
                          (forallTree_iff_forall_mem.mp hrr_right) x hx_rr
                        rcases hq_r with hq_rl | hq_eq_rk | hq_rr
                        · have hq_lt_rk : q < rk :=
                            (forallTree_iff_forall_mem.mp hrl_left) q hq_rl
                          omega
                        · omega
                        · have hrk_lt_q : rk < q :=
                            (forallTree_iff_forall_mem.mp hrr_right) q hq_rr
                          have hinner :=
                            search_path_len_after_splay_lower_le_add_two_strong
                              hbst_rr hx_rr hq_rr hxlt
                          cases rr with
                          | empty =>
                              simp [BinaryTree.toKeyList] at hx_rr
                          | node a y b =>
                              have hroot_inner :=
                                splay_rootKey_eq_some_of_mem_isBST
                                  (BinaryTree.node a y b) x hbst_rr hx_rr
                              rw [splay.eq_def]
                              have hx_ne_root : x ≠ root := by omega
                              have hnot_x_lt_root : ¬ x < root := by omega
                              have hnot_x_lt_rk : ¬ x < rk := by omega
                              have hnot_q_lt_root : ¬ q < root := by omega
                              have hnot_q_lt_rk : ¬ q < rk := by omega
                              cases hs :
                                  splay (BinaryTree.node a y b) x with
                              | empty =>
                                  simp [rootKey, hs] at hroot_inner
                              | node sl sk sr =>
                                  simp [rootKey, hs] at hroot_inner
                                  subst sk
                                  have hnot_q_lt_x : ¬ q < x := by omega
                                  simp [hx_ne_root, hnot_x_lt_root,
                                    hroot_lt_x, hnot_x_lt_rk, hrk_lt_x,
                                    hnot_q_lt_root, hroot_lt_q,
                                    hnot_q_lt_rk, hrk_lt_q, hnot_q_lt_x,
                                    hxlt, hs, BinaryTree.search_path_len,
                                    rotate, rotateLeft] at hinner ⊢
                                  omega

private theorem two_le_search_path_len_of_rootKey_ne_of_mem_isBST
    {t : BinaryTree} {root q : Nat}
    (hbst : IsBST t)
    (hroot : rootKey t = some root)
    (hmem : q ∈ t.toKeyList)
    (hne : q ≠ root) :
    2 ≤ t.search_path_len q := by
  cases t with
  | empty =>
      simp [rootKey] at hroot
  | node l k r =>
      cases hbst with
      | node _ _ _ hleft hright hbst_left hbst_right =>
          simp [rootKey] at hroot
          subst k
          simp [BinaryTree.toKeyList] at hmem
          rcases hmem with hmem_l | hq_eq | hmem_r
          · have hq_lt_root : q < root :=
              (forallTree_iff_forall_mem.mp hleft) q hmem_l
            have hpos : 0 < l.search_path_len q :=
              search_path_len_pos_of_mem l q hmem_l
            simp [BinaryTree.search_path_len, hq_lt_root]
            omega
          · omega
          · have hroot_lt_q : root < q :=
              (forallTree_iff_forall_mem.mp hright) q hmem_r
            have hnot_q_lt_root : ¬ q < root := by omega
            have hpos : 0 < r.search_path_len q :=
              search_path_len_pos_of_mem r q hmem_r
            simp [BinaryTree.search_path_len, hnot_q_lt_root,
              hroot_lt_q]
            omega

private theorem qpath_cancel_after_root_lower_then_upper
    {t : BinaryTree} {q y x : Nat}
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hy_mem : y ∈ t.toKeyList)
    (hx_mem : x ∈ t.toKeyList)
    (hyx : y < x)
    (hxq : x < q) :
    ((splay (splay t y) x).search_path_len q : ℝ) + 1 ≤
      ((splay t y).search_path_len q : ℝ) +
        ((splay (splay (splay t y) q) x).search_path_len q : ℝ) := by
  let actual := splay t y
  let reset := splay actual q
  have hq_mem : q ∈ t.toKeyList := rootKey_mem_toKeyList hroot
  have hbst_actual : IsBST actual := by
    unfold actual
    exact splay_isBST t y hbst
  have hroot_actual : rootKey actual = some y := by
    unfold actual
    exact splay_rootKey_eq_some_of_mem_isBST t y hbst hy_mem
  have hx_mem_actual : x ∈ actual.toKeyList := by
    unfold actual
    rw [splay_toKeyList]
    exact hx_mem
  have hq_mem_actual : q ∈ actual.toKeyList := by
    unfold actual
    rw [splay_toKeyList]
    exact hq_mem
  have hpath_nat :
      (splay actual x).search_path_len q ≤
        actual.search_path_len q + 1 :=
    search_path_len_after_splay_root_lt_same_right_le_add_one
      hbst_actual hroot_actual hx_mem_actual hq_mem_actual hyx hxq
  have hx_mem_reset : x ∈ reset.toKeyList := by
    unfold reset actual
    rw [splay_toKeyList, splay_toKeyList]
    exact hx_mem
  have hbst_reset_x : IsBST (splay reset x) := by
    unfold reset
    exact splay_isBST reset x
      (splay_isBST actual q hbst_actual)
  have hroot_reset_x : rootKey (splay reset x) = some x := by
    exact
      splay_rootKey_eq_some_of_mem_isBST reset x
        (by unfold reset; exact splay_isBST actual q hbst_actual)
        hx_mem_reset
  have hq_mem_reset_x : q ∈ (splay reset x).toKeyList := by
    unfold reset actual
    rw [splay_toKeyList, splay_toKeyList, splay_toKeyList]
    exact hq_mem
  have hq_ne_x : q ≠ x := by omega
  have htwo_nat :
      2 ≤ (splay reset x).search_path_len q :=
    two_le_search_path_len_of_rootKey_ne_of_mem_isBST
      hbst_reset_x hroot_reset_x hq_mem_reset_x hq_ne_x
  have hpath :
      ((splay actual x).search_path_len q : ℝ) ≤
        (actual.search_path_len q : ℝ) + 1 := by
    exact_mod_cast hpath_nat
  have htwo :
      (2 : ℝ) ≤ ((splay reset x).search_path_len q : ℝ) := by
    exact_mod_cast htwo_nat
  dsimp [actual, reset] at hpath htwo ⊢
  nlinarith

private theorem search_path_len_after_splay_lower_le_boundary_add_reset
    {t : BinaryTree} {q x : Nat}
    (hbst : IsBST t)
    (hxmem : x ∈ t.toKeyList)
    (hqmem : q ∈ t.toKeyList)
    (hxlt : x < q) :
    (splay t x).search_path_len q ≤
      t.search_path_len q + (splay (splay t q) x).search_path_len q := by
  have hle :
      (splay t x).search_path_len q ≤ t.search_path_len q + 2 :=
    search_path_len_after_splay_lower_le_add_two_strong
      hbst hxmem hqmem hxlt
  have hbst_tq : IsBST (splay t q) :=
    splay_isBST t q hbst
  have hxmem_tq : x ∈ (splay t q).toKeyList := by
    rw [splay_toKeyList]
    exact hxmem
  have hbst_reset : IsBST (splay (splay t q) x) :=
    splay_isBST (splay t q) x hbst_tq
  have hroot_reset :
      rootKey (splay (splay t q) x) = some x :=
    splay_rootKey_eq_some_of_mem_isBST
      (splay t q) x hbst_tq hxmem_tq
  have hqmem_reset : q ∈ (splay (splay t q) x).toKeyList := by
    rw [splay_toKeyList, splay_toKeyList]
    exact hqmem
  have hq_ne_x : q ≠ x := by omega
  have htwo : 2 ≤ (splay (splay t q) x).search_path_len q :=
      two_le_search_path_len_of_rootKey_ne_of_mem_isBST
        hbst_reset hroot_reset hqmem_reset hq_ne_x
  omega

private theorem search_path_len_after_splay_lower_le_add_two_Q_bound
    {t : BinaryTree} {q x : Nat}
    (hbst : IsBST t)
    (hxmem : x ∈ t.toKeyList)
    (hqmem : q ∈ t.toKeyList)
    (hxlt : x < q) :
    (splay t x).search_path_len q ≤ t.search_path_len q + 2 := by
  exact
    search_path_len_after_splay_lower_le_add_two_strong
      hbst hxmem hqmem hxlt

private theorem search_path_len_after_splay_lower_le_boundary_add_reset_Q_bound
    {t : BinaryTree} {q x : Nat}
    (hbst : IsBST t)
    (hxmem : x ∈ t.toKeyList)
    (hqmem : q ∈ t.toKeyList)
    (hxlt : x < q) :
    (splay t x).search_path_len q ≤
      t.search_path_len q + (splay (splay t q) x).search_path_len q := by
  exact
    search_path_len_after_splay_lower_le_boundary_add_reset
      hbst hxmem hqmem hxlt

private theorem search_path_len_after_lower_access_le_actual_boundary_add_reset_access
    {actual reset : BinaryTree} {q x : Nat}
    (hbst_actual : IsBST actual)
    (hbst_reset : IsBST reset)
    (hroot_reset : rootKey reset = some q)
    (hkeys : reset.toKeyList = actual.toKeyList)
    (hx_mem : x ∈ actual.toKeyList)
    (hx_lt : x < q) :
    (splay actual x).search_path_len q ≤
      actual.search_path_len q + (splay reset x).search_path_len q := by
  have hq_mem_actual : q ∈ actual.toKeyList := by
    rw [← hkeys]
    exact rootKey_mem_toKeyList hroot_reset
  have hle :
      (splay actual x).search_path_len q ≤
        actual.search_path_len q + 2 :=
    search_path_len_after_splay_lower_le_add_two_strong
      hbst_actual hx_mem hq_mem_actual hx_lt
  have hx_mem_reset : x ∈ reset.toKeyList := by
    rw [hkeys]
    exact hx_mem
  have hbst_rx : IsBST (splay reset x) :=
    splay_isBST reset x hbst_reset
  have hroot_rx : rootKey (splay reset x) = some x :=
    splay_rootKey_eq_some_of_mem_isBST reset x hbst_reset hx_mem_reset
  have hq_mem_rx : q ∈ (splay reset x).toKeyList := by
    rw [splay_toKeyList]
    exact rootKey_mem_toKeyList hroot_reset
  have hq_ne_x : q ≠ x := by omega
  have htwo : 2 ≤ (splay reset x).search_path_len q :=
      two_le_search_path_len_of_rootKey_ne_of_mem_isBST
        hbst_rx hroot_rx hq_mem_rx hq_ne_x
  omega

private theorem resetPairDominatesAbove_of_path_len_bound
    {q lo : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hbst_actual : IsBST actual)
    (hbst_reset : IsBST reset)
    (hroot_reset : rootKey reset = some q)
    (hkeys : reset.toKeyList = actual.toKeyList)
    (hpath :
      ∀ x : Nat,
        x ∈ actual.toKeyList →
        lo ≤ x →
        x < q →
        (actual.search_path_len x : ℝ) ≤
          (reset.search_path_len x : ℝ) + D) :
    resetPairDominatesAbove q lo D actual reset := by
  refine ⟨hbst_actual, hbst_reset, hroot_reset, hkeys, ?_⟩
  intro x hx_mem hlo hx_lt
  have hq_path_nat :
      (splay actual x).search_path_len q ≤
        actual.search_path_len q + (splay reset x).search_path_len q :=
    search_path_len_after_lower_access_le_actual_boundary_add_reset_access
      hbst_actual hbst_reset hroot_reset hkeys hx_mem hx_lt
  have hq_path :
      ((splay actual x).search_path_len q : ℝ) ≤
        (actual.search_path_len q : ℝ) +
          ((splay reset x).search_path_len q : ℝ) := by
    exact_mod_cast hq_path_nat
  have hx_path := hpath x hx_mem hlo hx_lt
  nlinarith

private theorem resetPathDominatesAbove.to_pair
    {q lo : Nat} {D : ℝ} {actual reset : BinaryTree}
