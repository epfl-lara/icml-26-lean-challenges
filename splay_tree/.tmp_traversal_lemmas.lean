    exact hmem m
  have hts_bst : IsBST ts := by
    unfold ts
    exact splay_isBST tp (X m) htp_bst
  have hpivot_mem_ts : X m ∈ ts.toKeyList := by
    unfold ts
    rw [splay_toKeyList]
    exact hpivot_mem_tp
  have hstrict_mem :
      ∀ i : Fin (strictLowerSuffixIndices X m).length,
        i ∈ List.finRange (strictLowerSuffixIndices X m).length →
        strictLowerSuffixSeq X m i ∈ ts.toKeyList := by
    intro i _hi
    unfold ts tp
    exact strictLowerSuffixSeq_mem_after_prefix_pivot hmem i
  have hpair :
      pivotResetPairPathSum (strictLowerSuffixSeq X m) (X m) ts
          (List.finRange (strictLowerSuffixIndices X m).length) ≤
        4 *
          (((strictLowerSuffixIndices X m).length : ℝ) *
            boundaryBudget (strictLowerSuffixSeq X m) ts
              (List.finRange (strictLowerSuffixIndices X m).length)
              (X m)) := by
    simpa [List.length_finRange] using
      pivotResetPairPathSum_le_four_length_mul_boundaryBudget
        (strictLowerSuffixSeq X m) (X m)
        (List.finRange (strictLowerSuffixIndices X m).length)
        ts hts_bst hpivot_mem_ts hstrict_mem
  have hbudget :=
    boundaryBudget_strictLowerSuffixSeq_after_prefix_pivot_le_finRange
      (m := m) hbst hmem
  change
    boundaryBudget (strictLowerSuffixSeq X m) ts
        (List.finRange (strictLowerSuffixIndices X m).length) (X m) ≤
      boundaryBudget X init (List.finRange n) (X m) at hbudget
  have hmul :
      4 *
          (((strictLowerSuffixIndices X m).length : ℝ) *
            boundaryBudget (strictLowerSuffixSeq X m) ts
              (List.finRange (strictLowerSuffixIndices X m).length)
              (X m)) ≤
        4 *
          (((strictLowerSuffixIndices X m).length : ℝ) *
            boundaryBudget X init (List.finRange n) (X m)) := by
    have hcoef_nonneg :
        0 ≤ 4 * ((strictLowerSuffixIndices X m).length : ℝ) := by
      positivity
    have hmul' :
        (4 * ((strictLowerSuffixIndices X m).length : ℝ)) *
            boundaryBudget (strictLowerSuffixSeq X m) ts
              (List.finRange (strictLowerSuffixIndices X m).length)
              (X m) ≤
          (4 * ((strictLowerSuffixIndices X m).length : ℝ)) *
            boundaryBudget X init (List.finRange n) (X m) := by
      exact mul_le_mul_of_nonneg_left hbudget hcoef_nonneg
    calc
      4 *
          (((strictLowerSuffixIndices X m).length : ℝ) *
            boundaryBudget (strictLowerSuffixSeq X m) ts
              (List.finRange (strictLowerSuffixIndices X m).length)
              (X m))
          =
        (4 * ((strictLowerSuffixIndices X m).length : ℝ)) *
            boundaryBudget (strictLowerSuffixSeq X m) ts
              (List.finRange (strictLowerSuffixIndices X m).length)
              (X m) := by ring
      _ ≤
        (4 * ((strictLowerSuffixIndices X m).length : ℝ)) *
            boundaryBudget X init (List.finRange n) (X m) := hmul'
      _ =
        4 *
          (((strictLowerSuffixIndices X m).length : ℝ) *
            boundaryBudget X init (List.finRange n) (X m)) := by ring
  exact le_trans hpair hmul

private theorem strictLowerSuffixSeq_pivotResetPairPathSum_le_full_boundary_of_weighted_step
    (A C : ℝ) (hA : 0 ≤ A) (hC : 0 ≤ C)
