  refine ⟨K * (A + 1), ?_⟩
  intro n X havoid init h_size hbst hmem
  by_cases hn : 0 < n
  · obtain ⟨m, _hmax, _hfirst, hpath⟩ :=
      hbound hn X init h_size havoid hbst hmem
    have hcost_path := sequence_cost_add_length_eq_pathSum X init hmem
    have hhull :=
      boundaryHullSize_le_num_nodes X init (List.finRange n) (X m)
    have hweighted :
        weightedBoundaryBudget A X init (List.finRange n) (X m) ≤
          (A + 1) * (n : ℝ) := by
      unfold weightedBoundaryBudget
      rw [List.length_finRange]
      rw [h_size] at hhull
      have hhullR : (boundaryHullSize X init (List.finRange n) (X m) : ℝ) ≤ n := by
        exact_mod_cast hhull
      nlinarith
    have hpath_linear :
        splayPathSum X init (List.finRange n) ≤
          K * ((A + 1) * (n : ℝ)) := by
      exact le_trans hpath (mul_le_mul_of_nonneg_left hweighted hK)
    nlinarith [show 0 ≤ (n : ℝ) by positivity]
  · have hn_zero : n = 0 := by omega
    have hcost := sequence_cost_le_num_nodes_mul_length X init
    have hcost0 : splay.sequence_cost init X ≤ 0 := by
      have hcost' := hcost
      rw [h_size] at hcost'
      have hnR : (n : ℝ) = 0 := by
        exact_mod_cast hn_zero
      nlinarith
    have hgoal : (K * (A + 1)) * (n : ℝ) = 0 := by
      rw [hn_zero]
      norm_num
    rw [hgoal]
    exact hcost0

private theorem traversal_conjecture_of_boundary_blocks
    (K : ℝ) (hK : 0 ≤ K)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q)
    (hupper :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i ≤ q) →
        splayPathSum Y t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  refine ⟨4 * K, ?_⟩
  intro n X havoid init h_size hbst hmem
  by_cases hn : 0 < n
  · have hcost_path := sequence_cost_add_length_eq_pathSum X init hmem
    have hpath :=
      firstMax_path_bound_of_boundary_blocks
        K hK hstrict hupper hn X init h_size havoid hbst hmem
    nlinarith [show 0 ≤ (n : ℝ) by positivity, hcost_path, hpath]
  · have hn_zero : n = 0 := by omega
    have hcost := sequence_cost_le_num_nodes_mul_length X init
    have hcost0 : splay.sequence_cost init X ≤ 0 := by
      have hcost' := hcost
      rw [h_size] at hcost'
      have hnR : (n : ℝ) = 0 := by
        exact_mod_cast hn_zero
      nlinarith
    have hgoal : (4 * K) * (n : ℝ) = 0 := by
      rw [hn_zero]
      norm_num
    rw [hgoal]
    exact hcost0

private theorem traversal_conjecture_of_boundary_block_inductions
    (K : ℝ) (hK : 7 ≤ K)
    (hstrictStep :
