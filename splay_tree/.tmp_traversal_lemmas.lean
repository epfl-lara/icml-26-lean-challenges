private theorem boundaryBudget_drop_le_of_intersection_bound_32
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n)) (q : Nat)
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hq_mem : q ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList)
    (hinter :
      32 *
          ((boundaryHullKeys X (splay t (X i)) xs q).toFinset ∩
            (searchPathKeys t (X i)).toFinset).card ≤
        31 * t.search_path_len (X i) + 304) :
    (t.search_path_len (X i) : ℝ) +
        32 * boundaryBudget X (splay t (X i)) xs q ≤
      272 + 32 * boundaryBudget X t (i :: xs) q := by
  let newKeys := boundaryHullKeys X (splay t (X i)) xs q
  let oldKeys := boundaryHullKeys X t (i :: xs) q
  let pathKeys := searchPathKeys t (X i)
  let m := (newKeys.toFinset ∩ pathKeys.toFinset).card
  have hcount :
      newKeys.length + t.search_path_len (X i) ≤
        oldKeys.length + m := by
    simpa [newKeys, oldKeys, pathKeys, m] using
      boundaryHullKeys_after_splay_length_add_path_len_le_cons_add_inter
        X i xs q hbst hi_mem hq_mem hmem_tail
  have hinter' : 32 * m ≤ 31 * t.search_path_len (X i) + 304 := by
    simpa [newKeys, pathKeys, m] using hinter
  have hnat :
      t.search_path_len (X i) +
          32 * (xs.length + newKeys.length) ≤
        272 + 32 * ((i :: xs).length + oldKeys.length) := by
    simp
    omega
  have hreal :
      ((t.search_path_len (X i) +
          32 * (xs.length + newKeys.length : Nat) : Nat) : ℝ) ≤
        (272 + 32 * ((i :: xs).length + oldKeys.length) : Nat) := by
    exact_mod_cast hnat
  unfold boundaryBudget boundaryHullSize
  change
    (t.search_path_len (X i) : ℝ) +
        32 * ((xs.length : ℝ) +
          (boundaryHullKeys X (splay t (X i)) xs q).length) ≤
      272 + 32 * (((i :: xs).length : ℝ) +
        (boundaryHullKeys X t (i :: xs) q).length)
  norm_num [Nat.cast_add, Nat.cast_mul] at hreal ⊢
  simpa [newKeys, oldKeys] using hreal

