  have hhull' :
      newKeys.length + t.search_path_len (X i) ≤
        oldKeys.length + (C + 1) := by
    simpa [newKeys, oldKeys] using hhull
  have hnat :
      t.search_path_len (X i) + (xs.length + newKeys.length) ≤
