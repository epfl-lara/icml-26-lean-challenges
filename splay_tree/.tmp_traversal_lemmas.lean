private theorem resetPairDominatesAbove_threshold_of_ordered_low_prefix_base_and_contextual_strict_preservation
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hD : 0 ≤ D)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (havoid : Y avoids ![2, 3, 1])
    (hle : ∀ j : Fin n, Y j ≤ q)
