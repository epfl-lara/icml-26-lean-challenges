private theorem splayPathSum_le_suffixResetUpperPathSum_of_prefix_pair_bound
    {n : Nat} (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (D : ℝ) (hD : 0 ≤ D)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hle_all : ∀ i : Fin n, X i ≤ q)
    (hpair :
      ∀ (done : List (Fin n)) (i : Fin n) (future : List (Fin n)),
        (done ++ i :: future).Sublist (List.finRange n) →
        X i < q →
        ((splayTreeAfter X init done).search_path_len (X i) : ℝ) +
            ((splay (splayTreeAfter X init done) (X i)).search_path_len q : ℝ) ≤
          ((splayTreeAfter X init done).search_path_len q : ℝ) +
            ((suffixResetTreeAfter X q init done).search_path_len (X i) : ℝ) +
            ((splay (suffixResetTreeAfter X q init done) (X i)).search_path_len q : ℝ) +
            D) :
    ∀ (done xs : List (Fin n)),
      (done ++ xs).Sublist (List.finRange n) →
      splayPathSum X (splayTreeAfter X init done) xs ≤
        ((splayTreeAfter X init done).search_path_len q : ℝ) +
          suffixResetUpperPathSum X q
            (suffixResetTreeAfter X q init done) xs +
          D * xs.length
| done, [], _hsub => by
    simp [splayPathSum, suffixResetUpperPathSum]
| done, i :: xs, hsub => by
    have hsub_next :
        ((done ++ [i]) ++ xs).Sublist (List.finRange n) := by
      simpa [List.append_assoc] using hsub
    have hactual_next :
        splayTreeAfter X init (done ++ [i]) =
          splay (splayTreeAfter X init done) (X i) := by
      rw [splayTreeAfter_append]
      simp [splayTreeAfter]
    have hi_le : X i ≤ q := hle_all i
    by_cases hi_lt : X i < q
    · have hreset_next :
        suffixResetTreeAfter X q init (done ++ [i]) =
          splay (splay (suffixResetTreeAfter X q init done) (X i)) q :=
          suffixResetTreeAfter_append_singleton_lt X q done init i hi_lt
      have ih :=
        splayPathSum_le_suffixResetUpperPathSum_of_prefix_pair_bound
          X q init D hD hbst hroot hle_all hpair
          (done ++ [i]) xs hsub_next
      rw [hactual_next, hreset_next] at ih
      have hp := hpair done i xs hsub hi_lt
      simp [splayPathSum, suffixResetUpperPathSum, hi_lt]
      nlinarith
    · have hi_eq : X i = q := by omega
      have hreset_next :
        suffixResetTreeAfter X q init (done ++ [i]) =
          suffixResetTreeAfter X q init done :=
          suffixResetTreeAfter_append_singleton_not_lt X q done init i hi_lt
      have ih :=
        splayPathSum_le_suffixResetUpperPathSum_of_prefix_pair_bound
          X q init D hD hbst hroot hle_all hpair
          (done ++ [i]) xs hsub_next
      rw [hactual_next, hreset_next] at ih
      rw [hi_eq] at ih
      let a := splayTreeAfter X init done
      have hbst_a : IsBST a := by
        unfold a
        exact splayTreeAfter_isBST X done init hbst
      have hq_mem_a : q ∈ a.toKeyList := by
        unfold a
        rw [splayTreeAfter_toKeyList]
        exact rootKey_mem_toKeyList hroot
      have hroot_next : rootKey (splay a q) = some q :=
        splay_rootKey_eq_some_of_mem_isBST a q hbst_a hq_mem_a
      have hpath_next : (splay a q).search_path_len q = 1 :=
        search_path_len_eq_one_of_rootKey_eq_some hroot_next
      have hpath_actual :
          (splay (splayTreeAfter X init done) q).search_path_len q = 1 := by
        simpa [a] using hpath_next
      rw [hpath_actual] at ih
      have hD_len :
          D * (xs.length : ℝ) ≤ D * ((xs.length : ℝ) + 1) := by
        nlinarith [hD]
      have ih_mono :
          splayPathSum X (splay (splayTreeAfter X init done) q) xs ≤
            (1 : ℝ) + suffixResetUpperPathSum X q
                (suffixResetTreeAfter X q init done) xs +
              D * ((xs.length : ℝ) + 1) := by
        calc
          splayPathSum X (splay (splayTreeAfter X init done) q) xs
              ≤ (1 : ℝ) + suffixResetUpperPathSum X q
                  (suffixResetTreeAfter X q init done) xs +
                D * (xs.length : ℝ) := by
                simpa using ih
          _ ≤ (1 : ℝ) + suffixResetUpperPathSum X q
                  (suffixResetTreeAfter X q init done) xs +
                D * ((xs.length : ℝ) + 1) := by
                linarith
      simp [splayPathSum, suffixResetUpperPathSum, hi_eq]
      nlinarith [ih_mono]

