    (hupperStep :
      ∀ N, 2 < N →
        (∀ k, k < N → ∀ (Y : Fin k → Nat) (q : Nat)
            (t : BinaryTree),
          IsBST t →
          rootKey t = some q →
          (∀ i : Fin k, Y i ∈ t.toKeyList) →
