    exact hp_eq_q
  have h :=
    done_left_le_current_of_pivot_between_avoids231
      (Y := Y) (done := done) (future := future) (i := i)
      (q := q)
      (by simpa [done, List.append_assoc] using hsub)
      havoid hia_ip ha_done hp_done
  rw [hget_a] at h
  exact h

private theorem split_left_lower_le_right_of_pivot_between_avoids231
    {n : Nat} {Y : Fin n → Nat}
    {left right future : List (Fin n)} {p i : Fin n} {q : Nat}
    (hsub : ((left ++ p :: right) ++ i :: future).Sublist
      (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
