          simpa [ht] using hbst
        have hmem_l : x ∈ l.toKeyList := by
          simpa [ht, leftSubtree] using hmem_left
        have hx_lt_q := isBST_left_mem_lt_root hbst_node hmem_l
        simp [leftSubtree, BinaryTree.search_path_len, hx_lt_q]
  rw [hpath] at hpair
  omega

