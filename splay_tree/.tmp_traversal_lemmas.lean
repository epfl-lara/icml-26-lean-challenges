private theorem prefix_pivot_pathSum_le_full_boundaryBudget_of_bound
    (K : ℝ) (hK : 0 ≤ K)
    (hbound :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q)
    {n : Nat} {X : Fin n → Nat} {init : BinaryTree} {m : Fin n}
    (hbst : IsBST init)
    (hmem : ∀ i : Fin n, X i ∈ init.toKeyList)
    (hpreAvoid : prefixSeq X m avoids ![2, 3, 1])
    (hpre_lt : ∀ i : Fin m.val, prefixSeq X m i < X m) :
    splayPathSum (prefixSeq X m) init (List.finRange m.val) +
        ((splayTreeAfter (prefixSeq X m) init
          (List.finRange m.val)).search_path_len (X m) : ℝ) ≤
      K * boundaryBudget X init (List.finRange n) (X m) := by
  have hprefinal :=
    hbound (prefixSeq X m) (X m) init hbst (hmem m)
      (prefixSeq_mem hmem m) hpreAvoid hpre_lt
  have hprefinal_path :
      splayPathSum (prefixSeq X m) init (List.finRange m.val) +
          ((splayTreeAfter (prefixSeq X m) init
            (List.finRange m.val)).search_path_len (X m) : ℝ) ≤
        K * boundaryBudget (prefixSeq X m) init
          (List.finRange m.val) (X m) := by
    simpa [splayPathSumWithFinal_eq_pathSum_add_final] using hprefinal
  have htake_sub :
      ((List.finRange n).take m.val).Sublist (List.finRange n) :=
    List.take_sublist _ _
  have hbudget_take :
      boundaryBudget X init ((List.finRange n).take m.val) (X m) ≤
        boundaryBudget X init (List.finRange n) (X m) :=
    boundaryBudget_sublist_le X init (X m) htake_sub
  have hbudget_prefix :
      boundaryBudget (prefixSeq X m) init
          (List.finRange m.val) (X m) ≤
        boundaryBudget X init (List.finRange n) (X m) := by
    simpa [boundaryBudget_take_eq_prefixSeq X init m] using hbudget_take
  have hmul :
      K * boundaryBudget (prefixSeq X m) init
          (List.finRange m.val) (X m) ≤
        K * boundaryBudget X init (List.finRange n) (X m) := by
    exact mul_le_mul_of_nonneg_left hbudget_prefix hK
