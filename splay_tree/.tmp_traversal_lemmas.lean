        (l := l) (rl := rl) (k := k) (rk := rk) (q := q)
        (fs := fs) hbst hmem hmax
    simp [splayMaxUnwindResult, rightMaxDepth]
    nlinarith [h]
| .node l k (.node rl rk (.node a x b)), fs, q, hbst, hmem, hmax => by
    rcases zagzag_context_max_state hbst hmem hmax with
      ⟨hbst_inner, hmem_inner, hmax_inner⟩
    have ih :=
      splayMaxUnwind_amortized_with_rightMaxDepth
        (.node a x b) ((rk, rl) :: (k, l) :: fs) q
