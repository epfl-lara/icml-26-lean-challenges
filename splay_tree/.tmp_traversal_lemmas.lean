private theorem pivotResetPairPathSum_le_four_pathWithFinal_le_two
    (N : Nat) (hN : N ≤ 2)
    (Y : Fin N → Nat) (q : Nat) (t : BinaryTree)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem : ∀ i : Fin N, Y i ∈ t.toKeyList)
    (hlt : ∀ i : Fin N, Y i < q) :
    pivotResetPairPathSum Y q t (List.finRange N) ≤
      4 * splayPathSumWithFinal Y q t (List.finRange N) := by
  rcases N with _ | N
  · simp [pivotResetPairPathSum, splayPathSumWithFinal]
  rcases N with _ | N
  · let i : Fin 1 := 0
    have hfin : List.finRange 1 = [i] := by
      native_decide
    rw [hfin]
    have hnonneg :
        0 ≤ splayPathSumWithFinal Y q t [i] := by
      simp [splayPathSumWithFinal]
      positivity
    rw [← splayPathSumWithFinal_singleton_eq_pivotResetPairPathSum]
    nlinarith
  rcases N with _ | N
  · let i : Fin 2 := 0
    let j : Fin 2 := 1
    have hfin : List.finRange 2 = [i, j] := by
      native_decide
    rw [hfin]
    let t1 := splay t (Y i)
    let tr := splay t1 q
    have hbst1 : IsBST t1 := by
      unfold t1
      exact splay_isBST t (Y i) hbst
    have hroot_tr : rootKey tr = some q := by
      unfold tr t1
      exact rootKey_after_pivot_reset_of_root hbst hroot
    have hbst_tr : IsBST tr := by
      unfold tr
      exact splay_isBST t1 q hbst1
    have hi_mem_t : Y i ∈ t.toKeyList := hmem i
    have hj_mem_t : Y j ∈ t.toKeyList := hmem j
    have hq_mem_t : q ∈ t.toKeyList :=
      rootKey_mem_toKeyList hroot
    have hq_mem_t1 : q ∈ t1.toKeyList := by
      unfold t1
      rw [splay_toKeyList]
      exact hq_mem_t
    have hj_mem_t1 : Y j ∈ t1.toKeyList := by
      unfold t1
      rw [splay_toKeyList]
      exact hj_mem_t
    have hj_mem_tr : Y j ∈ tr.toKeyList := by
      unfold tr t1
      rw [splay_toKeyList, splay_toKeyList]
      exact hj_mem_t
    have hpair_i :
        (t.search_path_len (Y i) : ℝ) +
            ((splay t (Y i)).search_path_len q : ℝ) ≤
          2 * (t.search_path_len (Y i) : ℝ) :=
      rooted_pivot_access_reset_pair_path_real_le_of_lt
        hbst hroot hi_mem_t (hlt i)
    have hpair_j :
        (tr.search_path_len (Y j) : ℝ) +
            ((splay tr (Y j)).search_path_len q : ℝ) ≤
          2 * (tr.search_path_len (Y j) : ℝ) :=
      rooted_pivot_access_reset_pair_path_real_le_of_lt
        hbst_tr hroot_tr hj_mem_tr (hlt j)
    have htr_path_nat :
        tr.search_path_len (Y j) ≤
          t1.search_path_len q + t1.search_path_len (Y j) := by
      unfold tr
      exact search_path_len_after_splay_le_path_add_of_mem
        hbst1 hq_mem_t1 hj_mem_t1
    have htr_path :
        (tr.search_path_len (Y j) : ℝ) ≤
          (t1.search_path_len q : ℝ) + t1.search_path_len (Y j) := by
      exact_mod_cast htr_path_nat
    have hfinal_nonneg :
        0 ≤ (splay t1 (Y j)).search_path_len q := by
      positivity
    simp [pivotResetPairPathSum, splayPathSumWithFinal, t1, tr]
    nlinarith
  · omega

private theorem search_path_len_le_reset_search_path_add_of_mem
