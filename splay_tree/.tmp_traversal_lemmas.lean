      (i :: xs).Sublist (List.finRange n) →
      splayPathSum Y (splay t (Y i)) xs ≤
        ((splay t (Y i)).search_path_len q : ℝ) +
          suffixResetUpperPathSum Y q (splay (splay t (Y i)) q) xs +
          D * xs.length + Ψ [i] xs := by
  intro t i xs hbst hroot hi_mem hi_lt hmem_tail hsub
  have hmem_all :
