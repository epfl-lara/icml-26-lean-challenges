private theorem rooted_upper_pathSum_le_boundaryBudget_of_pair_reset_finRange_bound
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (t : BinaryTree)
    (K : ℝ) (hK : 0 ≤ K)
    (hpair :
      ∀ {m : Nat} (Z : Fin m → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin m, Z i ∈ t.toKeyList) →
        (Z avoids ![2, 3, 1]) →
        (∀ i : Fin m, Z i < q) →
        pivotResetPairPathSum Z q t (List.finRange m) ≤
          K * boundaryBudget Z t (List.finRange m) q)
    (htail_dom :
      ∀ (t' : BinaryTree) (i : Fin n) (xs : List (Fin n)),
        IsBST t' →
        rootKey t' = some q →
        Y i ∈ t'.toKeyList →
        Y i < q →
        (∀ j : Fin n, j ∈ xs → Y j ∈ t'.toKeyList) →
        (∀ j : Fin n, j ∈ xs → Y j ≤ q) →
        splayPathSum Y (splay t' (Y i)) xs ≤
          ((splay t' (Y i)).search_path_len q : ℝ) +
            suffixResetUpperPathSum Y q
              (splay (splay t' (Y i)) q) xs +
            xs.length)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem : ∀ i : Fin n, Y i ∈ t.toKeyList)
    (havoid : Y avoids ![2, 3, 1])
    (hle : ∀ i : Fin n, Y i ≤ q) :
    splayPathSum Y t (List.finRange n) ≤
      (K + 2) * boundaryBudget Y t (List.finRange n) q := by
  let xsStrict :=
    (List.finRange n).filter (fun i => decide (Y i < q))
  have hstrict_sub :
      xsStrict.Sublist (List.finRange n) := by
    unfold xsStrict
    exact List.filter_sublist
  have hpair_strict :
      pivotResetPairPathSum Y q t xsStrict ≤
        K * boundaryBudget Y t xsStrict q := by
    unfold xsStrict
    exact
      pivotResetPairPathSum_filter_finRange_le_of_finRange_bound
        K hK hpair Y q t
        (fun i : Fin n => decide (Y i < q))
        hbst hroot hmem havoid
        (by
          intro i hi
          simpa using (List.mem_filter.mp hi).2)
  have hbudget_strict :
      boundaryBudget Y t xsStrict q ≤
        boundaryBudget Y t (List.finRange n) q :=
    boundaryBudget_sublist_le Y t q hstrict_sub
  have hpair_full :
      pivotResetPairPathSum Y q t xsStrict ≤
        K * boundaryBudget Y t (List.finRange n) q := by
    have hmul :
        K * boundaryBudget Y t xsStrict q ≤
          K * boundaryBudget Y t (List.finRange n) q := by
      exact mul_le_mul_of_nonneg_left hbudget_strict hK
    exact le_trans hpair_strict hmul
  have hupper :=
    rooted_upper_pathSum_le_boundaryBudget_of_pair_bound_of_mem_tail
      Y q t K htail_dom hbst hroot hmem hle ?_
  · exact hupper
  · simpa [xsStrict] using hpair_full

private theorem rooted_upper_pathSum_le_boundaryBudget_of_lower_reset_finRange_bound
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (t : BinaryTree)
    (K : ℝ) (hK : 0 ≤ K)
    (hlower :
      ∀ {m : Nat} (Z : Fin m → Nat) (q : Nat) (t : BinaryTree),
