private theorem deleteMaxContextResult_num_nodes_add_one :
    ∀ (t : BinaryTree) (fs : List RightContextFrame),
      0 < t.num_nodes →
      (deleteMaxContextResult t fs).num_nodes + 1 =
        (attachRightFrames t fs).num_nodes
| .empty, fs, hpos => by
