            (List.finRange (N - (m.val + 1))) q := by
  obtain ⟨m, hmax, _hfirst, hpreAvoid, hsufAvoid, hpre_lt,
      hsuf_le, _hpre_suf, hpath⟩ :=
    exists_first_max_path_decomp hn Y havoid t
  have hm_eq : Y m = q :=
    first_max_eq_of_exists_value hmax hle hocc
  let tp := splayTreeAfter (prefixSeq Y m) t (List.finRange m.val)
  let ts := splay tp q
  refine ⟨m, hm_eq, ?_⟩
  have hpre_lt_q : ∀ i : Fin m.val, prefixSeq Y m i < q := by
    intro i
    simpa [hm_eq] using hpre_lt i
  have hprefix :
      splayPathSum (prefixSeq Y m) t (List.finRange m.val) +
          ((tp.search_path_len q : Nat) : ℝ) ≤
        Ks * boundaryBudget (prefixSeq Y m) t (List.finRange m.val) q := by
    have hpreFinal :=
      hstrict (prefixSeq Y m) q t hbst
        (rootKey_mem_toKeyList hroot) (prefixSeq_mem hmem m)
        hpreAvoid hpre_lt_q
    unfold tp
    simpa [splayPathSumWithFinal_eq_pathSum_add_final] using hpreFinal
  have htp_bst : IsBST tp := by
    unfold tp
    exact splayTreeAfter_isBST (prefixSeq Y m) (List.finRange m.val) t hbst
  have hq_mem_tp : q ∈ tp.toKeyList := by
    unfold tp
    rw [splayTreeAfter_toKeyList (prefixSeq Y m) (List.finRange m.val) t]
    rw [← hm_eq]
    exact hmem m
  have hts_bst : IsBST ts := by
    unfold ts
    exact splay_isBST tp q htp_bst
  have hroot_ts : rootKey ts = some q := by
    unfold ts
    exact splay_rootKey_eq_some_of_mem_isBST tp q htp_bst hq_mem_tp
  have hsuf_mem :
      ∀ i : Fin (N - (m.val + 1)),
        suffixSeq Y m i ∈ ts.toKeyList := by
    intro i
    unfold ts tp
    simpa [hm_eq] using suffixSeq_mem_after_prefix_pivot hmem m i
  have hsuf_le_q :
      ∀ i : Fin (N - (m.val + 1)), suffixSeq Y m i ≤ q := by
    intro i
    simpa [hm_eq] using hsuf_le i
  have hsuffix :
      splayPathSum (suffixSeq Y m) ts
          (List.finRange (N - (m.val + 1))) ≤
        Ku * boundaryBudget (suffixSeq Y m) ts
          (List.finRange (N - (m.val + 1))) q := by
    exact hupperIH (N - (m.val + 1)) (suffix_length_lt_of_fin m)
      (suffixSeq Y m) q ts hts_bst hroot_ts hsuf_mem
      hsufAvoid hsuf_le_q
  rw [hpath]
  rw [hm_eq]
  unfold tp at hprefix hsuffix
  unfold ts at hsuffix
  nlinarith

private theorem upper_block_bound_of_strict_and_upper_factor
    (Ks Ku : ℝ) (hKs : 0 ≤ Ks) (hKu : 0 ≤ Ku)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          Ks * boundaryBudget Y t (List.finRange N) q)
    {N : Nat}
    (hupperIH :
      ∀ k, k < N → ∀ (Y : Fin k → Nat) (q : Nat)
          (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin k, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin k, Y i ≤ q) →
        splayPathSum Y t (List.finRange k) ≤
          Ku * boundaryBudget Y t (List.finRange k) q)
    (Y : Fin N → Nat) (q : Nat) (t : BinaryTree)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem : ∀ i : Fin N, Y i ∈ t.toKeyList)
    (havoid : Y avoids ![2, 3, 1])
    (hle : ∀ i : Fin N, Y i ≤ q) :
    splayPathSum Y t (List.finRange N) ≤
      (Ks + Ku) * boundaryBudget Y t (List.finRange N) q := by
  let B := boundaryBudget Y t (List.finRange N) q
  have hB_nonneg : 0 ≤ B := by
    unfold B
    exact boundaryBudget_nonneg Y t (List.finRange N) q
  rcases Classical.em (∃ i : Fin N, Y i = q) with hocc_pos | hocc_neg
  · obtain ⟨i0, hi0⟩ := hocc_pos
    have hn : 0 < N := by
      exact Nat.pos_of_ne_zero (by
        intro hN
        exact Fin.elim0 (hN ▸ i0))
    obtain ⟨m, hm_eq, hpath⟩ :=
      upper_block_firstMax_repeat_path_bound_mixed
        Ks Ku hstrict hn hupperIH Y q t hbst hroot hmem havoid hle
        ⟨i0, hi0⟩
    have htake_sub :
        ((List.finRange N).take m.val).Sublist (List.finRange N) :=
      List.take_sublist _ _
    have hbudget_take :
        boundaryBudget Y t ((List.finRange N).take m.val) q ≤ B := by
      unfold B
      exact boundaryBudget_sublist_le Y t q htake_sub
    have hprefix_le :
        boundaryBudget (prefixSeq Y m) t (List.finRange m.val) q ≤ B := by
      rw [← hm_eq] at hbudget_take ⊢
      simpa [boundaryBudget_take_eq_prefixSeq Y t m] using hbudget_take
    have hsuffix_le :
        boundaryBudget (suffixSeq Y m)
            (splay
              (splayTreeAfter (prefixSeq Y m) t
                (List.finRange m.val))
              q)
            (List.finRange (N - (m.val + 1))) q ≤ B := by
      have hsuf :=
        boundaryBudget_suffixSeq_after_prefix_pivot_le_finRange
          (m := m) hbst hmem
      simpa [hm_eq, B] using hsuf
    have hprefix_mul :
        Ks * boundaryBudget (prefixSeq Y m) t (List.finRange m.val) q ≤
          Ks * B := by
      exact mul_le_mul_of_nonneg_left hprefix_le hKs
    have hsuffix_mul :
        Ku *
            boundaryBudget (suffixSeq Y m)
              (splay
                (splayTreeAfter (prefixSeq Y m) t
                  (List.finRange m.val))
                q)
              (List.finRange (N - (m.val + 1))) q ≤
          Ku * B := by
      exact mul_le_mul_of_nonneg_left hsuffix_le hKu
    calc
      splayPathSum Y t (List.finRange N)
          ≤
        Ks * boundaryBudget (prefixSeq Y m) t (List.finRange m.val) q +
          Ku *
            boundaryBudget (suffixSeq Y m)
              (splay
                (splayTreeAfter (prefixSeq Y m) t
                  (List.finRange m.val))
                q)
              (List.finRange (N - (m.val + 1))) q := hpath
      _ ≤ Ks * B + Ku * B := by nlinarith
      _ = (Ks + Ku) * B := by ring
  · have hstrict_case :=
      upper_block_bound_of_no_root_occurrence
        Ks hstrict Y q t hbst hroot hmem havoid hle hocc_neg
    calc
      splayPathSum Y t (List.finRange N) ≤ Ks * B := by
        simpa [B] using hstrict_case
      _ ≤ (Ks + Ku) * B := by nlinarith

private theorem upper_block_bound_of_strict_and_repeat_budget_split
    (K : ℝ) (hK : 0 ≤ K)
    (hstrict :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
        IsBST t →
        q ∈ t.toKeyList →
        (∀ i : Fin N, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin N, Y i < q) →
        splayPathSumWithFinal Y q t (List.finRange N) ≤
          K * boundaryBudget Y t (List.finRange N) q)
    {N : Nat}
    (hupperIH :
      ∀ k, k < N → ∀ (Y : Fin k → Nat) (q : Nat)
          (t : BinaryTree),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin k, Y i ∈ t.toKeyList) →
        (Y avoids ![2, 3, 1]) →
        (∀ i : Fin k, Y i ≤ q) →
        splayPathSum Y t (List.finRange k) ≤
          K * boundaryBudget Y t (List.finRange k) q)
    (Y : Fin N → Nat) (q : Nat) (t : BinaryTree)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem : ∀ i : Fin N, Y i ∈ t.toKeyList)
    (havoid : Y avoids ![2, 3, 1])
    (hle : ∀ i : Fin N, Y i ≤ q)
    (hbudget_split :
      ∀ m : Fin N, Y m = q →
        boundaryBudget (prefixSeq Y m) t (List.finRange m.val) q +
          boundaryBudget (suffixSeq Y m)
            (splay
              (splayTreeAfter (prefixSeq Y m) t
                (List.finRange m.val))
              q)
            (List.finRange (N - (m.val + 1))) q ≤
          boundaryBudget Y t (List.finRange N) q) :
    splayPathSum Y t (List.finRange N) ≤
      K * boundaryBudget Y t (List.finRange N) q := by
  rcases Classical.em (∃ i : Fin N, Y i = q) with hocc_pos | hocc_neg
  · obtain ⟨i0, hi0⟩ := hocc_pos
    have hn : 0 < N := by
      exact Nat.pos_of_ne_zero (by
        intro hN
        exact Fin.elim0 (hN ▸ i0))
    obtain ⟨m, hm_eq, hpath⟩ :=
      upper_block_firstMax_repeat_path_bound
        K hstrict hn hupperIH Y q t hbst hroot hmem havoid hle
        ⟨i0, hi0⟩
    have hsplit := hbudget_split m hm_eq
    have hmul :
        K *
            (boundaryBudget (prefixSeq Y m) t (List.finRange m.val) q +
              boundaryBudget (suffixSeq Y m)
                (splay
                  (splayTreeAfter (prefixSeq Y m) t
                    (List.finRange m.val))
                  q)
                (List.finRange (N - (m.val + 1))) q) ≤
          K * boundaryBudget Y t (List.finRange N) q := by
      exact mul_le_mul_of_nonneg_left hsplit hK
    calc
      splayPathSum Y t (List.finRange N)
          ≤
        K * boundaryBudget (prefixSeq Y m) t (List.finRange m.val) q +
          K *
            boundaryBudget (suffixSeq Y m)
              (splay
                (splayTreeAfter (prefixSeq Y m) t
                  (List.finRange m.val))
                q)
              (List.finRange (N - (m.val + 1))) q := hpath
      _ =
        K *
          (boundaryBudget (prefixSeq Y m) t (List.finRange m.val) q +
            boundaryBudget (suffixSeq Y m)
              (splay
                (splayTreeAfter (prefixSeq Y m) t
                  (List.finRange m.val))
                q)
              (List.finRange (N - (m.val + 1))) q) := by ring
      _ ≤ K * boundaryBudget Y t (List.finRange N) q := hmul
  · exact upper_block_bound_of_no_root_occurrence
      K hstrict Y q t hbst hroot hmem havoid hle hocc_neg

private theorem upper_block_bound_of_strict_factor_two
    (K : ℝ) (hK : 0 ≤ K)
    (hstrict :
