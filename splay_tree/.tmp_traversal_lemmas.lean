private theorem max_zero_sub_after_pivot_le_qpath_add_before
    {t reset : BinaryTree} {q x : Nat}
    (hbst : IsBST t)
    (hq_mem : q ∈ t.toKeyList)
    (hx_mem : x ∈ t.toKeyList) :
    max 0
        (((splay t q).search_path_len x : ℝ) -
          (reset.search_path_len x : ℝ)) ≤
      max 0
          (((t.search_path_len x : ℝ) -
            (reset.search_path_len x : ℝ))) +
        (t.search_path_len q : ℝ) := by
  have hpath_nat :
      (splay t q).search_path_len x ≤
        t.search_path_len q + t.search_path_len x :=
    search_path_len_after_splay_le_path_add_of_mem hbst hq_mem hx_mem
  have hpath :
      ((splay t q).search_path_len x : ℝ) ≤
        (t.search_path_len q : ℝ) + (t.search_path_len x : ℝ) := by
    exact_mod_cast hpath_nat
  have hq_nonneg : 0 ≤ (t.search_path_len q : ℝ) := by
    positivity
  apply max_le
  · nlinarith [le_max_left (0 : ℝ)
        (((t.search_path_len x : ℝ) - (reset.search_path_len x : ℝ)))]
  · have hbefore :
        ((t.search_path_len x : ℝ) - (reset.search_path_len x : ℝ)) ≤
          max 0
            (((t.search_path_len x : ℝ) - (reset.search_path_len x : ℝ))) :=
      le_max_right _ _
    linarith

private theorem actualResetDistinctGapMaxPotential_pivot_growth_le_qpath
    {n : Nat} (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi : X i = q)
    (hmem_future : ∀ j : Fin n, j ∈ future → X j ∈ init.toKeyList) :
    actualResetDistinctGapMaxPotential X q init (done ++ [i]) future ≤
      actualResetDistinctGapMaxPotential X q init done future +
        ((splayTreeAfter X init done).search_path_len q : ℝ) := by
  let actual := splayTreeAfter X init done
  let reset := suffixResetTreeAfter X q init done
  have hnot : ¬ X i < q := by
    rw [hi]
    omega
  have hactual_next :
      splayTreeAfter X init (done ++ [i]) = splay actual q := by
    unfold actual
    rw [splayTreeAfter_append]
    simp [splayTreeAfter, hi]
  have hreset_next :
      suffixResetTreeAfter X q init (done ++ [i]) = reset := by
    unfold reset
    exact suffixResetTreeAfter_append_singleton_not_lt X q done init i hnot
  have hbst_actual : IsBST actual := by
    unfold actual
    exact splayTreeAfter_isBST X done init hbst
  have hq_mem_actual : q ∈ actual.toKeyList := by
    unfold actual
    rw [splayTreeAfter_toKeyList]
    exact rootKey_mem_toKeyList hroot
  unfold actualResetDistinctGapMaxPotential
  let keys := futureLowerKeys X q future
  change
    keys.foldr
        (fun x acc =>
          max
            (max 0
              (((splayTreeAfter X init (done ++ [i])).search_path_len x : ℝ) -
                ((suffixResetTreeAfter X q init (done ++ [i])).search_path_len x : ℝ)))
            acc)
        0 ≤
      keys.foldr
          (fun x acc =>
            max
              (max 0
                (((splayTreeAfter X init done).search_path_len x : ℝ) -
                  ((suffixResetTreeAfter X q init done).search_path_len x : ℝ)))
              acc)
          0 +
        ((splayTreeAfter X init done).search_path_len q : ℝ)
  apply foldr_max_le_add_of_forall
  · positivity
  · intro x hx
    rcases (mem_futureLowerKeys_iff X q x future).mp hx with
      ⟨j, hj_future, hj_eq, _hj_lt⟩
    have hx_mem_actual : x ∈ actual.toKeyList := by
      unfold actual
      rw [splayTreeAfter_toKeyList]
      rw [← hj_eq]
      exact hmem_future j hj_future
    have hle :=
      max_zero_sub_after_pivot_le_qpath_add_before
        (t := actual) (reset := reset) (q := q) (x := x)
        hbst_actual hq_mem_actual hx_mem_actual
    simpa [actual, reset, hactual_next, hreset_next] using hle

private noncomputable def upperResetMaxQPotential {n : Nat}
