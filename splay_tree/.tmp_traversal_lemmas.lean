private theorem current_path_len_suffix_reset_length_le_one_add_one
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hle : ∀ j : Fin n, Y j ≤ q)
    (hmem_done : ∀ j : Fin n, j ∈ done → Y j ∈ init.toKeyList)
    (hi_mem : Y i ∈ (splayTreeAfter Y init done).toKeyList)
    (hi_lt : Y i < q)
    (hlen : done.length ≤ 1) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) ≤
      ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) + 1 := by
  cases done with
  | nil =>
      simp [splayTreeAfter, suffixResetTreeAfter]
  | cons j rest =>
      cases rest with
      | nil =>
          have hj_mem : Y j ∈ init.toKeyList := hmem_done j (by simp)
          have hi_mem_init : Y i ∈ init.toKeyList := by
            simpa [splayTreeAfter_toKeyList Y [j] init] using hi_mem
          have hq_mem : q ∈ init.toKeyList := rootKey_mem_toKeyList hroot
          by_cases hj_lt : Y j < q
          · by_cases hij : Y i ≤ Y j
            · have hpath_nat :
                  (splay init (Y j)).search_path_len (Y i) ≤
                    (splay (splay init (Y j)) q).search_path_len (Y i) + 1 :=
                lower_or_same_path_after_access_le_after_boundary_reset_add_one
                  hbst hj_mem hq_mem hi_mem_init hij hj_lt
              have hpath :
                  ((splay init (Y j)).search_path_len (Y i) : ℝ) ≤
                    ((splay (splay init (Y j)) q).search_path_len (Y i) : ℝ) + 1 := by
                exact_mod_cast hpath_nat
              simpa [splayTreeAfter, suffixResetTreeAfter, hj_lt] using hpath
            · have hji : Y j < Y i := by omega
              have hpath_nat :
                  (splay init (Y j)).search_path_len (Y i) ≤
                    (splay (splay init (Y j)) q).search_path_len (Y i) + 1 :=
                upper_path_after_lower_access_le_after_boundary_reset_add_one
                  hbst hroot hj_mem hi_mem_init hji hi_lt
              have hpath :
                  ((splay init (Y j)).search_path_len (Y i) : ℝ) ≤
                    ((splay (splay init (Y j)) q).search_path_len (Y i) : ℝ) + 1 := by
                exact_mod_cast hpath_nat
              simpa [splayTreeAfter, suffixResetTreeAfter, hj_lt] using hpath
          · have hj_le : Y j ≤ q := hle j
            have hj_eq : Y j = q := by omega
            have hsplay : splay init (Y j) = init := by
              rw [hj_eq]
              exact splay_eq_self_of_rootKey_eq_some hroot
            have hsplay_q : splay init q = init :=
              splay_eq_self_of_rootKey_eq_some hroot
            have hreset :
                suffixResetTreeAfter Y q init [j] = init := by
              have hj_not : ¬ Y j < q := hj_lt
              simpa using
                suffixResetTreeAfter_append_singleton_not_lt
                  Y q [] init j hj_not
            simp [splayTreeAfter, suffixResetTreeAfter, hj_eq, hsplay_q, hreset]
      | cons k rest =>
          simp at hlen

