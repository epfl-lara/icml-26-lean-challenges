private theorem min_mem_left_of_left_nonempty
    {ll lr r : BinaryTree} {lk k q : Nat}
    (hbst : IsBST (.node (.node ll lk lr) k r))
    (hmem : q ∈ (BinaryTree.node (.node ll lk lr) k r).toKeyList)
