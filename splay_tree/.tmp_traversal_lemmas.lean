    exact hq_mem
  have hmem_tail_tx :
      ∀ j : Fin N, j ∈ xs → Y j ∈ tx.toKeyList := by
    intro j hj
    unfold tx
    rw [splay_toKeyList]
    exact hmem_tail j hj
  have hafter :
      boundaryBudget Y tr xs q ≤ boundaryBudget Y tx xs q := by
    unfold tr
    exact boundaryBudget_after_splay_boundary_le
      Y xs q hbst_tx hq_mem_tx hmem_tail_tx
  have hafter' :
      boundaryBudget Y (splay (splay t (Y i)) q) xs q ≤
        boundaryBudget Y (splay t (Y i)) xs q := by
    simpa [tx, tr] using hafter
  nlinarith

private noncomputable def pivotResetBoundaryBudgetSum {n : Nat}
    (X : Fin n → Nat) (q : Nat) : BinaryTree → List (Fin n) → ℝ
| _t, [] => 0
| t, i :: xs =>
    boundaryBudget X t (i :: xs) q +
      pivotResetBoundaryBudgetSum X q (splay (splay t (X i)) q) xs

private theorem pivotResetBoundaryBudgetSum_nonneg {n : Nat}
    (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      0 ≤ pivotResetBoundaryBudgetSum X q t xs
| [], t => by
    simp [pivotResetBoundaryBudgetSum]
| i :: xs, t => by
    have ih :=
      pivotResetBoundaryBudgetSum_nonneg X q xs
        (splay (splay t (X i)) q)
    have hb := boundaryBudget_nonneg X t (i :: xs) q
    simp [pivotResetBoundaryBudgetSum]
    nlinarith

private theorem pivotResetPairPathSum_le_four_pivotResetBoundaryBudgetSum
    {n : Nat} (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t →
      q ∈ t.toKeyList →
      (∀ i : Fin n, i ∈ xs → X i ∈ t.toKeyList) →
      pivotResetPairPathSum X q t xs ≤
        4 * pivotResetBoundaryBudgetSum X q t xs
| [], t, _hbst, _hq_mem, _hmem => by
    simp [pivotResetPairPathSum, pivotResetBoundaryBudgetSum]
| i :: xs, t, hbst, hq_mem, hmem => by
    have hi_mem : X i ∈ t.toKeyList := hmem i (by simp)
    have hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList := by
      intro j hj
      exact hmem j (by simp [hj])
    let tr := splay (splay t (X i)) q
    have hhead :
        (t.search_path_len (X i) : ℝ) +
            ((splay t (X i)).search_path_len q : ℝ) ≤
          4 * boundaryBudget X t (i :: xs) q := by
      exact
        pivot_reset_pair_head_le_four_boundaryBudget_cons
          X i xs q hbst hi_mem hq_mem hmem_tail
    have hbst_tr : IsBST tr := by
      unfold tr
      exact splay_isBST (splay t (X i)) q
        (splay_isBST t (X i) hbst)
    have hq_mem_tr : q ∈ tr.toKeyList := by
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hq_mem
    have hmem_tail_tr :
        ∀ j : Fin n, j ∈ xs → X j ∈ tr.toKeyList := by
      intro j hj
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hmem_tail j hj
    have ih :=
      pivotResetPairPathSum_le_four_pivotResetBoundaryBudgetSum
        X q xs tr hbst_tr hq_mem_tr hmem_tail_tr
    simp [pivotResetPairPathSum, pivotResetBoundaryBudgetSum]
    nlinarith

private theorem pivotResetBoundaryBudgetSum_le_length_mul_boundaryBudget
    {n : Nat} (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t →
      q ∈ t.toKeyList →
      (∀ i : Fin n, i ∈ xs → X i ∈ t.toKeyList) →
      pivotResetBoundaryBudgetSum X q t xs ≤
        (xs.length : ℝ) * boundaryBudget X t xs q
| [], t, _hbst, _hq_mem, _hmem => by
    simp [pivotResetBoundaryBudgetSum]
| i :: xs, t, hbst, hq_mem, hmem => by
    have hi_mem : X i ∈ t.toKeyList := hmem i (by simp)
    have hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList := by
      intro j hj
      exact hmem j (by simp [hj])
    let tr := splay (splay t (X i)) q
    have hbst_tr : IsBST tr := by
      unfold tr
      exact splay_isBST (splay t (X i)) q
        (splay_isBST t (X i) hbst)
    have hq_mem_tr : q ∈ tr.toKeyList := by
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hq_mem
    have hmem_tail_tr :
        ∀ j : Fin n, j ∈ xs → X j ∈ tr.toKeyList := by
      intro j hj
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hmem_tail j hj
    have ih :=
      pivotResetBoundaryBudgetSum_le_length_mul_boundaryBudget
        X q xs tr hbst_tr hq_mem_tr hmem_tail_tr
    have hnext_budget :
        boundaryBudget X tr xs q ≤ boundaryBudget X t (i :: xs) q := by
      unfold tr
      exact boundaryBudget_after_pivot_reset_le_cons
        X i xs q hbst hi_mem hq_mem hmem_tail
    have hmul :
        (xs.length : ℝ) * boundaryBudget X tr xs q ≤
          (xs.length : ℝ) * boundaryBudget X t (i :: xs) q := by
      nlinarith [hnext_budget,
        show 0 ≤ (xs.length : ℝ) by positivity]
    simp [pivotResetBoundaryBudgetSum]
    nlinarith

private theorem pivotResetPairPathSum_le_four_length_mul_boundaryBudget
    {n : Nat} (X : Fin n → Nat) (q : Nat)
    (xs : List (Fin n)) (t : BinaryTree)
    (hbst : IsBST t)
    (hq_mem : q ∈ t.toKeyList)
    (hmem : ∀ i : Fin n, i ∈ xs → X i ∈ t.toKeyList) :
    pivotResetPairPathSum X q t xs ≤
      4 * ((xs.length : ℝ) * boundaryBudget X t xs q) := by
  have hpair :=
    pivotResetPairPathSum_le_four_pivotResetBoundaryBudgetSum
      X q xs t hbst hq_mem hmem
  have hsum :=
    pivotResetBoundaryBudgetSum_le_length_mul_boundaryBudget
      X q xs t hbst hq_mem hmem
  nlinarith

private theorem search_path_len_add_boundaryBudget_after_splay_le_two_boundaryBudget_cons
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n)) (q : Nat)
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hq_mem : q ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList) :
    (t.search_path_len (X i) : ℝ) +
        boundaryBudget X (splay t (X i)) xs q ≤
      2 * boundaryBudget X t (i :: xs) q := by
  have hpath :=
    search_path_len_real_le_boundaryBudget_of_mem
      X (i :: xs) q hbst (i := i) (by simp)
  have hbudget :=
    boundaryBudget_after_splay_le_cons
      X i xs q hbst hi_mem hq_mem hmem_tail
  nlinarith

private theorem boundaryHullKeys_map_comp {n m : Nat}
    (X : Fin n → Nat) (g : Fin m → Fin n)
    (t : BinaryTree) (xs : List (Fin m)) (q : Nat) :
    boundaryHullKeys X t (xs.map g) q =
      boundaryHullKeys (fun i : Fin m => X (g i)) t xs q := by
  unfold boundaryHullKeys
  apply List.filter_congr
  intro key _hkey
  let P :=
    key ∈ searchPathKeys t q ∨
      ∃ j : Fin n, j ∈ xs.map g ∧ key ∈ searchPathKeys t (X j)
  let Q :=
    key ∈ searchPathKeys t q ∨
      ∃ i : Fin m, i ∈ xs ∧
        key ∈ searchPathKeys t ((fun i : Fin m => X (g i)) i)
  have hiff : P ↔ Q := by
    constructor
    · intro hp
      rcases hp with hq | ⟨j, hj, hpath⟩
      · exact Or.inl hq
      · rcases List.mem_map.mp hj with ⟨i, hi, hgi⟩
        subst j
        exact Or.inr ⟨i, hi, hpath⟩
    · intro hq
      rcases hq with hpathq | ⟨i, hi, hpath⟩
      · exact Or.inl hpathq
      · exact Or.inr ⟨g i, List.mem_map.mpr ⟨i, hi, rfl⟩, hpath⟩
  change decide P = decide Q
  by_cases hp : P
  · have hq : Q := hiff.mp hp
    simp [hp, hq]
  · have hq : ¬ Q := by
      intro hq
      exact hp (hiff.mpr hq)
    simp [hp, hq]

private theorem boundaryHullSize_map_comp {n m : Nat}
    (X : Fin n → Nat) (g : Fin m → Fin n)
    (t : BinaryTree) (xs : List (Fin m)) (q : Nat) :
    boundaryHullSize X t (xs.map g) q =
      boundaryHullSize (fun i : Fin m => X (g i)) t xs q := by
  unfold boundaryHullSize
  rw [boundaryHullKeys_map_comp X g t xs q]

private theorem boundaryBudget_map_comp {n m : Nat}
    (X : Fin n → Nat) (g : Fin m → Fin n)
    (t : BinaryTree) (xs : List (Fin m)) (q : Nat) :
    boundaryBudget X t (xs.map g) q =
      boundaryBudget (fun i : Fin m => X (g i)) t xs q := by
  unfold boundaryBudget
  rw [List.length_map, boundaryHullSize_map_comp X g t xs q]

private def splayTreeAfter {n : Nat} (X : Fin n → Nat) :
    BinaryTree → List (Fin n) → BinaryTree
| t, [] => t
| t, i :: xs => splayTreeAfter X (splay t (X i)) xs

private theorem splayTreeAfter_append {n : Nat} (X : Fin n → Nat) :
    ∀ (xs ys : List (Fin n)) (t : BinaryTree),
      splayTreeAfter X t (xs ++ ys) =
        splayTreeAfter X (splayTreeAfter X t xs) ys
| [], ys, t => by
    simp [splayTreeAfter]
| i :: xs, ys, t => by
    simp [splayTreeAfter, splayTreeAfter_append X xs ys (splay t (X i))]

private theorem splayTreeAfter_map_comp {n m : Nat}
    (X : Fin n → Nat) (g : Fin m → Fin n) :
    ∀ (xs : List (Fin m)) (t : BinaryTree),
      splayTreeAfter X t (xs.map g) =
        splayTreeAfter (fun i : Fin m => X (g i)) t xs
| [], t => by
    simp [splayTreeAfter]
| i :: xs, t => by
    simp [splayTreeAfter,
      splayTreeAfter_map_comp X g xs (splay t (X (g i)))]

private theorem splayPathSum_append {n : Nat} (X : Fin n → Nat) :
    ∀ (xs ys : List (Fin n)) (t : BinaryTree),
      splayPathSum X t (xs ++ ys) =
        splayPathSum X t xs +
          splayPathSum X (splayTreeAfter X t xs) ys
| [], ys, t => by
    simp [splayPathSum, splayTreeAfter]
| i :: xs, ys, t => by
    simp [splayPathSum, splayTreeAfter,
      splayPathSum_append X xs ys (splay t (X i))]
    ring

private theorem splayTreeAfter_take_drop {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (p : Nat) :
    splayTreeAfter X t xs =
      splayTreeAfter X (splayTreeAfter X t (xs.take p)) (xs.drop p) := by
  calc
    splayTreeAfter X t xs =
        splayTreeAfter X t (xs.take p ++ xs.drop p) := by
      rw [List.take_append_drop p xs]
    _ = splayTreeAfter X (splayTreeAfter X t (xs.take p)) (xs.drop p) := by
      rw [splayTreeAfter_append]

private theorem splayPathSum_take_drop {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (xs : List (Fin n)) (p : Nat) :
    splayPathSum X t xs =
      splayPathSum X t (xs.take p) +
        splayPathSum X (splayTreeAfter X t (xs.take p)) (xs.drop p) := by
  calc
    splayPathSum X t xs =
        splayPathSum X t (xs.take p ++ xs.drop p) := by
      rw [List.take_append_drop p xs]
    _ = splayPathSum X t (xs.take p) +
        splayPathSum X (splayTreeAfter X t (xs.take p)) (xs.drop p) := by
      rw [splayPathSum_append]

private theorem splayPathSum_le_of_reachable_sourcePotential_step {n : Nat}
    (X : Fin n → Nat) (init : BinaryTree) (C : ℝ)
    (hstep :
      ∀ (done : List (Fin n)) (i : Fin n) (future : List (Fin n)),
        done ++ i :: future = List.finRange n →
        ((splayTreeAfter X init done).search_path_len (X i) : ℝ) +
            sourcePotential X
              (splay (splayTreeAfter X init done) (X i))
              (done ++ [i]) future ≤
          C + sourcePotential X
            (splayTreeAfter X init done) done (i :: future)) :
    ∀ (xs done : List (Fin n)),
      done ++ xs = List.finRange n →
      splayPathSum X (splayTreeAfter X init done) xs ≤
        C * (xs.length : ℝ) +
          sourcePotential X (splayTreeAfter X init done) done xs
| [], done, _hsplit => by
    simp [splayPathSum, sourcePotential_nil_future]
| i :: xs, done, hsplit => by
    have hnext_split : (done ++ [i]) ++ xs = List.finRange n := by
      simpa [List.append_assoc] using hsplit
    have htree :
        splayTreeAfter X init (done ++ [i]) =
          splay (splayTreeAfter X init done) (X i) := by
      rw [splayTreeAfter_append]
      simp [splayTreeAfter]
    have ih :=
      splayPathSum_le_of_reachable_sourcePotential_step
        X init C hstep xs (done ++ [i]) hnext_split
    rw [htree] at ih
    have hs := hstep done i xs hsplit
    simp only [splayPathSum, List.length_cons, Nat.cast_add, Nat.cast_one]
    nlinarith

private theorem splayPathSum_finRange_le_of_reachable_sourcePotential_step
    {n : Nat} (X : Fin n → Nat) (init : BinaryTree) (C : ℝ)
    (hstep :
      ∀ (done : List (Fin n)) (i : Fin n) (future : List (Fin n)),
        done ++ i :: future = List.finRange n →
        ((splayTreeAfter X init done).search_path_len (X i) : ℝ) +
            sourcePotential X
              (splay (splayTreeAfter X init done) (X i))
              (done ++ [i]) future ≤
          C + sourcePotential X
            (splayTreeAfter X init done) done (i :: future)) :
    splayPathSum X init (List.finRange n) ≤ C * (n : ℝ) := by
  have h :=
    splayPathSum_le_of_reachable_sourcePotential_step
      X init C hstep (List.finRange n) [] (by simp)
  rw [List.length_finRange] at h
  simpa [splayTreeAfter, sourcePotential_nil_done] using h

private theorem splayPathSum_add_finalPotential_le_of_reachable_potential_step
    {n : Nat} (X : Fin n → Nat) (init : BinaryTree)
    (Φ : BinaryTree → List (Fin n) → List (Fin n) → ℝ) (C : ℝ)
    (hstep :
      ∀ (done : List (Fin n)) (i : Fin n) (future : List (Fin n)),
        done ++ i :: future = List.finRange n →
        ((splayTreeAfter X init done).search_path_len (X i) : ℝ) +
            Φ (splay (splayTreeAfter X init done) (X i))
              (done ++ [i]) future ≤
          C + Φ (splayTreeAfter X init done) done (i :: future)) :
    ∀ (xs done : List (Fin n)),
      done ++ xs = List.finRange n →
      splayPathSum X (splayTreeAfter X init done) xs +
          Φ (splayTreeAfter X init (done ++ xs)) (done ++ xs) [] ≤
        C * (xs.length : ℝ) +
          Φ (splayTreeAfter X init done) done xs
| [], done, hsplit => by
    have hdone : done = List.finRange n := by
      simpa using hsplit
    subst done
    simp [splayPathSum]
| i :: xs, done, hsplit => by
    have hnext_split : (done ++ [i]) ++ xs = List.finRange n := by
      simpa [List.append_assoc] using hsplit
    have htree :
        splayTreeAfter X init (done ++ [i]) =
          splay (splayTreeAfter X init done) (X i) := by
      rw [splayTreeAfter_append]
      simp [splayTreeAfter]
    have ih :=
      splayPathSum_add_finalPotential_le_of_reachable_potential_step
        X init Φ C hstep xs (done ++ [i]) hnext_split
    rw [htree] at ih
    have hs := hstep done i xs hsplit
    have hdone_assoc :
        done ++ i :: xs = (done ++ [i]) ++ xs := by
      simp [List.append_assoc]
    simp only [splayPathSum, List.length_cons, Nat.cast_add, Nat.cast_one]
    rw [hdone_assoc]
    nlinarith

private theorem splayPathSum_finRange_le_of_reachable_potential_step_with_initial
    {n : Nat} (X : Fin n → Nat) (init : BinaryTree)
    (Φ : BinaryTree → List (Fin n) → List (Fin n) → ℝ)
    (C A : ℝ)
    (hstep :
      ∀ (done : List (Fin n)) (i : Fin n) (future : List (Fin n)),
        done ++ i :: future = List.finRange n →
        ((splayTreeAfter X init done).search_path_len (X i) : ℝ) +
            Φ (splay (splayTreeAfter X init done) (X i))
              (done ++ [i]) future ≤
          C + Φ (splayTreeAfter X init done) done (i :: future))
    (hinit : Φ init [] (List.finRange n) ≤ A * (n : ℝ))
    (hfinal_nonneg :
      0 ≤ Φ (splayTreeAfter X init (List.finRange n))
        (List.finRange n) []) :
    splayPathSum X init (List.finRange n) ≤ (C + A) * (n : ℝ) := by
  have h :=
    splayPathSum_add_finalPotential_le_of_reachable_potential_step
      X init Φ C hstep (List.finRange n) [] (by simp)
  have hmain :
      splayPathSum X init (List.finRange n) +
          Φ (splayTreeAfter X init (List.finRange n))
            (List.finRange n) [] ≤
        C * (n : ℝ) + Φ init [] (List.finRange n) := by
    simpa [splayTreeAfter, List.length_finRange] using h
  nlinarith [hmain, hinit, hfinal_nonneg]

private theorem splayPathSumWithFinal_eq_pathSum_add_final {n : Nat}
    (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      splayPathSumWithFinal X q t xs =
        splayPathSum X t xs +
          (splayTreeAfter X t xs).search_path_len q
| [], t => by
    simp [splayPathSumWithFinal, splayPathSum, splayTreeAfter]
| i :: xs, t => by
    simp [splayPathSumWithFinal, splayPathSum, splayTreeAfter,
      splayPathSumWithFinal_eq_pathSum_add_final X q xs
        (splay t (X i))]
    ring

private theorem splayPathSum_le_splayPathSumWithFinal {n : Nat}
    (X : Fin n → Nat) (q : Nat) (xs : List (Fin n))
    (t : BinaryTree) :
    splayPathSum X t xs ≤ splayPathSumWithFinal X q t xs := by
  rw [splayPathSumWithFinal_eq_pathSum_add_final X q xs t]
  have hfinal :
      0 ≤ ((splayTreeAfter X t xs).search_path_len q : ℝ) := by
    positivity
  nlinarith

private theorem splayPathSumWithFinal_append {n : Nat}
    (X : Fin n → Nat) (q : Nat) :
    ∀ (xs ys : List (Fin n)) (t : BinaryTree),
      splayPathSumWithFinal X q t (xs ++ ys) =
        splayPathSum X t xs +
          splayPathSumWithFinal X q
            (splayTreeAfter X t xs) ys
| [], ys, t => by
    simp [splayPathSum, splayTreeAfter]
| i :: xs, ys, t => by
    simp [splayPathSumWithFinal, splayPathSum, splayTreeAfter,
      splayPathSumWithFinal_append X q xs ys (splay t (X i))]
    ring

private theorem splayPathSumWithFinal_map_comp {n m : Nat}
    (X : Fin n → Nat) (g : Fin m → Fin n) (q : Nat) :
    ∀ (xs : List (Fin m)) (t : BinaryTree),
      splayPathSumWithFinal X q t (xs.map g) =
        splayPathSumWithFinal (fun i : Fin m => X (g i)) q t xs
| [], t => by
    simp [splayPathSumWithFinal]
| i :: xs, t => by
    simp [splayPathSumWithFinal,
      splayPathSumWithFinal_map_comp X g q xs
        (splay t (X (g i)))]

private theorem splayPathSumWithFinal_take_drop {n : Nat}
    (X : Fin n → Nat) (q : Nat) (t : BinaryTree)
    (xs : List (Fin n)) (p : Nat) :
    splayPathSumWithFinal X q t xs =
      splayPathSum X t (xs.take p) +
        splayPathSumWithFinal X q
          (splayTreeAfter X t (xs.take p)) (xs.drop p) := by
  calc
    splayPathSumWithFinal X q t xs =
        splayPathSumWithFinal X q t (xs.take p ++ xs.drop p) := by
      rw [List.take_append_drop p xs]
    _ =
      splayPathSum X t (xs.take p) +
        splayPathSumWithFinal X q
          (splayTreeAfter X t (xs.take p)) (xs.drop p) := by
      rw [splayPathSumWithFinal_append]

private theorem splayTreeAfter_singleton {n : Nat}
    (X : Fin n → Nat) (t : BinaryTree) (i : Fin n) :
    splayTreeAfter X t [i] = splay t (X i) := by
  simp [splayTreeAfter]

private theorem splayPathSum_split_singleton {n : Nat}
    (X : Fin n → Nat) :
    ∀ (xs ys : List (Fin n)) (t : BinaryTree) (i : Fin n),
      splayPathSum X t (xs ++ [i] ++ ys) =
        splayPathSum X t xs +
          ((splayTreeAfter X t xs).search_path_len (X i) +
            splayPathSum X
              (splay (splayTreeAfter X t xs) (X i)) ys)
| xs, ys, t, i => by
    rw [List.append_assoc]
    rw [splayPathSum_append X xs ([i] ++ ys) t]
    simp [splayPathSum]

private theorem splayTreeAfter_split_singleton {n : Nat}
    (X : Fin n → Nat) :
    ∀ (xs ys : List (Fin n)) (t : BinaryTree) (i : Fin n),
      splayTreeAfter X t (xs ++ [i] ++ ys) =
        splayTreeAfter X
          (splay (splayTreeAfter X t xs) (X i)) ys
| xs, ys, t, i => by
    rw [List.append_assoc]
    rw [splayTreeAfter_append X xs ([i] ++ ys) t]
    simp [splayTreeAfter]

private def tailSeq {n : Nat} (X : Fin (n + 1) → Nat) : Fin n → Nat :=
  fun i => X (Fin.succ i)

private theorem fold_splayStep_map_succ_tailSeq {n : Nat}
    (X : Fin (n + 1) → Nat) :
    ∀ (xs : List (Fin n)) (acc : BinaryTree × ℝ),
      (xs.map Fin.succ).foldl (splayStep X) acc =
        xs.foldl (splayStep (tailSeq X)) acc
| [], acc => by
    simp
| i :: xs, acc => by
    cases acc with
    | mk t c =>
        simp [splayStep, tailSeq,
          fold_splayStep_map_succ_tailSeq X xs
            (splay t (X (Fin.succ i)), c + splay.cost t (X (Fin.succ i)))]

private theorem fold_splayStep_cost_offset {n : Nat}
    (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree) (c0 d : ℝ),
      (xs.foldl (splayStep X) (t, c0 + d)).2 =
        d + (xs.foldl (splayStep X) (t, c0)).2
| [], t, c0, d => by
    simp
    ring
| i :: xs, t, c0, d => by
    dsimp [List.foldl, splayStep]
    have ih := fold_splayStep_cost_offset X xs
      (splay t (X i)) (c0 + splay.cost t (X i)) d
    simpa [add_assoc, add_comm, add_left_comm] using ih

private theorem sequence_cost_finRange_succ {n : Nat}
    (X : Fin (n + 1) → Nat) (init : BinaryTree) :
    splay.sequence_cost init X =
      splay.cost init (X 0) +
        splay.sequence_cost (splay init (X 0)) (tailSeq X) := by
  unfold splay.sequence_cost
  rw [List.finRange_succ]
  simp only [List.foldl]
  have hmap :=
    congrArg Prod.snd
      (fold_splayStep_map_succ_tailSeq X (List.finRange n)
        (splay init (X 0), 0 + splay.cost init (X 0)))
  have hoff :=
    fold_splayStep_cost_offset (tailSeq X) (List.finRange n)
      (splay init (X 0)) 0 (splay.cost init (X 0))
  exact (by
    simpa [splayStep, tailSeq, zero_add] using hmap.trans hoff)

private theorem splayPathSum_map_succ_tailSeq {n : Nat}
    (X : Fin (n + 1) → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      splayPathSum X t (xs.map Fin.succ) =
        splayPathSum (tailSeq X) t xs
| [], t => by
    simp [splayPathSum]
| i :: xs, t => by
    simp [splayPathSum, tailSeq,
      splayPathSum_map_succ_tailSeq X xs (splay t (X (Fin.succ i)))]

private theorem splayPathSum_map_comp {n m : Nat}
    (X : Fin n → Nat) (g : Fin m → Fin n) :
    ∀ (xs : List (Fin m)) (t : BinaryTree),
      splayPathSum X t (xs.map g) =
        splayPathSum (fun i : Fin m => X (g i)) t xs
| [], t => by
    simp [splayPathSum]
| i :: xs, t => by
    simp [splayPathSum,
      splayPathSum_map_comp X g xs (splay t (X (g i)))]

private theorem splayPathSum_finRange_succ {n : Nat}
    (X : Fin (n + 1) → Nat) (init : BinaryTree) :
    splayPathSum X init (List.finRange (n + 1)) =
      init.search_path_len (X 0) +
        splayPathSum (tailSeq X) (splay init (X 0)) (List.finRange n) := by
  rw [List.finRange_succ]
  simp [splayPathSum, splayPathSum_map_succ_tailSeq X]

private theorem pivotResetLowerPathSum_map_succ_tailSeq {n : Nat}
    (X : Fin (n + 1) → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      pivotResetLowerPathSum X q t (xs.map Fin.succ) =
        pivotResetLowerPathSum (tailSeq X) q t xs
| [], t => by
    simp [pivotResetLowerPathSum]
| i :: xs, t => by
    simp [pivotResetLowerPathSum, tailSeq,
      pivotResetLowerPathSum_map_succ_tailSeq X q xs
        (splay (splay t (X (Fin.succ i))) q)]

private theorem pivotResetTreeAfter_map_succ_tailSeq {n : Nat}
    (X : Fin (n + 1) → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      pivotResetTreeAfter X q t (xs.map Fin.succ) =
        pivotResetTreeAfter (tailSeq X) q t xs
| [], t => by
    simp [pivotResetTreeAfter]
| i :: xs, t => by
    simp [pivotResetTreeAfter, tailSeq,
      pivotResetTreeAfter_map_succ_tailSeq X q xs
        (splay (splay t (X (Fin.succ i))) q)]

private theorem pivotResetPairPathSum_map_succ_tailSeq {n : Nat}
    (X : Fin (n + 1) → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      pivotResetPairPathSum X q t (xs.map Fin.succ) =
        pivotResetPairPathSum (tailSeq X) q t xs
| [], t => by
    simp [pivotResetPairPathSum]
| i :: xs, t => by
    simp [pivotResetPairPathSum, tailSeq,
      pivotResetPairPathSum_map_succ_tailSeq X q xs
        (splay (splay t (X (Fin.succ i))) q)]

private theorem boundaryBudget_map_succ_tailSeq {n : Nat}
    (X : Fin (n + 1) → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      boundaryBudget X t (xs.map Fin.succ) q =
        boundaryBudget (tailSeq X) t xs q
| xs, t => by
    unfold tailSeq
    simpa using
      boundaryBudget_map_comp X Fin.succ t xs q

private theorem pivotResetLowerPathSum_finRange_succ {n : Nat}
    (X : Fin (n + 1) → Nat) (q : Nat) (t : BinaryTree) :
    pivotResetLowerPathSum X q t (List.finRange (n + 1)) =
      (t.search_path_len (X 0) : ℝ) +
        pivotResetLowerPathSum (tailSeq X) q
          (splay (splay t (X 0)) q) (List.finRange n) := by
  rw [List.finRange_succ]
  simp [pivotResetLowerPathSum, pivotResetLowerPathSum_map_succ_tailSeq X q]

private theorem pivotResetTreeAfter_finRange_succ {n : Nat}
    (X : Fin (n + 1) → Nat) (q : Nat) (t : BinaryTree) :
    pivotResetTreeAfter X q t (List.finRange (n + 1)) =
      pivotResetTreeAfter (tailSeq X) q
        (splay (splay t (X 0)) q) (List.finRange n) := by
  rw [List.finRange_succ]
  simp [pivotResetTreeAfter, pivotResetTreeAfter_map_succ_tailSeq X q]

private theorem pivotResetPairPathSum_finRange_succ {n : Nat}
    (X : Fin (n + 1) → Nat) (q : Nat) (t : BinaryTree) :
    pivotResetPairPathSum X q t (List.finRange (n + 1)) =
      (t.search_path_len (X 0) : ℝ) +
        ((splay t (X 0)).search_path_len q : ℝ) +
        pivotResetPairPathSum (tailSeq X) q
          (splay (splay t (X 0)) q) (List.finRange n) := by
  rw [List.finRange_succ]
  simp [pivotResetPairPathSum, pivotResetPairPathSum_map_succ_tailSeq X q]

private theorem splayTreeAfter_num_nodes {n : Nat} (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      (splayTreeAfter X t xs).num_nodes = t.num_nodes
| [], t => by
    simp [splayTreeAfter]
| i :: xs, t => by
    simp [splayTreeAfter, splayTreeAfter_num_nodes X xs (splay t (X i)),
      splay_num_nodes]

private theorem splayPathSumWithFinal_le_pathSum_add_num_nodes {n : Nat}
    (X : Fin n → Nat) (q : Nat)
    (xs : List (Fin n)) (t : BinaryTree) :
    splayPathSumWithFinal X q t xs ≤
      splayPathSum X t xs + t.num_nodes := by
  rw [splayPathSumWithFinal_eq_pathSum_add_final X q xs t]
  have hpath :=
    search_path_len_le_num_nodes (splayTreeAfter X t xs) q
  have hnodes :=
    splayTreeAfter_num_nodes X xs t
  have hpathR :
      ((splayTreeAfter X t xs).search_path_len q : ℝ) ≤
        t.num_nodes := by
    rw [hnodes] at hpath
    exact_mod_cast hpath
  nlinarith

private theorem splayTreeAfter_toKeyList {n : Nat} (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      (splayTreeAfter X t xs).toKeyList = t.toKeyList
| [], t => by
    simp [splayTreeAfter]
| i :: xs, t => by
    simp [splayTreeAfter, splayTreeAfter_toKeyList X xs (splay t (X i)),
      splay_toKeyList]

private theorem splayTreeAfter_isBST {n : Nat} (X : Fin n → Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t → IsBST (splayTreeAfter X t xs)
| [], t, hbst => by
    simpa [splayTreeAfter] using hbst
| i :: xs, t, hbst => by
    simp [splayTreeAfter]
    exact splayTreeAfter_isBST X xs (splay t (X i))
      (splay_isBST t (X i) hbst)

private theorem splayTreeAfter_append_singleton {n : Nat}
    (X : Fin n → Nat) (xs : List (Fin n)) (t : BinaryTree) (i : Fin n) :
    splayTreeAfter X t (xs ++ [i]) =
      splay (splayTreeAfter X t xs) (X i) := by
  rw [splayTreeAfter_append]
  simp [splayTreeAfter]

private theorem splayTreeAfter_rootKey_append_singleton_of_mem
    {n : Nat} (X : Fin n → Nat) (xs : List (Fin n))
    (t : BinaryTree) (i : Fin n)
    (hbst : IsBST t) (hmem : X i ∈ t.toKeyList) :
    rootKey (splayTreeAfter X t (xs ++ [i])) = some (X i) := by
  rw [splayTreeAfter_append_singleton]
  exact
    splay_rootKey_eq_some_of_mem_isBST
      (splayTreeAfter X t xs) (X i)
      (splayTreeAfter_isBST X xs t hbst)
      (by
        rw [splayTreeAfter_toKeyList]
        exact hmem)

private theorem exists_rootKey_splayTreeAfter_nonempty_le
    {n : Nat} (X : Fin n → Nat) (lo : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t →
      (∀ i : Fin n, i ∈ xs → X i ∈ t.toKeyList) →
      (∀ i : Fin n, i ∈ xs → X i ≤ lo) →
      xs ≠ [] →
      ∃ r : Nat, rootKey (splayTreeAfter X t xs) = some r ∧ r ≤ lo
| [], t, _hbst, _hmem, _hle, hne => by
    exact False.elim (hne rfl)
| i :: xs, t, hbst, hmem, hle, _hne => by
    cases xs with
    | nil =>
        have hi_mem : X i ∈ t.toKeyList := hmem i (by simp)
        have hi_le : X i ≤ lo := hle i (by simp)
        refine ⟨X i, ?_, hi_le⟩
        simpa [splayTreeAfter] using
          splay_rootKey_eq_some_of_mem_isBST t (X i) hbst hi_mem
    | cons j rest =>
        have hi_mem : X i ∈ t.toKeyList := hmem i (by simp)
        have hbst' : IsBST (splay t (X i)) :=
          splay_isBST t (X i) hbst
        have hmem_tail :
            ∀ a : Fin n, a ∈ j :: rest →
              X a ∈ (splay t (X i)).toKeyList := by
          intro a ha
          rw [splay_toKeyList]
          exact hmem a (by simp [ha])
        have hle_tail :
            ∀ a : Fin n, a ∈ j :: rest → X a ≤ lo := by
          intro a ha
          exact hle a (by simp [ha])
        have htail :=
          exists_rootKey_splayTreeAfter_nonempty_le
            X lo (j :: rest) (splay t (X i)) hbst'
            hmem_tail hle_tail (by simp)
        simpa [splayTreeAfter] using htail

private theorem exists_rootKey_splayTreeAfter_done_le_current
    {n : Nat} (Y : Fin n → Nat) (init : BinaryTree)
    (done : List (Fin n)) (i : Fin n)
    (hbst : IsBST init)
    (hmem_done : ∀ j : Fin n, j ∈ done → Y j ∈ init.toKeyList)
    (hall_le : ∀ j : Fin n, j ∈ done → Y j ≤ Y i)
    (hne : done ≠ []) :
    ∃ r : Nat,
      rootKey (splayTreeAfter Y init done) = some r ∧ r ≤ Y i := by
  exact
    exists_rootKey_splayTreeAfter_nonempty_le
      Y (Y i) done init hbst hmem_done hall_le hne

private def suffixResetTreeAfter {n : Nat} (X : Fin n → Nat) (q : Nat) :
    BinaryTree → List (Fin n) → BinaryTree
| t, [] => t
| t, i :: xs =>
    if X i < q then
      suffixResetTreeAfter X q (splay (splay t (X i)) q) xs
    else
      suffixResetTreeAfter X q t xs

private theorem suffixResetTreeAfter_append {n : Nat}
    (X : Fin n → Nat) (q : Nat) :
    ∀ (xs ys : List (Fin n)) (t : BinaryTree),
      suffixResetTreeAfter X q t (xs ++ ys) =
        suffixResetTreeAfter X q
          (suffixResetTreeAfter X q t xs) ys
| [], ys, t => by
    simp [suffixResetTreeAfter]
| i :: xs, ys, t => by
    by_cases hi : X i < q
    · simp [suffixResetTreeAfter, hi,
        suffixResetTreeAfter_append X q xs ys
          (splay (splay t (X i)) q)]
    · simp [suffixResetTreeAfter, hi,
        suffixResetTreeAfter_append X q xs ys t]

private theorem suffixResetTreeAfter_toKeyList {n : Nat}
    (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      (suffixResetTreeAfter X q t xs).toKeyList = t.toKeyList
| [], t => by
    simp [suffixResetTreeAfter]
| i :: xs, t => by
    by_cases hi : X i < q
    · simp [suffixResetTreeAfter, hi,
        suffixResetTreeAfter_toKeyList X q xs
          (splay (splay t (X i)) q), splay_toKeyList]
    · simp [suffixResetTreeAfter, hi,
        suffixResetTreeAfter_toKeyList X q xs t]

private theorem suffixResetTreeAfter_isBST {n : Nat}
    (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t → IsBST (suffixResetTreeAfter X q t xs)
| [], t, hbst => by
    simpa [suffixResetTreeAfter] using hbst
| i :: xs, t, hbst => by
    by_cases hi : X i < q
    · simp [suffixResetTreeAfter, hi]
      exact suffixResetTreeAfter_isBST X q xs
        (splay (splay t (X i)) q)
        (splay_isBST (splay t (X i)) q
          (splay_isBST t (X i) hbst))
    · simp [suffixResetTreeAfter, hi]
      exact suffixResetTreeAfter_isBST X q xs t hbst

private theorem suffixResetTreeAfter_rootKey {n : Nat}
    (X : Fin n → Nat) (q : Nat) :
    ∀ (xs : List (Fin n)) (t : BinaryTree),
      IsBST t →
      rootKey t = some q →
      rootKey (suffixResetTreeAfter X q t xs) = some q
| [], t, _hbst, hroot => by
    simpa [suffixResetTreeAfter] using hroot
| i :: xs, t, hbst, hroot => by
    by_cases hi : X i < q
    · let tr := splay (splay t (X i)) q
      have hbst_tr : IsBST tr := by
        unfold tr
        exact splay_isBST (splay t (X i)) q
          (splay_isBST t (X i) hbst)
      have hroot_tr : rootKey tr = some q := by
        unfold tr
        exact rootKey_after_pivot_reset_of_root hbst hroot
      simpa [suffixResetTreeAfter, hi, tr] using
        suffixResetTreeAfter_rootKey X q xs tr hbst_tr hroot_tr
    · simpa [suffixResetTreeAfter, hi] using
        suffixResetTreeAfter_rootKey X q xs t hbst hroot

private theorem suffixResetTreeAfter_append_singleton_lt {n : Nat}
    (X : Fin n → Nat) (q : Nat) (done : List (Fin n))
    (t : BinaryTree) (i : Fin n) (hi : X i < q) :
    suffixResetTreeAfter X q t (done ++ [i]) =
      splay (splay (suffixResetTreeAfter X q t done) (X i)) q := by
  rw [suffixResetTreeAfter_append]
  simp [suffixResetTreeAfter, hi]

private theorem suffixResetTreeAfter_append_singleton_not_lt {n : Nat}
    (X : Fin n → Nat) (q : Nat) (done : List (Fin n))
    (t : BinaryTree) (i : Fin n) (hi : ¬ X i < q) :
    suffixResetTreeAfter X q t (done ++ [i]) =
      suffixResetTreeAfter X q t done := by
  rw [suffixResetTreeAfter_append]
  simp [suffixResetTreeAfter, hi]

private theorem post_lower_pair_head_le_add_two_of_pathKey_union_inter_budget
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i j : Fin n)
    (hbst : IsBST init)
    (hbudget :
      ((searchPathKeys (splayTreeAfter Y init (done ++ [i]))
          (Y j)).toFinset ∪
          (searchPathKeys
            (splay (splayTreeAfter Y init (done ++ [i])) (Y j))
            q).toFinset).card +
        ((searchPathKeys (splayTreeAfter Y init (done ++ [i]))
          (Y j)).toFinset ∩
          (searchPathKeys
            (splay (splayTreeAfter Y init (done ++ [i])) (Y j))
            q).toFinset).card ≤
          (searchPathKeys (splayTreeAfter Y init (done ++ [i]))
            q).toFinset.card +
            (searchPathKeys
              (suffixResetTreeAfter Y q init (done ++ [i]))
              (Y j)).toFinset.card +
            (searchPathKeys
              (splay (suffixResetTreeAfter Y q init (done ++ [i]))
                (Y j))
              q).toFinset.card + 2) :
    ((splayTreeAfter Y init (done ++ [i])).search_path_len
        (Y j) : ℝ) +
        ((splay (splayTreeAfter Y init (done ++ [i]))
          (Y j)).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init (done ++ [i])).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init
          (done ++ [i])).search_path_len (Y j) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init
          (done ++ [i])) (Y j)).search_path_len q : ℝ) + 2 := by
  exact
    reset_pair_slack_two_of_pathKey_union_inter_budget
      (actual := splayTreeAfter Y init (done ++ [i]))
      (reset := suffixResetTreeAfter Y q init (done ++ [i]))
      (q := q) (x := Y j)
      (splayTreeAfter_isBST Y (done ++ [i]) init hbst)
      (suffixResetTreeAfter_isBST Y q (done ++ [i]) init hbst)
      hbudget

private noncomputable def resetPathGapPotential {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) : ℝ :=
  future.foldr
    (fun i acc =>
      max 0
        (((suffixResetTreeAfter X q init done).search_path_len (X i) : ℝ) -
          ((splayTreeAfter X init done).search_path_len (X i) : ℝ)) + acc)
    0

private theorem resetPathGapPotential_nonneg {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) :
    0 ≤ resetPathGapPotential X q init done future := by
  unfold resetPathGapPotential
  induction future with
  | nil =>
      simp
  | cons i xs ih =>
      simp only [List.foldr_cons]
      exact add_nonneg (le_max_left _ _) ih

private theorem resetPathGapPotential_initial_eq_zero {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (future : List (Fin n)) :
    resetPathGapPotential X q init [] future = 0 := by
  unfold resetPathGapPotential
  induction future with
  | nil =>
      simp
  | cons i xs ih =>
      simp [splayTreeAfter, suffixResetTreeAfter, ih]

private noncomputable def actualResetGapPotential {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) : ℝ :=
  future.foldr
    (fun i acc =>
      if X i < q then
        max 0
          (((splayTreeAfter X init done).search_path_len (X i) : ℝ) -
            ((suffixResetTreeAfter X q init done).search_path_len (X i) : ℝ)) +
            acc
      else acc)
    0

private theorem actualResetGapPotential_nonneg {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) :
    0 ≤ actualResetGapPotential X q init done future := by
  unfold actualResetGapPotential
  induction future with
  | nil =>
      simp
  | cons i xs ih =>
      simp only [List.foldr_cons]
      by_cases hi : X i < q
      · simp [hi, add_nonneg (le_max_left _ _) ih]
      · simpa [hi] using ih

private theorem actualResetGapPotential_initial_eq_zero {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (future : List (Fin n)) :
    actualResetGapPotential X q init [] future = 0 := by
  unfold actualResetGapPotential
  induction future with
  | nil =>
      simp
  | cons i xs ih =>
      by_cases hi : X i < q
      · simp [hi, splayTreeAfter, suffixResetTreeAfter, ih]
      · simp [hi, ih]

private noncomputable def upperActualPotential {n : Nat}
    (A G : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) : ℝ :=
  A * boundaryBudget X (splayTreeAfter X init done) future q +
    G * actualResetGapPotential X q init done future

private theorem upperActualPotential_nonneg {n : Nat}
    (A G : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (hA : 0 ≤ A) (hG : 0 ≤ G) :
    0 ≤ upperActualPotential A G X q init done future := by
  unfold upperActualPotential
  have hb :
      0 ≤ boundaryBudget X (splayTreeAfter X init done) future q :=
    boundaryBudget_nonneg X (splayTreeAfter X init done) future q
  have hg :
      0 ≤ actualResetGapPotential X q init done future :=
    actualResetGapPotential_nonneg X q init done future
  nlinarith [mul_nonneg hA hb, mul_nonneg hG hg]

private theorem upperActualPotential_initial_le {n : Nat}
    (A G : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (future : List (Fin n)) :
    upperActualPotential A G X q init [] future ≤
      A * boundaryBudget X init future q := by
  unfold upperActualPotential
  rw [actualResetGapPotential_initial_eq_zero]
  simp [splayTreeAfter]

private noncomputable def futureLowerKeys {n : Nat}
    (X : Fin n → Nat) (q : Nat) (future : List (Fin n)) : List Nat :=
  (((future.filter (fun i => decide (X i < q))).map X).toFinset.toList)

private theorem futureLowerKeys_nodup {n : Nat}
    (X : Fin n → Nat) (q : Nat) (future : List (Fin n)) :
    (futureLowerKeys X q future).Nodup := by
  unfold futureLowerKeys
  exact Finset.nodup_toList _

private theorem mem_futureLowerKeys_iff {n : Nat}
    (X : Fin n → Nat) (q x : Nat) (future : List (Fin n)) :
    x ∈ futureLowerKeys X q future ↔
      ∃ i : Fin n, i ∈ future ∧ X i = x ∧ X i < q := by
  unfold futureLowerKeys
  constructor
  · intro hx
    have hx_map :
        x ∈ (future.filter (fun i => decide (X i < q))).map X := by
      have hx_fin :
          x ∈ ((future.filter (fun i => decide (X i < q))).map X).toFinset := by
        exact (Finset.mem_toList.mp hx)
      exact (List.mem_toFinset.mp hx_fin)
    rcases List.mem_map.mp hx_map with ⟨i, hi_filter, hix⟩
    have hi := List.mem_filter.mp hi_filter
    exact ⟨i, hi.1, hix, by simpa using hi.2⟩
  · rintro ⟨i, hi_future, hix, hi_lt⟩
    apply Finset.mem_toList.mpr
    apply List.mem_toFinset.mpr
    apply List.mem_map.mpr
    refine ⟨i, ?_, hix⟩
    exact List.mem_filter.mpr ⟨hi_future, by simpa using hi_lt⟩

private theorem futureLowerKeys_cons_not_lt {n : Nat}
    (X : Fin n → Nat) (q : Nat) (i : Fin n)
    (future : List (Fin n)) (hi : ¬ X i < q) :
    futureLowerKeys X q (i :: future) = futureLowerKeys X q future := by
  unfold futureLowerKeys
  simp [hi]

private noncomputable def actualResetDistinctGapPotential {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) : ℝ :=
  (futureLowerKeys X q future).foldr
    (fun x acc =>
      max 0
        (((splayTreeAfter X init done).search_path_len x : ℝ) -
          ((suffixResetTreeAfter X q init done).search_path_len x : ℝ)) + acc)
    0

private theorem actualResetDistinctGapPotential_cons_not_lt {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) (hi : ¬ X i < q) :
    actualResetDistinctGapPotential X q init done (i :: future) =
      actualResetDistinctGapPotential X q init done future := by
  unfold actualResetDistinctGapPotential
  rw [futureLowerKeys_cons_not_lt X q i future hi]

private theorem actualResetDistinctGapPotential_cons_pivot_eq {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) (hi : X i = q) :
    actualResetDistinctGapPotential X q init done (i :: future) =
      actualResetDistinctGapPotential X q init done future := by
  apply actualResetDistinctGapPotential_cons_not_lt
  rw [hi]
  omega

private theorem actualResetDistinctGapPotential_nonneg {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) :
    0 ≤ actualResetDistinctGapPotential X q init done future := by
  unfold actualResetDistinctGapPotential
  let keys := futureLowerKeys X q future
  change
    0 ≤ keys.foldr
      (fun x acc =>
        max 0
          (((splayTreeAfter X init done).search_path_len x : ℝ) -
            ((suffixResetTreeAfter X q init done).search_path_len x : ℝ)) + acc)
      0
  induction keys with
  | nil =>
      simp
  | cons x xs ih =>
      simp only [List.foldr_cons]
      exact add_nonneg (le_max_left _ _) ih

private theorem actualResetDistinctGapPotential_initial_eq_zero {n : Nat}
