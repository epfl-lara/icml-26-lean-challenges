    (hpres_lt :
      ∀ (actual reset : BinaryTree) (x : Nat),
        resetPairDominatesAbove q (Y i) D actual reset →
        x ∈ actual.toKeyList →
        x < q →
        resetPairDominatesAbove q (Y i) D
          (splay actual x) (splay (splay reset x) q))
    (hlast_pivot :
      ∀ (left : List (Fin n)) (p : Fin n) (right : List (Fin n)),
        done = left ++ p :: right →
        Y p = q →
        (∀ c : Fin right.length, Y (right.get c) < q) →
        (∀ a : Fin left.length,
          Y (left.get a) < q → Y (left.get a) ≤ Y i) →
        (∀ a : Fin left.length, ∀ c : Fin right.length,
          Y (left.get a) < q → Y (left.get a) ≤ Y (right.get c)) →
        splayTreeAfter Y init done =
          splayTreeAfter Y
            (splay (splayTreeAfter Y init left) q) right →
        suffixResetTreeAfter Y q init done =
          suffixResetTreeAfter Y q
            (suffixResetTreeAfter Y q init left) right →
        resetPairDominatesAbove q (Y i) D
          (splayTreeAfter Y init done)
          (suffixResetTreeAfter Y q init done)) :
    resetPairDominatesAbove q (Y i) D
      (splayTreeAfter Y init done)
      (suffixResetTreeAfter Y q init done) := by
  exact
    resetPairDominatesAbove_threshold_of_last_pivot_split
      Y q D init done i future hbst hroot havoid hle hsub
      (fun hall_strict =>
        resetPairDominatesAbove_after_strict_prefix_of_preservation
          Y q (Y i) D hD hpres_lt init done hbst hroot
