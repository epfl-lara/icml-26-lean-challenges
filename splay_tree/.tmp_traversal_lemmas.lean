          boundaryBudget (strictLowerSuffixSeq X m) ts
            (List.finRange (strictLowerSuffixIndices X m).length) (X m) := by
    exact
      pivotResetPairPathSum_le_boundaryBudget_of_weighted_step_of_lt
        (strictLowerSuffixSeq X m) (X m) A C hA hC
        (fun t i xs hbst_t hroot_t hi_mem hi_lt hmem_tail hlt_tail =>
          hstep (strictLowerSuffixSeq X m) (X m) t i xs
            hbst_t hroot_t hi_mem hi_lt hmem_tail hlt_tail)
        (List.finRange (strictLowerSuffixIndices X m).length) ts
