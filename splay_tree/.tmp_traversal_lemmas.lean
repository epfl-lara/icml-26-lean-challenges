  | h n ih =>
      intro X havoid init hbst hmem
      by_cases hn : n ≤ 2
      · exact hsmall n hn X havoid init hbst hmem
      · have hn2 : 2 < n := Nat.lt_of_not_ge hn
        exact hstep n hn2 ih X havoid init hbst hmem

