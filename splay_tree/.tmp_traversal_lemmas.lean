        Y j < q →
        resetPairDominatesAbove q (Y i) D
          (splayTreeAfter Y init pre)
          (suffixResetTreeAfter Y q init pre) →
        Y j ∈ (splayTreeAfter Y init pre).toKeyList →
        resetPairDominatesAbove q (Y i) D
          (splay (splayTreeAfter Y init pre) (Y j))
          (splay (splay (suffixResetTreeAfter Y q init pre) (Y j)) q))
    (hbase :
      ∀ (left : List (Fin n)) (p : Fin n) (right : List (Fin n)),
        done = left ++ p :: right →
        Y p = q →
        (∀ c : Fin right.length, Y (right.get c) < q) →
        (∀ a : Fin left.length,
          Y (left.get a) < q → Y (left.get a) ≤ Y i) →
        (∀ a : Fin left.length, ∀ c : Fin right.length,
          Y (left.get a) < q → Y (left.get a) ≤ Y (right.get c)) →
        resetPairDominatesAbove q (Y i) D
          (splay (splayTreeAfter Y init left) q)
          (suffixResetTreeAfter Y q init left)) :
    resetPairDominatesAbove q (Y i) D
      (splayTreeAfter Y init done)
      (suffixResetTreeAfter Y q init done) := by
