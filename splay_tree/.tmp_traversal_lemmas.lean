private theorem resetPairDominatesAbove_ordered_pivot_prefix_of_low_final
    {n : Nat} (Y : Fin n → Nat) (q lo : Nat) (D : ℝ)
    (hD : 0 ≤ D)
    (hlow_final :
      ∀ (actual reset : BinaryTree) (xs : List (Fin n)),
        resetPairDominatesAbove q lo D actual reset →
        rootKey actual = some q →
        (∀ j : Fin n, j ∈ xs → Y j ∈ actual.toKeyList) →
        (∀ j : Fin n, j ∈ xs → Y j ≤ lo) →
        resetPairDominatesAbove q lo D
          (splay (splayTreeAfter Y actual xs) q)
          (suffixResetTreeAfter Y q reset xs))
    (init : BinaryTree) (left : List (Fin n))
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hmem_left : ∀ j : Fin n, j ∈ left → Y j ∈ init.toKeyList)
    (hle_left : ∀ j : Fin n, j ∈ left → Y j ≤ q)
    (hlow_left :
      ∀ j : Fin n, j ∈ left → Y j < q → Y j ≤ lo) :
    resetPairDominatesAbove q lo D
      (splay (splayTreeAfter Y init left) q)
      (suffixResetTreeAfter Y q init left) := by
  classical
  let P : Nat → Prop := fun m =>
    ∀ (left : List (Fin n)),
      left.length = m →
      ∀ (init : BinaryTree),
        IsBST init →
        rootKey init = some q →
        (∀ j : Fin n, j ∈ left → Y j ∈ init.toKeyList) →
        (∀ j : Fin n, j ∈ left → Y j ≤ q) →
        (∀ j : Fin n, j ∈ left → Y j < q → Y j ≤ lo) →
        resetPairDominatesAbove q lo D
          (splay (splayTreeAfter Y init left) q)
          (suffixResetTreeAfter Y q init left)
  have hmain : ∀ m : Nat, P m := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
        intro left hlen init hbst hroot hmem hle hlow
        by_cases hpivot : ∃ p : Fin n, p ∈ left ∧ Y p = q
        · obtain ⟨pre, p, post, hsplit, hp_eq, hpost_ne⟩ :=
            exists_last_pivot_split Y q left hpivot
          have hpre_len : pre.length < m := by
            rw [← hlen, hsplit]
            simp
          have hmem_pre :
              ∀ j : Fin n, j ∈ pre → Y j ∈ init.toKeyList := by
            intro j hj
            exact hmem j (by rw [hsplit]; simp [hj])
          have hle_pre :
              ∀ j : Fin n, j ∈ pre → Y j ≤ q := by
            intro j hj
            exact hle j (by rw [hsplit]; simp [hj])
          have hlow_pre :
              ∀ j : Fin n, j ∈ pre → Y j < q → Y j ≤ lo := by
            intro j hj hj_lt
            exact hlow j (by rw [hsplit]; simp [hj]) hj_lt
          have hdom_pre :
              resetPairDominatesAbove q lo D
                (splay (splayTreeAfter Y init pre) q)
                (suffixResetTreeAfter Y q init pre) :=
            ih pre.length hpre_len pre rfl init hbst hroot
              hmem_pre hle_pre hlow_pre
          let actual0 : BinaryTree := splay (splayTreeAfter Y init pre) q
          let reset0 : BinaryTree := suffixResetTreeAfter Y q init pre
          have hroot_actual0 : rootKey actual0 = some q := by
            unfold actual0
            have hbst_pre : IsBST (splayTreeAfter Y init pre) :=
              splayTreeAfter_isBST Y pre init hbst
            have hq_mem_pre : q ∈ (splayTreeAfter Y init pre).toKeyList := by
              rw [splayTreeAfter_toKeyList]
              exact rootKey_mem_toKeyList hroot
            exact
              splay_rootKey_eq_some_of_mem_isBST
                (splayTreeAfter Y init pre) q hbst_pre hq_mem_pre
          have hmem_post :
              ∀ j : Fin n, j ∈ post → Y j ∈ actual0.toKeyList := by
            intro j hj
            have hj_init : Y j ∈ init.toKeyList := by
              exact hmem j (by rw [hsplit]; simp [hj])
            unfold actual0
            rw [splay_toKeyList, splayTreeAfter_toKeyList]
            exact hj_init
          have hpost_le_lo :
              ∀ j : Fin n, j ∈ post → Y j ≤ lo := by
            intro j hj
            have hj_left : j ∈ left := by
              rw [hsplit]
              simp [hj]
            have hj_ne : Y j ≠ q := hpost_ne j hj
            have hj_lt : Y j < q := lt_of_le_of_ne (hle j hj_left) hj_ne
            exact hlow j (by rw [hsplit]; simp [hj]) hj_lt
          have hdom_post :
              resetPairDominatesAbove q lo D
                (splay (splayTreeAfter Y actual0 post) q)
                (suffixResetTreeAfter Y q reset0 post) :=
            hlow_final actual0 reset0 post hdom_pre hroot_actual0
              hmem_post hpost_le_lo
          have hactual :
              splay (splayTreeAfter Y init left) q =
                splay (splayTreeAfter Y actual0 post) q := by
            rw [hsplit]
            unfold actual0
            rw [splayTreeAfter_split_pivot_eq_root Y q pre post init p hp_eq]
          have hreset :
              suffixResetTreeAfter Y q init left =
                suffixResetTreeAfter Y q reset0 post := by
            rw [hsplit]
            unfold reset0
            exact suffixResetTreeAfter_split_pivot_eq Y q pre post init p hp_eq
          simpa [hactual, hreset] using hdom_post
        · have hle_lo :
              ∀ j : Fin n, j ∈ left → Y j ≤ lo := by
            intro j hj
            have hj_ne : Y j ≠ q := by
              intro hj_eq
              exact hpivot ⟨j, hj, hj_eq⟩
            have hj_lt : Y j < q := lt_of_le_of_ne (hle j hj) hj_ne
            exact hlow j hj hj_lt
          have hdom0 :
              resetPairDominatesAbove q lo D init init :=
            resetPairDominatesAbove_refl_root q lo D init hD hbst hroot
          exact hlow_final init init left hdom0 hroot hmem hle_lo
  exact hmain left.length left rfl init hbst hroot
    hmem_left hle_left hlow_left

