private theorem post_lower_pair_head_append_eq_target
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i j : Fin n)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hmem_i : Y i ∈ init.toKeyList)
    (hmem_j : Y j ∈ init.toKeyList)
    (hij : Y i = Y j) :
    ((splayTreeAfter Y init (done ++ [i])).search_path_len (Y j) : ℝ) +
        ((splay (splayTreeAfter Y init (done ++ [i]))
          (Y j)).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init (done ++ [i])).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init
          (done ++ [i])).search_path_len (Y j) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init
          (done ++ [i])) (Y j)).search_path_len q : ℝ) := by
  have hactual_next :
      splayTreeAfter Y init (done ++ [i]) =
        splay (splayTreeAfter Y init done) (Y i) := by
    rw [splayTreeAfter_append_singleton]
  have hbst_done : IsBST (splayTreeAfter Y init done) :=
    splayTreeAfter_isBST Y done init hbst
  have hi_mem_done : Y i ∈ (splayTreeAfter Y init done).toKeyList := by
    rw [splayTreeAfter_toKeyList]
    exact hmem_i
  have hroot_next :
      rootKey (splayTreeAfter Y init (done ++ [i])) = some (Y j) := by
    rw [hactual_next, hij]
    exact
      splay_rootKey_eq_some_of_mem_isBST
        (splayTreeAfter Y init done) (Y j) hbst_done
        (by simpa [hij] using hi_mem_done)
  have htarget_path :
      (splayTreeAfter Y init (done ++ [i])).search_path_len (Y j) = 1 :=
    search_path_len_eq_one_of_rootKey_eq_some hroot_next
  have hsplay_target :
      splay (splayTreeAfter Y init (done ++ [i])) (Y j) =
        splayTreeAfter Y init (done ++ [i]) :=
    splay_eq_self_of_rootKey_eq_some hroot_next
  have hj_mem_reset :
      Y j ∈ (suffixResetTreeAfter Y q init (done ++ [i])).toKeyList := by
    rw [suffixResetTreeAfter_toKeyList]
    exact hmem_j
  have hreset_pos :
      0 < (suffixResetTreeAfter Y q init (done ++ [i])).search_path_len
        (Y j) :=
    search_path_len_pos_of_mem
      (suffixResetTreeAfter Y q init (done ++ [i])) (Y j)
      hj_mem_reset
  have hreset_pos_real :
      (1 : ℝ) ≤
        ((suffixResetTreeAfter Y q init (done ++ [i])).search_path_len
          (Y j) : ℝ) := by
    exact_mod_cast hreset_pos
  have hreset_splay_nonneg :
      (0 : ℝ) ≤
        ((splay (suffixResetTreeAfter Y q init (done ++ [i]))
          (Y j)).search_path_len q : ℝ) := by
    exact_mod_cast
      (Nat.zero_le
        ((splay (suffixResetTreeAfter Y q init (done ++ [i]))
          (Y j)).search_path_len q))
  rw [htarget_path, hsplay_target]
  norm_num
  nlinarith

