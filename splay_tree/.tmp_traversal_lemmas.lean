      isBST_of_isBST_attachRightFrames (.node l k .empty) fs hbst
    have hmax_base :
        ∀ y : Nat, y ∈ (BinaryTree.node l k .empty).toKeyList → y ≤ q := by
      intro y hy
      exact hmax y (mem_toKeyList_attachRightFrames_of_mem
        (.node l k .empty) fs hy)
    have hq : q = k :=
      max_eq_root_of_right_empty hbst_base hmem hmax_base
    subst q
    have hframes :
        frameKeysBelow k fs :=
      frameKeysBelow_of_isBST_attachRightFrames_mem
        (.node l k .empty) fs k hbst
        (by simp [BinaryTree.toKeyList])
    simpa [splayMaxUnwindResult] using
      leftSubtree_splay_attachRightFrames_right_empty_eq l k fs hframes
| .node l k (.node rl rk .empty), fs, q, hbst, hmem, hmax => by
    have hbst_base :
        IsBST (.node l k (.node rl rk .empty)) :=
      isBST_of_isBST_attachRightFrames
        (.node l k (.node rl rk .empty)) fs hbst
    have hmax_base :
        ∀ y : Nat,
          y ∈ (BinaryTree.node l k (.node rl rk .empty)).toKeyList →
            y ≤ q := by
      intro y hy
      exact hmax y (mem_toKeyList_attachRightFrames_of_mem
        (.node l k (.node rl rk .empty)) fs hy)
    have hq : q = rk :=
      max_eq_right_root_of_right_right_empty hbst_base hmem hmax_base
    subst q
    have hbst_context :
        IsBST (attachRightFrames (.node rl rk .empty) ((k, l) :: fs)) := by
      simpa [attachRightFrames] using hbst
    have hframes :
        frameKeysBelow rk ((k, l) :: fs) :=
      frameKeysBelow_of_isBST_attachRightFrames_mem
        (.node rl rk .empty) ((k, l) :: fs) rk hbst_context
        (by simp [BinaryTree.toKeyList])
    have hroot :=
      leftSubtree_splay_attachRightFrames_right_empty_eq
        rl rk ((k, l) :: fs) hframes
    simpa [attachRightFrames, splayMaxUnwindResult] using hroot
| .node l k (.node rl rk (.node a x b)), fs, q, hbst, hmem, hmax => by
    rcases zagzag_context_max_state hbst hmem hmax with
      ⟨hbst_inner, hmem_inner, hmax_inner⟩
    have ih :=
      leftSubtree_splay_attachRightFrames_max_eq_unwind
        (.node a x b) ((rk, rl) :: (k, l) :: fs) q
        hbst_inner hmem_inner hmax_inner
    simpa [attachRightFrames, splayMaxUnwindResult] using ih

private theorem rightSubtree_splay_min_eq_unwind
    (t : BinaryTree) (q : Nat)
    (hbst : IsBST t) (hmem : q ∈ t.toKeyList)
    (hmin : ∀ y : Nat, y ∈ t.toKeyList → q ≤ y) :
    rightSubtree (splay t q) = splayMinUnwindResult t [] := by
  simpa [attachLeftFrames] using
    rightSubtree_splay_attachLeftFrames_min_eq_unwind
      t [] q (by simpa [attachLeftFrames] using hbst) hmem
