                        rightEdges] at hinner ⊢
                      ring_nf at hinner ⊢
                      nlinarith
          | node srl srk srr =>
              cases lr with
              | empty =>
                  cases r with
                  | empty =>
                      simp [rightSubtree, strongSequentialPotential, leftEdges,
                        rightEdges] at hinner ⊢
                      ring_nf at hinner ⊢
                      nlinarith
                  | node rl rk rr =>
