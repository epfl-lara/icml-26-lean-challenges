private theorem exists_last_pred_split {α : Type} (P : α → Prop)
    [DecidablePred P] :
    ∀ xs : List α,
      (∃ x : α, x ∈ xs ∧ P x) →
        ∃ left : List α, ∃ p : α, ∃ right : List α,
          xs = left ++ p :: right ∧ P p ∧
            ∀ x : α, x ∈ right → ¬ P x
| [], h => by
    rcases h with ⟨x, hx, _⟩
    simp at hx
| x :: xs, h => by
    by_cases htail : ∃ y : α, y ∈ xs ∧ P y
    · obtain ⟨left, p, right, hsplit, hp, hright⟩ :=
        exists_last_pred_split P xs htail
      refine ⟨x :: left, p, right, ?_, hp, hright⟩
      simp [hsplit]
    · have hxP : P x := by
        rcases h with ⟨y, hy, hyP⟩
        simp at hy
        rcases hy with hyx | hyxs
        · simpa [hyx] using hyP
        · exact False.elim (htail ⟨y, hyxs, hyP⟩)
      refine ⟨[], x, xs, by simp, hxP, ?_⟩
      intro y hy hyP
      exact htail ⟨y, hy, hyP⟩

private theorem exists_first_pred_split {α : Type} (P : α → Prop)
    [DecidablePred P] :
    ∀ xs : List α,
      (∃ x : α, x ∈ xs ∧ P x) →
        ∃ left : List α, ∃ p : α, ∃ right : List α,
          xs = left ++ p :: right ∧ P p ∧
            ∀ x : α, x ∈ left → ¬ P x
| [], h => by
    rcases h with ⟨x, hx, _⟩
    simp at hx
| x :: xs, h => by
    by_cases hxP : P x
    · refine ⟨[], x, xs, by simp, hxP, ?_⟩
      intro y hy
      simp at hy
    · have htail : ∃ y : α, y ∈ xs ∧ P y := by
        rcases h with ⟨y, hy, hyP⟩
        simp at hy
        rcases hy with hyx | hyxs
        · subst y
          exact False.elim (hxP hyP)
        · exact ⟨y, hyxs, hyP⟩
      obtain ⟨left, p, right, hsplit, hp, hleft⟩ :=
        exists_first_pred_split P xs htail
      refine ⟨x :: left, p, right, ?_, hp, ?_⟩
      · simp [hsplit]
      · intro y hy
        simp at hy
        rcases hy with hyx | hyleft
        · subst y
          exact hxP
        · exact hleft y hyleft

private theorem exists_first_done_gt_current_split_with_barriers
    {n : Nat} {Y : Fin n → Nat}
    {done future : List (Fin n)} {i : Fin n}
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1])
    (hgt : ∃ p : Fin n, p ∈ done ∧ Y i < Y p) :
    ∃ left : List (Fin n), ∃ p : Fin n, ∃ right : List (Fin n),
      done = left ++ p :: right ∧
        Y i < Y p ∧
        (∀ a : Fin left.length, Y (left.get a) ≤ Y i) ∧
        (∀ c : Fin right.length,
          Y i < Y (right.get c) → Y (right.get c) ≤ Y p) := by
  classical
  obtain ⟨left, p, right, hsplit, hp_gt, hleft_not⟩ :=
    exists_first_pred_split (fun p : Fin n => Y i < Y p) done hgt
  subst done
  refine ⟨left, p, right, rfl, hp_gt, ?_, ?_⟩
  · intro a
    have hleft_mem : left.get a ∈ left :=
      List.getElem_mem a.isLt
    have hnot := hleft_not (left.get a) hleft_mem
    exact Nat.le_of_not_gt hnot
  · intro c hc_gt
    let done' : List (Fin n) := left ++ p :: right
    let ia : Fin done'.length := ⟨left.length, by
      simp [done']⟩
    let ib : Fin done'.length := ⟨left.length + 1 + c.val, by
      have hc : c.val < right.length := c.isLt
      simp [done']
      omega⟩
    have hiaib : ia < ib := by
      change left.length < left.length + 1 + c.val
      omega
    have hget_a : done'.get ia = p := by
      simp [done', ia]
    have hget_b : done'.get ib = right.get c := by
      rcases c with ⟨cv, hcv⟩
      simp [done', ib, Nat.add_assoc]
      have hs : cv + 1 < (p :: right).length := by
        simpa [Nat.add_comm] using Nat.succ_lt_succ hcv
      simpa [Nat.add_comm] using (List.getElem_cons_succ p right cv hs)
    have hcurrent_lt_done_a : Y i < Y (done'.get ia) := by
      rw [hget_a]
      exact hp_gt
    have hle :=
      done_later_le_earlier_of_current_lt_earlier_avoids231
        (Y := Y) (done := done') (future := future) (i := i)
        hsub havoid hiaib hcurrent_lt_done_a
    rw [hget_a, hget_b] at hle
    exact hle

