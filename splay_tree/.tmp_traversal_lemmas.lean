private theorem prefix_pair_bound_of_current_path_len_bound
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi_mem : Y i ∈ (splayTreeAfter Y init done).toKeyList)
    (hi_lt : Y i < q)
    (hpath :
      ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) ≤
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) + D) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
        ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init done).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
        D := by
  rcases reachable_actual_reset_state Y q init done hbst hroot with
    ⟨hbst_actual, hbst_reset, hroot_reset, hkeys⟩
  have hq_path_nat :
      (splay (splayTreeAfter Y init done) (Y i)).search_path_len q ≤
        (splayTreeAfter Y init done).search_path_len q +
          (splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q :=
    search_path_len_after_lower_access_le_actual_boundary_add_reset_access
      hbst_actual hbst_reset hroot_reset hkeys hi_mem hi_lt
  have hq_path :
      ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) ≤
        ((splayTreeAfter Y init done).search_path_len q : ℝ) +
          ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) := by
    exact_mod_cast hq_path_nat
  nlinarith

private theorem prefix_pair_bound_of_gapMax_head
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi_mem : Y i ∈ (splayTreeAfter Y init done).toKeyList)
    (hi_lt : Y i < q) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
        ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init done).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
        actualResetDistinctGapMaxPotential Y q init done (i :: future) := by
  let gap :=
    actualResetDistinctGapMaxPotential Y q init done (i :: future)
  have hgap_head :
      max 0
          (((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) -
            ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ)) ≤
        gap := by
    unfold gap
    exact
      actualResetDistinctGapMaxPotential_ge_head
        Y q init done future i hi_lt
  have hdiff_le :
      ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) -
          ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) ≤
        gap := by
    exact le_trans (le_max_right _ _) hgap_head
  have hpath :
      ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) ≤
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
          gap := by
    linarith
  exact
    prefix_pair_bound_of_current_path_len_bound
      Y q gap init done i hbst hroot hi_mem hi_lt hpath

private theorem upperResetMaxQPotential_lower_step_of_gapMax_drop
    {n : Nat} (A G H D : ℝ) (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi_mem : Y i ∈ (splayTreeAfter Y init done).toKeyList)
    (hi_lt : Y i < q)
    (hdrop :
      actualResetDistinctGapMaxPotential Y q init done (i :: future) +
          upperResetMaxQPotential A G H Y q init (done ++ [i]) future ≤
        D + upperResetMaxQPotential A G H Y q init done (i :: future)) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
        ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) +
        upperResetMaxQPotential A G H Y q init (done ++ [i]) future ≤
      ((splayTreeAfter Y init done).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
        D + upperResetMaxQPotential A G H Y q init done (i :: future) := by
  have hpair :=
    prefix_pair_bound_of_gapMax_head
      Y q init done i future hbst hroot hi_mem hi_lt
  nlinarith

private theorem upperResetMaxQPotential_gapMax_drop_of_local_bound
    {n : Nat} (A G H D : ℝ) (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hA : 0 ≤ A)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi_mem : Y i ∈ (splayTreeAfter Y init done).toKeyList)
    (hi_lt : Y i < q)
    (hmem_future : ∀ j : Fin n, j ∈ future → Y j ∈ init.toKeyList)
    (hlocal :
      actualResetDistinctGapMaxPotential Y q init done (i :: future) +
          G * actualResetDistinctGapMaxPotential Y q init (done ++ [i]) future +
          H * ((splayTreeAfter Y init (done ++ [i])).search_path_len q : ℝ) ≤
        D +
          G * actualResetDistinctGapMaxPotential Y q init done (i :: future) +
          H * ((splayTreeAfter Y init done).search_path_len q : ℝ) + A) :
    actualResetDistinctGapMaxPotential Y q init done (i :: future) +
        upperResetMaxQPotential A G H Y q init (done ++ [i]) future ≤
      D + upperResetMaxQPotential A G H Y q init done (i :: future) := by
  have hreset_next :
      suffixResetTreeAfter Y q init (done ++ [i]) =
        splay (splay (suffixResetTreeAfter Y q init done) (Y i)) q :=
    suffixResetTreeAfter_append_singleton_lt Y q done init i hi_lt
  have hactual_next :
      splayTreeAfter Y init (done ++ [i]) =
        splay (splayTreeAfter Y init done) (Y i) := by
    rw [splayTreeAfter_append]
    simp [splayTreeAfter]
  have hbst_reset : IsBST (suffixResetTreeAfter Y q init done) :=
    suffixResetTreeAfter_isBST Y q done init hbst
  have hq_mem_reset : q ∈ (suffixResetTreeAfter Y q init done).toKeyList := by
    have hroot_reset :=
      suffixResetTreeAfter_rootKey Y q done init hbst hroot
    exact rootKey_mem_toKeyList hroot_reset
  have hi_mem_reset :
      Y i ∈ (suffixResetTreeAfter Y q init done).toKeyList := by
    rw [suffixResetTreeAfter_toKeyList]
    rw [splayTreeAfter_toKeyList] at hi_mem
    exact hi_mem
  have hmem_future_reset :
      ∀ j : Fin n, j ∈ future →
        Y j ∈ (suffixResetTreeAfter Y q init done).toKeyList := by
    intro j hj
    rw [suffixResetTreeAfter_toKeyList]
    exact hmem_future j hj
  have hbudget :=
    boundaryBudget_after_pivot_reset_add_one_le_cons
      Y i future q hbst_reset hi_mem_reset hq_mem_reset
      hmem_future_reset
  have hbudgetR :
      A * boundaryBudget Y (suffixResetTreeAfter Y q init (done ++ [i]))
            future q ≤
        A * boundaryBudget Y (suffixResetTreeAfter Y q init done)
            (i :: future) q - A := by
    rw [hreset_next]
    have hbudget' :
        boundaryBudget Y
              (splay (splay (suffixResetTreeAfter Y q init done) (Y i)) q)
              future q ≤
          boundaryBudget Y (suffixResetTreeAfter Y q init done)
              (i :: future) q - 1 := by
      linarith
    have hmul :=
      mul_le_mul_of_nonneg_left hbudget' hA
    linarith
  unfold upperResetMaxQPotential
  nlinarith

private theorem qpath_after_lower_access_le_add_two_reachable
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi_mem : Y i ∈ (splayTreeAfter Y init done).toKeyList)
    (hi_lt : Y i < q) :
    ((splayTreeAfter Y init (done ++ [i])).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init done).search_path_len q : ℝ) + 2 := by
  have hactual_next :
      splayTreeAfter Y init (done ++ [i]) =
        splay (splayTreeAfter Y init done) (Y i) := by
    rw [splayTreeAfter_append]
    simp [splayTreeAfter]
  have hbst_actual : IsBST (splayTreeAfter Y init done) :=
    splayTreeAfter_isBST Y done init hbst
  have hq_mem_actual :
      q ∈ (splayTreeAfter Y init done).toKeyList := by
    rw [splayTreeAfter_toKeyList]
    exact rootKey_mem_toKeyList hroot
  have hpath_nat :
      (splay (splayTreeAfter Y init done) (Y i)).search_path_len q ≤
        (splayTreeAfter Y init done).search_path_len q + 2 :=
    search_path_len_after_splay_lower_le_add_two_strong
      hbst_actual hi_mem hq_mem_actual hi_lt
  rw [hactual_next]
  exact_mod_cast hpath_nat

private noncomputable def actualResetFirstLowerGapPotential {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done : List (Fin n)) : List (Fin n) → ℝ
| [] => 0
| i :: future =>
    if X i < q then
      max 0
        (((splayTreeAfter X init done).search_path_len (X i) : ℝ) -
          ((suffixResetTreeAfter X q init done).search_path_len (X i) : ℝ))
    else
      actualResetFirstLowerGapPotential X q init done future

private theorem actualResetFirstLowerGapPotential_nil {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done : List (Fin n)) :
    actualResetFirstLowerGapPotential X q init done [] = 0 := by
  rfl

private theorem actualResetFirstLowerGapPotential_cons_lt {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) (hi : X i < q) :
    actualResetFirstLowerGapPotential X q init done (i :: future) =
      max 0
        (((splayTreeAfter X init done).search_path_len (X i) : ℝ) -
          ((suffixResetTreeAfter X q init done).search_path_len (X i) : ℝ)) := by
  simp [actualResetFirstLowerGapPotential, hi]

private theorem actualResetFirstLowerGapPotential_cons_not_lt {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) (hi : ¬ X i < q) :
    actualResetFirstLowerGapPotential X q init done (i :: future) =
      actualResetFirstLowerGapPotential X q init done future := by
  simp [actualResetFirstLowerGapPotential, hi]

private theorem actualResetFirstLowerGapPotential_cons_pivot_eq {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) (hi : X i = q) :
    actualResetFirstLowerGapPotential X q init done (i :: future) =
      actualResetFirstLowerGapPotential X q init done future := by
  apply actualResetFirstLowerGapPotential_cons_not_lt
  rw [hi]
  omega

private theorem actualResetFirstLowerGapPotential_nonneg {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) :
    0 ≤ actualResetFirstLowerGapPotential X q init done future := by
  induction future with
  | nil =>
      simp [actualResetFirstLowerGapPotential]
  | cons i future ih =>
      by_cases hi : X i < q
      · simp [actualResetFirstLowerGapPotential, hi]
      · simpa [actualResetFirstLowerGapPotential, hi] using ih

private theorem actualResetFirstLowerGapPotential_initial_eq_zero {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (future : List (Fin n)) :
    actualResetFirstLowerGapPotential X q init [] future = 0 := by
  induction future with
  | nil =>
      simp [actualResetFirstLowerGapPotential]
  | cons i future ih =>
      by_cases hi : X i < q
      · simp [actualResetFirstLowerGapPotential, hi, splayTreeAfter,
          suffixResetTreeAfter]
      · simpa [actualResetFirstLowerGapPotential, hi] using ih

private theorem actualResetFirstLowerGapPotential_ge_head {n : Nat}
    (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) (hi : X i < q) :
    max 0
        (((splayTreeAfter X init done).search_path_len (X i) : ℝ) -
          ((suffixResetTreeAfter X q init done).search_path_len (X i) : ℝ)) ≤
      actualResetFirstLowerGapPotential X q init done (i :: future) := by
  rw [actualResetFirstLowerGapPotential_cons_lt X q init done future i hi]

private theorem actualResetFirstLowerGapPotential_pivot_growth_le_qpath
    {n : Nat} (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi : X i = q)
    (hmem_future : ∀ j : Fin n, j ∈ future → X j ∈ init.toKeyList) :
    actualResetFirstLowerGapPotential X q init (done ++ [i]) future ≤
      actualResetFirstLowerGapPotential X q init done future +
        ((splayTreeAfter X init done).search_path_len q : ℝ) := by
  induction future with
  | nil =>
      simp [actualResetFirstLowerGapPotential]
  | cons j future ih =>
      by_cases hj : X j < q
      · let actual := splayTreeAfter X init done
        let reset := suffixResetTreeAfter X q init done
        have hnot : ¬ X i < q := by
          rw [hi]
          omega
        have hactual_next :
            splayTreeAfter X init (done ++ [i]) = splay actual q := by
          unfold actual
          rw [splayTreeAfter_append]
          simp [splayTreeAfter, hi]
        have hreset_next :
            suffixResetTreeAfter X q init (done ++ [i]) = reset := by
          unfold reset
          exact suffixResetTreeAfter_append_singleton_not_lt
            X q done init i hnot
        have hbst_actual : IsBST actual := by
          unfold actual
          exact splayTreeAfter_isBST X done init hbst
        have hq_mem_actual : q ∈ actual.toKeyList := by
          unfold actual
          rw [splayTreeAfter_toKeyList]
          exact rootKey_mem_toKeyList hroot
        have hx_mem_actual : X j ∈ actual.toKeyList := by
          unfold actual
          rw [splayTreeAfter_toKeyList]
          exact hmem_future j (by simp)
        have hle :=
          max_zero_sub_after_pivot_le_qpath_add_before
            (t := actual) (reset := reset) (q := q) (x := X j)
            hbst_actual hq_mem_actual hx_mem_actual
        simpa [actualResetFirstLowerGapPotential, hj, actual, reset,
          hactual_next, hreset_next] using hle
      · have htail_mem :
            ∀ k : Fin n, k ∈ future → X k ∈ init.toKeyList := by
          intro k hk
          exact hmem_future k (by simp [hk])
        have ih' := ih htail_mem
        simpa [actualResetFirstLowerGapPotential, hj] using ih'

private noncomputable def upperResetFirstQPotential {n : Nat}
    (A G H : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) : ℝ :=
  A * boundaryBudget X (suffixResetTreeAfter X q init done) future q +
    G * actualResetFirstLowerGapPotential X q init done future +
      H * ((splayTreeAfter X init done).search_path_len q : ℝ)

private theorem upperResetFirstQPotential_nonneg {n : Nat}
    (A G H : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (hA : 0 ≤ A) (hG : 0 ≤ G)
    (hH : 0 ≤ H) :
    0 ≤ upperResetFirstQPotential A G H X q init done future := by
  unfold upperResetFirstQPotential
  have hb :
      0 ≤ boundaryBudget X (suffixResetTreeAfter X q init done) future q :=
    boundaryBudget_nonneg X (suffixResetTreeAfter X q init done) future q
  have hg :
      0 ≤ actualResetFirstLowerGapPotential X q init done future :=
    actualResetFirstLowerGapPotential_nonneg X q init done future
  have hq : 0 ≤ ((splayTreeAfter X init done).search_path_len q : ℝ) := by
    positivity
  nlinarith [mul_nonneg hA hb, mul_nonneg hG hg, mul_nonneg hH hq]

private theorem upperResetFirstQPotential_initial_le {n : Nat}
    (A G H : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (future : List (Fin n)) (_hA : 0 ≤ A) (hH : 0 ≤ H)
    (hbst : IsBST init) :
    upperResetFirstQPotential A G H X q init [] future ≤
      (A + H) * boundaryBudget X init future q := by
  unfold upperResetFirstQPotential
  rw [actualResetFirstLowerGapPotential_initial_eq_zero]
  simp [suffixResetTreeAfter, splayTreeAfter]
  have hpath :
      ((init.search_path_len q : ℝ)) ≤ boundaryBudget X init future q :=
    search_path_len_real_le_boundaryBudget_of_boundary X future q hbst
  have hb : 0 ≤ boundaryBudget X init future q :=
    boundaryBudget_nonneg X init future q
  nlinarith [mul_le_mul_of_nonneg_left hpath hH]

private theorem upperResetFirstQPotential_cons_pivot_eq {n : Nat}
    (A G H : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n) (hi : X i = q) :
    upperResetFirstQPotential A G H X q init done (i :: future) =
      upperResetFirstQPotential A G H X q init done future + A := by
  unfold upperResetFirstQPotential
  rw [boundaryBudget_cons_pivot_eq X
      (suffixResetTreeAfter X q init done) i future q hi,
    actualResetFirstLowerGapPotential_cons_pivot_eq
      X q init done future i hi]
  ring

private theorem upperResetFirstQPotential_pivot_step_of_qpath_growth {n : Nat}
    (A G H : ℝ) (X : Fin n → Nat) (q : Nat) (init : BinaryTree)
    (done future : List (Fin n)) (i : Fin n)
    (hA : 0 ≤ A) (hG : 0 ≤ G) (hHgeG : G ≤ H)
    (hbst : IsBST init) (hroot : rootKey init = some q)
    (hi : X i = q)
    (hmem_future : ∀ j : Fin n, j ∈ future → X j ∈ init.toKeyList) :
    upperResetFirstQPotential A G H X q init (done ++ [i]) future ≤
      H + upperResetFirstQPotential A G H X q init done (i :: future) := by
  have hnot : ¬ X i < q := by
    rw [hi]
    omega
  have hreset :
      suffixResetTreeAfter X q init (done ++ [i]) =
        suffixResetTreeAfter X q init done :=
    suffixResetTreeAfter_append_singleton_not_lt X q done init i hnot
  have hactual_next :
      splayTreeAfter X init (done ++ [i]) =
        splay (splayTreeAfter X init done) q := by
    rw [splayTreeAfter_append]
    simp [splayTreeAfter, hi]
  have hroot_actual :
      rootKey (splayTreeAfter X init (done ++ [i])) = some q := by
    rw [hactual_next]
    exact
      splay_rootKey_eq_some_of_mem_isBST
        (splayTreeAfter X init done) q
        (splayTreeAfter_isBST X done init hbst)
        (by
          rw [splayTreeAfter_toKeyList]
          exact rootKey_mem_toKeyList hroot)
  have hq_after :
      (splayTreeAfter X init (done ++ [i])).search_path_len q = 1 :=
    search_path_len_eq_one_of_rootKey_eq_some hroot_actual
  have hq_before_pos :
      1 ≤ (splayTreeAfter X init done).search_path_len q := by
    have hq_mem :
        q ∈ (splayTreeAfter X init done).toKeyList := by
      rw [splayTreeAfter_toKeyList]
      exact rootKey_mem_toKeyList hroot
    exact search_path_len_pos_of_mem (splayTreeAfter X init done) q hq_mem
  have hgap :
      actualResetFirstLowerGapPotential X q init (done ++ [i]) future ≤
        actualResetFirstLowerGapPotential X q init done future +
          ((splayTreeAfter X init done).search_path_len q : ℝ) :=
    actualResetFirstLowerGapPotential_pivot_growth_le_qpath
      X q init done future i hbst hroot hi hmem_future
  have hgap_mul :
      G * actualResetFirstLowerGapPotential X q init (done ++ [i]) future ≤
        G * (actualResetFirstLowerGapPotential X q init done future +
          ((splayTreeAfter X init done).search_path_len q : ℝ)) := by
    exact mul_le_mul_of_nonneg_left hgap hG
  have hcons :=
    upperResetFirstQPotential_cons_pivot_eq
      A G H X q init done future i hi
  rw [hcons]
  unfold upperResetFirstQPotential
  rw [hreset, hq_after]
  have hq_before_nonneg :
      0 ≤ ((splayTreeAfter X init done).search_path_len q : ℝ) := by
    positivity
  have hGq_le_Hq :
      G * ((splayTreeAfter X init done).search_path_len q : ℝ) ≤
        H * ((splayTreeAfter X init done).search_path_len q : ℝ) :=
    mul_le_mul_of_nonneg_right hHgeG hq_before_nonneg
  have hgap_bound :
      G * actualResetFirstLowerGapPotential X q init (done ++ [i]) future ≤
        G * actualResetFirstLowerGapPotential X q init done future +
          H * ((splayTreeAfter X init done).search_path_len q : ℝ) := by
    calc
      G * actualResetFirstLowerGapPotential X q init (done ++ [i]) future
          ≤ G * (actualResetFirstLowerGapPotential X q init done future +
              ((splayTreeAfter X init done).search_path_len q : ℝ)) := hgap_mul
      _ = G * actualResetFirstLowerGapPotential X q init done future +
            G * ((splayTreeAfter X init done).search_path_len q : ℝ) := by
          ring
      _ ≤ G * actualResetFirstLowerGapPotential X q init done future +
            H * ((splayTreeAfter X init done).search_path_len q : ℝ) := by
          exact add_le_add le_rfl hGq_le_Hq
  ring_nf
  nlinarith [hgap_bound, hA]

private theorem prefix_pair_bound_of_firstLowerGap_head
    {n : Nat} (Y : Fin n → Nat) (q : Nat)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hi_mem : Y i ∈ (splayTreeAfter Y init done).toKeyList)
    (hi_lt : Y i < q) :
    ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) +
        ((splay (splayTreeAfter Y init done) (Y i)).search_path_len q : ℝ) ≤
      ((splayTreeAfter Y init done).search_path_len q : ℝ) +
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
        ((splay (suffixResetTreeAfter Y q init done) (Y i)).search_path_len q : ℝ) +
        actualResetFirstLowerGapPotential Y q init done (i :: future) := by
  let gap :=
    actualResetFirstLowerGapPotential Y q init done (i :: future)
  have hgap_head :
      max 0
          (((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) -
            ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ)) ≤
        gap := by
    unfold gap
    exact
      actualResetFirstLowerGapPotential_ge_head
        Y q init done future i hi_lt
  have hdiff_le :
      ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) -
          ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) ≤
        gap := by
    exact le_trans (le_max_right _ _) hgap_head
  have hpath :
      ((splayTreeAfter Y init done).search_path_len (Y i) : ℝ) ≤
        ((suffixResetTreeAfter Y q init done).search_path_len (Y i) : ℝ) +
          gap := by
    linarith
  exact
    prefix_pair_bound_of_current_path_len_bound
      Y q gap init done i hbst hroot hi_mem hi_lt hpath

