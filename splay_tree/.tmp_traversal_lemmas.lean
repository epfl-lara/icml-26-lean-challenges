private theorem lower_path_after_access_le_after_boundary_reset
    {t : BinaryTree} {q x y : Nat}
    (hbst : IsBST t)
    (hx_mem : x ∈ t.toKeyList)
    (hq_mem : q ∈ t.toKeyList)
    (hy_mem : y ∈ t.toKeyList)
    (hyx : y < x) (hxq : x < q) :
    (splay t x).search_path_len y ≤
      (splay (splay t x) q).search_path_len y := by
  let tx := splay t x
  have htx_bst : IsBST tx := by
    unfold tx
    exact splay_isBST t x hbst
  have hroot_tx : rootKey tx = some x := by
    unfold tx
    exact splay_rootKey_eq_some_of_mem_isBST t x hbst hx_mem
  have hq_mem_tx : q ∈ tx.toKeyList := by
    unfold tx
    rw [splay_toKeyList]
    exact hq_mem
  have hy_mem_tx : y ∈ tx.toKeyList := by
    unfold tx
    rw [splay_toKeyList]
    exact hy_mem
  have hq_right :
      q ∈ (rightSubtree tx).toKeyList :=
    mem_rightSubtree_of_root_gt_isBST
      htx_bst hroot_tx hq_mem_tx hxq
  have hy_left :
      y ∈ (leftSubtree tx).toKeyList :=
    mem_leftSubtree_of_root_lt_isBST
      htx_bst hroot_tx hy_mem_tx hyx
  exact rooted_left_path_le_after_splay_right
    htx_bst hroot_tx hq_right hy_left

private theorem lower_or_same_path_after_access_le_after_boundary_reset_add_one
    {t : BinaryTree} {q x y : Nat}
    (hbst : IsBST t)
    (hx_mem : x ∈ t.toKeyList)
    (hq_mem : q ∈ t.toKeyList)
    (hy_mem : y ∈ t.toKeyList)
    (hyx : y ≤ x) (hxq : x < q) :
    (splay t x).search_path_len y ≤
      (splay (splay t x) q).search_path_len y + 1 := by
  rcases lt_or_eq_of_le hyx with hy_lt_x | hy_eq_x
  · have hle :=
      lower_path_after_access_le_after_boundary_reset
        hbst hx_mem hq_mem hy_mem hy_lt_x hxq
    omega
  · subst y
    have hroot_tx :
        rootKey (splay t x) = some x :=
      splay_rootKey_eq_some_of_mem_isBST t x hbst hx_mem
    have hpath_tx :
        (splay t x).search_path_len x = 1 :=
      search_path_len_eq_one_of_rootKey_eq_some hroot_tx
    let tr := splay (splay t x) q
    have hx_mem_tr : x ∈ tr.toKeyList := by
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hx_mem
    have hpos : 0 < tr.search_path_len x :=
      search_path_len_pos_of_mem tr x hx_mem_tr
    rw [hpath_tx]
    omega

private theorem upper_path_after_left_access_root_reset_add_one_node
    {l r : BinaryTree} {q y x : Nat}
    (hbst : IsBST (BinaryTree.node l q r))
    (hy_mem : y ∈ l.toKeyList)
    (hx_mem : x ∈ l.toKeyList)
    (hyx : y < x) :
    (splay (BinaryTree.node l q r) y).search_path_len x ≤
      (splay (splay (BinaryTree.node l q r) y) q).search_path_len x + 1 := by
  have hy_lt_q : y < q := isBST_left_mem_lt_root hbst hy_mem
  have hx_lt_q : x < q := isBST_left_mem_lt_root hbst hx_mem
  cases l with
  | empty =>
      simp [BinaryTree.toKeyList] at hy_mem
  | node ll lk lr =>
      cases hbst with
      | node _ _ _ hleft _hright hbst_left _hbst_right =>
          cases hbst_left with
          | node _ _ _ hll_left hlr_right hbst_ll hbst_lr =>
              have hlk_lt_q : lk < q :=
                (forallTree_iff_forall_mem.mp hleft) lk
                  (by simp [BinaryTree.toKeyList])
              simp [BinaryTree.toKeyList] at hy_mem hx_mem
              rw [splay.eq_def]
              rcases hy_mem with hy_ll | hy_eq_lk | hy_lr
              · have hy_lt_lk : y < lk :=
                  (forallTree_iff_forall_mem.mp hll_left) y hy_ll
                have hy_ne_q : y ≠ q := by omega
                cases ll with
                | empty =>
                    simp [BinaryTree.toKeyList] at hy_ll
                | node a z b =>
                    have hroot_inner :=
                      splay_rootKey_eq_some_of_mem_isBST
                        (BinaryTree.node a z b) y hbst_ll hy_ll
                    cases hs : splay (BinaryTree.node a z b) y with
                    | empty =>
                        simp [rootKey, hs] at hroot_inner
                    | node sl sk sr =>
                        simp [rootKey, hs] at hroot_inner
                        subst sk
                        have hnot_q_lt_y : ¬ q < y := by omega
                        have hnot_q_lt_lk : ¬ q < lk := by omega
                        have hq_ne_y : q ≠ y := by omega
                        have hq_ne_lk : q ≠ lk := by omega
                        have hreset_zz :
                            splay
                                (BinaryTree.node sl y
                                  (BinaryTree.node sr lk
                                    (BinaryTree.node lr q r))) q =
                              BinaryTree.node
                                (BinaryTree.node
                                  (BinaryTree.node sl y sr) lk lr) q r := by
                          rw [splay.eq_def]
                          simp [hq_ne_y, hnot_q_lt_y, hnot_q_lt_lk,
                            hlk_lt_q, splay.eq_def, rotate, rotateLeft]
                        rcases hx_mem with hx_ll | hx_eq_lk | hx_lr
                        · have hx_lt_lk : x < lk :=
                            (forallTree_iff_forall_mem.mp hll_left) x hx_ll
                          have hnot_x_lt_y : ¬ x < y := by omega
                          have hx_ne_y : x ≠ y := by omega
                          simp [hy_ne_q, hy_lt_q, hy_lt_lk, hs, rotate,
                            rotateRight, rotateLeft, BinaryTree.search_path_len,
                            hnot_x_lt_y, hyx, hx_lt_lk, hx_ne_y,
                            hnot_q_lt_y, hq_ne_y, hnot_q_lt_lk, hq_ne_lk,
                            hlk_lt_q, hx_lt_q, hreset_zz]
                          omega
                        · subst x
                          have hnot_lk_lt_y : ¬ lk < y := by omega
                          have hlk_ne_y : lk ≠ y := by omega
                          simp [hy_ne_q, hy_lt_q, hy_lt_lk, hs, rotate,
                            rotateRight, rotateLeft, BinaryTree.search_path_len,
                            hnot_lk_lt_y, hlk_ne_y, hnot_q_lt_y, hq_ne_y,
                            hnot_q_lt_lk, hq_ne_lk, hlk_lt_q, hreset_zz]
                        · have hlk_lt_x : lk < x :=
                            (forallTree_iff_forall_mem.mp hlr_right) x hx_lr
                          have hnot_x_lt_y : ¬ x < y := by omega
                          have hnot_x_lt_lk : ¬ x < lk := by omega
                          have hx_ne_y : x ≠ y := by omega
                          simp [hy_ne_q, hy_lt_q, hy_lt_lk, hs, rotate,
                            rotateRight, rotateLeft, BinaryTree.search_path_len,
                            hnot_x_lt_y, hyx, hnot_x_lt_lk, hlk_lt_x,
                            hx_ne_y, hnot_q_lt_y, hq_ne_y, hnot_q_lt_lk,
                            hq_ne_lk, hlk_lt_q, hx_lt_q, hreset_zz]
                          omega
              · subst y
                have hlk_ne_q : lk ≠ q := by omega
                have hnot_q_lt_lk : ¬ q < lk := by omega
                have hq_ne_lk : q ≠ lk := by omega
                have hreset_child :
                    splay
                        (BinaryTree.node ll lk
                          (BinaryTree.node lr q r)) q =
                      BinaryTree.node (BinaryTree.node ll lk lr) q r := by
                  rw [splay.eq_def]
                  simp [hq_ne_lk, hnot_q_lt_lk, hlk_lt_q, splay.eq_def,
                    rotate, rotateLeft]
                rcases hx_mem with hx_ll | hx_eq_lk | hx_lr
                · have hx_lt_lk :=
                    (forallTree_iff_forall_mem.mp hll_left) x hx_ll
                  omega
                · omega
                · have hlk_lt_x :=
                    (forallTree_iff_forall_mem.mp hlr_right) x hx_lr
                  have hnot_x_lt_lk : ¬ x < lk := by omega
                  have hnot_q_lt_x : ¬ q < x := by omega
                  simp [hy_lt_q, rotate, rotateRight, rotateLeft,
                    BinaryTree.search_path_len, hlk_ne_q, hnot_q_lt_lk,
                    hnot_x_lt_lk, hlk_lt_x, hnot_q_lt_x, hx_lt_q,
                    hreset_child]
              · have hlk_lt_y : lk < y :=
                  (forallTree_iff_forall_mem.mp hlr_right) y hy_lr
                have hnot_y_lt_lk : ¬ y < lk := by omega
                have hy_ne_q : y ≠ q := by omega
                cases lr with
                | empty =>
                    simp [BinaryTree.toKeyList] at hy_lr
                | node a z b =>
                    have hroot_inner :=
                      splay_rootKey_eq_some_of_mem_isBST
                        (BinaryTree.node a z b) y hbst_lr hy_lr
                    cases hs : splay (BinaryTree.node a z b) y with
                    | empty =>
                        simp [rootKey, hs] at hroot_inner
                    | node sl sk sr =>
                        simp [rootKey, hs] at hroot_inner
                        subst sk
                        have hnot_q_lt_y : ¬ q < y := by omega
                        have hq_ne_y : q ≠ y := by omega
                        have hreset_zigzag :
                            splay
                                (BinaryTree.node
                                  (BinaryTree.node ll lk sl) y
                                  (BinaryTree.node sr q r)) q =
                              BinaryTree.node
                                (BinaryTree.node
                                  (BinaryTree.node ll lk sl) y sr) q r := by
                          rw [splay.eq_def]
                          simp [hq_ne_y, hnot_q_lt_y, hy_lt_q,
                            splay.eq_def, rotate, rotateLeft]
                        rcases hx_mem with hx_ll | hx_eq_lk | hx_lr
                        · have hx_lt_lk :=
                            (forallTree_iff_forall_mem.mp hll_left) x hx_ll
                          omega
                        · omega
                        · have hlk_lt_x :=
                            (forallTree_iff_forall_mem.mp hlr_right) x hx_lr
                          have hnot_x_lt_lk : ¬ x < lk := by omega
                          have hnot_x_lt_y : ¬ x < y := by omega
                          have hx_ne_y : x ≠ y := by omega
                          have hnot_q_lt_lk : ¬ q < lk := by omega
                          have hq_ne_lk : q ≠ lk := by omega
                          simp [hy_ne_q, hy_lt_q, hnot_y_lt_lk, hlk_lt_y,
                            hs, rotate, rotateRight, rotateLeft,
                            BinaryTree.search_path_len, hnot_x_lt_y, hyx,
                            hnot_x_lt_lk, hlk_lt_x, hx_ne_y, hnot_q_lt_y,
                            hq_ne_y, hnot_q_lt_lk, hq_ne_lk, hlk_lt_q,
                            hx_lt_q, hreset_zigzag]

private theorem upper_path_after_lower_access_le_after_boundary_reset_add_one
    {t : BinaryTree} {q y x : Nat}
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hy_mem : y ∈ t.toKeyList)
    (hx_mem : x ∈ t.toKeyList)
    (hyx : y < x)
    (hxq : x < q) :
    (splay t y).search_path_len x ≤
      (splay (splay t y) q).search_path_len x + 1 := by
  cases ht : t with
  | empty =>
      simp [BinaryTree.toKeyList, ht] at hy_mem
  | node l k r =>
      simp [rootKey, ht] at hroot
      subst k
      have hbst_node : IsBST (BinaryTree.node l q r) := by
        simpa [ht] using hbst
      have hy_lt_q : y < q := by omega
      have hy_mem_l : y ∈ l.toKeyList :=
        isBST_node_mem_left_of_lt_root hbst_node
          (by simpa [ht] using hy_mem) hy_lt_q
      have hx_mem_l : x ∈ l.toKeyList :=
        isBST_node_mem_left_of_lt_root hbst_node
          (by simpa [ht] using hx_mem) hxq
      simpa [ht] using
        upper_path_after_left_access_root_reset_add_one_node
          (l := l) (r := r) (q := q) (y := y) (x := x)
          hbst_node hy_mem_l hx_mem_l hyx

private theorem rootKey_after_pivot_reset_of_root
    {t : BinaryTree} {q x : Nat}
    (hbst : IsBST t) (hroot : rootKey t = some q) :
    rootKey (splay (splay t x) q) = some q := by
  have hmem : q ∈ (splay t x).toKeyList := by
    rw [splay_toKeyList]
    exact rootKey_mem_toKeyList hroot
  exact splay_rootKey_eq_some_of_mem_isBST (splay t x) q
    (splay_isBST t x hbst) hmem

private theorem mem_leftSubtree_after_pivot_reset_of_lt
    {t : BinaryTree} {q x y : Nat}
    (hbst : IsBST t) (hroot : rootKey t = some q)
    (hymem : y ∈ t.toKeyList) (hylt : y < q) :
    y ∈ (leftSubtree (splay (splay t x) q)).toKeyList := by
  let tr := splay (splay t x) q
  have hroot_tr : rootKey tr = some q := by
    unfold tr
    exact rootKey_after_pivot_reset_of_root hbst hroot
  have hbst_tr : IsBST tr := by
    unfold tr
    exact splay_isBST (splay t x) q (splay_isBST t x hbst)
  have hymem_tr : y ∈ tr.toKeyList := by
    unfold tr
    rw [splay_toKeyList, splay_toKeyList]
    exact hymem
  exact mem_leftSubtree_of_root_lt_isBST hbst_tr hroot_tr hymem_tr hylt

private theorem mem_rightSubtree_after_pivot_reset_of_gt
    {t : BinaryTree} {q x y : Nat}
    (hbst : IsBST t) (hroot : rootKey t = some q)
    (hymem : y ∈ t.toKeyList) (hygt : q < y) :
    y ∈ (rightSubtree (splay (splay t x) q)).toKeyList := by
  let tr := splay (splay t x) q
  have hroot_tr : rootKey tr = some q := by
    unfold tr
    exact rootKey_after_pivot_reset_of_root hbst hroot
  have hbst_tr : IsBST tr := by
    unfold tr
    exact splay_isBST (splay t x) q (splay_isBST t x hbst)
  have hymem_tr : y ∈ tr.toKeyList := by
    unfold tr
    rw [splay_toKeyList, splay_toKeyList]
    exact hymem
  exact mem_rightSubtree_of_root_gt_isBST hbst_tr hroot_tr hymem_tr hygt

private theorem splay_cost_add_one_eq_search_path_len_of_mem
    (t : BinaryTree) (q : Nat) (hmem : q ∈ t.toKeyList) :
    splay.cost t q + 1 = t.search_path_len q := by
  rw [splay_cost_eq_search_path_len_sub_one]
  have hpos := search_path_len_pos_of_mem t q hmem
  have hnat : (t.search_path_len q - 1) + 1 = t.search_path_len q := by
    omega
  exact_mod_cast hnat

private theorem splay_cost_attachLeftFrames_eq_add_length
    (t : BinaryTree) (q : Nat) (fs : List LeftContextFrame)
    (hframes : frameKeysAbove q fs) (hmem : q ∈ t.toKeyList) :
    splay.cost (attachLeftFrames t fs) q =
      splay.cost t q + (fs.length : ℝ) := by
  have hmem_attach :
      q ∈ (attachLeftFrames t fs).toKeyList :=
    mem_toKeyList_attachLeftFrames_of_mem t fs hmem
  have hcost_attach :=
    splay_cost_add_one_eq_search_path_len_of_mem
      (attachLeftFrames t fs) q hmem_attach
  have hcost_base :=
    splay_cost_add_one_eq_search_path_len_of_mem t q hmem
  have hpath :=
    search_path_len_attachLeftFrames_of_frameKeysAbove t q fs hframes
  rw [hpath] at hcost_attach
  norm_num at hcost_attach
  nlinarith

private theorem splay_cost_attachLeftFrames_zigzig_eq
    {a b lr r : BinaryTree} {x lk k q : Nat}
    {fs : List LeftContextFrame}
    (hbst :
      IsBST (attachLeftFrames
        (.node (.node (.node a x b) lk lr) k r) fs))
    (hmem : q ∈ (BinaryTree.node a x b).toKeyList) :
    splay.cost
        (attachLeftFrames (.node (.node (.node a x b) lk lr) k r) fs) q =
      splay.cost (.node a x b) q + ((fs.length + 2 : Nat) : ℝ) := by
  have hframes :=
    frameKeysAbove_zigzig_context_of_isBST hbst hmem
  have hcost :=
    splay_cost_attachLeftFrames_eq_add_length
      (.node a x b) q ((lk, lr) :: (k, r) :: fs) hframes hmem
  rw [attachLeftFrames_zigzig_context] at hcost
  simpa [Nat.cast_add, Nat.cast_ofNat, add_assoc, add_comm, add_left_comm]
    using hcost

