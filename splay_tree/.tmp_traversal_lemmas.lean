private theorem exists_first_tail_rise_or_all_tail_le_head {n : Nat}
    {Y : Fin n → Nat} {i : Fin n} {xs : List (Fin n)}
    (hsub : (i :: xs).Sublist (List.finRange n))
    (havoid : Y avoids ![2, 3, 1]) :
    (∀ r : Fin xs.length, Y (xs.get r) ≤ Y i) ∨
      ∃ p : Fin xs.length,
        Y i < Y (xs.get p) ∧
        (∀ r : Fin xs.length, r < p → Y (xs.get r) ≤ Y i) ∧
        (∀ r : Fin xs.length, p ≤ r → Y i ≤ Y (xs.get r)) := by
  classical
  let P : Fin xs.length → Prop := fun p => Y i < Y (xs.get p)
  by_cases hex : ∃ p : Fin xs.length, P p
  · obtain ⟨p₀, hp₀⟩ := hex
    obtain ⟨p, _hp_le, hmin⟩ :=
      Finite.exists_le_minimal (p := P) (a := p₀) hp₀
    refine Or.inr ⟨p, hmin.1, ?_, ?_⟩
    · intro r hrp
      apply Nat.le_of_not_gt
      intro hrise
      have hp_le_r : p ≤ r := hmin.2 hrise (le_of_lt hrp)
      exact (not_lt_of_ge hp_le_r) hrp
    · intro r hpr
      exact head_le_tail_at_or_after_first_rise_of_avoids231
        hsub havoid hmin.1 hpr
  · left
    intro r
    apply Nat.le_of_not_gt
    intro hrise
    exact hex ⟨r, hrise⟩

private theorem take_before_first_tail_rise_le_head {n : Nat}
    {Y : Fin n → Nat} {i : Fin n} {xs : List (Fin n)}
    {p : Fin xs.length}
    (hbefore :
      ∀ r : Fin xs.length, r < p → Y (xs.get r) ≤ Y i) :
    ∀ r : Fin (xs.take p.val).length,
      Y ((xs.take p.val).get r) ≤ Y i := by
  intro r
  let rxs : Fin xs.length := ⟨r.val, by
    have hr : r.val < (xs.take p.val).length := r.isLt
    have htake : (xs.take p.val).length ≤ xs.length := by
      simp [List.length_take]
    omega⟩
  have hrp : rxs < p := by
    have hr : r.val < (xs.take p.val).length := r.isLt
    have hlen : (xs.take p.val).length = p.val := by
      simp [List.length_take, Nat.min_eq_left (Nat.le_of_lt p.isLt)]
    change r.val < p.val
    omega
  have hget : (xs.take p.val).get r = xs.get rxs := by
    simp [rxs, List.getElem_take]
  rw [hget]
  exact hbefore rxs hrp

private theorem drop_from_first_tail_rise_head_le {n : Nat}
    {Y : Fin n → Nat} {i : Fin n} {xs : List (Fin n)}
    {p : Fin xs.length}
    (hafter :
      ∀ r : Fin xs.length, p ≤ r → Y i ≤ Y (xs.get r)) :
    ∀ r : Fin (xs.drop p.val).length,
      Y i ≤ Y ((xs.drop p.val).get r) := by
  intro r
  let rxs : Fin xs.length := ⟨p.val + r.val, by
    have hr : r.val < (xs.drop p.val).length := r.isLt
    simp [List.length_drop] at hr
    omega⟩
  have hpr : p ≤ rxs := by
    change p.val ≤ p.val + r.val
    omega
  have hget : (xs.drop p.val).get r = xs.get rxs := by
    simp [rxs, List.getElem_drop, add_comm, add_left_comm, add_assoc]
  rw [hget]
  exact hafter rxs hpr

private theorem pair_budget_drop_of_first_tail_rise_cases
    (A C : ℝ)
    (hall_tail_le :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat)
          (t : BinaryTree) (i : Fin N) (xs : List (Fin N)),
        xs ≠ [] →
        IsBST t →
        rootKey t = some q →
        Y i ∈ t.toKeyList →
        Y i < q →
        (∀ j : Fin N, j ∈ xs → Y j ∈ t.toKeyList) →
        (∀ j : Fin N, j ∈ xs → Y j < q) →
        (i :: xs).Sublist (List.finRange N) →
        (Y avoids ![2, 3, 1]) →
        (∀ r : Fin xs.length, Y (xs.get r) ≤ Y i) →
        (t.search_path_len (Y i) : ℝ) +
            ((splay t (Y i)).search_path_len q : ℝ) ≤
          C + A *
            (boundaryBudget Y t (i :: xs) q -
              boundaryBudget Y (splay (splay t (Y i)) q) xs q))
    (hfirst_rise :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat)
          (t : BinaryTree) (i : Fin N) (xs : List (Fin N)),
        xs ≠ [] →
        IsBST t →
        rootKey t = some q →
        Y i ∈ t.toKeyList →
        Y i < q →
        (∀ j : Fin N, j ∈ xs → Y j ∈ t.toKeyList) →
        (∀ j : Fin N, j ∈ xs → Y j < q) →
        (i :: xs).Sublist (List.finRange N) →
        (Y avoids ![2, 3, 1]) →
        ∀ p : Fin xs.length,
          Y i < Y (xs.get p) →
          (∀ r : Fin (xs.take p.val).length,
            Y ((xs.take p.val).get r) ≤ Y i) →
          (∀ r : Fin (xs.drop p.val).length,
            Y i ≤ Y ((xs.drop p.val).get r)) →
          (t.search_path_len (Y i) : ℝ) +
              ((splay t (Y i)).search_path_len q : ℝ) ≤
            C + A *
              (boundaryBudget Y t (i :: xs) q -
                boundaryBudget Y (splay (splay t (Y i)) q) xs q)) :
    ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat)
        (t : BinaryTree) (i : Fin N) (xs : List (Fin N)),
      xs ≠ [] →
      IsBST t →
      rootKey t = some q →
      Y i ∈ t.toKeyList →
      Y i < q →
      (∀ j : Fin N, j ∈ xs → Y j ∈ t.toKeyList) →
      (∀ j : Fin N, j ∈ xs → Y j < q) →
      (i :: xs).Sublist (List.finRange N) →
      (Y avoids ![2, 3, 1]) →
      (t.search_path_len (Y i) : ℝ) +
          ((splay t (Y i)).search_path_len q : ℝ) ≤
        C + A *
          (boundaryBudget Y t (i :: xs) q -
            boundaryBudget Y (splay (splay t (Y i)) q) xs q) := by
  intro N Y q t i xs hxs_ne hbst hroot hi_mem hi_lt hmem_tail
    hlt_tail hsub havoid
  rcases exists_first_tail_rise_or_all_tail_le_head
      (Y := Y) (i := i) (xs := xs) hsub havoid with hall | hrise
  · exact
      hall_tail_le Y q t i xs hxs_ne hbst hroot hi_mem hi_lt
        hmem_tail hlt_tail hsub havoid hall
  · rcases hrise with ⟨p, hp_rise, hbefore, hafter⟩
    have hbefore_take :
        ∀ r : Fin (xs.take p.val).length,
          Y ((xs.take p.val).get r) ≤ Y i :=
      take_before_first_tail_rise_le_head hbefore
    have hafter_drop :
        ∀ r : Fin (xs.drop p.val).length,
          Y i ≤ Y ((xs.drop p.val).get r) :=
      drop_from_first_tail_rise_head_le hafter
    exact
      hfirst_rise Y q t i xs hxs_ne hbst hroot hi_mem hi_lt
        hmem_tail hlt_tail hsub havoid p hp_rise hbefore_take hafter_drop

