    (hmin : ∀ y : Nat, y ∈ (attachLeftFrames t fs).toKeyList → q ≤ y) :
    x ∈ (splayMinUnwindResult t fs).toKeyList ↔
      x ∈ (attachLeftFrames t fs).toKeyList ∧ q < x := by
