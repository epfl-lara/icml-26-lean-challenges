private theorem rooted_upper_pathSum_le_boundaryBudget_of_lower_reset_list_bound
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (t : BinaryTree)
    (K : ℝ) (hK : 0 ≤ K)
    (hlower :
      ∀ {m : Nat} (Z : Fin m → Nat) (q : Nat) (t : BinaryTree)
        (xs : List (Fin m)),
        IsBST t →
        rootKey t = some q →
        (∀ i : Fin m, i ∈ xs → Z i ∈ t.toKeyList) →
        (Z avoids ![2, 3, 1]) →
        (∀ i : Fin m, i ∈ xs → Z i < q) →
        pivotResetLowerPathSum Z q t xs ≤
          K * boundaryBudget Z t xs q)
    (htail_dom :
      ∀ (t' : BinaryTree) (i : Fin n) (xs : List (Fin n)),
        IsBST t' →
        rootKey t' = some q →
        Y i ∈ t'.toKeyList →
        Y i < q →
        (∀ j : Fin n, j ∈ xs → Y j ∈ t'.toKeyList) →
        (∀ j : Fin n, j ∈ xs → Y j ≤ q) →
        splayPathSum Y (splay t' (Y i)) xs ≤
          ((splay t' (Y i)).search_path_len q : ℝ) +
            suffixResetUpperPathSum Y q
              (splay (splay t' (Y i)) q) xs +
            xs.length)
    (hbst : IsBST t)
    (hroot : rootKey t = some q)
    (hmem : ∀ i : Fin n, Y i ∈ t.toKeyList)
    (havoid : Y avoids ![2, 3, 1])
    (hle : ∀ i : Fin n, Y i ≤ q) :
    splayPathSum Y t (List.finRange n) ≤
      (2 * K + 2) * boundaryBudget Y t (List.finRange n) q := by
  let xsStrict :=
    (List.finRange n).filter (fun i => decide (Y i < q))
  have hstrict_mem :
      ∀ i : Fin n, i ∈ xsStrict → Y i ∈ t.toKeyList := by
    intro i _hi
    exact hmem i
  have hstrict_lt :
      ∀ i : Fin n, i ∈ xsStrict → Y i < q := by
    intro i hi
    unfold xsStrict at hi
    simpa using (List.mem_filter.mp hi).2
  have hpair_lower :
      pivotResetPairPathSum Y q t xsStrict ≤
        2 * pivotResetLowerPathSum Y q t xsStrict :=
    pivotResetPairPathSum_le_two_lowerPathSum_of_lt
      Y q xsStrict t hbst hroot hstrict_mem hstrict_lt
  have hlower_strict :
      pivotResetLowerPathSum Y q t xsStrict ≤
        K * boundaryBudget Y t xsStrict q :=
    hlower Y q t xsStrict hbst hroot hstrict_mem havoid hstrict_lt
  have hstrict_sub :
      xsStrict.Sublist (List.finRange n) := by
    unfold xsStrict
    exact List.filter_sublist
  have hbudget_strict :
      boundaryBudget Y t xsStrict q ≤
        boundaryBudget Y t (List.finRange n) q :=
    boundaryBudget_sublist_le Y t q hstrict_sub
  have hpair_full :
      pivotResetPairPathSum Y q t xsStrict ≤
        (2 * K) * boundaryBudget Y t (List.finRange n) q := by
    have hmul :
        K * boundaryBudget Y t xsStrict q ≤
          K * boundaryBudget Y t (List.finRange n) q := by
      exact mul_le_mul_of_nonneg_left hbudget_strict hK
    nlinarith
  have hupper :=
    rooted_upper_pathSum_le_boundaryBudget_of_pair_bound_of_mem_tail
      Y q t (2 * K) htail_dom hbst hroot hmem hle ?_
  · simpa [xsStrict] using hupper
  · simpa [xsStrict] using hpair_full

private theorem boundaryHullKeys_after_splay_sublist_cons {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n)) (q : Nat)
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hq_mem : q ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList) :
    (boundaryHullKeys X (splay t (X i)) xs q).Sublist
      (boundaryHullKeys X t (i :: xs) q) := by
  unfold boundaryHullKeys
  rw [splay_toKeyList]
  apply filter_sublist_filter_of_imp
  intro key hkey
  simp at hkey ⊢
  rcases hkey with hq_path | hfuture_path
  · have hor :=
      searchPathKeys_splay_subset_union t (X i) q key
        hbst hi_mem hq_mem hq_path
    rcases hor with hi_path | hq_old
    · exact Or.inr (Or.inl hi_path)
    · exact Or.inl hq_old
  · rcases hfuture_path with ⟨j, hj, hpath⟩
    have hor :=
      searchPathKeys_splay_subset_union t (X i) (X j) key
        hbst hi_mem (hmem_tail j hj) hpath
    rcases hor with hi_path | hj_path
    · exact Or.inr (Or.inl hi_path)
    · exact Or.inr (Or.inr ⟨j, hj, hj_path⟩)

private theorem boundaryHullKeys_after_splay_length_add_path_len_le_cons_add_inter
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n)) (q : Nat)
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hq_mem : q ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList) :
    (boundaryHullKeys X (splay t (X i)) xs q).length +
        t.search_path_len (X i) ≤
      (boundaryHullKeys X t (i :: xs) q).length +
        ((boundaryHullKeys X (splay t (X i)) xs q).toFinset ∩
          (searchPathKeys t (X i)).toFinset).card := by
  classical
  let newKeys := boundaryHullKeys X (splay t (X i)) xs q
  let oldKeys := boundaryHullKeys X t (i :: xs) q
  let pathKeys := searchPathKeys t (X i)
  have hnew_nodup : newKeys.Nodup := by
    unfold newKeys
    exact boundaryHullKeys_nodup_of_isBST X xs q
      (splay_isBST t (X i) hbst)
  have hold_nodup : oldKeys.Nodup := by
    unfold oldKeys
    exact boundaryHullKeys_nodup_of_isBST X (i :: xs) q hbst
  have hpath_nodup : pathKeys.Nodup := by
    unfold pathKeys
    exact searchPathKeys_nodup_of_isBST t (X i) hbst
  have hnew_card : newKeys.toFinset.card = newKeys.length :=
    List.toFinset_card_of_nodup hnew_nodup
  have hold_card : oldKeys.toFinset.card = oldKeys.length :=
    List.toFinset_card_of_nodup hold_nodup
  have hpath_card : pathKeys.toFinset.card = pathKeys.length :=
    List.toFinset_card_of_nodup hpath_nodup
  have hnew_subset : newKeys.toFinset ⊆ oldKeys.toFinset := by
    intro key hkey
    have hkey_new : key ∈ boundaryHullKeys X (splay t (X i)) xs q := by
      simpa [newKeys] using hkey
    have hsub :=
      boundaryHullKeys_after_splay_sublist_cons
        X i xs q hbst hi_mem hq_mem hmem_tail
    simpa [oldKeys] using hsub.subset hkey_new
  have hpath_subset : pathKeys.toFinset ⊆ oldKeys.toFinset := by
    intro key hkey
    have hkey_path : key ∈ searchPathKeys t (X i) := by
      simpa [pathKeys] using hkey
    have hkey_old : key ∈ boundaryHullKeys X t (i :: xs) q :=
      mem_boundaryHullKeys_of_mem_searchPath X t (i :: xs) q
        (i := i) (by simp) hkey_path
    simpa [oldKeys] using hkey_old
  have hunion_subset :
      newKeys.toFinset ∪ pathKeys.toFinset ⊆ oldKeys.toFinset := by
    intro key hkey
    rw [Finset.mem_union] at hkey
    rcases hkey with hkey_new | hkey_path
    · exact hnew_subset hkey_new
    · exact hpath_subset hkey_path
  have hcard_union_bound :
      (newKeys.toFinset ∪ pathKeys.toFinset).card ≤
        oldKeys.toFinset.card :=
    Finset.card_le_card hunion_subset
  have hcard_sum :
      newKeys.toFinset.card + pathKeys.toFinset.card ≤
        oldKeys.toFinset.card +
          (newKeys.toFinset ∩ pathKeys.toFinset).card := by
    have hinc :=
      Finset.card_union_add_card_inter newKeys.toFinset pathKeys.toFinset
    omega
  have hlen :
      newKeys.length + pathKeys.length ≤
        oldKeys.length +
          (newKeys.toFinset ∩ pathKeys.toFinset).card := by
    omega
  rw [show pathKeys.length = t.search_path_len (X i) by
    unfold pathKeys
    exact searchPathKeys_length_eq_search_path_len t (X i)] at hlen
  simpa [newKeys, oldKeys, pathKeys] using hlen

private theorem boundaryHullSize_after_splay_le_cons {n : Nat}
