private theorem resetPairDominatesAbove_threshold_of_low_prefix_base_and_strict_preservation
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    (init : BinaryTree) (done : List (Fin n)) (i : Fin n)
    (future : List (Fin n))
    (hD : 0 ≤ D)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (havoid : Y avoids ![2, 3, 1])
    (hle : ∀ j : Fin n, Y j ≤ q)
    (hsub : (done ++ i :: future).Sublist (List.finRange n))
    (hmem_prefix :
      ∀ j : Fin n, j ∈ done ++ i :: future → Y j ∈ init.toKeyList)
    (hpres_lt :
      ∀ (actual reset : BinaryTree) (x : Nat),
        resetPairDominatesAbove q (Y i) D actual reset →
        x ∈ actual.toKeyList →
        x < q →
        resetPairDominatesAbove q (Y i) D
          (splay actual x) (splay (splay reset x) q))
    (hbase :
      ∀ (left : List (Fin n)) (p : Fin n) (right : List (Fin n)),
        done = left ++ p :: right →
        Y p = q →
        (∀ a : Fin left.length,
          Y (left.get a) < q → Y (left.get a) ≤ Y i) →
        resetPairDominatesAbove q (Y i) D
          (splay (splayTreeAfter Y init left) q)
          (suffixResetTreeAfter Y q init left)) :
    resetPairDominatesAbove q (Y i) D
      (splayTreeAfter Y init done)
      (suffixResetTreeAfter Y q init done) := by
  refine
    resetPairDominatesAbove_threshold_of_last_pivot_split_of_strict_preservation
      Y q D init done i future hD hbst hroot havoid hle hsub
      hmem_prefix hpres_lt ?_
  intro left p right hsplit hp_eq hright_lt hleft_current
      _hleft_right hactual hreset
  let actual0 := splay (splayTreeAfter Y init left) q
  let reset0 := suffixResetTreeAfter Y q init left
  have hdom0 :
      resetPairDominatesAbove q (Y i) D actual0 reset0 := by
    unfold actual0 reset0
    exact hbase left p right hsplit hp_eq hleft_current
  have hmem_right_actual0 :
      ∀ j : Fin n, j ∈ right → Y j ∈ actual0.toKeyList := by
    intro j hj
    have hj_done : j ∈ done := by
      rw [hsplit]
      simp [hj]
    have hj_init : Y j ∈ init.toKeyList := by
      exact hmem_prefix j (by simp [hj_done])
    unfold actual0
    rw [splay_toKeyList, splayTreeAfter_toKeyList]
    exact hj_init
  have hright_lt_mem :
      ∀ j : Fin n, j ∈ right → Y j < q := by
    intro j hj
    rcases List.mem_iff_getElem.mp hj with ⟨k, hk, hget⟩
    let c : Fin right.length := ⟨k, hk⟩
    have hc := hright_lt c
    simpa [c, hget] using hc
  have htail :
      resetPairDominatesAbove q (Y i) D
        (splayTreeAfter Y actual0 right)
        (suffixResetTreeAfter Y q reset0 right) :=
    resetPairDominatesAbove_after_strict_lists_of_preservation
      Y q (Y i) D hpres_lt right actual0 reset0
      hdom0 hmem_right_actual0 hright_lt_mem
  simpa [actual0, reset0, hactual, hreset] using htail

