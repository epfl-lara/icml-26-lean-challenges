        Y [i, j] q hbst (i := i) (by simp)
    have hjB :=
      search_path_len_real_le_boundaryBudget_of_mem
        Y [i, j] q hbst (i := j) (by simp)
    have hqB :=
      search_path_len_real_le_boundaryBudget_of_boundary
