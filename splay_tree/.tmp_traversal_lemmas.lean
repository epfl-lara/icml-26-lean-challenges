private theorem pivotResetPairPathSum_append {n : Nat}
    (Y : Fin n → Nat) (q : Nat) :
    ∀ (xs ys : List (Fin n)) (t : BinaryTree),
      pivotResetPairPathSum Y q t (xs ++ ys) =
        pivotResetPairPathSum Y q t xs +
          pivotResetPairPathSum Y q
            (pivotResetTreeAfter Y q t xs) ys
| [], ys, t => by
    simp [pivotResetPairPathSum, pivotResetTreeAfter]
| i :: xs, ys, t => by
