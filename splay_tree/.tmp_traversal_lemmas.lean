private theorem strictLowerSuffixSeq_pivotResetPairPathSum_le_full_boundary_of_pair_path
    (A K : ℝ) (hA : 0 ≤ A) (hK : 0 ≤ K)
    (hpair_path :
      ∀ {N : Nat} (Y : Fin N → Nat) (q : Nat) (t : BinaryTree),
