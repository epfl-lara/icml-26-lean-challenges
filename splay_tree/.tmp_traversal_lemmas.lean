        rootKey t = some q →
        (∀ i : Fin m, Z i ∈ t.toKeyList) →
        (Z avoids ![2, 3, 1]) →
        (∀ i : Fin m, Z i < q) →
        pivotResetLowerPathSum Z q t (List.finRange m) ≤
