          32 * boundaryBudget Y (splay t (Y i)) xs q ≤
        272 + 32 * boundaryBudget Y t (i :: xs) q :=
    boundaryBudget_drop_le_of_intersection_bound_32
      Y i xs q hbst hi_mem hq_mem hmem_tail
