private theorem rooted_pivot_access_reset_pair_path_real_le_of_lt
    {t : BinaryTree} {q x : Nat}
    (hbst : IsBST t) (hroot : rootKey t = some q)
    (hmem : x ∈ t.toKeyList) (hlt : x < q) :
    (t.search_path_len x : ℝ) +
        ((splay t x).search_path_len q : ℝ) ≤
      2 * (t.search_path_len x : ℝ) := by
  have hmem_left :
      x ∈ (leftSubtree t).toKeyList :=
    mem_leftSubtree_of_root_lt_isBST hbst hroot hmem hlt
  exact_mod_cast
    rooted_pivot_access_reset_pair_path_le
      hbst hroot hmem_left

private theorem rooted_local_pair_slack_two_nat
    {t : BinaryTree} {q x : Nat}
    (_hbst : IsBST t)
    (hroot : rootKey t = some q)
    (_hxmem : x ∈ t.toKeyList)
    (_hxlt : x < q) :
    t.search_path_len x + (splay t x).search_path_len q ≤
      t.search_path_len q + (splay t q).search_path_len x +
        (splay (splay t q) x).search_path_len q + 2 := by
  have hpath_q : t.search_path_len q = 1 :=
    search_path_len_eq_one_of_rootKey_eq_some hroot
  have hsplay_q : splay t q = t :=
    splay_eq_self_of_rootKey_eq_some hroot
  rw [hpath_q, hsplay_q]
  omega

private theorem root_access_local_pair_slack_two_nat
    {t : BinaryTree} {q x : Nat}
