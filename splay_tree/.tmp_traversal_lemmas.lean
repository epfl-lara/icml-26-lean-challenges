    resetPairDominatesAbove_of_path_len_bound
      hdom.1 hdom.2.1 hdom.2.2.1 hdom.2.2.2.1
      hdom.2.2.2.2

private theorem resetPathDominatesAbove.of_state_path
    {q lo : Nat} {D : ℝ} {actual reset : BinaryTree}
    (hbst_actual : IsBST actual)
