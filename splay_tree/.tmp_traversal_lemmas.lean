        (.node ctx pk (.node l k (.node rl rk (.node a x b)))) + 2 := by
  rcases max_right_right_state_of_right_right_nonempty
      hbst hmem hmax with
    ⟨hbst_inner, hmem_inner, hmax_inner, hrk_lt_q⟩
  have hk_lt_rk : k < rk := by
    cases hbst with
    | node _ _ _ _hleft hright _hlbst _hrbst =>
        exact (forallTree_iff_forall_mem.mp hright) rk
          (by simp [BinaryTree.toKeyList])
  have hk_lt_q : k < q := lt_trans hk_lt_rk hrk_lt_q
