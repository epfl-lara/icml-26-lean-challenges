    (hmem_prefix :
      ∀ j : Fin n, j ∈ done ++ i :: future → Y j ∈ init.toKeyList)
    (hpres_lt_path :
      ∀ (actual reset : BinaryTree) (x : Nat),
        resetPairDominatesAbove q (Y i) D actual reset →
        x ∈ actual.toKeyList →
        x < q →
        ∀ y : Nat,
          y ∈ actual.toKeyList →
          Y i ≤ y →
          y < q →
          ((splay actual x).search_path_len y : ℝ) ≤
            ((splay (splay reset x) q).search_path_len y : ℝ) + D)
    (hpres_eq_path :
      ∀ (actual reset : BinaryTree) (x : Nat),
        resetPairDominatesAbove q (Y i) D actual reset →
        x = q →
        ∀ y : Nat,
          y ∈ actual.toKeyList →
          Y i ≤ y →
          y < q →
          ((splay actual x).search_path_len y : ℝ) ≤
            (reset.search_path_len y : ℝ) + D) :
