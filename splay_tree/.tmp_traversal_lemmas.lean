private theorem traversal_conjecture_of_reachable_sourcePotential_step
    (C : ℝ)
    (hstep :
      ∀ {n : Nat} (X : Fin n → Nat) (init : BinaryTree),
        (X avoids ![2, 3, 1]) →
        init.num_nodes = n →
        IsBST init →
        (∀ i : Fin n, X i ∈ init.toKeyList) →
        ∀ (done : List (Fin n)) (i : Fin n)
            (future : List (Fin n)),
          done ++ i :: future = List.finRange n →
          ((splayTreeAfter X init done).search_path_len (X i) : ℝ) +
              sourcePotential X
                (splay (splayTreeAfter X init done) (X i))
                (done ++ [i]) future ≤
            C + sourcePotential X
              (splayTreeAfter X init done) done (i :: future)) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  refine traversal_conjecture_of_pathSum_linear C ?_
  intro n X havoid init h_size hbst hmem
  exact
    splayPathSum_finRange_le_of_reachable_sourcePotential_step
      X init C
      (fun done i future hsplit =>
        hstep X init havoid h_size hbst hmem done i future hsplit)

private theorem traversal_conjecture_of_reachable_sourcePotential_card_drop
    (D : Nat)
    (hdrop :
      ∀ {n : Nat} (X : Fin n → Nat) (init : BinaryTree),
        (X avoids ![2, 3, 1]) →
        init.num_nodes = n →
        IsBST init →
        (∀ i : Fin n, X i ∈ init.toKeyList) →
        ∀ (done : List (Fin n)) (i : Fin n)
            (future : List (Fin n)),
          done ++ i :: future = List.finRange n →
          (sourcePotentialKeys X
                (splay (splayTreeAfter X init done) (X i))
                (done ++ [i]) future).length +
              (splayTreeAfter X init done).search_path_len (X i) ≤
            (sourcePotentialKeys X
                (splayTreeAfter X init done) done (i :: future)).length +
              D) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  refine traversal_conjecture_of_reachable_sourcePotential_step (2 * D) ?_
  intro n X init havoid h_size hbst hmem done i future hsplit
  let cur := splayTreeAfter X init done
  let newKeys :=
    sourcePotentialKeys X (splay cur (X i)) (done ++ [i]) future
  let oldKeys := sourcePotentialKeys X cur done (i :: future)
  have hd_nat :
      newKeys.length + cur.search_path_len (X i) ≤ oldKeys.length + D := by
    unfold newKeys oldKeys cur
    exact hdrop X init havoid h_size hbst hmem done i future hsplit
  have hd_real :
      (newKeys.length : ℝ) + (cur.search_path_len (X i) : ℝ) ≤
        (oldKeys.length : ℝ) + D := by
    exact_mod_cast hd_nat
  unfold sourcePotential
  change
    (cur.search_path_len (X i) : ℝ) +
        2 * (newKeys.length : ℝ) ≤
      2 * (D : ℝ) + 2 * (oldKeys.length : ℝ)
  nlinarith

private theorem traversal_conjecture_of_reachable_sourcePotential_static_inter
    (hstatic :
      ∀ {n : Nat} (X : Fin n → Nat) (init : BinaryTree),
        (X avoids ![2, 3, 1]) →
        init.num_nodes = n →
        IsBST init →
        (∀ i : Fin n, X i ∈ init.toKeyList) →
        ∀ (done : List (Fin n)) (i : Fin n)
            (future : List (Fin n)),
          done ++ i :: future = List.finRange n →
          staticSubRootByTouched X
            (splayTreeAfter X init done) done (X i))
    (hinter :
      ∀ {n : Nat} (X : Fin n → Nat) (init : BinaryTree),
        (X avoids ![2, 3, 1]) →
        init.num_nodes = n →
        IsBST init →
        (∀ i : Fin n, X i ∈ init.toKeyList) →
        ∀ (done : List (Fin n)) (i : Fin n)
            (future : List (Fin n)),
          done ++ i :: future = List.finRange n →
          ∀ key : Nat,
            key ∈ sourcePotentialKeys X
              (splay (splayTreeAfter X init done) (X i))
              (done ++ [i]) future →
            key ∈ searchPathKeys (splayTreeAfter X init done) (X i) →
            key = X i) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  refine traversal_conjecture_of_reachable_sourcePotential_card_drop 2 ?_
  intro n X init havoid h_size hbst hmem done i future hsplit
  let cur := splayTreeAfter X init done
  have hbst_cur : IsBST cur := by
    unfold cur
    exact splayTreeAfter_isBST X done init hbst
  have hi_mem_cur : X i ∈ cur.toKeyList := by
    unfold cur
    rw [splayTreeAfter_toKeyList]
    exact hmem i
  have hfuture_mem_cur :
      ∀ j : Fin n, j ∈ future → X j ∈ cur.toKeyList := by
    intro j _hj
    unfold cur
    rw [splayTreeAfter_toKeyList]
    exact hmem j
  have hsub :
      staticSubRootByTouched X cur done (X i) := by
    unfold cur
    exact hstatic X init havoid h_size hbst hmem done i future hsplit
  have hdis :
      ∀ key : Nat,
        key ∈ sourcePotentialKeys X (splay cur (X i))
          (done ++ [i]) future →
        key ∈ searchPathKeys cur (X i) →
        key = X i := by
    intro key hnew hpath
    unfold cur at hnew hpath
    exact hinter X init havoid h_size hbst hmem done i future hsplit
      key hnew hpath
  simpa [cur] using
    sourcePotentialKeys_card_drop_of_staticSubRoot_inter_singleton
      X (hbst := hbst_cur) (hi_mem := hi_mem_cur)
      (hfuture_mem := hfuture_mem_cur) hsub hdis

private theorem traversal_conjecture_of_reachable_potential_step_with_initial
    (C A : ℝ)
    (Φ : ∀ {n : Nat}, (Fin n → Nat) → BinaryTree →
      BinaryTree → List (Fin n) → List (Fin n) → ℝ)
    (hstep :
      ∀ {n : Nat} (X : Fin n → Nat) (init : BinaryTree),
        (X avoids ![2, 3, 1]) →
        init.num_nodes = n →
        IsBST init →
        (∀ i : Fin n, X i ∈ init.toKeyList) →
        ∀ (done : List (Fin n)) (i : Fin n)
            (future : List (Fin n)),
          done ++ i :: future = List.finRange n →
          ((splayTreeAfter X init done).search_path_len (X i) : ℝ) +
              Φ X init
                (splay (splayTreeAfter X init done) (X i))
                (done ++ [i]) future ≤
            C + Φ X init
              (splayTreeAfter X init done) done (i :: future))
    (hinit :
      ∀ {n : Nat} (X : Fin n → Nat) (init : BinaryTree),
        (X avoids ![2, 3, 1]) →
        init.num_nodes = n →
        IsBST init →
        (∀ i : Fin n, X i ∈ init.toKeyList) →
        Φ X init init [] (List.finRange n) ≤ A * (n : ℝ))
    (hfinal_nonneg :
      ∀ {n : Nat} (X : Fin n → Nat) (init : BinaryTree),
        (X avoids ![2, 3, 1]) →
        init.num_nodes = n →
        IsBST init →
        (∀ i : Fin n, X i ∈ init.toKeyList) →
        0 ≤
          Φ X init (splayTreeAfter X init (List.finRange n))
            (List.finRange n) []) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  refine traversal_conjecture_of_pathSum_linear (C + A) ?_
  intro n X havoid init h_size hbst hmem
  exact
    splayPathSum_finRange_le_of_reachable_potential_step_with_initial
      X init (fun t done future => Φ X init t done future) C A
      (fun done i future hsplit =>
        hstep X init havoid h_size hbst hmem done i future hsplit)
      (hinit X init havoid h_size hbst hmem)
      (hfinal_nonneg X init havoid h_size hbst hmem)

