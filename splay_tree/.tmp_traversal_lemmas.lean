private theorem resetPairDominatesAbove_low_prefix_base_length_le_one
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    (init : BinaryTree) (left : List (Fin n)) (i : Fin n)
    (hD : 0 ≤ D)
    (hbst : IsBST init)
    (hroot : rootKey init = some q)
    (hle_left : ∀ j : Fin n, j ∈ left → Y j ≤ q)
    (hlen : left.length ≤ 1) :
    resetPairDominatesAbove q (Y i) D
      (splay (splayTreeAfter Y init left) q)
      (suffixResetTreeAfter Y q init left) := by
  cases left with
  | nil =>
      simp [splayTreeAfter, suffixResetTreeAfter]
      have hsplay : splay init q = init :=
        splay_eq_self_of_rootKey_eq_some hroot
      rw [hsplay]
      exact resetPairDominatesAbove_refl_root
        q (Y i) D init hD hbst hroot
  | cons j rest =>
      cases rest with
      | nil =>
          have hj_le : Y j ≤ q := hle_left j (by simp)
          by_cases hj_lt : Y j < q
          · have hactual :
                splay (splayTreeAfter Y init [j]) q =
                  splay (splay init (Y j)) q := by
              simp [splayTreeAfter]
            have hreset :
                suffixResetTreeAfter Y q init [j] =
                  splay (splay init (Y j)) q := by
              simpa using
                suffixResetTreeAfter_append_singleton_lt
                  Y q [] init j hj_lt
            rw [hactual, hreset]
            have hbst_reset :
                IsBST (splay (splay init (Y j)) q) :=
              splay_isBST (splay init (Y j)) q
                (splay_isBST init (Y j) hbst)
            have hroot_reset :
                rootKey (splay (splay init (Y j)) q) = some q :=
              rootKey_after_pivot_reset_of_root hbst hroot
            exact resetPairDominatesAbove_refl_root
              q (Y i) D (splay (splay init (Y j)) q)
              hD hbst_reset hroot_reset
          · have hj_eq : Y j = q := by omega
            have hactual :
                splay (splayTreeAfter Y init [j]) q = init := by
              have hsplay : splay init q = init :=
                splay_eq_self_of_rootKey_eq_some hroot
              simp [splayTreeAfter, hj_eq, hsplay]
            have hreset :
                suffixResetTreeAfter Y q init [j] = init := by
              have hnot : ¬ Y j < q := by omega
              simpa [hj_eq] using
                suffixResetTreeAfter_append_singleton_not_lt
                  Y q [] init j hnot
            rw [hactual, hreset]
            exact resetPairDominatesAbove_refl_root
              q (Y i) D init hD hbst hroot
      | cons k rest =>
          simp at hlen

private theorem ordered_low_prefix_base_pair_of_length_le_one
    {n : Nat} (Y : Fin n → Nat) (q : Nat) (D : ℝ)
    (init : BinaryTree) (left : List (Fin n)) (i : Fin n)
    (hD : 0 ≤ D)
    (hbst : IsBST init)
