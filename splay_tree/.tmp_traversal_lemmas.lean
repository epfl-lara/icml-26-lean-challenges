private theorem boundaryBudget_after_pivotResetTreeAfter_le_append {n : Nat}
    (X : Fin n → Nat) (q : Nat) :
    ∀ (consumed future : List (Fin n)) (t : BinaryTree),
      IsBST t →
      q ∈ t.toKeyList →
      (∀ i : Fin n, i ∈ consumed ++ future → X i ∈ t.toKeyList) →
      boundaryBudget X (pivotResetTreeAfter X q t consumed) future q ≤
        boundaryBudget X t (consumed ++ future) q
| [], future, t, _hbst, _hq_mem, _hmem => by
    simp [pivotResetTreeAfter]
| i :: consumed, future, t, hbst, hq_mem, hmem => by
    let tr := splay (splay t (X i)) q
    have hi_mem : X i ∈ t.toKeyList := hmem i (by simp)
    have hmem_tail_t :
        ∀ j : Fin n, j ∈ consumed ++ future → X j ∈ t.toKeyList := by
      intro j hj
      exact hmem j (by simp [hj])
    have hbst_tr : IsBST tr := by
      unfold tr
      exact splay_isBST (splay t (X i)) q
        (splay_isBST t (X i) hbst)
    have hq_mem_tr : q ∈ tr.toKeyList := by
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hq_mem
    have hmem_tail_tr :
        ∀ j : Fin n, j ∈ consumed ++ future → X j ∈ tr.toKeyList := by
      intro j hj
      unfold tr
      rw [splay_toKeyList, splay_toKeyList]
      exact hmem_tail_t j hj
    have ih :=
      boundaryBudget_after_pivotResetTreeAfter_le_append
        X q consumed future tr hbst_tr hq_mem_tr hmem_tail_tr
    have hstep :
        boundaryBudget X tr (consumed ++ future) q ≤
          boundaryBudget X t (i :: (consumed ++ future)) q := by
      unfold tr
      exact boundaryBudget_after_pivot_reset_le_cons
        X i (consumed ++ future) q hbst hi_mem hq_mem hmem_tail_t
    simpa [pivotResetTreeAfter, tr, List.append_assoc] using
      le_trans ih hstep

private theorem one_le_boundaryHullSize_of_rootKey {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n)) {q : Nat}
    (hbst : IsBST t) (hroot : rootKey t = some q) :
    1 ≤ boundaryHullSize X t xs q := by
  have hpath :=
    search_path_len_le_boundaryHullSize_of_boundary X xs q hbst
  rw [search_path_len_eq_one_of_rootKey_eq_some hroot] at hpath
  exact hpath

private theorem one_le_boundaryBudget_of_rootKey {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} (xs : List (Fin n)) {q : Nat}
    (hbst : IsBST t) (hroot : rootKey t = some q) :
    1 ≤ boundaryBudget X t xs q := by
  have hhull := one_le_boundaryHullSize_of_rootKey X xs hbst hroot
  unfold boundaryBudget
  exact_mod_cast Nat.le_add_left 1 xs.length |>.trans
    (Nat.add_le_add_left hhull xs.length)

private theorem boundaryHullSize_nil_eq_one_of_rootKey {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} {q : Nat}
    (hbst : IsBST t) (hroot : rootKey t = some q) :
    boundaryHullSize X t [] q = 1 := by
  let keys := boundaryHullKeys X t ([] : List (Fin n)) q
  have hkeys_nodup : keys.Nodup := by
    unfold keys
    exact boundaryHullKeys_nodup_of_isBST X [] q hbst
  have hcard : keys.toFinset.card = keys.length :=
    List.toFinset_card_of_nodup hkeys_nodup
  have hfin : keys.toFinset = ({q} : Finset Nat) := by
    ext key
    constructor
    · intro hkey
      have hkey_list : key ∈ keys := by
        simpa [keys] using hkey
      rcases (mem_boundaryHullKeys_iff X t ([] : List (Fin n)) q).mp
          (by simpa [keys] using hkey_list) with
        ⟨_hmem_tree, hpath | hfuture⟩
      · have hsingle :=
          searchPathKeys_eq_singleton_of_rootKey_eq_some
            (t := t) (q := q) hroot
        rw [hsingle] at hpath
        simp at hpath
        simp [hpath]
      · rcases hfuture with ⟨j, hj, _hpath⟩
        simp at hj
    · intro hkey
      have hkey_eq : key = q := by simpa using hkey
      subst key
      have hpath : q ∈ searchPathKeys t q := by
        rw [searchPathKeys_eq_singleton_of_rootKey_eq_some hroot]
        simp
      have hq : q ∈ keys := by
        unfold keys
        exact mem_boundaryHullKeys_of_mem_boundaryPath
          X t ([] : List (Fin n)) q hpath
      simpa [keys] using hq
  have hlen : keys.length = 1 := by
    rw [← hcard, hfin]
    simp
  simpa [boundaryHullSize, keys] using hlen

private theorem boundaryBudget_nil_eq_one_of_rootKey {n : Nat}
    (X : Fin n → Nat) {t : BinaryTree} {q : Nat}
    (hbst : IsBST t) (hroot : rootKey t = some q) :
    boundaryBudget X t [] q = 1 := by
  have hhull :=
    boundaryHullSize_nil_eq_one_of_rootKey
      X (t := t) (q := q) hbst hroot
  unfold boundaryBudget
  simp [hhull]

