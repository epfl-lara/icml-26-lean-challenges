private theorem pivot_reset_weighted_step_le_of_pair_hull_discharge
    {n : Nat} (X : Fin n → Nat) {t : BinaryTree} (i : Fin n)
    (xs : List (Fin n)) (q : Nat) (A C D : ℝ)
    (hA_one : 1 ≤ A)
    (hD_le : D ≤ C + A)
    (hbst : IsBST t)
    (hi_mem : X i ∈ t.toKeyList)
    (hq_mem : q ∈ t.toKeyList)
    (hmem_tail : ∀ j : Fin n, j ∈ xs → X j ∈ t.toKeyList)
    (hdischarge :
      (t.search_path_len (X i) : ℝ) +
          ((splay t (X i)).search_path_len q : ℝ) +
          (boundaryHullSize X (splay (splay t (X i)) q) xs q : ℝ) ≤
        (boundaryHullSize X t (i :: xs) q : ℝ) + D) :
    (t.search_path_len (X i) : ℝ) +
        ((splay t (X i)).search_path_len q : ℝ) +
        A * boundaryBudget X (splay (splay t (X i)) q) xs q ≤
      C + A * boundaryBudget X t (i :: xs) q := by
  have hA_nonneg : 0 ≤ A := by nlinarith
  have hA_sub_nonneg : 0 ≤ A - 1 := by nlinarith
  have hhull_nat :
      boundaryHullSize X (splay (splay t (X i)) q) xs q ≤
        boundaryHullSize X t (i :: xs) q :=
    boundaryHullSize_after_pivot_reset_le_cons
      X i xs q hbst hi_mem hq_mem hmem_tail
  have hhull :
      (boundaryHullSize X (splay (splay t (X i)) q) xs q : ℝ) ≤
        (boundaryHullSize X t (i :: xs) q : ℝ) := by
    exact_mod_cast hhull_nat
  have hscaled_hull :
      A * (boundaryHullSize X (splay (splay t (X i)) q) xs q : ℝ) ≤
        (boundaryHullSize X (splay (splay t (X i)) q) xs q : ℝ) +
          (A - 1) * (boundaryHullSize X t (i :: xs) q : ℝ) := by
    have hmul :
        (A - 1) *
            (boundaryHullSize X (splay (splay t (X i)) q) xs q : ℝ) ≤
          (A - 1) * (boundaryHullSize X t (i :: xs) q : ℝ) := by
      exact mul_le_mul_of_nonneg_left hhull hA_sub_nonneg
    nlinarith
  unfold boundaryBudget
  simp only [List.length_cons, Nat.cast_add, Nat.cast_one]
  nlinarith [show 0 ≤ (xs.length : ℝ) by positivity]

