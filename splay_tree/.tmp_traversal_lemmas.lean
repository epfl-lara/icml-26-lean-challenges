private theorem traversal_conjecture_of_direct_firstMax_boundary_bound
    (K : ℝ) (hK : 0 ≤ K)
    (hbound :
      ∀ {n : Nat} (hn : 0 < n) (X : Fin n → Nat)
        (init : BinaryTree),
        init.num_nodes = n →
        (X avoids ![2, 3, 1]) →
        IsBST init →
        (∀ i : Fin n, X i ∈ init.toKeyList) →
        ∃ m : Fin n,
          (∀ a : Fin n, X a ≤ X m) ∧
          (∀ a : Fin n, a < m → X a ≠ X m) ∧
          splayPathSum X init (List.finRange n) ≤
            K * boundaryBudget X init (List.finRange n) (X m)) :
    ∃ c, ∀ n, ∀ X : Fin n → Nat,
      (X avoids ![2, 3, 1]) →
      ∀ (init : BinaryTree), init.num_nodes = n → IsBST init →
      (∀ i : Fin n, (X i) ∈ init.toKeyList) →
      splay.sequence_cost init X ≤ c * n := by
  refine ⟨2 * K, ?_⟩
  intro n X havoid init h_size hbst hmem
  by_cases hn : 0 < n
  · obtain ⟨m, _hmax, _hfirst, hpath⟩ :=
      hbound hn X init h_size havoid hbst hmem
    have hcost_path := sequence_cost_add_length_eq_pathSum X init hmem
    have hbudget :
        boundaryBudget X init (List.finRange n) (X m) ≤ 2 * (n : ℝ) := by
      have hb :=
        boundaryBudget_le_length_add_num_nodes
          X init (List.finRange n) (X m)
      rw [List.length_finRange, h_size] at hb
      nlinarith
    have hpath_linear :
        splayPathSum X init (List.finRange n) ≤ K * (2 * (n : ℝ)) := by
      exact le_trans hpath (mul_le_mul_of_nonneg_left hbudget hK)
    nlinarith [show 0 ≤ (n : ℝ) by positivity, hcost_path, hpath_linear]
  · have hn_zero : n = 0 := by omega
    have hcost := sequence_cost_le_num_nodes_mul_length X init
    have hcost0 : splay.sequence_cost init X ≤ 0 := by
      have hcost' := hcost
      rw [h_size] at hcost'
      have hnR : (n : ℝ) = 0 := by
        exact_mod_cast hn_zero
      nlinarith
    have hgoal : (2 * K) * (n : ℝ) = 0 := by
      rw [hn_zero]
      norm_num
    rw [hgoal]
    exact hcost0

